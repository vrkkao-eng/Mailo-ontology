  <rdf:Description rdf:about="https://w3id.org/mailo#lit_DAOnt_A_Formal_Ontology_for_EU_Data_Act_Compliance_2024_2">
    <rdf:type rdf:resource="https://w3id.org/mailo#LiteratureSource"/>
    <rdfs:label>DAOnt: A Formal Ontology for EU Data Act Compliance. (2024/2026). arXiv:2604.16386.</rdfs:label>
