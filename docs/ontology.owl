  <rdf:Description rdf:about="https://w3id.org/mailo#Risk_AIActQMS_MDR_Overlap">
    <rdf:type rdf:resource="https://w3id.org/mailo#ComplianceRisk"/>
    <rdfs:label xml:lang="en">AI Act Art.17 QMS / MDR Annex IX Double Burden</rdfs:label>
    <rdfs:comment xml:lang="en">AI-SaMD must comply with both AI Act QMS (Art.17) and MDR QMS (Annex IX). Without regulatory alignment, manufacturers face duplicative audit requirements.</rdfs:comment>
    <mailo:riskLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HIGH</mailo:riskLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#EHDS_Art68">
