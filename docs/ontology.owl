    <rdfs:label>PatientRight</rdfs:label>
    <rdfs:label xml:lang="en">Patient Right</rdfs:label>
    <rdfs:comment>A patient-specific data or health right</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#DataSubjectRight"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/mailo#EURegulation">
    <rdfs:label>EURegulation</rdfs:label>
    <rdfs:label xml:lang="en">EU Regulation</rdfs:label>
    <rdfs:comment>EU Regulation (directly applicable)</rdfs:comment>
