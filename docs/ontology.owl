  <rdf:Description rdf:about="https://w3id.org/mailo#EPO_G0001_19">
    <rdf:type rdf:resource="https://w3id.org/mailo#EPOProceding"/>
    <rdfs:label xml:lang="en">EPO G 0001/19 — Patentability of Computer-Implemented Simulations</rdfs:label>
    <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-10</dcterms:date>
    <dcterms:identifier>G 0001/19</dcterms:identifier>
    <mailo:decidedBy rdf:resource="https://w3id.org/mailo#EPO_EnlargedBoA"/>
    <mailo:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Computer-implemented simulation of a technical process is not excluded from patentability (Art.52(2)). Technical character assessed at claim level. Foundational for AI-based clinical decision simulation systems.</mailo:hasOutcome>
    <mailo:interpretesArticle rdf:resource="https://w3id.org/mailo#EPC_Art52"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#lit_MDCG_2025-6_2025_European_Commission_Joint_Guidance_on_M">
    <rdf:type rdf:resource="https://w3id.org/mailo#LiteratureSource"/>
    <rdfs:label>MDCG 2025-6. (2025). European Commission Joint Guidance on MDR/IVDR × AI Act.</rdfs:label>
    <dcterms:date>2025</dcterms:date>
    <dcterms:description>Official EU-level mapping document. MAILO instances must align with it.</dcterms:description>
    <dcterms:source rdf:resource="https://health.ec.europa.eu/document/download/b78a17d7-e3cd-4943-851d-e02a2f22bbb4_en"/>
    <mailo:relevanceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</mailo:relevanceScore>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#hasHumanOversightRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has human oversight record</rdfs:label>
    <rdfs:comment>Links system to its oversight documentation</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an automated decision system to its human oversight documentation. At least one record is required (C-634/21 P_634_002).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#HumanOversightRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#PatentClaim">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>PatentClaim</rdfs:label>
    <rdfs:label xml:lang="en">Patent Claim</rdfs:label>
    <rdfs:comment>A claim within a patent specification</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#isHighRiskAIAct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">is high-risk under AI Act</rdfs:label>
    <rdfs:comment>True if system falls under AI Act Annex III high-risk categories</rdfs:comment>
    <rdfs:comment xml:lang="en">True if the system falls within AI Act Annex III high-risk categories (medical device AI, biometric, critical infrastructure).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#MedicalAISystem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#UPC_GXD_Myriad">
    <rdf:type rdf:resource="https://w3id.org/mailo#UPCCase"/>
    <rdfs:label xml:lang="en">GXD-Bio v. Myriad Genetics — Genomic Diagnostic AI</rdfs:label>
    <dcterms:identifier>UPC_CFI_437/2024</dcterms:identifier>
    <mailo:citesPrecedent rdf:resource="https://w3id.org/mailo#EPO_T0161_18"/>
    <mailo:decidedBy rdf:resource="https://w3id.org/mailo#UPC_LD_Munich"/>
    <mailo:hasDefendant rdf:resource="https://w3id.org/mailo#MyriadGenetics"/>
    <mailo:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Patent fully revoked for added matter; infringement claim dismissed. First UPC biotech NPE case.</mailo:hasOutcome>
    <mailo:hasPlaintiff rdf:resource="https://w3id.org/mailo#GXDBio"/>
    <mailo:hasStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Final — revoked</mailo:hasStatus>
    <mailo:involvesPatent rdf:resource="https://w3id.org/mailo#EP_3346403"/>
    <mailo:involvesTechnology rdf:resource="https://w3id.org/mailo#GenomicDiagnosticAI"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#DGA_Art2">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">DGA Art.2 — Re-use of Public Sector Health Data</rdfs:label>
    <rdfs:comment xml:lang="en">Chapter II framework for re-use of protected public sector data (including health data subject to confidentiality). Applies to AI training use cases at hospitals and research institutes.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#P_634_002">
    <rdf:type rdf:resource="https://w3id.org/mailo#RatioDecidendi"/>
    <rdfs:label xml:lang="en">P-634/21-002: Functional 'Solely' Test</rdfs:label>
    <rdfs:comment xml:lang="en">'Solely' is assessed functionally: formal human intervention that does not constitute substantive review (rubber-stamping) does not negate the 'solely' requirement. The decisive weight given to the automated output is the test.</rdfs:comment>
    <mailo:appliesTo rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
    <mailo:appliesTo rdf:resource="https://w3id.org/mailo#ClinicalDecisionSupport"/>
    <mailo:appliesTo rdf:resource="https://w3id.org/mailo#MedicalImagingAI"/>
    <mailo:hasPrecedenceLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">binding_ratio</mailo:hasPrecedenceLevel>
    <mailo:triggersObligation rdf:resource="https://w3id.org/mailo#HumanOversightObligation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#UPCCase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>UPCCase</rdfs:label>
    <rdfs:label xml:lang="en">UPC Case</rdfs:label>
    <rdfs:comment>Case before the Unified Patent Court</rdfs:comment>
    <rdfs:comment xml:lang="en">Infringement, revocation, or PI proceeding before the Unified Patent Court.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#Case"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#hasPlaintiff">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has plaintiff</rdfs:label>
    <rdfs:comment>Plaintiff in the case</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#Case"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#LegalEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#LegalArticle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>LegalArticle</rdfs:label>
    <rdfs:label xml:lang="en">Legal Article</rdfs:label>
    <rdfs:comment>A specific provision within a legal instrument</rdfs:comment>
    <rdfs:comment xml:lang="en">A specific provision within a legal instrument.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/eli/ontology#LegalExpression"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#P_203_001">
    <rdf:type rdf:resource="https://w3id.org/mailo#RatioDecidendi"/>
    <rdfs:label xml:lang="en">P-203/22-001: Meaningful Explainability Standard</rdfs:label>
    <rdfs:comment xml:lang="en">Art.15(1)(h) requires actionable explanations in non-technical language, identifying which inputs affected the output and the main reasoning path. Abstract mathematical formulas are insufficient.</rdfs:comment>
    <mailo:appliesTo rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
    <mailo:appliesTo rdf:resource="https://w3id.org/mailo#MedicalAISystem"/>
    <mailo:hasPrecedenceLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">binding_ratio</mailo:hasPrecedenceLevel>
    <mailo:triggersObligation rdf:resource="https://w3id.org/mailo#ExplainabilityObligation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#P_817_004">
    <rdf:type rdf:resource="https://w3id.org/mailo#RatioDecidendi"/>
    <rdfs:label xml:lang="en">P-817/19-004: Non-Discrimination — Health Status Excluded</rdfs:label>
    <rdfs:comment xml:lang="en">Automated assessment criteria must not be based on health status. AI systems trained on medical history data may not use health condition as a discriminatory classification basis.</rdfs:comment>
    <mailo:appliesTo rdf:resource="https://w3id.org/mailo#GenomicDiagnosticAI"/>
    <mailo:appliesTo rdf:resource="https://w3id.org/mailo#MedicalAISystem"/>
    <mailo:hasPrecedenceLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constitutional_grand_chamber</mailo:hasPrecedenceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#involvesFramework">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">involves framework</rdfs:label>
    <rdfs:comment>A cross-framework tension involves a regulatory framework.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#CrossFrameworkTension"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#DataAct_Art15">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">Data Act Art.15 — Trade Secret Protection</rdfs:label>
    <rdfs:comment xml:lang="en">Data sharing obligation is limited by trade secret protection — manufacturers may refuse where disclosure would reveal protected business information. Key tension with AI transparency obligations.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#Tension_PLD_AIAct_Liability">
    <rdf:type rdf:resource="https://w3id.org/mailo#CrossFrameworkTension"/>
    <rdfs:label xml:lang="en">PLD Strict Liability vs. AI Act Conformity Defence</rdfs:label>
    <rdfs:comment xml:lang="en">&#13;
        PLD Art.4 imposes strict liability; AI Act conformity assessment is not a&#13;
        defence to PLD claims. A CE-marked AI-SaMD that passes AI Act conformity&#13;
        assessment may still be 'defective' under PLD if it fails in real-world&#13;
        deployment. The two regimes do not create a safety harbour from each other.&#13;
    </rdfs:comment>
    <mailo:conflictsWith rdf:resource="https://w3id.org/mailo#PLD_Art4"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#EPOProceding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>EPOProceding</rdfs:label>
    <rdfs:label xml:lang="en">EPO Proceeding</rdfs:label>
    <rdfs:comment>EPO opposition, appeal, or examination</rdfs:comment>
    <rdfs:comment xml:lang="en">Opposition, appeal, or examination proceeding before the EPO.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#Case"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#hasObligation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Framework imposes an obligation</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#ComplianceObligation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#producesSignificantImpact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">produces significant impact</rdfs:label>
    <rdfs:comment>True if outputs have legal/similarly significant effects on individuals</rdfs:comment>
    <rdfs:comment xml:lang="en">True if the system's outputs have legal or similarly significant effects on individuals (C-634/21 P_634_001). Triggers full Art.22 obligation chain.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#lit_Hybrid_Neuro-Symbolic_Models_for_Ethical_AI_in_Risk-Sensitiv">
    <rdf:type rdf:resource="https://w3id.org/mailo#LiteratureSource"/>
    <rdfs:label>Hybrid Neuro-Symbolic Models for Ethical AI in Risk-Sensitive Domains. (2025). arXiv:2511.17644.</rdfs:label>
    <dcterms:date>2025</dcterms:date>
    <dcterms:description>Risk-sensitive domains demand transparency + regulatory compliance. Neural pattern recognition + symbolic reasoning yields verifiable explanations. Healthcare among the case studies.</dcterms:description>
    <dcterms:source rdf:resource="https://arxiv.org/html/2511.17644v1"/>
    <mailo:relevanceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</mailo:relevanceScore>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#P_817_005">
    <rdf:type rdf:resource="https://w3id.org/mailo#ObiterDictum"/>
    <rdfs:label xml:lang="en">P-817/19-005: Independent Oversight Obligation</rdfs:label>
    <rdfs:comment xml:lang="en">Automated processing systems must be subject to effective independent oversight including DPO access and regular algorithmic legality review.</rdfs:comment>
    <mailo:hasPrecedenceLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">persuasive_obiter</mailo:hasPrecedenceLevel>
    <mailo:triggersObligation rdf:resource="https://w3id.org/mailo#DPIAObligation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#OmnibusAI_ProvisionalAgreement_20260507">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegislativeAmendment"/>
    <rdfs:label>Digital Omnibus on AI — Provisional Agreement (Council + EP, 2026-05-07)</rdfs:label>
    <mailo:amendmentDescription>Provisional political agreement on Digital Omnibus on AI (Omnibus VII package). Extends Annex III standalone high-risk deadline to 2027-12-02 and Annex I (SaMD/MDR) deadline to 2028-08-02 via conditional standards-availability mechanism. Introduces unified MDR+AI Act notified body assessment pathway. Not yet formally adopted as of 2026-05-10; formal adoption expected before 2026-08-02. Source: Consilium press release 2026-05-07.</mailo:amendmentDescription>
    <mailo:versionStartDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-07</mailo:versionStartDate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#Tension_EHDS_GDPR_OptOut">
    <rdf:type rdf:resource="https://w3id.org/mailo#CrossFrameworkTension"/>
    <rdfs:label xml:lang="en">EHDS Art.35 opt-out vs. AI Act Art.10(3) representativeness</rdfs:label>
    <rdfs:comment xml:lang="en">EHDS Art.35 grants patients an unconditional right to opt out of secondary health data use. Where opt-out rates are elevated in a clinically significant subpopulation, the resulting training dataset violates AI Act Art.10(3) representativeness. No legislative safe harbour bridges these positions.</rdfs:comment>
    <mailo:conflictType rdf:resource="https://w3id.org/mailo#DataGovernanceConflict"/>
    <mailo:hasResolutionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">unresolved</mailo:hasResolutionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#NationalCourtCase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>NationalCourtCase</rdfs:label>
    <rdfs:label xml:lang="en">National Court Case</rdfs:label>
    <rdfs:comment>Proceeding before a national court</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#Case"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#NationalAuthority">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>NationalAuthority</rdfs:label>
    <rdfs:label xml:lang="en">National Authority</rdfs:label>
    <rdfs:comment>A national regulatory or supervisory body</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#LegalEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#AIAct_v2_GPAIModelObligations">
    <rdf:type rdf:resource="https://w3id.org/mailo#RegulationVersion"/>
    <rdfs:label>GPAI model provider obligations apply (Title VIII, Arts.51–56)</rdfs:label>
    <mailo:applicablePhase>gpai_model_obligations</mailo:applicablePhase>
    <mailo:isCurrentVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</mailo:isCurrentVersion>
    <mailo:triggeredBy rdf:resource="https://w3id.org/mailo#Amend_AIAct_v2_GPAIModelObligations"/>
    <mailo:versionEndDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-31</mailo:versionEndDate>
    <mailo:versionOf rdf:resource="https://w3id.org/mailo#AIAct_2024_1689"/>
    <mailo:versionStartDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-08-02</mailo:versionStartDate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#Tension_DataAct_TradeSecret_AITransparency">
    <rdf:type rdf:resource="https://w3id.org/mailo#CrossFrameworkTension"/>
    <rdfs:label xml:lang="en">Data Act Art.15 trade secret vs. AI Act Art.13 + GDPR Art.15(1)(h) transparency</rdfs:label>
    <rdfs:comment xml:lang="en">C-203/22 Dun &amp; Bradstreet §§60-70 limits trade-secret defence: a controller cannot refuse all causal explanation on trade-secret grounds. The precise boundary between permitted limitation and impermissible derogation is determined case-by-case.</rdfs:comment>
    <mailo:conflictType rdf:resource="https://w3id.org/mailo#TradeSecretConflict"/>
    <mailo:hasResolutionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">partial</mailo:hasResolutionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#hasTension">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Tension involves a framework</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#CrossFrameworkTension"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#EP_2352431">
    <rdf:type rdf:resource="https://w3id.org/mailo#EuropeanPatent"/>
    <rdfs:label xml:lang="en">EP 2 352 431 B1</rdfs:label>
    <rdfs:comment xml:lang="en">Hologic breast imaging AI-assisted reading technology.</rdfs:comment>
  </rdf:Description>
