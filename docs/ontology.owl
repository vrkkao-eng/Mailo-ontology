    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <mailo:LiteratureSource rdf:about="https://w3id.org/mailo#lit_Frontiers_Digital_Health_2025_Ontologies_as_the_semantic">
    <rdfs:label>Frontiers Digital Health. (2025). Ontologies as the semantic bridge between artificial intelligence and healthcare.</rdfs:label>
    <dcterms:date>2025</dcterms:date>
    <dcterms:description>OWL2 + SWRL semantic reasoning enables auditable inference consistent with domain expertise. Ontologies encode explicit rules and traceable data relationships required by AI Act. Doctrinal scaffold for MAILO.</dcterms:description>
    <dcterms:source rdf:resource="https://www.frontiersin.org/journals/digital-health/articles/10.3389/fdgth.2025.1668385/full"/>
    <mailo:relevanceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</mailo:relevanceScore>
  </mailo:LiteratureSource>
  <mailo:LiteratureSource rdf:about="https://w3id.org/mailo#lit_npj_Health_Systems_2026_Data-driven_medical_devices_and">
    <rdfs:label>npj Health Systems. (2026). Data-driven medical devices and the EU MDR: mapping gaps in standards for regulatory compliance.</rdfs:label>
    <dcterms:date>2026</dcterms:date>
    <dcterms:description>ISO/IEC 27001/27010 + ISO/IEC 5338, 25059, BS 30440 are insufficient for AI medical safety/transparency — exactly the gap MAILO addresses.</dcterms:description>
    <dcterms:source rdf:resource="https://www.nature.com/articles/s44401-026-00075-2"/>
    <mailo:relevanceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</mailo:relevanceScore>
  </mailo:LiteratureSource>
