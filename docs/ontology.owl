  <mailo:CrossFrameworkTension rdf:about="https://w3id.org/mailo#Tension_EPO_MDR_SemanticScope">
    <rdfs:label xml:lang="en">EPO G-II §3.3 broad claim scope vs. MDR Annex II §1.1 + AI Act Art.9/13 intended purpose</rdfs:label>
    <rdfs:comment xml:lang="en">EPO patent prosecution optimises for broad technical-effect claims (wider scope = stronger IP protection); MDR Annex II requires precise intended-purpose specification (narrower scope = easier clinical evaluation); AI Act Art.9/13 requires intermediate characterisation covering intended purpose plus reasonably foreseeable misuse. The same SaMD must be described at opposing granularity levels across three institutional knowledge spaces. No EPO, MDCG, or AI Office guidance addresses this triangular scope alignment problem.</rdfs:comment>
    <mailo:conflictType>
      <mailo:ConflictType rdf:about="https://w3id.org/mailo#SemanticGranularityConflict">
        <rdfs:label xml:lang="en">Semantic granularity conflict</rdfs:label>
        <rdfs:comment xml:lang="en">Frameworks describe the same artefact at incompatible levels of specificity, so a statement that satisfies one reads as over- or under-inclusive under another (e.g. broad EPO claim scope against narrow MDR intended purpose against intermediate AI Act foreseeable use).</rdfs:comment>
      </mailo:ConflictType>
    </mailo:conflictType>
    <mailo:hasResolutionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">unresolved</mailo:hasResolutionStatus>
    <mailo:involvesArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#MDR_AnnexII">
        <rdfs:label xml:lang="en">MDR Annex II — Technical documentation</rdfs:label>
        <rdfs:comment xml:lang="en">The technical documentation manufacturers must prepare, beginning at section 1.1 with the device description and specification including intended purpose, intended users and clinical indications. Referenced by Tension_EPO_MDR_SemanticScope, which contrasts the precision MDR demands of the intended purpose with the breadth patent prosecution seeks in claim scope. Added in v5.1.0: the tension cited this annex while the ontology did not encode it.</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:involvesArticle>
    <mailo:involvesFramework>
      <mailo:EURegulation rdf:about="https://w3id.org/mailo#AIAct">
        <rdf:type rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
        <rdfs:label xml:lang="en">EU AI Act 2024/1689</rdfs:label>
        <eli:id_local>32024R1689</eli:id_local>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-08-01</dcterms:date>
        <dcterms:identifier>2024/1689/EU</dcterms:identifier>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#AIAct_Art10"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#AIAct_Art13"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#AIAct_Art14"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#AIAct_Art17"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#AIAct_Art26"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#AIAct_Art50"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#AIAct_Art86"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#AIAct_Art9"/>
      </mailo:EURegulation>
    </mailo:involvesFramework>
    <mailo:involvesFramework>
      <mailo:InternationalTreaty rdf:about="https://w3id.org/mailo#EPC">
        <rdf:type rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
        <rdfs:label xml:lang="en">European Patent Convention</rdfs:label>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1977-10-07</dcterms:date>
        <rdfs:comment xml:lang="en">European Patent Convention (in force 1977-10-07). Governs patentability of AI/medical-AI inventions (Art.52 exclusions), sufficiency of disclosure for ML models (Art.83), and EPO opposition/appeal proceedings. Administered by EPO; distinct from EU law but intersects via UPC.</rdfs:comment>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#EPC_Art52"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#EPC_Art83"/>
      </mailo:InternationalTreaty>
    </mailo:involvesFramework>
    <mailo:involvesFramework>
      <mailo:EURegulation rdf:about="https://w3id.org/mailo#MDR">
        <rdf:type rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
        <rdfs:label xml:lang="en">MDR 2017/745</rdfs:label>
        <eli:id_local>32017R0745</eli:id_local>
        <dcterms:identifier>2017/745/EU</dcterms:identifier>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#MDR_AnnexI"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#MDR_AnnexII"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#MDR_AnnexIX"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#MDR_AnnexVIII_Rule11"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#MDR_Art15"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#MDR_Art61"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#MDR_Art83"/>
      </mailo:EURegulation>
    </mailo:involvesFramework>
  </mailo:CrossFrameworkTension>
