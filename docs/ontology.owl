    <rdfs:label xml:lang="en">status verified as at</rdfs:label>
    <rdfs:comment xml:lang="en">The date on which the legislative status recorded here was checked against a source. A status assertion without this date is not auditable and should not be relied on.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#PendingAmendment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/mailo#NationalAuthority">
    <rdfs:label>NationalAuthority</rdfs:label>
