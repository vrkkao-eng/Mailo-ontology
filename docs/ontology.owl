    <rdfs:comment>Automated risk stratification or scoring system</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/mailo#LegalPrinciple">
    <rdfs:label>LegalPrinciple</rdfs:label>
    <rdfs:label xml:lang="en">Legal Principle</rdfs:label>
    <rdfs:comment>A binding or persuasive rule extracted from case law</rdfs:comment>
    <rdfs:comment xml:lang="en">A binding or persuasive rule extracted from case law or legislation.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/mailo#InternationalTreaty">
    <rdfs:label>InternationalTreaty</rdfs:label>
    <rdfs:label xml:lang="en">International Treaty</rdfs:label>
    <rdfs:comment>International treaty or convention</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#LegalInstrument"/>
  </owl:Class>
  <mailo:DataSubjectRight rdf:about="https://w3id.org/mailo#Right_Explanation">
    <rdfs:label xml:lang="en">Right to Meaningful Explanation (Art.15(1)(h), C-203/22)</rdfs:label>
  </mailo:DataSubjectRight>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#TSD_Art2">
    <rdfs:label xml:lang="en">TSD Article 2 — Definition of Trade Secret</rdfs:label>
    <rdfs:comment xml:lang="en">Three-part cumulative test: information must be (1) secret (not generally known or readily accessible), (2) have commercial value because it is secret, and (3) be subject to reasonable steps to keep it secret. All three must hold for ML model weights or training data to qualify.</rdfs:comment>
  </mailo:LegalArticle>
  <mailo:PendingAmendment rdf:about="https://w3id.org/mailo#DigitalOmnibus_DataAct_ChapterV">
    <rdfs:label xml:lang="en">Digital Omnibus — proposed consolidation of Data Act Chapter V into a new Art.15a</rdfs:label>
    <mailo:amendmentProcedureRef rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025/0360(COD)</mailo:amendmentProcedureRef>
    <mailo:amendmentProposalRef rdf:datatype="http://www.w3.org/2001/XMLSchema#string">COM(2025) 837 final</mailo:amendmentProposalRef>
    <mailo:legislativeStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">council_position</mailo:legislativeStatus>
    <mailo:proposedEffect rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deletes Data Act Arts 14 and 15 and consolidates the business-to-government regime into a new Art.15a, narrowing the trigger from 'exceptional need' to public emergencies only. Not adopted as at the verification date: the AI limb of the Digital Omnibus was severed and adopted separately as Regulation (EU) 2026/1744, while the data limb remains in negotiation. MAILO therefore continues to encode the numbering of Regulation (EU) 2023/2854 as published.</mailo:proposedEffect>
    <mailo:proposedRenumberingTo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Data Act Art.15a</mailo:proposedRenumberingTo>
    <mailo:statusVerifiedAsAt rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-05</mailo:statusVerifiedAsAt>
  </mailo:PendingAmendment>
  <owl:Class rdf:about="https://w3id.org/mailo#Company">
    <rdfs:label>Company</rdfs:label>
    <rdfs:label xml:lang="en">Company</rdfs:label>
    <rdfs:comment>A corporate entity</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#LegalEntity"/>
  </owl:Class>
  <mailo:RatioDecidendi rdf:about="https://w3id.org/mailo#P_Bara_001">
    <rdfs:label xml:lang="en">Transparency Rights Foundation</rdfs:label>
    <rdfs:comment xml:lang="en">Data subjects must be informed of data transfers; establishes foundational transparency obligation.</rdfs:comment>
    <mailo:hasEncodingBasis>
      <mailo:EncodingBasis rdf:about="https://w3id.org/mailo#CourtHolding">
        <rdfs:label xml:lang="en">Court holding</rdfs:label>
        <rdfs:comment xml:lang="en">The encoded proposition is what the court decided, at the paragraphs cited.</rdfs:comment>
      </mailo:EncodingBasis>
    </mailo:hasEncodingBasis>
    <mailo:hasPrecedenceLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">binding_ratio</mailo:hasPrecedenceLevel>
  </mailo:RatioDecidendi>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#GDPR_Art22_3">
    <rdfs:label xml:lang="en">GDPR Art.22(3)</rdfs:label>
    <rdfs:comment xml:lang="en">Safeguards when exceptions apply: human intervention, right to express views, contest decision.</rdfs:comment>
    <mailo:grantsRight>
      <mailo:DataSubjectRight rdf:about="https://w3id.org/mailo#Right_Contest">
        <rdfs:label xml:lang="en">Right to Contest Decision (Art.22(3)(c))</rdfs:label>
      </mailo:DataSubjectRight>
    </mailo:grantsRight>
    <mailo:grantsRight>
      <mailo:DataSubjectRight rdf:about="https://w3id.org/mailo#Right_ExpressViews">
        <rdfs:label xml:lang="en">Right to Express Views (Art.22(3)(b))</rdfs:label>
      </mailo:DataSubjectRight>
    </mailo:grantsRight>
    <mailo:grantsRight>
      <mailo:DataSubjectRight rdf:about="https://w3id.org/mailo#Right_HumanIntervention">
        <rdfs:label xml:lang="en">Right to Human Intervention (Art.22(3)(a))</rdfs:label>
      </mailo:DataSubjectRight>
    </mailo:grantsRight>
  </mailo:LegalArticle>
