  <rdf:Description rdf:about="https://w3id.org/mailo#DGA">
    <rdf:type rdf:resource="https://w3id.org/mailo#EURegulation"/>
    <rdf:type rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
    <rdfs:label xml:lang="en">DGA 2022/868</rdfs:label>
    <eli:id_local>32022R0868</eli:id_local>
    <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-05-30</dcterms:date>
    <dcterms:identifier>2022/868/EU</dcterms:identifier>
    <rdfs:comment xml:lang="en">Data Governance Act. Applies from 2023-09-24. Creates data intermediaries, data altruism organisations, and re-use frameworks for public sector health data.</rdfs:comment>
    <mailo:coversArticle rdf:resource="https://w3id.org/mailo#DGA_Art10"/>
    <mailo:coversArticle rdf:resource="https://w3id.org/mailo#DGA_Art16"/>
    <mailo:coversArticle rdf:resource="https://w3id.org/mailo#DGA_Art2"/>
    <mailo:coversArticle rdf:resource="https://w3id.org/mailo#DGA_Art31"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#EPO_T0161_18">
    <rdf:type rdf:resource="https://w3id.org/mailo#EPOProceding"/>
    <rdfs:label xml:lang="en">EPO T 0161/18 — AI Medical Device Disclosure</rdfs:label>
    <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-05-12</dcterms:date>
    <dcterms:identifier>T 0161/18</dcterms:identifier>
    <mailo:decidedBy rdf:resource="https://w3id.org/mailo#EPO_BoA"/>
    <mailo:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AI medical device patent invalid for insufficient disclosure: training data set characteristics must be disclosed. Gold standard for AI patent sufficiency in EPO and UPC.</mailo:hasOutcome>
    <mailo:interpretesArticle rdf:resource="https://w3id.org/mailo#EPC_Art52"/>
    <mailo:interpretesArticle rdf:resource="https://w3id.org/mailo#EPC_Art83"/>
    <mailo:involvesTechnology rdf:resource="https://w3id.org/mailo#MedicalAISystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#amendmentDescription">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Human-readable description of what this legislative event changes</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#celex">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>CELEX number for EU legislation</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#EHDS_Art35">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">EHDS Art.35 — Opt-Out Right</rdfs:label>
    <rdfs:comment xml:lang="en">Data subjects may opt out of secondary use of their health data in databases not requiring individual consent. Creates tension with AI Act Art.10 data governance obligations.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#ExplainabilityObligation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>ExplainabilityObligation</rdfs:label>
    <rdfs:label xml:lang="en">Explainability Obligation</rdfs:label>
    <rdfs:comment>Obligation to provide actionable explanations</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://w3id.org/dpv#ExplainabilityObligation"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#ComplianceObligation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#TSD_Art2">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">TSD Article 2 — Definition of Trade Secret</rdfs:label>
    <rdfs:comment xml:lang="en">Three-part cumulative test: information must be (1) secret (not generally known or readily accessible), (2) have commercial value because it is secret, and (3) be subject to reasonable steps to keep it secret. All three must hold for ML model weights or training data to qualify.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#enforcedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Framework enforced by authority</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#RegulatoryAuthority"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#Right">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Right</rdfs:label>
    <rdfs:label xml:lang="en">Right</rdfs:label>
    <rdfs:comment>A legal right</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#PLD">
    <rdf:type rdf:resource="https://w3id.org/mailo#EUDirective"/>
    <rdf:type rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
    <rdfs:label xml:lang="en">PLD 2024/2853</rdfs:label>
    <eli:id_local>32024L2853</eli:id_local>
    <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-11-23</dcterms:date>
    <dcterms:identifier>2024/2853/EU</dcterms:identifier>
    <rdfs:comment xml:lang="en">Revised Product Liability Directive. AILD was withdrawn 2025-02-10; PLD 2024 is the operative EU strict-liability instrument for AI systems as 'products'.</rdfs:comment>
    <mailo:coversArticle rdf:resource="https://w3id.org/mailo#PLD_Art10"/>
    <mailo:coversArticle rdf:resource="https://w3id.org/mailo#PLD_Art11"/>
    <mailo:coversArticle rdf:resource="https://w3id.org/mailo#PLD_Art4"/>
    <mailo:coversArticle rdf:resource="https://w3id.org/mailo#PLD_Art7"/>
    <mailo:coversArticle rdf:resource="https://w3id.org/mailo#PLD_Art9"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#UPC_Hologic_Siemens">
    <rdf:type rdf:resource="https://w3id.org/mailo#UPCCase"/>
    <rdfs:label xml:lang="en">Hologic v. Siemens Healthineers — Medical Imaging AI</rdfs:label>
    <dcterms:identifier>UPC_CFI_758/2024</dcterms:identifier>
    <mailo:decidedBy rdf:resource="https://w3id.org/mailo#UPC_LD_Dusseldorf"/>
    <mailo:hasDefendant rdf:resource="https://w3id.org/mailo#SiemensHealthineers"/>
    <mailo:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Decision issued 2026-03-09; details pending publication.</mailo:hasOutcome>
    <mailo:hasPlaintiff rdf:resource="https://w3id.org/mailo#Hologic"/>
    <mailo:hasStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Active — post-decision stage</mailo:hasStatus>
    <mailo:involvesPatent rdf:resource="https://w3id.org/mailo#EP_2352431"/>
    <mailo:involvesTechnology rdf:resource="https://w3id.org/mailo#MedicalImagingAI"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#Hologic">
    <rdf:type rdf:resource="https://w3id.org/mailo#Company"/>
    <rdfs:label xml:lang="en">Hologic Inc.</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#PLD_Art11">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">PLD Art.11 — Causation Presumption</rdfs:label>
    <rdfs:comment xml:lang="en">Rebuttable causation presumption where defect is established and damage is of a kind normally caused by the defect. Key for medical AI harm cases.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#conflictsWith">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:label xml:lang="en">conflicts with</rdfs:label>
    <rdfs:comment>Article conflicts with another</rdfs:comment>
    <rdfs:comment xml:lang="en">Two legal obligations or principles that are in tension.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#LegalArticle"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#lit_Medical_Law_Review_2024_A_health-conformant_reading_of_t">
    <rdf:type rdf:resource="https://w3id.org/mailo#LiteratureSource"/>
    <rdfs:label>Medical Law Review. (2024). A health-conformant reading of the GDPR's right not to be subject to automated decision-making, 32(3), 373.</rdfs:label>
    <dcterms:date>2024</dcterms:date>
    <dcterms:description>Only article addressing the exact intersection of GDPR Art.22 + medical AI. Doctrinal foundation for MAILO's medical-AI ADM rules.</dcterms:description>
    <dcterms:source rdf:resource="https://academic.oup.com/medlaw/article/32/3/373/7732100"/>
    <mailo:relevanceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</mailo:relevanceScore>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#lit_Pandit_H_J_et_al_2024_Data_Privacy_Vocabulary_DPV">
    <rdf:type rdf:resource="https://w3id.org/mailo#LiteratureSource"/>
    <rdfs:label>Pandit, H. J. et al. (2024). Data Privacy Vocabulary (DPV) – Version 2.0. Springer / W3C DPVCG.</rdfs:label>
    <dcterms:date>2024</dcterms:date>
    <dcterms:description>RDFS/SKOS + OWL2 alt; 911 concepts; serialised in TTL/JSON-LD/RDF-XML; namespace http://w3id.org/dpv#. Foundational vocabulary the thesis should reuse. Recommendation: import DPV namespace into MAILO; align mailo:hasObligation with dpv:hasLegalBasis.</dcterms:description>
    <dcterms:source rdf:resource="https://w3c.github.io/dpv/2.1/dpv/"/>
    <mailo:relevanceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</mailo:relevanceScore>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#isCurrentVersion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>True if this is the currently applicable version as of the query date</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#PNRDirective">
    <rdf:type rdf:resource="https://w3id.org/mailo#EUDirective"/>
    <rdf:type rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
    <rdfs:label xml:lang="en">PNR Directive 2016/681</rdfs:label>
    <dcterms:identifier>2016/681/EU</dcterms:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#DPIARecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>DPIARecord</rdfs:label>
    <rdfs:label xml:lang="en">DPIA Record</rdfs:label>
    <rdfs:comment>Data Protection Impact Assessment document (GDPR Art.35; C-817/19)</rdfs:comment>
    <rdfs:comment xml:lang="en">A Data Protection Impact Assessment document required for high-risk automated processing (GDPR Art.35; C-817/19 P_817_005).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#lit_Kang_M_Li_B_et_al_2025_R_-Guard_Robust_Reasoning_E">
    <rdf:type rdf:resource="https://w3id.org/mailo#LiteratureSource"/>
    <rdfs:label>Kang, M., Li, B. et al. (2025). R²-Guard: Robust Reasoning Enabled LLM Guardrail via Knowledge-Enhanced Logical Reasoning. ICLR 2025.</rdfs:label>
    <dcterms:date>2025</dcterms:date>
    <dcterms:description>Markov logic networks + probabilistic circuits over a safety reasoning graph. +30.2% over Llama Guard on ToxicChat; +59.5% under jailbreak attacks. Direct precedent for logic-graph-as-runtime-safety-filter pattern that MAILO advances, but for general LLM safety, not medical regulation.</dcterms:description>
    <dcterms:source rdf:resource="https://arxiv.org/abs/2407.05557"/>
    <mailo:relevanceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</mailo:relevanceScore>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#DataAct_Art5">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">Data Act Art.5 — Data Sharing with Third Parties</rdfs:label>
    <rdfs:comment xml:lang="en">Data holders must share IoT-generated health data with third parties at user request. Creates AI training data supply chain implications for medical device manufacturers.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#NotifiedBody">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>NotifiedBody</rdfs:label>
    <rdfs:label xml:lang="en">Notified Body</rdfs:label>
    <rdfs:comment>A conformity assessment body notified under MDR/AI Act</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#LegalEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#GDPR_v1_FullyApplicable">
    <rdf:type rdf:resource="https://w3id.org/mailo#RegulationVersion"/>
    <rdfs:label>GDPR fully applicable — all provisions in force</rdfs:label>
    <mailo:applicablePhase>fully_applicable</mailo:applicablePhase>
    <mailo:isCurrentVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</mailo:isCurrentVersion>
    <mailo:versionOf rdf:resource="https://w3id.org/mailo#GDPR_2016_679"/>
    <mailo:versionStartDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2018-05-25</mailo:versionStartDate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#MDR_Art83">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">MDR Art.83 — Post-Market Surveillance</rdfs:label>
    <rdfs:comment xml:lang="en">PMS system must collect real-world performance data. For AI-SaMD: continuous monitoring of model drift and performance degradation in deployment populations.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#AIAct_Art50">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">AI Act Art.50 — Transparency for GPAI</rdfs:label>
    <rdfs:comment xml:lang="en">General-purpose AI (GPAI) providers must disclose AI-generated content (watermarking/labelling). Applies to AI-generated radiology reports, diagnostic summaries.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#InternationalTreaty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>InternationalTreaty</rdfs:label>
    <rdfs:label xml:lang="en">International Treaty</rdfs:label>
    <rdfs:comment>International treaty or convention</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#LegalInstrument"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#mitigatedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">mitigated by</rdfs:label>
    <rdfs:comment>Risk mitigated by obligation</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#ComplianceRisk"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#ComplianceObligation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#DataAct_Art17">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">Data Act Art.17 — B2G Data Sharing (Public Emergency)</rdfs:label>
    <rdfs:comment xml:lang="en">In public health emergencies, governments may require medical AI companies to share health data. Applies to epidemic surveillance AI and clinical trial datasets.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#Risk_InsufficientDisclosure">
    <rdf:type rdf:resource="https://w3id.org/mailo#ComplianceRisk"/>
    <rdfs:label xml:lang="en">Insufficient Training Data Disclosure (EPO T0161/18)</rdfs:label>
    <mailo:mitigatedBy rdf:resource="https://w3id.org/mailo#DisclosureObligation"/>
    <mailo:riskLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HIGH</mailo:riskLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#EHDS_Art50">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">EHDS Art.50 — HealthData@EU Infrastructure</rdfs:label>
    <rdfs:comment xml:lang="en">HealthData@EU federated cross-border health data access infrastructure. Enables EU-wide AI training datasets without raw data transfer.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#ConformityRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>ConformityRecord</rdfs:label>
    <rdfs:label xml:lang="en">Conformity Record</rdfs:label>
    <rdfs:comment>Conformity assessment / technical documentation record</rdfs:comment>
    <rdfs:comment xml:lang="en">A conformity assessment or technical documentation record under AI Act Annex IV / MDR Annex II.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#Risk_EHDSOptOut">
    <rdf:type rdf:resource="https://w3id.org/mailo#ComplianceRisk"/>
    <rdfs:label xml:lang="en">EHDS Art.35 Opt-Out Erodes Training Dataset</rdfs:label>
    <rdfs:comment xml:lang="en">Widespread exercise of opt-out rights under EHDS Art.35 may substantially reduce available health data for AI training, creating representativeness risk under AI Act Art.10.</rdfs:comment>
    <mailo:riskLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MEDIUM</mailo:riskLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#involvesTechnology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">involves technology</rdfs:label>
    <rdfs:comment>Case involves a technology class</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#Case"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#Technology"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#Risk_TradeSecretTransparencyConflict">
    <rdf:type rdf:resource="https://w3id.org/mailo#ComplianceRisk"/>
    <rdfs:label xml:lang="en">Trade Secret Shield vs. AI Act/GDPR Transparency Mandate (TSD Art.2 Conflict)</rdfs:label>
    <rdfs:comment xml:lang="en">Medical AI operators relying on TSD Art.2 to protect model weights face: (a) mandatory AI Act Art.13 disclosure to deployers; (b) GDPR Art.15(1)(h) actionable explanation obligations to data subjects; (c) mandatory supervisory authority adjudication when TSD is claimed (C-203/22). Hybrid strategy required: patent final outputs, trade secret the AI platform, use ZKP/ZKML for auditor verification without weight disclosure.</rdfs:comment>
    <mailo:mitigatedBy rdf:resource="https://w3id.org/mailo#ExplainabilityObligation"/>
    <mailo:riskLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HIGH</mailo:riskLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#TimelineEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>TimelineEvent</rdfs:label>
    <rdfs:comment>A regulatory obligation activation date or deadline</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#TransparencyObligation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>TransparencyObligation</rdfs:label>
    <rdfs:label xml:lang="en">Transparency Obligation</rdfs:label>
    <rdfs:comment>Obligation to be transparent about AI processing</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#ComplianceObligation"/>
    <owl:equivalentClass rdf:resource="http://w3id.org/dpv#TransparencyObligation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#DisclosureObligation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>DisclosureObligation</rdfs:label>
    <rdfs:label xml:lang="en">Disclosure Obligation</rdfs:label>
    <rdfs:comment>Obligation to disclose information to data subjects</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://w3id.org/dpv#ProvideInformation"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#ComplianceObligation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#AutomatedDecisionSystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>AutomatedDecisionSystem</rdfs:label>
    <rdfs:label xml:lang="en">Automated Decision System</rdfs:label>
    <rdfs:comment>System processing personal data without meaningful human review</rdfs:comment>
    <rdfs:comment xml:lang="en">A system that processes personal data to produce outputs affecting individuals without meaningful human review.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://w3id.org/dpv#DataProcessing"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#MedicalAISystem"/>
    <owl:equivalentClass rdf:resource="http://w3id.org/dpv#AutomatedDecisionMaking"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#citesPrecedent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">cites precedent</rdfs:label>
    <rdfs:comment>Case relies on earlier case as precedent</rdfs:comment>
    <rdfs:comment xml:lang="en">A case relies on an earlier case as precedent.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#Case"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#Case"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#OmnibusGDPR_Art22_Proposal_20251119">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegislativeAmendment"/>
    <rdfs:label>Digital Omnibus Regulation — GDPR Art.22 Reframing Proposal (NOT YET ADOPTED)</rdfs:label>
    <mailo:amendmentDescription>Commission proposal (2025-11-19) to replace GDPR Art.22(1)-(2) prohibition structure with an exhaustive positive permission list for solely automated decision-making. EDPB-EDPS Joint Opinion 2/2026 (2026-02-11) strongly opposes the reframing, citing CJEU confirmation of Art.22 as a prohibition in principle (C-634/21, C-817/19). Status: UNADOPTED — in trilogue negotiation as of 2026-05-10. MAILO SHACL shapes remain grounded in current prohibition structure. If adopted, NodeShapes C634_Art22ProhibitionShape and related shapes require reformulation to encode positive permission conditions rather than absence of exception.</mailo:amendmentDescription>
    <mailo:versionStartDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-19</mailo:versionStartDate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#interpretsArticle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Case interprets a specific article</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#Case"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#LegalArticle"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#ecliIdentifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>ECLI case identifier</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#Amend_AIAct_v3a_Omnibus_AnnexIII_Standalone">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegislativeAmendment"/>
    <rdfs:label>Activation event: high_risk_annex_iii_omnibus</rdfs:label>
    <mailo:amendmentDescription>Omnibus VII provisional agreement — Annex III standalone systems: 2027-12-02. Conditional on harmonised standards availability (Article 6(2) revised).</mailo:amendmentDescription>
    <mailo:versionStartDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2027-12-02</mailo:versionStartDate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#DataAct_Art23">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">Data Act Art.23 — Switching Cloud Services</rdfs:label>
    <rdfs:comment xml:lang="en">Medical AI providers using cloud infrastructure must enable switching between cloud providers without data lock-in. Relevant for hospital AI SaaS deployment models.</rdfs:comment>
  </rdf:Description>
