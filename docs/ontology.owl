  </owl:ObjectProperty>
  <mailo:ComplianceRisk rdf:about="https://w3id.org/mailo#Risk_TradeSecretTransparencyConflict">
    <rdfs:label xml:lang="en">Trade Secret Shield vs. AI Act/GDPR Transparency Mandate (TSD Art.2 Conflict)</rdfs:label>
    <rdfs:comment xml:lang="en">Medical AI operators relying on TSD Art.2 to protect model weights face: (a) mandatory AI Act Art.13 disclosure to deployers; (b) GDPR Art.15(1)(h) actionable explanation obligations to data subjects; (c) mandatory supervisory authority adjudication when TSD is claimed (C-203/22). Hybrid strategy required: patent final outputs, trade secret the AI platform, use ZKP/ZKML for auditor verification without weight disclosure.</rdfs:comment>
    <mailo:mitigatedBy rdf:resource="https://w3id.org/mailo#ExplainabilityObligation"/>
    <mailo:riskLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HIGH</mailo:riskLevel>
  </mailo:ComplianceRisk>
  <owl:DatatypeProperty rdf:about="https://w3id.org/mailo#relevanceScore">
    <rdfs:comment>Relevance score 1-5</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <mailo:LiteratureSource rdf:about="https://w3id.org/mailo#lit_Pandit_H_J_et_al_2024_Data_Privacy_Vocabulary_DPV">
    <rdfs:label>Pandit, H. J. et al. (2024). Data Privacy Vocabulary (DPV) – Version 2.0. Springer / W3C DPVCG.</rdfs:label>
    <dcterms:date>2024</dcterms:date>
    <dcterms:description>RDFS/SKOS + OWL2 alt; 911 concepts; serialised in TTL/JSON-LD/RDF-XML; namespace http://w3id.org/dpv#. Foundational vocabulary the thesis should reuse. Recommendation: import DPV namespace into MAILO; align mailo:hasObligation with dpv:hasLegalBasis.</dcterms:description>
    <dcterms:source rdf:resource="https://w3c.github.io/dpv/2.1/dpv/"/>
    <mailo:relevanceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</mailo:relevanceScore>
  </mailo:LiteratureSource>
  <owl:DatatypeProperty rdf:about="https://w3id.org/mailo#hasIndividualNonAutomatedReview">
    <rdfs:label xml:lang="en">has individual non-automated review</rdfs:label>
    <rdfs:comment>True = individual non-automated review before any measure (C-817/19 P_817_001)</rdfs:comment>
    <rdfs:comment xml:lang="en">True if every positive automated match is subject to individual non-automated human review before any measure is taken. C-817/19 P_817_001 constitutional minimum.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
