  <mailo:CJEUCase rdf:about="https://w3id.org/mailo#C_201_14">
    <rdfs:label xml:lang="en">C-201/14 Bara</rdfs:label>
    <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-10-01</dcterms:date>
    <dcterms:identifier>C-201/14</dcterms:identifier>
    <rdfs:comment xml:lang="en">Inclusion basis (TransposedPrinciple): Health data transferred between public bodies without information; earliest link in the retained chain.</rdfs:comment>
