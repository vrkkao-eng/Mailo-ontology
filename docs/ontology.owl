  <owl:Class rdf:about="https://w3id.org/mailo#ConflictType">
    <rdfs:label xml:lang="en">ConflictType</rdfs:label>
    <rdfs:comment xml:lang="en">Classification of the kind of friction a CrossFrameworkTension represents. Declared in v5.1.0: the five instances below were in use as values of mailo:conflictType but had never been typed.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/mailo#BlackBoxMLSystem">
    <rdfs:label>BlackBoxMLSystem</rdfs:label>
    <rdfs:label xml:lang="en">Black-Box ML System</rdfs:label>
    <rdfs:comment>Non-transparent self-learning ML system (C-817/19 prohibition)</rdfs:comment>
    <rdfs:comment xml:lang="en">A non-transparent, self-learning system whose decision logic cannot be explained. Prohibited under C-817/19 for decisions with significant impact.</rdfs:comment>
    <rdfs:comment xml:lang="en">Corrected in v5.1.0: previously declared a subclass of MedicalAISystem. Opacity is a property of a system's decision logic, not of its clinical application; the PNR system in C-817/19 was not medical.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://w3id.org/airo#OpaqueSystem"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
  </owl:Class>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#GDPR_Art9">
    <rdfs:label xml:lang="en">GDPR Article 9</rdfs:label>
    <rdfs:comment xml:lang="en">Processing of special categories of personal data, including health data.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://w3id.org/dpv#SpecialCategoryData"/>
  </mailo:LegalArticle>
