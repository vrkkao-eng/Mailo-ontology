  <mailo:LiteratureSource rdf:about="https://w3id.org/mailo#lit_Kang_M_Li_B_et_al_2025_R_-Guard_Robust_Reasoning_E">
    <rdfs:label>Kang, M., Li, B. et al. (2025). R²-Guard: Robust Reasoning Enabled LLM Guardrail via Knowledge-Enhanced Logical Reasoning. ICLR 2025.</rdfs:label>
    <dcterms:date>2025</dcterms:date>
    <dcterms:description>Markov logic networks + probabilistic circuits over a safety reasoning graph. +30.2% over Llama Guard on ToxicChat; +59.5% under jailbreak attacks. Direct precedent for logic-graph-as-runtime-safety-filter pattern that MAILO advances, but for general LLM safety, not medical regulation.</dcterms:description>
    <dcterms:source rdf:resource="https://arxiv.org/abs/2407.05557"/>
    <mailo:relevanceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</mailo:relevanceScore>
  </mailo:LiteratureSource>
  <mailo:UPCCase rdf:about="https://w3id.org/mailo#UPC_GXD_Myriad">
    <rdfs:label xml:lang="en">GXD-Bio v. Myriad Genetics — Genomic Diagnostic AI</rdfs:label>
    <dcterms:identifier>UPC_CFI_437/2024</dcterms:identifier>
    <rdfs:comment xml:lang="en">Inclusion basis (DirectSubjectMatter): Genomic diagnostic signature patent (EndoPredict).</rdfs:comment>
    <mailo:decidedBy>
      <mailo:UPCDivision rdf:about="https://w3id.org/mailo#UPC_LD_Munich">
        <rdfs:label xml:lang="en">UPC Local Division — Munich</rdfs:label>
      </mailo:UPCDivision>
    </mailo:decidedBy>
    <mailo:hasDefendant>
      <mailo:Company rdf:about="https://w3id.org/mailo#MyriadGenetics">
        <rdfs:label xml:lang="en">Myriad Genetics Inc.</rdfs:label>
      </mailo:Company>
    </mailo:hasDefendant>
    <mailo:hasInclusionBasis>
      <mailo:InclusionBasis rdf:about="https://w3id.org/mailo#DirectSubjectMatter">
        <rdfs:label xml:lang="en">Direct subject matter</rdfs:label>
        <rdfs:comment xml:lang="en">The case is itself about a medical AI or medical software system. Only such cases may carry a medical-AI value for mailo:involvesTechnology.</rdfs:comment>
      </mailo:InclusionBasis>
    </mailo:hasInclusionBasis>
    <mailo:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Munich Local Division, December 2025: EP 3 346 403 revoked for added matter and the infringement claims against Myriad's EndoPredict test dismissed. First UPC biotech NPE action.</mailo:hasOutcome>
    <mailo:hasPlaintiff>
      <mailo:NPE rdf:about="https://w3id.org/mailo#GXDBio">
        <rdfs:label xml:lang="en">GXD-Bio Corporation (NPE)</rdfs:label>
      </mailo:NPE>
    </mailo:hasPlaintiff>
    <mailo:hasStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Under appeal — GXD-Bio appealed in February 2026 (verified 2026-09-01)</mailo:hasStatus>
    <mailo:involvesPatent>
      <mailo:EuropeanPatent rdf:about="https://w3id.org/mailo#EP_3346403">
        <rdfs:label xml:lang="en">EP 3 346 403</rdfs:label>
        <rdfs:comment xml:lang="en">Breast cancer recurrence prediction genomic expression test.</rdfs:comment>
      </mailo:EuropeanPatent>
    </mailo:involvesPatent>
    <mailo:involvesTechnology rdf:resource="https://w3id.org/mailo#GenomicDiagnosticAI"/>
  </mailo:UPCCase>
