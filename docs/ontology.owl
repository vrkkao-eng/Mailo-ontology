  <owl:ObjectProperty rdf:about="https://w3id.org/mailo#hasPendingAmendment">
    <rdfs:label xml:lang="en">has pending amendment</rdfs:label>
    <rdfs:comment xml:lang="en">Links a LegalArticle whose numbering or content is currently in force to a proposed amendment that has not been adopted. Asserting this property makes no claim that the amendment will pass.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#PendingAmendment"/>
  </owl:ObjectProperty>
  <mailo:RegulationVersion rdf:about="https://w3id.org/mailo#AIAct_v3a_Omnibus_AnnexIII_Standalone">
    <rdfs:label>Omnibus-revised Annex III standalone high-risk deadline (biometrics, employment, education, law enforcement, critical infrastructure, border management)</rdfs:label>
    <mailo:applicablePhase>high_risk_annex_iii_omnibus</mailo:applicablePhase>
    <mailo:isCurrentVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</mailo:isCurrentVersion>
    <mailo:triggeredBy>
      <mailo:LegislativeAmendment rdf:about="https://w3id.org/mailo#Amend_AIAct_v3a_Omnibus_AnnexIII_Standalone">
        <rdfs:label>Activation event: high_risk_annex_iii_omnibus</rdfs:label>
        <mailo:amendmentDescription>Omnibus VII provisional agreement — Annex III standalone systems: 2027-12-02. Conditional on harmonised standards availability (Article 6(2) revised).</mailo:amendmentDescription>
        <mailo:versionStartDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2027-12-02</mailo:versionStartDate>
      </mailo:LegislativeAmendment>
    </mailo:triggeredBy>
    <mailo:triggeredBy>
      <mailo:LegislativeAmendment rdf:about="https://w3id.org/mailo#OmnibusAI_ProvisionalAgreement_20260507">
        <rdfs:label>Digital Omnibus on AI — Provisional Agreement (Council + EP, 2026-05-07)</rdfs:label>
        <mailo:amendmentDescription>Provisional political agreement on Digital Omnibus on AI (Omnibus VII package). Extends Annex III standalone high-risk deadline to 2027-12-02 and Annex I (SaMD/MDR) deadline to 2028-08-02 via conditional standards-availability mechanism. Introduces unified MDR+AI Act notified body assessment pathway. Not yet formally adopted as of 2026-05-10; formal adoption expected before 2026-08-02. Source: Consilium press release 2026-05-07.</mailo:amendmentDescription>
        <mailo:versionStartDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-07</mailo:versionStartDate>
      </mailo:LegislativeAmendment>
    </mailo:triggeredBy>
    <mailo:versionOf>
      <mailo:EURegulation rdf:about="https://w3id.org/mailo#AIAct_2024_1689">
        <rdfs:label>AI Act 2024/1689</rdfs:label>
        <mailo:celex>32024R1689</mailo:celex>
        <mailo:hasVersion rdf:resource="https://w3id.org/mailo#AIAct_v1_ProhibitedPractices"/>
        <mailo:hasVersion rdf:resource="https://w3id.org/mailo#AIAct_v2_GPAIModelObligations"/>
        <mailo:hasVersion rdf:resource="https://w3id.org/mailo#AIAct_v3_OriginalHighRisk"/>
        <mailo:hasVersion rdf:resource="https://w3id.org/mailo#AIAct_v3a_Omnibus_AnnexIII_Standalone"/>
        <mailo:hasVersion rdf:resource="https://w3id.org/mailo#AIAct_v3b_Omnibus_AnnexI_SaMD"/>
        <mailo:hasVersion rdf:resource="https://w3id.org/mailo#AIAct_v4_FRIA_PublicBodies"/>
      </mailo:EURegulation>
    </mailo:versionOf>
    <mailo:versionStartDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2027-12-02</mailo:versionStartDate>
  </mailo:RegulationVersion>
  <owl:Class rdf:about="https://w3id.org/mailo#HumanOversightObligation">
    <rdfs:label>HumanOversightObligation</rdfs:label>
