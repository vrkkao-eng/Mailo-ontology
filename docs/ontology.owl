  <rdf:Description rdf:about="https://w3id.org/mailo#Tension_PLD_AIAct_LiabilityGap">
    <rdf:type rdf:resource="https://w3id.org/mailo#CrossFrameworkTension"/>
    <rdfs:label xml:lang="en">PLD Art.10 defect presumption vs. AI Act Art.9 risk management</rdfs:label>
    <rdfs:comment xml:lang="en">PLD Art.11 defect presumption applies where it is excessively difficult for the claimant to prove defect. AI Act Art.9-compliant risk management documentation may rebut the presumption but no legislative safe harbour confirms this.</rdfs:comment>
    <mailo:conflictType rdf:resource="https://w3id.org/mailo#LiabilityConflict"/>
    <mailo:hasResolutionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">partial</mailo:hasResolutionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#hasPurposeLimitation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">has purpose limitation</rdfs:label>
    <rdfs:comment>Tri-level proportionality (b): purpose limitation</rdfs:comment>
    <rdfs:comment xml:lang="en">Tri-level proportionality test (b): documented purpose limitation. C-817/19 P_817_003.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#HumanOversightObligation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>HumanOversightObligation</rdfs:label>
    <rdfs:label xml:lang="en">Human Oversight Obligation</rdfs:label>
    <rdfs:comment>Obligation to ensure substantive human review</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://w3id.org/airo#HumanOversight"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#ComplianceObligation"/>
    <owl:equivalentClass rdf:resource="http://w3id.org/dpv#HumanInvolvement"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#UPC_10x_NanoString">
    <rdf:type rdf:resource="https://w3id.org/mailo#UPCCase"/>
    <rdfs:label xml:lang="en">10x Genomics v. NanoString — Spatial Biology AI</rdfs:label>
    <mailo:decidedBy rdf:resource="https://w3id.org/mailo#UPC_CoA"/>
    <mailo:decidedBy rdf:resource="https://w3id.org/mailo#UPC_LD_Munich"/>
    <mailo:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Munich LD granted PI; CoA first substantive ruling reversed PI on invalidity grounds ('more likely than not' standard). Case settled 2025.</mailo:hasOutcome>
    <mailo:hasStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Settled 2025</mailo:hasStatus>
    <mailo:involvesTechnology rdf:resource="https://w3id.org/mailo#GenomicDiagnosticAI"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#DataSubjectRight">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>DataSubjectRight</rdfs:label>
    <rdfs:label xml:lang="en">Data Subject Right</rdfs:label>
    <rdfs:comment>A right of an individual under GDPR</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://w3id.org/dpv#DataSubjectRight"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#Right"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#P_Bara_001">
    <rdf:type rdf:resource="https://w3id.org/mailo#RatioDecidendi"/>
    <rdfs:label xml:lang="en">Transparency Rights Foundation</rdfs:label>
    <rdfs:comment xml:lang="en">Data subjects must be informed of data transfers; establishes foundational transparency obligation.</rdfs:comment>
    <mailo:hasPrecedenceLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">binding_ratio</mailo:hasPrecedenceLevel>
  </rdf:Description>
