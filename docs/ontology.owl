  <rdf:Description rdf:about="https://w3id.org/mailo#CJEU_GrandChamber">
    <rdf:type rdf:resource="https://w3id.org/mailo#Court"/>
    <rdfs:label xml:lang="en">CJEU Grand Chamber</rdfs:label>
    <rdfs:comment xml:lang="en">Highest formation of CJEU; judgments carry maximum precedential weight.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#P_634_001">
    <rdf:type rdf:resource="https://w3id.org/mailo#RatioDecidendi"/>
    <rdfs:label xml:lang="en">P-634/21-001: Broad 'Decision' Concept</rdfs:label>
    <rdfs:comment xml:lang="en">A 'decision' under Art.22 encompasses any act producing legal or similarly significant effects. Automated scoring creating probabilities relied upon by third parties constitutes a 'decision'.</rdfs:comment>
    <mailo:appliesTo rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
    <mailo:appliesTo rdf:resource="https://w3id.org/mailo#ClinicalDecisionSupport"/>
    <mailo:appliesTo rdf:resource="https://w3id.org/mailo#RiskScoringSystem"/>
    <mailo:hasPrecedenceLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">binding_ratio</mailo:hasPrecedenceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#DPIAObligation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>DPIAObligation</rdfs:label>
    <rdfs:label xml:lang="en">DPIA Obligation</rdfs:label>
    <rdfs:comment>Obligation to carry out a DPIA under GDPR Art.35</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#ComplianceObligation"/>
    <owl:equivalentClass rdf:resource="http://w3id.org/dpv#DPIA"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#lit_Rebedea_T_et_al_2023_NeMo_Guardrails_A_Toolkit_for_Co">
    <rdf:type rdf:resource="https://w3id.org/mailo#LiteratureSource"/>
    <rdfs:label>Rebedea, T. et al. (2023). NeMo Guardrails: A Toolkit for Controllable and Safe LLM Applications with Programmable Rails. EMNLP Demo. arXiv:2310.10501.</rdfs:label>
    <dcterms:date>2023</dcterms:date>
    <dcterms:description>Colang DSL + dialogue-state engine; rules user-defined and interpretable. 2025 update: NIM micro-services with ~0.5s added latency for ~50% protection lift. Establishes programmable-rail paradigm; uses ad-hoc DSL not formal ontology.</dcterms:description>
    <dcterms:source rdf:resource="https://arxiv.org/abs/2310.10501"/>
    <mailo:relevanceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</mailo:relevanceScore>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#Right_MedicalRecordAccess">
    <rdf:type rdf:resource="https://w3id.org/mailo#PatientRight"/>
    <rdfs:label xml:lang="en">Right to Access Medical Records (C-307/22)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#GDPR_Art22_2">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">GDPR Art.22(2)</rdfs:label>
    <rdfs:comment xml:lang="en">Exceptions: contract necessity, explicit consent, EU/Member State law.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#EPC_Art83">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">EPC Article 83</rdfs:label>
    <rdfs:comment xml:lang="en">Disclosure of the invention — sufficiency of disclosure.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#Risk_NPE_Revocation">
    <rdf:type rdf:resource="https://w3id.org/mailo#ComplianceRisk"/>
    <rdfs:label xml:lang="en">NPE-Initiated Revocation Attack</rdfs:label>
    <mailo:riskLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MEDIUM</mailo:riskLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#DataSubject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>DataSubject</rdfs:label>
