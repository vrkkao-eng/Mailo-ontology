  <mailo:CrossFrameworkTension rdf:about="https://w3id.org/mailo#Tension_DataAct_TradeSecret_AITransparency">
    <rdfs:label xml:lang="en">Data Act Art.15 trade secret vs. AI Act Art.13 + GDPR Art.15(1)(h) transparency</rdfs:label>
    <rdfs:comment xml:lang="en">C-203/22 Dun &amp; Bradstreet §§60-70 limits trade-secret defence: a controller cannot refuse all causal explanation on trade-secret grounds. The precise boundary between permitted limitation and impermissible derogation is determined case-by-case.</rdfs:comment>
    <mailo:conflictType rdf:resource="https://w3id.org/mailo#TradeSecretConflict"/>
    <mailo:hasResolutionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">partial</mailo:hasResolutionStatus>
  </mailo:CrossFrameworkTension>
