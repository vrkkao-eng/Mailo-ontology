    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/mailo#conflictType">
    <rdfs:label xml:lang="en">conflict type</rdfs:label>
