  <rdf:Description rdf:about="https://w3id.org/mailo#">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-30</dcterms:created>
    <dcterms:description>OWL ontology mapping EU regulatory frameworks (GDPR, AI Act, MDR, PLD, EHDS, DGA, Data Act) to medical AI automated decision-making, CJEU case law, UPC patent litigation, and compliance obligations.</dcterms:description>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-12</dcterms:modified>
    <dcterms:title>Medical AI Legal Ontology (MAILO)</dcterms:title>
    <owl:versionIRI rdf:resource="https://w3id.org/mailo/5.0.2"/>
    <owl:versionInfo>5.0.2</owl:versionInfo>
    <owl:priorVersion rdf:resource="https://w3id.org/mailo/5.0.1"/>
    <rdfs:comment xml:lang="en">Version 5.0.2 (patch): corrected the ECLI recorded for C-203/22 (Dun &amp; Bradstreet Austria) from the erroneous ECLI:EU:C:2025:145 to the correct ECLI:EU:C:2025:117.</rdfs:comment>
    <dcterms:creator>Victor Kao</dcterms:creator>
    <dcterms:publisher>KU Leuven, Faculty of Engineering Science</dcterms:publisher>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#lit_Esteves_B_Rodr_guez-Doncel_V_et_al_2024_Analysis_of">
    <rdf:type rdf:resource="https://w3id.org/mailo#LiteratureSource"/>
    <rdfs:label>Esteves, B., Rodríguez-Doncel, V. et al. (2024). Analysis of ontologies and policy languages to represent information flows in GDPR. Semantic Web Journal.</rdfs:label>
    <dcterms:date>2024</dcterms:date>
    <dcterms:description>Comparative table of ontology and policy languages. Positions DPV + ODRL + LegalRuleML as Pareto-front. ODRL+LegalRuleML+DPV+GDPRtEXT can model 39 of 57 informational items.</dcterms:description>
    <dcterms:source rdf:resource="https://journals.sagepub.com/doi/10.3233/SW-223009"/>
    <mailo:relevanceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</mailo:relevanceScore>
  </rdf:Description>
