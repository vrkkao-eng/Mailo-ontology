  <rdf:Description rdf:about="https://w3id.org/mailo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:abstract xml:lang="en">MAILO (Medical AI Legal Ontology) is a machine-executable knowledge graph encoding EU regulatory obligations for medical artificial intelligence systems. It formalises eight EU legislative instruments -- the GDPR, MDR, AI Act, Product Liability Directive, EHDS, Data Governance Act, Data Act, and Trade Secrets Directive -- as OWL 2 classes and SHACL shape constraints, grounded in three CJEU judgments on automated decision-making (Ligue des droits humains, SCHUFA Holding, and Dun &amp; Bradstreet Austria). MAILO functions as a deterministic, auditable compliance-verification layer: SHACL NodeShapes validate instance data describing a medical AI system against the encoded legal constraints and produce structured, traceable conformance reports.</dcterms:abstract>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-27</dcterms:created>
    <dcterms:description xml:lang="en">&#13;
        Ontology capturing the legal landscape governing AI-driven automated&#13;
        decision-making in medical contexts. Covers CJEU precedents on GDPR&#13;
        Art.22, UPC/EPO patent litigation in MedTech, the EU AI Act high-risk&#13;
        regime, MDR 2017/745, PLD 2024/2853, EHDS 2025/327, DGA 2022/868,&#13;
        and Data Act 2023/2854 — with full precedent chains, SHACL runtime&#13;
        constraints, and compliance obligation mappings.&#13;
        Imports: W3C DPV v2.0 (data privacy vocabulary), AIRO (AI risk ontology),&#13;
        ELI (European Legislation Identifier), ECLI (European Case Law Identifier).&#13;
    </dcterms:description>
    <dcterms:language>en</dcterms:language>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-12</dcterms:modified>
    <dcterms:title xml:lang="en">Medical AI Legal Ontology (MAILO)</dcterms:title>
    <owl:imports rdf:resource="http://data.europa.eu/eli/ontology"/>
    <owl:imports rdf:resource="http://w3id.org/dpv"/>
    <owl:imports rdf:resource="https://w3id.org/airo"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#CrossFrameworkTension">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>CrossFrameworkTension</rdfs:label>
    <rdfs:comment>A conflict or gap between two regulatory frameworks</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#TSD">
    <rdf:type rdf:resource="https://w3id.org/mailo#EUDirective"/>
    <rdf:type rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
    <rdfs:label xml:lang="en">Trade Secrets Directive 2016/943</rdfs:label>
    <eli:id_local>32016L0943</eli:id_local>
    <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2016-06-08</dcterms:date>
    <dcterms:identifier>2016/943/EU</dcterms:identifier>
    <rdfs:comment xml:lang="en">EU Trade Secrets Directive. Harmonises civil-law protection of undisclosed know-how and business information. Key for medical AI: model weights, training data schemas, and proprietary algorithms qualify as trade secrets under the Art.2 three-part test. Art.5 carve-outs limit the secrecy shield when exercise of the right to information is at stake — directly engaged by GDPR Art.15(1)(h) and AI Act Art.13 transparency obligations.</rdfs:comment>
    <mailo:coversArticle rdf:resource="https://w3id.org/mailo#TSD_Art2"/>
    <mailo:coversArticle rdf:resource="https://w3id.org/mailo#TSD_Art5"/>
    <mailo:coversArticle rdf:resource="https://w3id.org/mailo#TSD_Art9"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#LegalPrinciple">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>LegalPrinciple</rdfs:label>
    <rdfs:label xml:lang="en">Legal Principle</rdfs:label>
    <rdfs:comment>A binding or persuasive rule extracted from case law</rdfs:comment>
    <rdfs:comment xml:lang="en">A binding or persuasive rule extracted from case law or legislation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#UPC_Microsoft_Suinno">
    <rdf:type rdf:resource="https://w3id.org/mailo#UPCCase"/>
    <rdfs:label xml:lang="en">Microsoft v. Suinno — AI Method Patent</rdfs:label>
    <dcterms:identifier>UPC_CFI_433/2024</dcterms:identifier>
    <mailo:citesPrecedent rdf:resource="https://w3id.org/mailo#EPO_T0161_18"/>
    <mailo:decidedBy rdf:resource="https://w3id.org/mailo#UPC_CD_Paris"/>
    <mailo:hasDefendant rdf:resource="https://w3id.org/mailo#Microsoft"/>
    <mailo:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EP'173 fully revoked for added matter (2026-01-07). Appeal dismissed for lack of independent representation.</mailo:hasOutcome>
    <mailo:hasStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Final — revoked</mailo:hasStatus>
    <mailo:involvesPatent rdf:resource="https://w3id.org/mailo#EP_2671173"/>
    <mailo:involvesTechnology rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#C_203_22">
    <rdf:type rdf:resource="https://w3id.org/mailo#CJEUCase"/>
    <rdfs:label xml:lang="en">C-203/22 Dun &amp; Bradstreet Austria</rdfs:label>
    <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-02-27</dcterms:date>
    <dcterms:identifier>C-203/22</dcterms:identifier>
    <dcterms:identifier>ECLI:EU:C:2025:117</dcterms:identifier>
    <skos:notation>ECLI:EU:C:2025:117</skos:notation>
    <mailo:citesPrecedent rdf:resource="https://w3id.org/mailo#C_634_21"/>
    <mailo:decidedBy rdf:resource="https://w3id.org/mailo#CJEU_FirstChamber"/>
    <mailo:establishesPrinciple rdf:resource="https://w3id.org/mailo#P_203_001"/>
    <mailo:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Actionable explanations required (not algorithm formulas); explanation must enable effective exercise of Art.22(3) remedies.</mailo:hasOutcome>
    <mailo:hasStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Final — binding precedent</mailo:hasStatus>
    <mailo:interpretesArticle rdf:resource="https://w3id.org/mailo#GDPR_Art15_1h"/>
    <mailo:interpretesArticle rdf:resource="https://w3id.org/mailo#GDPR_Art22"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#PLD_Art9">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">PLD Art.9 — Disclosure Obligations (Evidence Facilitation)</rdfs:label>
    <rdfs:comment xml:lang="en">Courts may order defendants to disclose evidence about high-risk AI systems; creates procedural discovery mechanism absent in AILD.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#Risk_PLDStrictLiability">
    <rdf:type rdf:resource="https://w3id.org/mailo#ComplianceRisk"/>
    <rdfs:label xml:lang="en">PLD 2024 Strict Liability for AI-SaMD</rdfs:label>
    <rdfs:comment xml:lang="en">Medical AI systems qualifying as 'defective products' under PLD Art.4 expose manufacturers to strict liability without fault. Presumptions in Art.10 and Art.11 shift burden to defendants.</rdfs:comment>
    <mailo:mitigatedBy rdf:resource="https://w3id.org/mailo#HumanOversightObligation"/>
    <mailo:mitigatedBy rdf:resource="https://w3id.org/mailo#TransparencyObligation"/>
    <mailo:riskLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HIGH</mailo:riskLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#GDPR_Art22_4">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">GDPR Art.22(4)</rdfs:label>
    <rdfs:comment xml:lang="en">Enhanced protection for special category data (including health data) in automated decisions.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#AIAct_v3_OriginalHighRisk">
    <rdf:type rdf:resource="https://w3id.org/mailo#RegulationVersion"/>
    <rdfs:label>Original Annex III + Annex I deadline (superseded by Omnibus provisional agreement)</rdfs:label>
    <mailo:applicablePhase>high_risk_original_deadline</mailo:applicablePhase>
    <mailo:isCurrentVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</mailo:isCurrentVersion>
    <mailo:triggeredBy rdf:resource="https://w3id.org/mailo#Amend_AIAct_v3_OriginalHighRisk"/>
    <mailo:versionOf rdf:resource="https://w3id.org/mailo#AIAct_2024_1689"/>
    <mailo:versionStartDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-02</mailo:versionStartDate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#EHDS_Art33">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">EHDS Art.33 — Secondary Use Authorisation</rdfs:label>
    <rdfs:comment xml:lang="en">Health data access bodies must authorise secondary use of health data for AI training, research, and policy. Access by data permit only; no direct de-identified access.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#AIAct_v4_FRIA_PublicBodies">
    <rdf:type rdf:resource="https://w3id.org/mailo#RegulationVersion"/>
    <rdfs:label>FRIA obligation for public-body deployers applies (Art.27)</rdfs:label>
    <mailo:applicablePhase>fria_public_bodies</mailo:applicablePhase>
    <mailo:isCurrentVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</mailo:isCurrentVersion>
    <mailo:triggeredBy rdf:resource="https://w3id.org/mailo#Amend_AIAct_v4_FRIA_PublicBodies"/>
    <mailo:versionOf rdf:resource="https://w3id.org/mailo#AIAct_2024_1689"/>
    <mailo:versionStartDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2027-08-02</mailo:versionStartDate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#hasDPIA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has DPIA</rdfs:label>
    <rdfs:comment>Links system to its DPIA record</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a medical AI system to its DPIA record. Required for all high-risk automated processing (GDPR Art.35; C-817/19 P_817_005).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#MedicalAISystem"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#DPIARecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#hasIndividualNonAutomatedReview">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">has individual non-automated review</rdfs:label>
    <rdfs:comment>True = individual non-automated review before any measure (C-817/19 P_817_001)</rdfs:comment>
    <rdfs:comment xml:lang="en">True if every positive automated match is subject to individual non-automated human review before any measure is taken. C-817/19 P_817_001 constitutional minimum.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#lit_Robaldo_L_Bartolini_C_Palmirani_M_et_al_2020_Fo">
    <rdf:type rdf:resource="https://w3id.org/mailo#LiteratureSource"/>
    <rdfs:label>Robaldo, L., Bartolini, C., Palmirani, M., et al. (2020). Formalizing GDPR Provisions in Reified I/O Logic: The DAPRECO Knowledge Base. Journal of Logic, Language and Information.</rdfs:label>
    <dcterms:date>2020</dcterms:date>
    <dcterms:description>LegalRuleML + reified Input/Output logic + SPINDle defeasible reasoner. The canonical precedent for formal GDPR reasoning. Limitations addressed by MAILO: GDPR-only; no medical AI integration; no CJEU case-law layer; no runtime guardrail integration.</dcterms:description>
    <dcterms:source rdf:resource="https://link.springer.com/article/10.1007/s10849-019-09309-z"/>
    <mailo:relevanceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</mailo:relevanceScore>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#MedicalImagingAI">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>MedicalImagingAI</rdfs:label>
    <rdfs:label xml:lang="en">Medical Imaging AI</rdfs:label>
    <rdfs:comment>AI system for medical image analysis</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#MedicalAISystem"/>
    <mailo:hasRisk rdf:resource="https://w3id.org/mailo#Risk_DataActIoT"/>
    <mailo:hasRisk rdf:resource="https://w3id.org/mailo#Risk_EPOUPC_Divergence"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#P_817_001">
    <rdf:type rdf:resource="https://w3id.org/mailo#RatioDecidendi"/>
    <rdfs:label xml:lang="en">P-817/19-001: Mandatory Non-Automated Individual Review</rdfs:label>
    <rdfs:comment xml:lang="en">Any positive match from automated PNR analysis must be subject to individual non-automated review before any measure is taken. Establishes constitutional minimum for meaningful human intervention.</rdfs:comment>
    <mailo:appliesTo rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
    <mailo:appliesTo rdf:resource="https://w3id.org/mailo#MedicalAISystem"/>
    <mailo:hasPrecedenceLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constitutional_grand_chamber</mailo:hasPrecedenceLevel>
    <mailo:triggersObligation rdf:resource="https://w3id.org/mailo#HumanOversightObligation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#RegulationVersion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>RegulationVersion</rdfs:label>
    <rdfs:comment>A versioned expression of an EU regulation at a specific applicability phase</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#EURegulation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#Tension_MDR_AIAct_DualTrack">
    <rdf:type rdf:resource="https://w3id.org/mailo#CrossFrameworkTension"/>
    <rdfs:label xml:lang="en">MDR Annex IX conformity vs. AI Act Art.43 conformity assessment</rdfs:label>
    <rdfs:comment xml:lang="en">Two separate conformity assessment pathways for the same SaMD. MDCG AIB 2025-1 provides a procedural joint-assessment mechanism but does not harmonise the substantive requirement sets.</rdfs:comment>
    <mailo:conflictType rdf:resource="https://w3id.org/mailo#ConformityGapConflict"/>
    <mailo:hasResolutionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">procedural_only</mailo:hasResolutionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#hasPredeterminedCriteria">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">has predetermined criteria</rdfs:label>
    <rdfs:comment>True = pre-determined explainable criteria; false = self-learning black-box</rdfs:comment>
    <rdfs:comment xml:lang="en">True if the system's assessment criteria are pre-determined and not modified by self-learning without human review. Required to avoid black-box prohibition (C-817/19 P_817_002).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#lit_Conflict-tolerant_Deontic_Traditional_Scheme_for_the_Semanti">
    <rdf:type rdf:resource="https://w3id.org/mailo#LiteratureSource"/>
    <rdfs:label>Conflict-tolerant Deontic Traditional Scheme for the Semantic Web. (2025). Journal of Logic and Computation 35(8), Oxford.</rdfs:label>
    <dcterms:date>2025</dcterms:date>
    <dcterms:description>Addresses cross-framework normative conflict resolution that MAILO will face (e.g. GDPR Art.22 vs AI Act Art.86). Provides RDF-based conflict-tolerant deontic logic.</dcterms:description>
    <dcterms:source rdf:resource="https://academic.oup.com/logcom/article/35/8/exaf054/8320660"/>
    <mailo:relevanceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</mailo:relevanceScore>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#versionOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Version belongs to a parent regulation</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#RegulationVersion"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#EURegulation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#AIAct_Art26">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">AI Act Art.26 — Deployer Obligations</rdfs:label>
    <rdfs:comment xml:lang="en">Deployers (e.g., hospitals using third-party AI) must ensure human oversight, monitor performance, inform affected persons, maintain logs. Creates shared responsibility with providers.</rdfs:comment>
    <mailo:complementedBy rdf:resource="https://w3id.org/mailo#AIAct_Art14"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#PatentClassification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>PatentClassification</rdfs:label>
    <rdfs:comment>An IPC/CPC patent classification code</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#Court">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Court</rdfs:label>
    <rdfs:label xml:lang="en">Court</rdfs:label>
    <rdfs:comment>A judicial body</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#LegalEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#lit_Communications_Medicine_Nature_2025_Neuro-symbolic_AI">
    <rdf:type rdf:resource="https://w3id.org/mailo#LiteratureSource"/>
    <rdfs:label>Communications Medicine (Nature). (2025). Neuro-symbolic AI for auditable cognitive information extraction from medical reports.</rdfs:label>
    <dcterms:date>2025</dcterms:date>
    <dcterms:description>LLM extracts candidate facts → symbolic verifier checks against medical rules → traceable, deterministic labels. Empirical demonstration of the harness pattern MAILO advocates, applied to clinical text.</dcterms:description>
    <dcterms:source rdf:resource="https://www.nature.com/articles/s43856-025-01194-x"/>
    <mailo:relevanceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</mailo:relevanceScore>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#GenomicDiagnosticAI">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>GenomicDiagnosticAI</rdfs:label>
    <rdfs:label xml:lang="en">Genomic Diagnostic AI</rdfs:label>
    <rdfs:comment>AI system for genomic/genetic diagnostics</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#MedicalAISystem"/>
    <mailo:hasRisk rdf:resource="https://w3id.org/mailo#Risk_EHDSOptOut"/>
    <mailo:hasRisk rdf:resource="https://w3id.org/mailo#Risk_NPE_Revocation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#MedicalAISystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>MedicalAISystem</rdfs:label>
    <rdfs:label xml:lang="en">Medical AI System</rdfs:label>
    <rdfs:comment>An AI-based system used in clinical contexts</rdfs:comment>
    <rdfs:comment xml:lang="en">An AI-based system used in clinical diagnosis, treatment recommendation, or patient risk stratification.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://w3id.org/airo#AISystem"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#Technology"/>
    <mailo:hasRisk rdf:resource="https://w3id.org/mailo#Risk_BlackBox"/>
    <mailo:hasRisk rdf:resource="https://w3id.org/mailo#Risk_HealthDataDoubleLayer"/>
    <mailo:hasRisk rdf:resource="https://w3id.org/mailo#Risk_InsufficientDisclosure"/>
    <mailo:hasRisk rdf:resource="https://w3id.org/mailo#Risk_PLDStrictLiability"/>
    <mailo:hasRisk rdf:resource="https://w3id.org/mailo#Risk_SolelyTest"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#Tension_TSD_AIAct_Transparency">
    <rdf:type rdf:resource="https://w3id.org/mailo#CrossFrameworkTension"/>
    <rdfs:label xml:lang="en">TSD Art.2 Trade Secret vs. AI Act Art.13 + GDPR Art.15(1)(h) — Core Transparency Tension</rdfs:label>
    <rdfs:comment xml:lang="en">TSD Art.2 protects model weights, training data schemas, and architecture as trade secrets. AI Act Art.13 requires deployers to receive sufficient information about high-risk AI system capabilities and limitations. C-203/22 §§60-70 sets the mandatory floor: controller cannot invoke TSD Art.2 to deny all causal explanation of an automated decision — disputed information must be produced to the competent supervisory authority or court for balance. AI Act Art.78 ensures national authority confidentiality but does not disapply Art.13 disclosure to deployers. TSD Art.5 is the only legislative bridge but its scope in the medical AI context remains unresolved pending a CJEU reference on Art.22 and clinical AI.</rdfs:comment>
    <mailo:conflictType rdf:resource="https://w3id.org/mailo#TradeSecretConflict"/>
    <mailo:conflictsWith rdf:resource="https://w3id.org/mailo#ExplainabilityObligation"/>
    <mailo:conflictsWith rdf:resource="https://w3id.org/mailo#TransparencyObligation"/>
    <mailo:hasResolutionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">partial</mailo:hasResolutionStatus>
    <mailo:involvesFramework rdf:resource="https://w3id.org/mailo#AIAct"/>
    <mailo:involvesFramework rdf:resource="https://w3id.org/mailo#GDPR"/>
    <mailo:involvesFramework rdf:resource="https://w3id.org/mailo#TSD"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#applicationDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Date from which the act applies</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#SiemensHealthineers">
    <rdf:type rdf:resource="https://w3id.org/mailo#Company"/>
    <rdfs:label xml:lang="en">Siemens Healthineers AG</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#C_634_21">
    <rdf:type rdf:resource="https://w3id.org/mailo#CJEUCase"/>
    <rdfs:label xml:lang="en">C-634/21 SCHUFA Holding (Scoring)</rdfs:label>
    <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-12-07</dcterms:date>
    <dcterms:identifier>C-634/21</dcterms:identifier>
    <dcterms:identifier>ECLI:EU:C:2023:957</dcterms:identifier>
    <skos:notation>ECLI:EU:C:2023:957</skos:notation>
    <mailo:citesPrecedent rdf:resource="https://w3id.org/mailo#C_817_19"/>
    <mailo:decidedBy rdf:resource="https://w3id.org/mailo#CJEU_FirstChamber"/>
    <mailo:establishesPrinciple rdf:resource="https://w3id.org/mailo#P_634_001"/>
    <mailo:establishesPrinciple rdf:resource="https://w3id.org/mailo#P_634_002"/>
    <mailo:establishesPrinciple rdf:resource="https://w3id.org/mailo#P_634_003"/>
    <mailo:establishesPrinciple rdf:resource="https://w3id.org/mailo#P_634_004"/>
    <mailo:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GDPR Art.22(1) constitutes a prohibition; automated scoring by credit agency = 'decision' triggering Art.22; 'solely' test is functional not formal.</mailo:hasOutcome>
    <mailo:hasStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Final — binding precedent</mailo:hasStatus>
    <mailo:interpretesArticle rdf:resource="https://w3id.org/mailo#GDPR_Art15_1h"/>
    <mailo:interpretesArticle rdf:resource="https://w3id.org/mailo#GDPR_Art22"/>
    <mailo:interpretesArticle rdf:resource="https://w3id.org/mailo#GDPR_Art22_1"/>
    <mailo:interpretesArticle rdf:resource="https://w3id.org/mailo#GDPR_Art22_2"/>
    <mailo:involvesTechnology rdf:resource="https://w3id.org/mailo#RiskScoringSystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#C_511_18">
    <rdf:type rdf:resource="https://w3id.org/mailo#CJEUCase"/>
    <rdfs:label xml:lang="en">C-511/18 La Quadrature du Net</rdfs:label>
