  <rdf:Description rdf:about="https://w3id.org/mailo#lit_npj_Health_Systems_2026_Data-driven_medical_devices_and">
    <rdf:type rdf:resource="https://w3id.org/mailo#LiteratureSource"/>
    <rdfs:label>npj Health Systems. (2026). Data-driven medical devices and the EU MDR: mapping gaps in standards for regulatory compliance.</rdfs:label>
    <dcterms:date>2026</dcterms:date>
    <dcterms:description>ISO/IEC 27001/27010 + ISO/IEC 5338, 25059, BS 30440 are insufficient for AI medical safety/transparency — exactly the gap MAILO addresses.</dcterms:description>
    <dcterms:source rdf:resource="https://www.nature.com/articles/s44401-026-00075-2"/>
    <mailo:relevanceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</mailo:relevanceScore>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#CJEUCase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>CJEUCase</rdfs:label>
    <rdfs:label xml:lang="en">CJEU Case</rdfs:label>
    <rdfs:comment>Judgment of the Court of Justice of the EU</rdfs:comment>
    <rdfs:comment xml:lang="en">Preliminary ruling or direct action before the Court of Justice of the EU.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#Case"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#ClinicalDecisionSupport">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>ClinicalDecisionSupport</rdfs:label>
    <rdfs:label xml:lang="en">Clinical Decision Support System</rdfs:label>
    <rdfs:comment>Clinical decision support system (CDSS)</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#MedicalAISystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#Risk_EPOUPC_Divergence">
    <rdf:type rdf:resource="https://w3id.org/mailo#ComplianceRisk"/>
    <rdfs:label xml:lang="en">EPO-UPC Divergent Validity Rulings (Opt-Out Strategy)</rdfs:label>
    <mailo:riskLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HIGH</mailo:riskLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#EP_3346403">
    <rdf:type rdf:resource="https://w3id.org/mailo#EuropeanPatent"/>
    <rdfs:label xml:lang="en">EP 3 346 403</rdfs:label>
    <rdfs:comment xml:lang="en">Breast cancer recurrence prediction genomic expression test.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#UPC_Sanofi_Amgen">
    <rdf:type rdf:resource="https://w3id.org/mailo#UPCCase"/>
    <rdfs:label xml:lang="en">Sanofi &amp; Regeneron v. Amgen — PCSK9 Medical Use</rdfs:label>
    <dcterms:identifier>UPC_CFI_505/2024</dcterms:identifier>
    <mailo:decidedBy rdf:resource="https://w3id.org/mailo#UPC_LD_Dusseldorf"/>
    <mailo:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Düsseldorf LD: patent valid, no infringement (dual-element test established). CoA: EP'797 restored after Munich CD revocation. EPO-UPC divergence on inventive step.</mailo:hasOutcome>
    <mailo:hasStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Active — EPO BoA hearing scheduled 2026-04</mailo:hasStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#Tension_EPO_MDR_SemanticScope">
    <rdf:type rdf:resource="https://w3id.org/mailo#CrossFrameworkTension"/>
    <rdfs:label xml:lang="en">EPO G-II §3.3 broad claim scope vs. MDR Annex II §1.1 + AI Act Art.9/13 intended purpose</rdfs:label>
    <rdfs:comment xml:lang="en">EPO patent prosecution optimises for broad technical-effect claims (wider scope = stronger IP protection); MDR Annex II requires precise intended-purpose specification (narrower scope = easier clinical evaluation); AI Act Art.9/13 requires intermediate characterisation covering intended purpose plus reasonably foreseeable misuse. The same SaMD must be described at opposing granularity levels across three institutional knowledge spaces. No EPO, MDCG, or AI Office guidance addresses this triangular scope alignment problem.</rdfs:comment>
    <mailo:conflictType rdf:resource="https://w3id.org/mailo#SemanticGranularityConflict"/>
    <mailo:hasResolutionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">unresolved</mailo:hasResolutionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#GDPR_2016_679">
    <rdf:type rdf:resource="https://w3id.org/mailo#EURegulation"/>
    <rdfs:label>GDPR 2016/679</rdfs:label>
    <mailo:celex>32016R0679</mailo:celex>
    <mailo:hasVersion rdf:resource="https://w3id.org/mailo#GDPR_v1_FullyApplicable"/>
    <mailo:hasVersion rdf:resource="https://w3id.org/mailo#GDPR_v2_OmnibusProposed_Art22"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#AIAct_Art17">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">AI Act Art.17 — Quality Management System</rdfs:label>
    <rdfs:comment xml:lang="en">High-risk AI providers must implement a QMS covering design, development, post-market monitoring. Aligned with MDR Annex IX QMS requirements to avoid double burden.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#P_634_003">
    <rdf:type rdf:resource="https://w3id.org/mailo#RatioDecidendi"/>
    <rdfs:label xml:lang="en">P-634/21-003: Multi-Actor ADM Chain Gap-Filling</rdfs:label>
    <rdfs:comment xml:lang="en">The prohibition in Art.22 cannot be circumvented by splitting the automated decision across multiple actors (scoring agency + final decision maker). Both may bear responsibility.</rdfs:comment>
    <mailo:appliesTo rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
    <mailo:hasPrecedenceLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">binding_ratio</mailo:hasPrecedenceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#MDR_Art15">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">MDR Art.15 — Person Responsible for Regulatory Compliance</rdfs:label>
    <rdfs:comment xml:lang="en">Manufacturers must designate a person responsible for regulatory compliance (PRRC). For AI-SaMD companies this person must have expertise in medical AI regulation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#hasRisk">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has compliance risk</rdfs:label>
    <rdfs:comment>Technology carries a compliance risk</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#Technology"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#ComplianceRisk"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#EP_3435866">
    <rdf:type rdf:resource="https://w3id.org/mailo#EuropeanPatent"/>
    <rdfs:label xml:lang="en">EP 3 435 866</rdfs:label>
    <rdfs:comment xml:lang="en">Dexcom continuous glucose monitoring system.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#DGA_Art16">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">DGA Art.16 — Data Altruism Organisations</rdfs:label>
    <rdfs:comment xml:lang="en">Registered data altruism organisations may collect health data voluntarily shared for AI research, subject to GDPR. Separate from commercial data intermediaries.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#hasPrinciple">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Establishes a legal principle (alias)</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#CJEUCase"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#LegalPrinciple"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#caseDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Date of judgment or decision</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#AIAct_Art9">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">AI Act Art.9 — Risk Management System</rdfs:label>
    <rdfs:comment xml:lang="en">High-risk AI providers must establish and maintain a risk management system throughout the AI system lifecycle. Iterative process; complements MDR post-market surveillance.</rdfs:comment>
    <mailo:complementedBy rdf:resource="https://w3id.org/mailo#AIAct_Art14"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#ConstitutionalPrinciple">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>ConstitutionalPrinciple</rdfs:label>
    <rdfs:label xml:lang="en">Constitutional Principle</rdfs:label>
    <rdfs:comment>Principle derived from EU Charter of Fundamental Rights</rdfs:comment>
    <rdfs:comment xml:lang="en">Principle derived from the EU Charter of Fundamental Rights.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#LegalPrinciple"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#P_817_003">
    <rdf:type rdf:resource="https://w3id.org/mailo#RatioDecidendi"/>
    <rdfs:label xml:lang="en">P-817/19-003: Strict Necessity Tri-Level Proportionality Test</rdfs:label>
    <rdfs:comment xml:lang="en">Large-scale automated processing must satisfy: (a) targeted scope, (b) purpose limitation, (c) temporal limitation. Failure at any level invalidates the entire processing system.</rdfs:comment>
    <mailo:appliesTo rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
    <mailo:hasPrecedenceLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constitutional_grand_chamber</mailo:hasPrecedenceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#ComplianceRisk">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>ComplianceRisk</rdfs:label>
    <rdfs:label xml:lang="en">Compliance Risk</rdfs:label>
    <rdfs:comment>A compliance risk for medical AI developers</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://w3id.org/airo#Risk"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#Tension_DGA_Neutrality_DataAcquisition">
    <rdf:type rdf:resource="https://w3id.org/mailo#CrossFrameworkTension"/>
    <rdfs:label xml:lang="en">DGA Art.10 neutrality obligation vs. AI Act Art.10 data governance</rdfs:label>
    <rdfs:comment xml:lang="en">DGA Art.10 prohibits data-sharing intermediaries from using shared data for purposes beyond the sharing service. Integrated AI development models in which intermediary and developer are related entities require structural business model restructuring that no guidance resolves.</rdfs:comment>
    <mailo:conflictType rdf:resource="https://w3id.org/mailo#DataGovernanceConflict"/>
    <mailo:hasResolutionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">unresolved</mailo:hasResolutionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#UPCA">
    <rdf:type rdf:resource="https://w3id.org/mailo#InternationalTreaty"/>
    <rdf:type rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
    <rdfs:label xml:lang="en">UPC Agreement (UPCA)</rdfs:label>
    <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-01</dcterms:date>
    <dcterms:identifier>OJ C 175, 20.6.2013</dcterms:identifier>
    <rdfs:comment xml:lang="en">Agreement on a Unified Patent Court (in force 2023-06-01). Establishes the UPC as a supranational court for infringement and revocation of European patents across contracting states. Key for medtech AI: opt-out strategy, PI threshold ('more likely than not' invalidity standard from 10x v. NanoString CoA), EPO-UPC divergence risk.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#hasExplanation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has explanation</rdfs:label>
    <rdfs:comment>Links system to its explanation for data subjects</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an automated decision system to its actionable explanation for data subjects (C-203/22 P_203_001; GDPR Art.15(1)(h)).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#Explanation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#GDPR_Art9">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">GDPR Article 9</rdfs:label>
    <rdfs:comment xml:lang="en">Processing of special categories of personal data, including health data.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://w3id.org/dpv#SpecialCategoryData"/>
  </rdf:Description>
