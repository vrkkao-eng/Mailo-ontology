    <rdf:type rdf:resource="https://w3id.org/mailo#CJEUCase"/>
    <rdfs:label xml:lang="en">C-201/14 Bara</rdfs:label>
    <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-10-01</dcterms:date>
    <dcterms:identifier>C-201/14</dcterms:identifier>
    <mailo:citesPrecedent rdf:nodeID="nb4790e6000cc4a2bbfcaf655b4f77b52b1"/>
