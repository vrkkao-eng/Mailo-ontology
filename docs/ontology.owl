  <mailo:InternationalTreaty rdf:about="https://w3id.org/mailo#UPCA">
    <rdf:type rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
    <rdfs:label xml:lang="en">UPC Agreement (UPCA)</rdfs:label>
    <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-01</dcterms:date>
    <dcterms:identifier>OJ C 175, 20.6.2013</dcterms:identifier>
    <rdfs:comment xml:lang="en">Agreement on a Unified Patent Court (in force 2023-06-01). Establishes the UPC as a supranational court for infringement and revocation of European patents across contracting states. Key for medtech AI: opt-out strategy, PI threshold ('more likely than not' invalidity standard from 10x v. NanoString CoA), EPO-UPC divergence risk.</rdfs:comment>
  </mailo:InternationalTreaty>
