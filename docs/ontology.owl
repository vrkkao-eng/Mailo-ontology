    <mailo:versionStartDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-02</mailo:versionStartDate>
  </mailo:RegulationVersion>
  <mailo:RegulationVersion rdf:about="https://w3id.org/mailo#AIAct_v2_GPAIModelObligations">
    <rdfs:label>GPAI model provider obligations apply (Title VIII, Arts.51–56)</rdfs:label>
