  <rdf:Description rdf:about="https://w3id.org/mailo#DataAct">
    <rdf:type rdf:resource="https://w3id.org/mailo#EURegulation"/>
    <rdf:type rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
    <rdfs:label xml:lang="en">Data Act 2023/2854</rdfs:label>
    <eli:id_local>32023R2854</eli:id_local>
    <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-12-13</dcterms:date>
    <dcterms:identifier>2023/2854/EU</dcterms:identifier>
    <rdfs:comment xml:lang="en">Data Act. Applies from 2025-09-12. Governs data sharing obligations for IoT-generated data (medical devices, wearables) and B2G/B2B data access for AI development.</rdfs:comment>
    <mailo:coversArticle rdf:resource="https://w3id.org/mailo#DataAct_Art15"/>
    <mailo:coversArticle rdf:resource="https://w3id.org/mailo#DataAct_Art17"/>
    <mailo:coversArticle rdf:resource="https://w3id.org/mailo#DataAct_Art23"/>
    <mailo:coversArticle rdf:resource="https://w3id.org/mailo#DataAct_Art3"/>
    <mailo:coversArticle rdf:resource="https://w3id.org/mailo#DataAct_Art5"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#lit_EHJ_Digital_Health_Oxford_2025_Medicine_healthcare_an">
    <rdf:type rdf:resource="https://w3id.org/mailo#LiteratureSource"/>
    <rdfs:label>EHJ Digital Health (Oxford). (2025). Medicine, healthcare and the AI act: gaps, challenges and future implications.</rdfs:label>
    <dcterms:date>2025</dcterms:date>
    <dcterms:description>Explicit multi-framework gap analysis. Core citation for MAILO Chapter 2.</dcterms:description>
    <dcterms:source rdf:resource="https://academic.oup.com/ehjdh/advance-article/doi/10.1093/ehjdh/ztaf041/8118685"/>
    <mailo:relevanceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</mailo:relevanceScore>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#SoftwareAsMedicalDevice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>SoftwareAsMedicalDevice</rdfs:label>
    <rdfs:label xml:lang="en">Software as Medical Device (SaMD)</rdfs:label>
    <rdfs:comment>Software qualifying as medical device under MDR 2017/745</rdfs:comment>
