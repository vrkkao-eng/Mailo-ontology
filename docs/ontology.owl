  <mailo:CrossFrameworkTension rdf:about="https://w3id.org/mailo#Tension_DGA_Neutrality_DataAcquisition">
    <rdfs:label xml:lang="en">DGA Art.12(1)(a) neutrality obligation vs. AI Act Art.10 data governance</rdfs:label>
    <rdfs:comment xml:lang="en">DGA Art.12(1)(a) prohibits a data intermediation services provider from using the data it intermediates for purposes other than putting it at the disposal of data users, and requires provision through a separate legal person. Integrated AI development models in which intermediary and developer are related entities therefore require structural separation, which no guidance resolves.</rdfs:comment>
    <mailo:conflictType>
      <mailo:ConflictType rdf:about="https://w3id.org/mailo#DataGovernanceConflict">
        <rdfs:label xml:lang="en">Data governance conflict</rdfs:label>
        <rdfs:comment xml:lang="en">Frameworks impose incompatible conditions on the acquisition, sharing or reuse of data (e.g. an EHDS opt-out reducing dataset representativeness against AI Act Art.10 data-quality duties).</rdfs:comment>
      </mailo:ConflictType>
    </mailo:conflictType>
    <mailo:hasResolutionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">unresolved</mailo:hasResolutionStatus>
    <mailo:involvesFramework rdf:resource="https://w3id.org/mailo#AIAct"/>
    <mailo:involvesFramework>
      <mailo:EURegulation rdf:about="https://w3id.org/mailo#DGA">
        <rdf:type rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
        <rdfs:label xml:lang="en">DGA 2022/868</rdfs:label>
        <eli:id_local>32022R0868</eli:id_local>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-05-30</dcterms:date>
        <dcterms:identifier>2022/868/EU</dcterms:identifier>
        <rdfs:comment xml:lang="en">Data Governance Act. Applies from 2023-09-24. Creates data intermediaries, data altruism organisations, and re-use frameworks for public sector health data.</rdfs:comment>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#DGA_Art10"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#DGA_Art12"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#DGA_Art16"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#DGA_Art2"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#DGA_Art29"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#DGA_Art3"/>
      </mailo:EURegulation>
    </mailo:involvesFramework>
  </mailo:CrossFrameworkTension>
