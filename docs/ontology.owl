    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/mailo#citesPrecedent">
    <rdfs:label xml:lang="en">cites precedent</rdfs:label>
    <rdfs:comment>Case relies on earlier case as precedent</rdfs:comment>
    <rdfs:comment xml:lang="en">A case relies on an earlier case as precedent.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#Case"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#Case"/>
