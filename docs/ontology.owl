    <rdf:type rdf:resource="https://w3id.org/mailo#Company"/>
    <rdfs:label xml:lang="en">Amgen Inc.</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#BlackBoxMLSystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>BlackBoxMLSystem</rdfs:label>
    <rdfs:label xml:lang="en">Black-Box ML System</rdfs:label>
    <rdfs:comment>Non-transparent self-learning ML system (C-817/19 prohibition)</rdfs:comment>
    <rdfs:comment xml:lang="en">A non-transparent, self-learning system whose decision logic cannot be explained. Prohibited under C-817/19 for decisions with significant impact.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://w3id.org/airo#OpaqueSystem"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#MedicalAISystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#AIAct_Art10">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">AI Act Art.10 — Data Governance</rdfs:label>
    <rdfs:comment xml:lang="en">Training, validation, and test datasets for high-risk AI must meet quality criteria: relevance, representativeness, freedom from errors, completeness. Direct tension with data scarcity in rare disease AI.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#GDPR_Art22_1">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">GDPR Art.22(1)</rdfs:label>
    <rdfs:comment xml:lang="en">Core prohibition: individuals shall not be subject to solely automated decisions producing significant effects.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#C_817_19">
    <rdf:type rdf:resource="https://w3id.org/mailo#CJEUCase"/>
    <rdfs:label xml:lang="en">C-817/19 Ligue des droits humains v. Conseil des ministres</rdfs:label>
    <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-06-21</dcterms:date>
    <dcterms:identifier>C-817/19</dcterms:identifier>
    <dcterms:identifier>ECLI:EU:C:2022:491</dcterms:identifier>
    <skos:notation>ECLI:EU:C:2022:491</skos:notation>
    <mailo:citesPrecedent rdf:resource="https://w3id.org/mailo#C_511_18"/>
    <mailo:citesPrecedent rdf:resource="https://w3id.org/mailo#C_634_21"/>
    <mailo:decidedBy rdf:resource="https://w3id.org/mailo#CJEU_GrandChamber"/>
    <mailo:establishesPrinciple rdf:resource="https://w3id.org/mailo#P_817_001"/>
    <mailo:establishesPrinciple rdf:resource="https://w3id.org/mailo#P_817_002"/>
    <mailo:establishesPrinciple rdf:resource="https://w3id.org/mailo#P_817_003"/>
    <mailo:establishesPrinciple rdf:resource="https://w3id.org/mailo#P_817_004"/>
    <mailo:establishesPrinciple rdf:resource="https://w3id.org/mailo#P_817_005"/>
    <mailo:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PNR Directive valid only with strict necessity; black-box ML systems prohibited; mandatory non-automated individual review; health status excluded from automated criteria.</mailo:hasOutcome>
    <mailo:hasStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Final — Grand Chamber binding precedent</mailo:hasStatus>
    <mailo:interpretesArticle rdf:resource="https://w3id.org/mailo#Charter_Art7"/>
    <mailo:interpretesArticle rdf:resource="https://w3id.org/mailo#Charter_Art8"/>
    <mailo:involvesTechnology rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
    <mailo:involvesTechnology rdf:resource="https://w3id.org/mailo#BlackBoxMLSystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#DGA_Art31">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">DGA Art.31 — European Data Innovation Board</rdfs:label>
    <rdfs:comment xml:lang="en">Advisory body for DGA implementation, including guidance on interoperability between health data repositories used for AI training.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#GXDBio">
    <rdf:type rdf:resource="https://w3id.org/mailo#NPE"/>
    <rdfs:label xml:lang="en">GXD-Bio Corporation (NPE)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#triggersObligation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">triggers obligation</rdfs:label>
    <rdfs:comment>Principle triggers a compliance obligation</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#LegalPrinciple"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#ComplianceObligation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#MDR_Art61">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">MDR Art.61 — Clinical Evaluation</rdfs:label>
    <rdfs:comment xml:lang="en">Medical device manufacturers must conduct clinical evaluation demonstrating safety and performance. For AI-SaMD, AI-specific performance validation (bias, drift, edge cases) is required.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#GDPR_Art22">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">GDPR Article 22</rdfs:label>
    <rdfs:comment xml:lang="en">Prohibition on solely automated individual decision-making.</rdfs:comment>
    <mailo:coversArticle rdf:resource="https://w3id.org/mailo#GDPR"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#relatedPatent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Involves patent class</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#UPCCase"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#PatentClassification"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#PLD_Art4">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">PLD Art.4 — Strict Liability for Defective Products</rdfs:label>
    <rdfs:comment xml:lang="en">Manufacturers strictly liable for defective products; 'defective' includes AI systems that do not provide the safety that persons are entitled to expect.</rdfs:comment>
  </rdf:Description>
