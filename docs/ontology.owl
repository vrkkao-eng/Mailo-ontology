  <owl:Class rdf:about="https://w3id.org/mailo#EncodingBasis">
    <rdfs:label xml:lang="en">EncodingBasis</rdfs:label>
    <rdfs:comment xml:lang="en">Whether an encoded principle states what a court held, or a
        construct of the ontology designer built on top of it.

        hasPrecedenceLevel records how much weight a holding claims. It cannot
        answer the prior question of whether the encoded proposition is a
        holding at all. Keeping the two apart means a reader can query for
        everything the graph asserts on the designer's own authority.</rdfs:comment>
  </owl:Class>
  <mailo:ComplianceRisk rdf:about="https://w3id.org/mailo#Risk_EHDSOptOut">
    <rdfs:label xml:lang="en">EHDS Art.35 Opt-Out Erodes Training Dataset</rdfs:label>
    <rdfs:comment xml:lang="en">Widespread exercise of opt-out rights under EHDS Art.35 may substantially reduce available health data for AI training, creating representativeness risk under AI Act Art.10.</rdfs:comment>
    <mailo:riskLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MEDIUM</mailo:riskLevel>
  </mailo:ComplianceRisk>
  <mailo:LegislativeAmendment rdf:about="https://w3id.org/mailo#Amend_AIAct_v3b_Omnibus_AnnexI_SaMD">
    <rdfs:label>Activation event: high_risk_annex_i_samd_omnibus</rdfs:label>
    <mailo:amendmentDescription>Omnibus VII provisional agreement — Annex I systems (AI embedded in regulated products including medical devices): 2028-08-02. Single joint MDR+AI Act notified body assessment pathway available. Art.9/10/13/14/43 high-risk obligations apply by this date.</mailo:amendmentDescription>
    <mailo:versionStartDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2028-08-02</mailo:versionStartDate>
  </mailo:LegislativeAmendment>
  <owl:Class rdf:about="https://w3id.org/mailo#LegalArticle">
    <rdfs:label>LegalArticle</rdfs:label>
    <rdfs:label xml:lang="en">Legal Article</rdfs:label>
    <rdfs:comment>A specific provision within a legal instrument</rdfs:comment>
    <rdfs:comment xml:lang="en">A specific provision within a legal instrument.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/eli/ontology#LegalExpression"/>
  </owl:Class>
  <mailo:CJEUCase rdf:about="https://w3id.org/mailo#C_817_19">
    <rdfs:label xml:lang="en">C-817/19 Ligue des droits humains v. Conseil des ministres</rdfs:label>
    <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-06-21</dcterms:date>
    <dcterms:identifier>C-817/19</dcterms:identifier>
    <dcterms:identifier>ECLI:EU:C:2022:491</dcterms:identifier>
    <rdfs:comment xml:lang="en">A citesPrecedent link to C-634/21 (SCHUFA) was removed in v5.2.0 as temporally impossible: this judgment is of 21 June 2022 and SCHUFA was decided on 7 December 2023. The influence runs the other way.</rdfs:comment>
    <rdfs:comment xml:lang="en">Inclusion basis (TransposedPrinciple): PNR / counter-terrorism. MAILO transposes the Grand Chamber's automated-decision safeguards to medical AI by structural analogy.</rdfs:comment>
    <skos:notation>ECLI:EU:C:2022:491</skos:notation>
    <mailo:citesPrecedent>
      <mailo:CJEUCase rdf:about="https://w3id.org/mailo#C_511_18">
        <rdfs:label xml:lang="en">C-511/18 La Quadrature du Net</rdfs:label>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-10-06</dcterms:date>
        <dcterms:identifier>C-511/18</dcterms:identifier>
        <rdfs:comment xml:lang="en">Inclusion basis (TransposedPrinciple): Bulk data retention. Retained for the proportionality line feeding C-817/19.</rdfs:comment>
        <mailo:citesPrecedent rdf:resource="https://w3id.org/mailo#C_201_14"/>
        <mailo:hasInclusionBasis rdf:resource="https://w3id.org/mailo#TransposedPrinciple"/>
        <mailo:hasStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Final</mailo:hasStatus>
      </mailo:CJEUCase>
    </mailo:citesPrecedent>
    <mailo:decidedBy>
      <mailo:Court rdf:about="https://w3id.org/mailo#CJEU_GrandChamber">
        <rdfs:label xml:lang="en">CJEU Grand Chamber</rdfs:label>
        <rdfs:comment xml:lang="en">Highest formation of CJEU; judgments carry maximum precedential weight.</rdfs:comment>
      </mailo:Court>
    </mailo:decidedBy>
    <mailo:establishesPrinciple>
      <mailo:RatioDecidendi rdf:about="https://w3id.org/mailo#P_817_001">
        <rdfs:label xml:lang="en">P-817/19-001: Mandatory Non-Automated Individual Review</rdfs:label>
        <rdfs:comment xml:lang="en">Any positive match from automated PNR analysis must be subject to individual non-automated review before any measure is taken. Establishes constitutional minimum for meaningful human intervention.</rdfs:comment>
        <mailo:appliesTo rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
        <mailo:appliesTo rdf:resource="https://w3id.org/mailo#MedicalAISystem"/>
        <mailo:hasEncodingBasis rdf:resource="https://w3id.org/mailo#CourtHolding"/>
        <mailo:hasPrecedenceLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constitutional_grand_chamber</mailo:hasPrecedenceLevel>
        <mailo:triggersObligation rdf:resource="https://w3id.org/mailo#HumanOversightObligation"/>
      </mailo:RatioDecidendi>
    </mailo:establishesPrinciple>
    <mailo:establishesPrinciple>
      <mailo:RatioDecidendi rdf:about="https://w3id.org/mailo#P_817_002">
        <rdfs:label xml:lang="en">P-817/19-002: Black-Box ML Prohibition</rdfs:label>
        <rdfs:comment xml:lang="en">Non-transparent, self-learning ML risk assessment systems may not be used for decisions with significant impact. Pre-determined criteria and regular review are required.</rdfs:comment>
        <mailo:appliesTo rdf:resource="https://w3id.org/mailo#BlackBoxMLSystem"/>
        <mailo:appliesTo rdf:resource="https://w3id.org/mailo#MedicalAISystem"/>
        <mailo:hasEncodingBasis rdf:resource="https://w3id.org/mailo#CourtHolding"/>
        <mailo:hasPrecedenceLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constitutional_grand_chamber</mailo:hasPrecedenceLevel>
        <mailo:triggersObligation rdf:resource="https://w3id.org/mailo#ExplainabilityObligation"/>
        <mailo:triggersObligation rdf:resource="https://w3id.org/mailo#TransparencyObligation"/>
      </mailo:RatioDecidendi>
    </mailo:establishesPrinciple>
    <mailo:establishesPrinciple>
      <mailo:RatioDecidendi rdf:about="https://w3id.org/mailo#P_817_003">
        <rdfs:label xml:lang="en">P-817/19-003: Strict Necessity Tri-Level Proportionality Test</rdfs:label>
        <rdfs:comment xml:lang="en">Large-scale automated processing must satisfy: (a) targeted scope (C-817/19 paras 167-168, 184, 191), (b) purpose limitation (para 191), (c) temporal limitation (paras 255-256, 262). The Court upheld the PNR Directive subject to Charter-conforming restrictive interpretation; non-conformity at a limb is flagged for review and does not entail invalidity.</rdfs:comment>
        <mailo:appliesTo rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
        <mailo:hasEncodingBasis rdf:resource="https://w3id.org/mailo#CourtHolding"/>
        <mailo:hasPrecedenceLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constitutional_grand_chamber</mailo:hasPrecedenceLevel>
      </mailo:RatioDecidendi>
    </mailo:establishesPrinciple>
    <mailo:establishesPrinciple>
      <mailo:RatioDecidendi rdf:about="https://w3id.org/mailo#P_817_004">
        <rdfs:label xml:lang="en">P-817/19-004: Non-Discrimination — Health Status Excluded</rdfs:label>
        <rdfs:comment xml:lang="en">Pre-determined assessment criteria may in no circumstances be based on health (PNR Directive Art.6(4); C-817/19 paras 105, 196-197) — a categorical prohibition, not a special-category rule curable by a GDPR Art.9(2) basis. MAILO transposes this to medical AI as a bar on using health condition as a discriminatory classification or risk-scoring criterion, which is narrower than any processing of health data.</rdfs:comment>
        <mailo:appliesTo rdf:resource="https://w3id.org/mailo#GenomicDiagnosticAI"/>
        <mailo:appliesTo rdf:resource="https://w3id.org/mailo#MedicalAISystem"/>
        <mailo:hasEncodingBasis rdf:resource="https://w3id.org/mailo#CourtHolding"/>
        <mailo:hasPrecedenceLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constitutional_grand_chamber</mailo:hasPrecedenceLevel>
      </mailo:RatioDecidendi>
    </mailo:establishesPrinciple>
    <mailo:establishesPrinciple>
      <mailo:ObiterDictum rdf:about="https://w3id.org/mailo#P_817_005">
        <rdfs:label xml:lang="en">P-817/19-005: Independent Prior Review (and MAILO's DPIA bridge)</rdfs:label>
        <rdfs:comment xml:lang="en">C-817/19 paras 222-227 (PNR Directive Art.12(3)(b)): disclosure after the initial period requires prior review by a court or independent administrative authority, which must be objective, impartial, free from external influence, and distinct from the requesting authority or the PIU. The Court said nothing about GDPR Art.35 or DPIAs; the link from independent prior review to a DPIA obligation for medical AI is an authorial cross-instrument interpretation by the ontology designer, not a holding. The DPIA requirement stands on GDPR Art.35 alone.</rdfs:comment>
        <rdfs:comment xml:lang="en">Encoding basis (DesignerTransposition): C-817/19 paras 222-227 concern prior review of PNR disclosure requests. The bridge to a GDPR Art.35 DPIA duty is the designer's; the DPIA constraint stands on Art.35 alone.</rdfs:comment>
        <mailo:hasEncodingBasis rdf:resource="https://w3id.org/mailo#DesignerTransposition"/>
        <mailo:hasPrecedenceLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">authorial_transposition</mailo:hasPrecedenceLevel>
        <mailo:triggersObligation rdf:resource="https://w3id.org/mailo#DPIAObligation"/>
      </mailo:ObiterDictum>
    </mailo:establishesPrinciple>
    <mailo:hasInclusionBasis rdf:resource="https://w3id.org/mailo#TransposedPrinciple"/>
    <mailo:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PNR Directive valid only with strict necessity; black-box ML systems prohibited; mandatory non-automated individual review; health status excluded from automated criteria.</mailo:hasOutcome>
    <mailo:hasStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Final — Grand Chamber binding precedent</mailo:hasStatus>
    <mailo:interpretesArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#Charter_Art7">
        <rdfs:label xml:lang="en">EU Charter Art.7</rdfs:label>
        <rdfs:comment xml:lang="en">Respect for private and family life.</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:interpretesArticle>
    <mailo:interpretesArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#Charter_Art8">
        <rdfs:label xml:lang="en">EU Charter Art.8</rdfs:label>
        <rdfs:comment xml:lang="en">Protection of personal data.</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:interpretesArticle>
    <mailo:involvesTechnology rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
    <mailo:involvesTechnology rdf:resource="https://w3id.org/mailo#BlackBoxMLSystem"/>
  </mailo:CJEUCase>
  <owl:Class rdf:about="https://w3id.org/mailo#ExplainabilityObligation">
    <rdfs:label>ExplainabilityObligation</rdfs:label>
    <rdfs:label xml:lang="en">Explainability Obligation</rdfs:label>
    <rdfs:comment>Obligation to provide actionable explanations</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://w3id.org/dpv#ExplainabilityObligation"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#ComplianceObligation"/>
  </owl:Class>
  <mailo:RatioDecidendi rdf:about="https://w3id.org/mailo#P_634_002">
    <rdfs:label xml:lang="en">P-634/21-002: Functional 'Solely' Test</rdfs:label>
    <rdfs:comment xml:lang="en">C-634/21 paras 49-50: where an automated output plays a determining role in the resulting decision, establishing that output is itself a decision under Art.22(1). The Court did not set out a rubber-stamping or substantive-review standard; MAILO operationalises the determining-role test through a human-asserted substantive-oversight proxy, which is the ontology designer's construction.</rdfs:comment>
    <rdfs:comment xml:lang="en">Encoding basis (DesignerOperationalisation): Paras 49-50 state a determining-role test. The substantive-oversight predicate is MAILO's proxy for it; the Court set no rubber-stamping standard.</rdfs:comment>
    <mailo:appliesTo rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
    <mailo:appliesTo rdf:resource="https://w3id.org/mailo#ClinicalDecisionSupport"/>
    <mailo:appliesTo rdf:resource="https://w3id.org/mailo#MedicalImagingAI"/>
    <mailo:hasEncodingBasis>
      <mailo:EncodingBasis rdf:about="https://w3id.org/mailo#DesignerOperationalisation">
        <rdfs:label xml:lang="en">Designer operationalisation</rdfs:label>
        <rdfs:comment xml:lang="en">The court's test is open-textured and the constraint encodes a proxy for it. The paragraphs are correct; the operative predicate is MAILO's. Example: C-634/21 states a determining-role test; the substantive-oversight predicate is a proxy for it.</rdfs:comment>
      </mailo:EncodingBasis>
    </mailo:hasEncodingBasis>
    <mailo:hasPrecedenceLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">binding_ratio</mailo:hasPrecedenceLevel>
    <mailo:triggersObligation rdf:resource="https://w3id.org/mailo#HumanOversightObligation"/>
  </mailo:RatioDecidendi>
  <owl:Class rdf:about="https://w3id.org/mailo#CrossFrameworkTension">
    <rdfs:label>CrossFrameworkTension</rdfs:label>
    <rdfs:comment>A conflict or gap between two regulatory frameworks</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/mailo#DataSubjectRight">
    <rdfs:label>DataSubjectRight</rdfs:label>
    <rdfs:label xml:lang="en">Data Subject Right</rdfs:label>
    <rdfs:comment>A right of an individual under GDPR</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://w3id.org/dpv#DataSubjectRight"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#Right"/>
  </owl:Class>
