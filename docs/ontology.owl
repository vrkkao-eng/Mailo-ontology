    <mailo:involvesTechnology rdf:resource="https://w3id.org/mailo#RiskScoringSystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#MDR">
    <rdf:type rdf:resource="https://w3id.org/mailo#EURegulation"/>
    <rdf:type rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
    <rdfs:label xml:lang="en">MDR 2017/745</rdfs:label>
    <eli:id_local>32017R0745</eli:id_local>
    <dcterms:identifier>2017/745/EU</dcterms:identifier>
    <mailo:coversArticle rdf:resource="https://w3id.org/mailo#MDR_Art15"/>
    <mailo:coversArticle rdf:resource="https://w3id.org/mailo#MDR_Art61"/>
    <mailo:coversArticle rdf:resource="https://w3id.org/mailo#MDR_Art83"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#Tension_EPO_GDPR_Disclosure">
    <rdf:type rdf:resource="https://w3id.org/mailo#CrossFrameworkTension"/>
    <rdfs:label xml:lang="en">EPC Art.83 Sufficiency Disclosure vs. GDPR Art.15(1)(h) + TSD Art.2 Secrecy</rdfs:label>
    <rdfs:comment xml:lang="en">&#13;
        EPC Art.83 requires public disclosure of training data structure to maintain patent validity.&#13;
        GDPR Art.15(1)(h) + C-203/22 require actionable explanations to data subjects.&#13;
        The EPO disclosure may inadvertently establish a baseline that strengthens GDPR access rights,&#13;
        eroding TSD Art.2 trade secret shields that might otherwise limit GDPR Art.15 responses.&#13;
        TSD Art.9 judicial confidentiality measures do not apply to EPO prosecution, leaving no&#13;
        mechanism to contain the disclosure baseline once it enters the public patent record.&#13;
    </rdfs:comment>
    <mailo:conflictsWith rdf:resource="https://w3id.org/mailo#DisclosureObligation"/>
    <mailo:involvesFramework rdf:resource="https://w3id.org/mailo#EPC"/>
    <mailo:involvesFramework rdf:resource="https://w3id.org/mailo#GDPR"/>
    <mailo:involvesFramework rdf:resource="https://w3id.org/mailo#TSD"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#EPO_T1191_19">
    <rdf:type rdf:resource="https://w3id.org/mailo#EPOProceding"/>
    <rdfs:label xml:lang="en">EPO T 1191/19 — AI Plausibility and Post-Filed Evidence</rdfs:label>
    <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-11-12</dcterms:date>
    <dcterms:identifier>T 1191/19</dcterms:identifier>
    <mailo:decidedBy rdf:resource="https://w3id.org/mailo#EPO_BoA"/>
    <mailo:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ab initio plausibility required for AI-based inventions claiming technical effect. Post-filed evidence accepted only where at least some plausibility established in application as filed. Relevant for medical AI patents claiming diagnostic performance metrics.</mailo:hasOutcome>
    <mailo:interpretesArticle rdf:resource="https://w3id.org/mailo#EPC_Art52"/>
    <mailo:interpretesArticle rdf:resource="https://w3id.org/mailo#EPC_Art83"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#hasDefinedScope">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">has defined scope</rdfs:label>
    <rdfs:comment>Tri-level proportionality (a): targeted scope (C-817/19 P_817_003)</rdfs:comment>
    <rdfs:comment xml:lang="en">Tri-level proportionality test (a): targeted scope. C-817/19 P_817_003.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#art22ExceptionApplied">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Art.22 exception applied</rdfs:label>
    <rdfs:comment>contract_necessity | explicit_consent | member_state_law</rdfs:comment>
    <rdfs:comment xml:lang="en">The GDPR Art.22(2) exception relied on: 'contract_necessity' | 'explicit_consent' | 'member_state_law'. Must be stated or Art.22(1) prohibition applies (C-634/21 P_634_004).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#hasPrecedenceLevel">
