        <rdfs:label>GDPR Art.22 Omnibus-proposed version — permission list framing (PROSPECTIVE, NOT ADOPTED)</rdfs:label>
        <mailo:applicablePhase>art22_omnibus_proposed_NOT_ADOPTED</mailo:applicablePhase>
