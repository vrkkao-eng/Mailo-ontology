  <rdf:Description rdf:about="https://w3id.org/mailo#Amend_AIAct_v3b_Omnibus_AnnexI_SaMD">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegislativeAmendment"/>
    <rdfs:label>Activation event: high_risk_annex_i_samd_omnibus</rdfs:label>
    <mailo:amendmentDescription>Omnibus VII provisional agreement — Annex I systems (AI embedded in regulated products including medical devices): 2028-08-02. Single joint MDR+AI Act notified body assessment pathway available. Art.9/10/13/14/43 high-risk obligations apply by this date.</mailo:amendmentDescription>
    <mailo:versionStartDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2028-08-02</mailo:versionStartDate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#versionEndDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Date until which this version applies (exclusive; absent = open-ended)</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#Amend_AIAct_v4_FRIA_PublicBodies">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegislativeAmendment"/>
    <rdfs:label>Activation event: fria_public_bodies</rdfs:label>
    <mailo:amendmentDescription>36-month anniversary — Fundamental Rights Impact Assessment mandatory for public-body deployers of high-risk AI systems</mailo:amendmentDescription>
    <mailo:versionStartDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2027-08-02</mailo:versionStartDate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#TSD_Art5">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">TSD Article 5 — Exceptions</rdfs:label>
    <rdfs:comment xml:lang="en">Trade secret protection does not apply where disclosure is required for the exercise of the right to information. Directly engaged when a data subject invokes GDPR Art.15(1)(h) or AI Act Art.86 for an explanation of an automated medical decision — controller cannot use TSD Art.2 to block all causal explanation (C-203/22 §§60-70).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#EUDirective">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>EUDirective</rdfs:label>
    <rdfs:label xml:lang="en">EU Directive</rdfs:label>
    <rdfs:comment>EU Directive (requires transposition)</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#LegalInstrument"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#PLD_Art7">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">PLD Art.7 — AI and Software as Products</rdfs:label>
    <rdfs:comment xml:lang="en">Expressly includes software (including AI systems) in the definition of 'product'. SaMD under MDR may simultaneously be a 'product' under PLD.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#usesHealthStatusAsCriterion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">uses health status as criterion</rdfs:label>
    <rdfs:comment>Must be false — health status excluded from automated criteria (C-817/19 P_817_004)</rdfs:comment>
    <rdfs:comment xml:lang="en">True if the system uses an individual's health status as an automated classification criterion. Must be false (C-817/19 P_817_004 Grand Chamber prohibition).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#hasDefendant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has defendant</rdfs:label>
    <rdfs:comment>Defendant in the case</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#Case"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#LegalEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#UPC_LD_Dusseldorf">
    <rdf:type rdf:resource="https://w3id.org/mailo#UPCDivision"/>
    <rdfs:label xml:lang="en">UPC Local Division — Düsseldorf</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#DataAct_Art3">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">Data Act Art.3 — IoT Data Access Right</rdfs:label>
    <rdfs:comment xml:lang="en">Users of connected medical devices (wearables, implantables) have a right to access data generated by those devices, enforceable against manufacturers. Extends GDPR Art.20 portability.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#riskLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">risk level</rdfs:label>
    <rdfs:comment>CRITICAL | HIGH | MEDIUM | LOW</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#ComplianceRisk"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#RegulatoryAuthority">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>RegulatoryAuthority</rdfs:label>
    <rdfs:comment>An EU or national regulatory or supervisory body</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#isActionable">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">is actionable</rdfs:label>
    <rdfs:comment>Explanation enables effective Art.22(3) remedies (C-203/22 P_203_001)</rdfs:comment>
    <rdfs:comment xml:lang="en">True if the explanation enables effective exercise of GDPR Art.22(3) remedies (C-203/22 P_203_001). Abstract mathematical formulas are insufficient.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#Explanation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#CJEU_FirstChamber">
    <rdf:type rdf:resource="https://w3id.org/mailo#Court"/>
    <rdfs:label xml:lang="en">CJEU First Chamber</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#ComplianceObligation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>ComplianceObligation</rdfs:label>
    <rdfs:label xml:lang="en">Compliance Obligation</rdfs:label>
    <rdfs:comment>A concrete obligation arising from regulation</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#DGA_Art10">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">DGA Art.10 — Data Intermediation Services</rdfs:label>
    <rdfs:comment xml:lang="en">Notification requirements for data intermediaries facilitating health data exchange between data subjects and AI developers. Must be neutral — cannot use data for own purposes.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#governedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Governed by a regulatory framework</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#Technology"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#PLD_Art10">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">PLD Art.10 — Presumption of Defectiveness</rdfs:label>
    <rdfs:comment xml:lang="en">Rebuttable presumption of defect where: defendant fails to disclose; product does not comply with mandatory safety requirements; obvious malfunction occurs. Reduces claimant's evidential burden.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#cites">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Cites another CJEU case (alias)</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#CJEUCase"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#CJEUCase"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#requiresAssessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Technology requires a conformity path</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#Technology"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#ConformityAssessment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#AIAct_v3a_Omnibus_AnnexIII_Standalone">
    <rdf:type rdf:resource="https://w3id.org/mailo#RegulationVersion"/>
    <rdfs:label>Omnibus-revised Annex III standalone high-risk deadline (biometrics, employment, education, law enforcement, critical infrastructure, border management)</rdfs:label>
    <mailo:applicablePhase>high_risk_annex_iii_omnibus</mailo:applicablePhase>
    <mailo:isCurrentVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</mailo:isCurrentVersion>
    <mailo:triggeredBy rdf:resource="https://w3id.org/mailo#Amend_AIAct_v3a_Omnibus_AnnexIII_Standalone"/>
    <mailo:triggeredBy rdf:resource="https://w3id.org/mailo#OmnibusAI_ProvisionalAgreement_20260507"/>
    <mailo:versionOf rdf:resource="https://w3id.org/mailo#AIAct_2024_1689"/>
    <mailo:versionStartDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2027-12-02</mailo:versionStartDate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#Right_HumanIntervention">
    <rdf:type rdf:resource="https://w3id.org/mailo#DataSubjectRight"/>
    <rdfs:label xml:lang="en">Right to Human Intervention (Art.22(3)(a))</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#Technology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Technology</rdfs:label>
    <rdfs:label xml:lang="en">Technology</rdfs:label>
    <rdfs:comment>A medical AI technology class</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#UPC_LD_Paris">
    <rdf:type rdf:resource="https://w3id.org/mailo#UPCDivision"/>
    <rdfs:label xml:lang="en">UPC Local Division — Paris</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#Risk_DataActIoT">
    <rdf:type rdf:resource="https://w3id.org/mailo#ComplianceRisk"/>
    <rdfs:label xml:lang="en">Data Act Art.3/5 IoT Data Sharing Obligation</rdfs:label>
    <rdfs:comment xml:lang="en">Medical device manufacturers must share IoT-generated health data with users/third parties. Conflicts with trade secret protection (Art.15) and competitive AI training data strategies.</rdfs:comment>
    <mailo:riskLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MEDIUM</mailo:riskLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#EURegulation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>EURegulation</rdfs:label>
    <rdfs:label xml:lang="en">EU Regulation</rdfs:label>
    <rdfs:comment>EU Regulation (directly applicable)</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://data.europa.eu/eli/ontology#LegalResource"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#LegalInstrument"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#UPC">
    <rdf:type rdf:resource="https://w3id.org/mailo#Court"/>
    <rdfs:label xml:lang="en">Unified Patent Court (UPC)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#Amend_AIAct_v3_OriginalHighRisk">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegislativeAmendment"/>
    <rdfs:label>Activation event: high_risk_original_deadline</rdfs:label>
    <mailo:amendmentDescription>24-month anniversary — original high-risk deadline per Art.113(2); SUPERSEDED: Omnibus provisional agreement (2026-05-07) extends this deadline.</mailo:amendmentDescription>
    <mailo:versionStartDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-02</mailo:versionStartDate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#Risk_SolelyTest">
    <rdf:type rdf:resource="https://w3id.org/mailo#ComplianceRisk"/>
    <rdfs:label xml:lang="en">GDPR Art.22 'Solely' Test Failure (Rubber-Stamping)</rdfs:label>
    <mailo:mitigatedBy rdf:resource="https://w3id.org/mailo#HumanOversightObligation"/>
    <mailo:riskLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CRITICAL</mailo:riskLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#Risk_BlackBox">
    <rdf:type rdf:resource="https://w3id.org/mailo#ComplianceRisk"/>
    <rdfs:label xml:lang="en">Black-Box ML System (C-817/19 Prohibition)</rdfs:label>
    <mailo:mitigatedBy rdf:resource="https://w3id.org/mailo#ExplainabilityObligation"/>
    <mailo:mitigatedBy rdf:resource="https://w3id.org/mailo#TransparencyObligation"/>
    <mailo:riskLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HIGH</mailo:riskLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#Amend_AIAct_v1_ProhibitedPractices">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegislativeAmendment"/>
    <rdfs:label>Activation event: prohibited_practices_and_general</rdfs:label>
    <mailo:amendmentDescription>Entry into force — OJ L 2024/1689 published 12 July 2024</mailo:amendmentDescription>
    <mailo:versionStartDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-08-01</mailo:versionStartDate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#relevanceScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Relevance score 1-5</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#P_634_004">
    <rdf:type rdf:resource="https://w3id.org/mailo#RatioDecidendi"/>
    <rdfs:label xml:lang="en">P-634/21-004: Art.22 = Prohibition Rule</rdfs:label>
    <rdfs:comment xml:lang="en">Art.22(1) is a prohibition rule, not merely a right to object. Exceptions in Art.22(2) are exhaustive; safeguards in Art.22(3) are mandatory when an exception applies.</rdfs:comment>
    <mailo:hasPrecedenceLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">persuasive_obiter</mailo:hasPrecedenceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#LegalEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>LegalEntity</rdfs:label>
    <rdfs:label xml:lang="en">Legal Entity</rdfs:label>
    <rdfs:comment>Any natural or legal person with legal standing</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#EPC_Art52">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">EPC Article 52</rdfs:label>
    <rdfs:comment xml:lang="en">Patentable inventions; exclusion of mathematical methods and software as such.</rdfs:comment>
  </rdf:Description>
</rdf:RDF>
