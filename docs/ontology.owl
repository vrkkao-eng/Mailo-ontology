    <mailo:versionStartDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-08-02</mailo:versionStartDate>
  </mailo:RegulationVersion>
  <owl:Class rdf:about="https://w3id.org/mailo#ConformityRecord">
    <rdfs:label>ConformityRecord</rdfs:label>
    <rdfs:label xml:lang="en">Conformity Record</rdfs:label>
    <rdfs:comment>Conformity assessment / technical documentation record</rdfs:comment>
    <rdfs:comment xml:lang="en">A conformity assessment or technical documentation record under AI Act Annex IV / MDR Annex II.</rdfs:comment>
  </owl:Class>
  <mailo:RatioDecidendi rdf:about="https://w3id.org/mailo#P_634_001">
    <rdfs:label xml:lang="en">P-634/21-001: Broad 'Decision' Concept</rdfs:label>
    <rdfs:comment xml:lang="en">A 'decision' under Art.22 encompasses any act producing legal or similarly significant effects. Automated scoring creating probabilities relied upon by third parties constitutes a 'decision'.</rdfs:comment>
    <mailo:appliesTo rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
    <mailo:appliesTo rdf:resource="https://w3id.org/mailo#ClinicalDecisionSupport"/>
    <mailo:appliesTo rdf:resource="https://w3id.org/mailo#RiskScoringSystem"/>
    <mailo:hasEncodingBasis rdf:resource="https://w3id.org/mailo#CourtHolding"/>
    <mailo:hasPrecedenceLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">binding_ratio</mailo:hasPrecedenceLevel>
  </mailo:RatioDecidendi>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#GDPR_Art22_1">
    <rdfs:label xml:lang="en">GDPR Art.22(1) — Right not to be subject to a solely automated decision</rdfs:label>
    <rdfs:comment xml:lang="en">The data subject shall have the RIGHT NOT TO BE SUBJECT to a decision based solely on automated processing, INCLUDING PROFILING, which produces legal effects concerning him or her or similarly significantly affects him or her. CORRECTED in v5.1.0: the earlier text read 'individuals shall not be subject to', stating a flat prohibition. Whether Art.22(1) is a prohibition applying of its own force or a right the data subject must invoke is contested and was not settled by C-634/21 — see the note on P_634_004. The encoding now follows the wording of the provision rather than pre-committing to one reading. The earlier text also omitted profiling and compressed the two-limb effects test.</rdfs:comment>
  </mailo:LegalArticle>
  <mailo:RegulationVersion rdf:about="https://w3id.org/mailo#AIAct_v3b_Omnibus_AnnexI_SaMD">
    <rdfs:label>Omnibus-revised Annex I deadline — SaMD under MDR 2017/745 and IVDR 2017/746 (primary compliance target for MAILO)</rdfs:label>
    <mailo:applicablePhase>high_risk_annex_i_samd_omnibus</mailo:applicablePhase>
    <mailo:isCurrentVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</mailo:isCurrentVersion>
    <mailo:triggeredBy>
      <mailo:LegislativeAmendment rdf:about="https://w3id.org/mailo#Amend_AIAct_v3b_Omnibus_AnnexI_SaMD">
        <rdfs:label>Activation event: high_risk_annex_i_samd_omnibus</rdfs:label>
        <mailo:amendmentDescription>Omnibus VII provisional agreement — Annex I systems (AI embedded in regulated products including medical devices): 2028-08-02. Single joint MDR+AI Act notified body assessment pathway available. Art.9/10/13/14/43 high-risk obligations apply by this date.</mailo:amendmentDescription>
        <mailo:versionStartDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2028-08-02</mailo:versionStartDate>
      </mailo:LegislativeAmendment>
    </mailo:triggeredBy>
    <mailo:triggeredBy>
      <mailo:LegislativeAmendment rdf:about="https://w3id.org/mailo#OmnibusAI_ProvisionalAgreement_20260507">
        <rdfs:label>Digital Omnibus on AI — Provisional Agreement (Council + EP, 2026-05-07)</rdfs:label>
        <mailo:amendmentDescription>Provisional political agreement on Digital Omnibus on AI (Omnibus VII package). Extends Annex III standalone high-risk deadline to 2027-12-02 and Annex I (SaMD/MDR) deadline to 2028-08-02 via conditional standards-availability mechanism. Introduces unified MDR+AI Act notified body assessment pathway. Not yet formally adopted as of 2026-05-10; formal adoption expected before 2026-08-02. Source: Consilium press release 2026-05-07.</mailo:amendmentDescription>
        <mailo:versionStartDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-07</mailo:versionStartDate>
      </mailo:LegislativeAmendment>
    </mailo:triggeredBy>
    <mailo:versionOf rdf:resource="https://w3id.org/mailo#AIAct_2024_1689"/>
    <mailo:versionStartDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2028-08-02</mailo:versionStartDate>
  </mailo:RegulationVersion>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#EHDS_Art71">
    <rdfs:label xml:lang="en">EHDS Art.71 — Right to opt out of secondary use</rdfs:label>
    <rdfs:comment xml:lang="en">Natural persons may opt out of the processing of their personal electronic health data for secondary use. GDPR supervisory authorities are competent for monitoring and enforcing this right. Creates tension with AI Act Art.10 data governance obligations, since opt-out reduces dataset representativeness. Renumbered in v5.1.0: previously recorded as Art.35, which is COM(2022) 197 proposal numbering.</rdfs:comment>
  </mailo:LegalArticle>
  <owl:Class rdf:about="https://w3id.org/mailo#ClinicalDecisionSupport">
    <rdfs:label>ClinicalDecisionSupport</rdfs:label>
    <rdfs:label xml:lang="en">Clinical Decision Support System</rdfs:label>
    <rdfs:comment>Clinical decision support system (CDSS)</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#MedicalAISystem"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/mailo#LiteratureSource">
    <rdfs:label>LiteratureSource</rdfs:label>
    <rdfs:comment>An academic paper, commentary, or official guidance</rdfs:comment>
  </owl:Class>
  <mailo:DataSubjectRight rdf:about="https://w3id.org/mailo#Right_Explanation">
    <rdfs:label xml:lang="en">Right to Meaningful Explanation (Art.15(1)(h), C-203/22)</rdfs:label>
  </mailo:DataSubjectRight>
  <owl:Class rdf:about="https://w3id.org/mailo#ConflictType">
    <rdfs:label xml:lang="en">ConflictType</rdfs:label>
    <rdfs:comment xml:lang="en">Classification of the kind of friction a CrossFrameworkTension represents. Declared in v5.1.0: the five instances below were in use as values of mailo:conflictType but had never been typed.</rdfs:comment>
  </owl:Class>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#GDPR_Art9">
    <rdfs:label xml:lang="en">GDPR Art.9 — Processing of special categories of personal data</rdfs:label>
    <rdfs:comment xml:lang="en">Art.9(1) PROHIBITS processing of special categories of personal data, including data concerning health. Art.9(2) sets out the exhaustive exceptions, of which (a) explicit consent and (g) substantial public interest are the two that can also unlock Art.22(4). Scope clarified in v5.1.0: the earlier comment described the article neutrally without recording that Art.9(1) is a prohibition.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://w3id.org/dpv#SpecialCategoryData"/>
  </mailo:LegalArticle>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#TSD_Art5">
    <rdfs:label xml:lang="en">TSD Art.5 — Exceptions (freedom of expression, whistleblowing, workers' representatives, legitimate interest)</rdfs:label>
    <rdfs:comment xml:lang="en">An application for the measures, procedures and remedies is dismissed where the acquisition, use or disclosure was carried out (a) for exercising the right to freedom of expression and information as set out in the Charter, including respect for the freedom and pluralism of the media; (b) for revealing misconduct, wrongdoing or illegal activity in order to protect the general public interest; (c) by workers to their representatives in the legitimate exercise of representative functions; or (d) for the purpose of protecting a legitimate interest recognised by Union or national law.

CORRECTED in v5.1.0, and this was a substantive error rather than a citation slip. The earlier entry read that trade secret protection does not apply 'where disclosure is required for the exercise of the right to information', and treated Art.5 as the provision engaged when a data subject invokes GDPR Art.15(1)(h). Art.5(a) is the freedom of expression and information of Charter Art.11 — media freedom, investigative journalism, protection of journalistic sources per recital 19. A patient seeking an explanation of an automated medical decision is not exercising that right. Art.5(d) might be argued to cover data-protection rights as a legitimate interest recognised by Union law, but that is an argument to be made rather than a plain reading, and the CJEU did not take that route in C-203/22: the Court resolved the trade-secret defence within the GDPR itself, requiring disclosure to the supervisory authority or court for balancing. The provision that actually preserves regulatory disclosure duties is Art.1(2)(b), now encoded separately.</rdfs:comment>
  </mailo:LegalArticle>
  <owl:Class rdf:about="https://w3id.org/mailo#UPCCase">
    <rdfs:label>UPCCase</rdfs:label>
    <rdfs:label xml:lang="en">UPC Case</rdfs:label>
    <rdfs:comment>Case before the Unified Patent Court</rdfs:comment>
    <rdfs:comment xml:lang="en">Infringement, revocation, or PI proceeding before the Unified Patent Court.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#Case"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/mailo#LegalPrinciple">
    <rdfs:label>LegalPrinciple</rdfs:label>
    <rdfs:label xml:lang="en">Legal Principle</rdfs:label>
    <rdfs:comment>A binding or persuasive rule extracted from case law</rdfs:comment>
    <rdfs:comment xml:lang="en">A binding or persuasive rule extracted from case law or legislation.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/mailo#NPE">
    <rdfs:label>NPE</rdfs:label>
    <rdfs:label xml:lang="en">Non-Practising Entity</rdfs:label>
    <rdfs:comment>Non-Practising Entity — patent assertion vehicle</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#Company"/>
  </owl:Class>
  <mailo:HighRiskRoute rdf:about="https://w3id.org/mailo#AnnexIIIRoute">
    <rdfs:label xml:lang="en">Annex III route (Art.6(2)) — listed standalone use case</rdfs:label>
    <rdfs:comment xml:lang="en">The system falls within one of the Annex III use cases. Healthcare relevance arises mainly at point 5, covering evaluation of eligibility for essential public assistance benefits and services including healthcare. Art.86 applies here, except to systems under point 2. Obligations for this route apply from 2 December 2027.</rdfs:comment>
  </mailo:HighRiskRoute>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#EHDS_Art75">
    <rdfs:label xml:lang="en">EHDS Art.75 — HealthData@EU (cross-border infrastructure for secondary use)</rdfs:label>
    <rdfs:comment xml:lang="en">HealthData@EU connects national contact points for secondary use, enabling EU-wide access to datasets through a single channel without raw data transfer. Not to be confused with MyHealth@EU (Art.23), the corresponding infrastructure for primary use. Third-country participation becomes possible under Art.75(5) from 26 March 2035. Renumbered in v5.1.0: previously recorded as Art.50, which is COM(2022) 197 proposal numbering.</rdfs:comment>
  </mailo:LegalArticle>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#EHDS_Art52">
    <rdfs:label xml:lang="en">EHDS Art.52 — IP rights, trade secrets and regulatory data protection in secondary use</rdfs:label>
    <rdfs:comment xml:lang="en">The provision governing the trade-secret / access conflict in the health domain, and the one most directly relevant to MAILO's transparency-secrecy tension. Datasets protected by IP rights, trade secrets or regulatory data protection may still be made available for secondary use provided the health data holder identifies and substantiates the protected elements. The health data access body must then take all specific, appropriate and proportionate legal, organisational and technical measures, which may include contractual arrangements, and may refuse access where a serious risk of infringement cannot be addressed satisfactorily. Art.52(3) covers technical measures. The decision chain it leaves to be operationalised runs: protected element, substantiated claim, access scenario, infringement pathway, safeguard, residual risk, permit or conditional permit or refusal. Added in v5.1.0: MAILO had encoded five EHDS articles and omitted this one.</rdfs:comment>
  </mailo:LegalArticle>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#EHDS_Art54">
    <rdfs:label xml:lang="en">EHDS Art.54 — Prohibited secondary use</rdfs:label>
    <rdfs:comment xml:lang="en">Secondary use may not be granted for purposes adverse to the natural persons whose data it is, including decisions detrimental to them or to groups, advertising and marketing, developing products or services that may harm individuals or public health, and decisions on insurance exclusion or premium adjustment. The counterpart to Art.53 and the boundary against which any medical-AI training purpose must also be tested. Added in v5.1.0.</rdfs:comment>
  </mailo:LegalArticle>
  <mailo:RatioDecidendi rdf:about="https://w3id.org/mailo#P_634_002">
    <rdfs:label xml:lang="en">P-634/21-002: Functional 'Solely' Test</rdfs:label>
    <rdfs:comment xml:lang="en">C-634/21 paras 49-50: where an automated output plays a determining role in the resulting decision, establishing that output is itself a decision under Art.22(1). The Court did not set out a rubber-stamping or substantive-review standard; MAILO operationalises the determining-role test through a human-asserted substantive-oversight proxy, which is the ontology designer's construction.</rdfs:comment>
    <rdfs:comment xml:lang="en">Encoding basis (DesignerOperationalisation): Paras 49-50 state a determining-role test. The substantive-oversight predicate is MAILO's proxy for it; the Court set no rubber-stamping standard.</rdfs:comment>
    <mailo:appliesTo rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
    <mailo:appliesTo rdf:resource="https://w3id.org/mailo#ClinicalDecisionSupport"/>
    <mailo:appliesTo rdf:resource="https://w3id.org/mailo#MedicalImagingAI"/>
    <mailo:hasEncodingBasis rdf:resource="https://w3id.org/mailo#DesignerOperationalisation"/>
    <mailo:hasPrecedenceLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">binding_ratio</mailo:hasPrecedenceLevel>
    <mailo:triggersObligation rdf:resource="https://w3id.org/mailo#HumanOversightObligation"/>
  </mailo:RatioDecidendi>
  <owl:Class rdf:about="https://w3id.org/mailo#UPCDivision">
    <rdfs:label xml:lang="en">UPC Division</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#Court"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/mailo#DPIARecord">
    <rdfs:label>DPIARecord</rdfs:label>
    <rdfs:label xml:lang="en">DPIA Record</rdfs:label>
    <rdfs:comment>Data Protection Impact Assessment document (GDPR Art.35; C-817/19)</rdfs:comment>
    <rdfs:comment xml:lang="en">A Data Protection Impact Assessment document required for high-risk automated processing (GDPR Art.35; C-817/19 P_817_005).</rdfs:comment>
  </owl:Class>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#AIAct_Art17">
    <rdfs:label xml:lang="en">AI Act Art.17 — Quality Management System</rdfs:label>
    <rdfs:comment xml:lang="en">High-risk AI providers must implement a QMS covering design, development, post-market monitoring. Aligned with MDR Annex IX QMS requirements to avoid double burden.</rdfs:comment>
  </mailo:LegalArticle>
  <owl:Class rdf:about="https://w3id.org/mailo#DataSubjectRight">
    <rdfs:label>DataSubjectRight</rdfs:label>
    <rdfs:label xml:lang="en">Data Subject Right</rdfs:label>
    <rdfs:comment>A right of an individual under GDPR</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://w3id.org/dpv#DataSubjectRight"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#Right"/>
  </owl:Class>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#AIAct_Art26">
    <rdfs:label xml:lang="en">AI Act Art.26 — Obligations of deployers of high-risk AI systems</rdfs:label>
    <rdfs:comment xml:lang="en">Deployers, for example a hospital using a third-party system, must take appropriate technical and organisational measures to ensure use in accordance with the instructions (26(1)); assign human oversight to natural persons with the necessary competence, training and authority (26(2)); ensure input data is relevant and sufficiently representative for the intended purpose so far as they control it (26(4)); monitor operation and inform the provider of risks or serious incidents (26(5)); keep automatically generated logs for at least six months (26(6)); inform workers before putting a system into use in the workplace (26(7)); and, where a decision concerning a natural person is taken on the basis of an Annex III system's output, inform the affected person that they are subject to it (26(11)). Note that 26(11), like Art.86, is scoped to Annex III.</rdfs:comment>
    <mailo:complementedBy rdf:resource="https://w3id.org/mailo#AIAct_Art14"/>
  </mailo:LegalArticle>
  <owl:Class rdf:about="https://w3id.org/mailo#EURegulation">
    <rdfs:label>EURegulation</rdfs:label>
    <rdfs:label xml:lang="en">EU Regulation</rdfs:label>
    <rdfs:comment>EU Regulation (directly applicable)</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://data.europa.eu/eli/ontology#LegalResource"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#LegalInstrument"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/mailo#RegulatoryFramework">
    <rdfs:label>RegulatoryFramework</rdfs:label>
    <rdfs:label xml:lang="en">Regulatory Framework</rdfs:label>
    <rdfs:comment>A coherent body of rules governing a domain</rdfs:comment>
    <rdfs:comment xml:lang="en">A coherent body of rules governing a specific domain.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/mailo#Case">
    <rdfs:label>Case</rdfs:label>
    <rdfs:label xml:lang="en">Case</rdfs:label>
    <rdfs:comment>Any judicial or quasi-judicial proceeding</rdfs:comment>
    <rdfs:comment xml:lang="en">Any judicial or quasi-judicial proceeding.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/mailo#PatentClassification">
    <rdfs:label>PatentClassification</rdfs:label>
    <rdfs:comment>An IPC/CPC patent classification code</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/mailo#InternationalTreaty">
    <rdfs:label>InternationalTreaty</rdfs:label>
    <rdfs:label xml:lang="en">International Treaty</rdfs:label>
    <rdfs:comment>International treaty or convention</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#LegalInstrument"/>
  </owl:Class>
  <mailo:RatioDecidendi rdf:about="https://w3id.org/mailo#P_634_003">
    <rdfs:label xml:lang="en">P-634/21-003: Multi-Actor ADM Chain Gap-Filling</rdfs:label>
    <rdfs:comment xml:lang="en">The prohibition in Art.22 cannot be circumvented by splitting the automated decision across multiple actors (scoring agency + final decision maker). Both may bear responsibility.</rdfs:comment>
    <mailo:appliesTo rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
    <mailo:hasEncodingBasis rdf:resource="https://w3id.org/mailo#CourtHolding"/>
    <mailo:hasPrecedenceLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">binding_ratio</mailo:hasPrecedenceLevel>
  </mailo:RatioDecidendi>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#AIAct_Art9">
    <rdfs:label xml:lang="en">AI Act Art.9 — Risk management system</rdfs:label>
    <rdfs:comment xml:lang="en">A risk management system shall be established, implemented, documented and maintained for high-risk AI systems as a CONTINUOUS ITERATIVE PROCESS planned and run throughout the entire lifecycle, requiring regular systematic review and updating. It comprises identification and analysis of known and reasonably foreseeable risks, estimation of risks in intended use and reasonably foreseeable misuse, and adoption of appropriate targeted risk-management measures. Art.9(10) permits integration with procedures required by other Union harmonisation law, which is the basis for combining it with MDR risk management rather than duplicating it.</rdfs:comment>
    <mailo:complementedBy rdf:resource="https://w3id.org/mailo#AIAct_Art14"/>
  </mailo:LegalArticle>
  <owl:Class rdf:about="https://w3id.org/mailo#RiskScoringSystem">
    <rdfs:label>RiskScoringSystem</rdfs:label>
    <rdfs:label xml:lang="en">Risk Scoring System</rdfs:label>
    <rdfs:comment>Automated risk stratification or scoring system</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
  </owl:Class>
  <mailo:PatientRight rdf:about="https://w3id.org/mailo#Right_MedicalRecordAccess">
    <rdfs:label xml:lang="en">Right to Access Medical Records (C-307/22)</rdfs:label>
  </mailo:PatientRight>
  <mailo:EncodingBasis rdf:about="https://w3id.org/mailo#DesignerTransposition">
    <rdfs:label xml:lang="en">Designer transposition</rdfs:label>
    <rdfs:comment xml:lang="en">The proposition is inferred across instruments or contexts by the ontology designer and is not held by any court. Must never be cited as case law. Example: the bridge from C-817/19 independent prior review to a GDPR Art.35 DPIA duty.</rdfs:comment>
  </mailo:EncodingBasis>
  <owl:Class rdf:about="https://w3id.org/mailo#RatioDecidendi">
    <rdfs:label>RatioDecidendi</rdfs:label>
    <rdfs:label xml:lang="en">Ratio Decidendi</rdfs:label>
    <rdfs:comment>Binding legal reasoning upon which decision rests</rdfs:comment>
    <rdfs:comment xml:lang="en">The binding legal reasoning upon which the decision rests.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#LegalPrinciple"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/mailo#ComplianceRisk">
    <rdfs:label>ComplianceRisk</rdfs:label>
    <rdfs:label xml:lang="en">Compliance Risk</rdfs:label>
    <rdfs:comment>A compliance risk for medical AI developers</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://w3id.org/airo#Risk"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/mailo#PatientRight">
    <rdfs:label>PatientRight</rdfs:label>
    <rdfs:label xml:lang="en">Patient Right</rdfs:label>
    <rdfs:comment>A patient-specific data or health right</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#DataSubjectRight"/>
  </owl:Class>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#AIAct_Art86">
    <rdfs:label xml:lang="en">AI Act Art.86 — Right to explanation of individual decision-making (Annex III only)</rdfs:label>
    <rdfs:comment xml:lang="en">An affected person subject to a decision taken by a deployer on the basis of the output of a high-risk AI system LISTED IN ANNEX III, excluding systems under point 2, which produces legal effects or similarly significantly affects them adversely in health, safety or fundamental rights, may obtain from the deployer clear and meaningful explanations of the role of the AI system in the decision-making procedure and of the main elements of the decision. Art.86(2) disapplies it where Union or national law provides exceptions; Art.86(3) makes it residual to rights available elsewhere in Union law.

SCOPE WARNING added in v5.1.0, and consequential for MAILO's domain: AI-based medical devices are high-risk by the ANNEX I route under Art.6(1), because MDR and IVDR are listed in Annex I Section A and Class IIa/IIb/III devices require third-party conformity assessment. Annex I is not Annex III. Art.86 therefore does NOT confer a right to explanation in respect of a diagnostic or imaging AI device that is high-risk solely as a regulated medical device. It can apply to healthcare AI reaching high-risk status through Annex III point 5, such as systems determining eligibility for publicly funded healthcare services. For the Annex I population, GDPR Art.15(1)(h) and Art.22 carry the explanation duty alone. The previous complementedBy link to GDPR Art.15(1)(h) implied the two operate together across medical AI; it is retained but qualified by this note.</rdfs:comment>
    <mailo:appliesToRoute rdf:resource="https://w3id.org/mailo#AnnexIIIRoute"/>
    <mailo:complementedBy rdf:resource="https://w3id.org/mailo#GDPR_Art15_1h"/>
  </mailo:LegalArticle>
  <owl:Class rdf:about="https://w3id.org/mailo#MedicalAISystem">
    <rdfs:label>MedicalAISystem</rdfs:label>
    <rdfs:label xml:lang="en">Medical AI System</rdfs:label>
    <rdfs:comment>An AI-based system used in clinical contexts</rdfs:comment>
    <rdfs:comment xml:lang="en">An AI-based system used in clinical diagnosis, treatment recommendation, or patient risk stratification.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://w3id.org/airo#AISystem"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#Technology"/>
    <mailo:hasRisk rdf:resource="https://w3id.org/mailo#Risk_BlackBox"/>
    <mailo:hasRisk>
      <mailo:ComplianceRisk rdf:about="https://w3id.org/mailo#Risk_HealthDataDoubleLayer">
        <rdfs:label xml:lang="en">Health Data Double Protection Layer (Art.9 + Art.22(4))</rdfs:label>
        <mailo:mitigatedBy rdf:resource="https://w3id.org/mailo#DPIAObligation"/>
        <mailo:riskLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CRITICAL</mailo:riskLevel>
      </mailo:ComplianceRisk>
    </mailo:hasRisk>
    <mailo:hasRisk rdf:resource="https://w3id.org/mailo#Risk_InsufficientDisclosure"/>
    <mailo:hasRisk rdf:resource="https://w3id.org/mailo#Risk_PLDStrictLiability"/>
    <mailo:hasRisk rdf:resource="https://w3id.org/mailo#Risk_SolelyTest"/>
  </owl:Class>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#MDR_Art61">
    <rdfs:label xml:lang="en">MDR Art.61 — Clinical Evaluation</rdfs:label>
    <rdfs:comment xml:lang="en">MAILO OPERATIONALISATION: the requirement of AI-specific performance validation covering bias, drift and edge cases is the ontology designer's reading of what clinical evaluation entails for AI-SaMD, not language found in Art.61. Recorded as such in v5.1.0.</rdfs:comment>
    <rdfs:comment xml:lang="en">Medical device manufacturers must conduct clinical evaluation demonstrating safety and performance. For AI-SaMD, AI-specific performance validation (bias, drift, edge cases) is required.</rdfs:comment>
  </mailo:LegalArticle>
  <owl:Class rdf:about="https://w3id.org/mailo#EncodingBasis">
    <rdfs:label xml:lang="en">EncodingBasis</rdfs:label>
    <rdfs:comment xml:lang="en">Whether an encoded principle states what a court held, or a
        construct of the ontology designer built on top of it.

        hasPrecedenceLevel records how much weight a holding claims. It cannot
        answer the prior question of whether the encoded proposition is a
        holding at all. Keeping the two apart means a reader can query for
        everything the graph asserts on the designer's own authority.</rdfs:comment>
  </owl:Class>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#AIAct_Art50">
    <rdfs:label xml:lang="en">AI Act Art.50 — Transparency obligations for certain AI systems</rdfs:label>
    <rdfs:comment xml:lang="en">Transparency duties on providers and deployers of AI systems that interact with natural persons or generate synthetic audio, image, video or text, including machine-readable marking and disclosure of artificially generated content. Applies to AI-generated radiology reports and diagnostic summaries. Relabelled in v5.1.0: this is NOT the GPAI regime, which is Chapter V (Arts.51-56) and addresses providers of general-purpose AI models.</rdfs:comment>
  </mailo:LegalArticle>
  <mailo:RatioDecidendi rdf:about="https://w3id.org/mailo#P_Bara_001">
    <rdfs:label xml:lang="en">Transparency Rights Foundation</rdfs:label>
    <rdfs:comment xml:lang="en">C-201/14 Bara: personal data transferred between public administrative bodies and further processed require that data subjects be informed of the transfer and of the categories of data concerned. UNVERIFIED (v5.1.0): no paragraph anchor and no ECLI are recorded, and the holding has not been checked against the judgment text. Do not cite until verified.</rdfs:comment>
    <mailo:hasEncodingBasis rdf:resource="https://w3id.org/mailo#CourtHolding"/>
    <mailo:hasPrecedenceLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">binding_ratio</mailo:hasPrecedenceLevel>
  </mailo:RatioDecidendi>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#EHDS_Art53">
    <rdfs:label xml:lang="en">EHDS Art.53 — Permitted purposes for secondary use</rdfs:label>
    <rdfs:comment xml:lang="en">Health data access bodies may grant access to Art.51 data only where processing is necessary for one of the listed purposes: public interest in public and occupational health; policy-making and regulatory activities; official statistics; education and training in the health or care sector; and scientific research related to health or care that contributes to public health or health technology assessment or ensures high quality and safety of healthcare, medicinal products or medical devices.

Art.53(1)(e)(ii) is of first-order importance to MAILO and was previously absent: it expressly names 'training, testing and evaluation of algorithms, INCLUDING IN MEDICAL DEVICES, IN VITRO DIAGNOSTIC MEDICAL DEVICES, AI SYSTEMS AND DIGITAL HEALTH APPLICATIONS' as a permitted secondary-use purpose. This is the express legal pathway for training medical AI on EHDS data, and the point at which the AI Act Art.10 data-governance duties and the EHDS access regime meet. Added in v5.1.0.</rdfs:comment>
  </mailo:LegalArticle>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#EHDS_Art92">
    <rdfs:label xml:lang="en">EHDS Art.92 — European Health Data Space Board (EHDS Board)</rdfs:label>
    <rdfs:comment xml:lang="en">Independent advisory body facilitating cooperation between Member States and the Commission, with two representatives per Member State (one for primary and one for secondary use). Its remit is consultative. Renumbered in v5.1.0: previously recorded as Art.68 — a particularly hazardous error, since Art.68 exists but governs the data permit, so the citation resolved to a real provision about something else.</rdfs:comment>
  </mailo:LegalArticle>
  <mailo:DataSubjectRight rdf:about="https://w3id.org/mailo#Right_ExpressViews">
    <rdfs:label xml:lang="en">Right to Express Views (Art.22(3)(b))</rdfs:label>
  </mailo:DataSubjectRight>
  <mailo:Court rdf:about="https://w3id.org/mailo#UPC">
    <rdfs:label xml:lang="en">Unified Patent Court (UPC)</rdfs:label>
  </mailo:Court>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#PLD_Art11">
    <rdfs:label xml:lang="en">PLD Art.11 — Exemption from liability</rdfs:label>
    <rdfs:comment xml:lang="en">Grounds on which an economic operator escapes liability, the burden resting on the operator: the product was not placed on the market by them, the defect probably did not exist when the product was placed on the market, or the defect is due to compliance with mandatory legal requirements. The state-of-the-art (development risk) defence sits at Art.11(1)(e), and Member States may derogate from it under Art.18(2). CORRECTED in v5.1.0: this individual previously carried the causation presumption, which is Art.10(4), not Art.11.</rdfs:comment>
  </mailo:LegalArticle>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#AIAct_Art10">
    <rdfs:label xml:lang="en">AI Act Art.10 — Data and data governance</rdfs:label>
    <rdfs:comment xml:lang="en">Art.10(3): training, validation and testing data sets shall be relevant, sufficiently representative, and, TO THE BEST EXTENT POSSIBLE, free of errors and complete in view of the intended purpose. CORRECTED in v5.1.0: the earlier comment listed 'freedom from errors, completeness' as flat criteria, dropping the qualifier the final text added precisely because absolute error-freedom is unattainable. The distinction matters for any claim that a dataset defect breaches Art.10(3) — including Tension_EHDS_GDPR_OptOut, which asserts that elevated opt-out rates in a clinically significant subpopulation put a dataset in violation. Under the qualified standard that conclusion requires showing the shortfall was avoidable, not merely that it exists.</rdfs:comment>
  </mailo:LegalArticle>
  <owl:Class rdf:about="https://w3id.org/mailo#Technology">
    <rdfs:label>Technology</rdfs:label>
    <rdfs:label xml:lang="en">Technology</rdfs:label>
    <rdfs:comment>A medical AI technology class</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/mailo#DPIAObligation">
    <rdfs:label>DPIAObligation</rdfs:label>
    <rdfs:label xml:lang="en">DPIA Obligation</rdfs:label>
    <rdfs:comment>Obligation to carry out a DPIA under GDPR Art.35</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#ComplianceObligation"/>
    <owl:equivalentClass rdf:resource="http://w3id.org/dpv#DPIA"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/mailo#LegalInstrument">
    <rdfs:label>LegalInstrument</rdfs:label>
    <rdfs:label xml:lang="en">Legal Instrument</rdfs:label>
    <rdfs:comment>Any binding or persuasive legal document</rdfs:comment>
    <rdfs:comment xml:lang="en">Any binding or persuasive legal document (regulation, directive, treaty, standard).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/eli/ontology#LegalResource"/>
  </owl:Class>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#PLD_Art6">
    <rdfs:label xml:lang="en">PLD Art.6 — Damage</rdfs:label>
    <rdfs:comment xml:lang="en">The recoverable heads of damage: death or personal injury including medically recognised harm to psychological health; damage to or destruction of property other than the defective product itself, excluding property used exclusively for professional purposes; and destruction or corruption of data not used for professional purposes. Added in v5.1.0.</rdfs:comment>
  </mailo:LegalArticle>
  <owl:Class rdf:about="https://w3id.org/mailo#RegulationVersion">
    <rdfs:label>RegulationVersion</rdfs:label>
    <rdfs:comment>A versioned expression of an EU regulation at a specific applicability phase</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#EURegulation"/>
  </owl:Class>
  <mailo:DataSubjectRight rdf:about="https://w3id.org/mailo#Right_Contest">
    <rdfs:label xml:lang="en">Right to Contest Decision (Art.22(3)(c))</rdfs:label>
  </mailo:DataSubjectRight>
  <owl:Class rdf:about="https://w3id.org/mailo#EuropeanPatent">
    <rdfs:label>EuropeanPatent</rdfs:label>
    <rdfs:label xml:lang="en">European Patent (EP)</rdfs:label>
    <rdfs:comment>A European patent granted by the EPO</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#Patent"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/mailo#Court">
    <rdfs:label>Court</rdfs:label>
    <rdfs:label xml:lang="en">Court</rdfs:label>
    <rdfs:comment>A judicial body</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#LegalEntity"/>
  </owl:Class>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#DGA_Art12">
    <rdfs:label xml:lang="en">DGA Art.12 — Conditions for providing data intermediation services (neutrality)</rdfs:label>
    <rdfs:comment xml:lang="en">Art.12(1)(a): the provider shall not use the data for which it provides intermediation services for purposes other than putting them at the disposal of data users, and shall provide the service through a separate legal person. Art.12(1)(c) restricts use of activity metadata to service development. Added in v5.1.0 to carry the neutrality obligation previously misattributed to Art.10.</rdfs:comment>
  </mailo:LegalArticle>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#DGA_Art16">
    <rdfs:label xml:lang="en">DGA Art.16 — National arrangements for data altruism</rdfs:label>
    <rdfs:comment xml:lang="en">Member States may put in place organisational or technical arrangements to facilitate data altruism. Registration of recognised data altruism organisations, which may collect health data voluntarily shared for AI research, is governed by Arts.18-19; such entities are separate from commercial data intermediation services. Scope clarified in v5.1.0: the earlier label attributed the registration regime to Art.16.</rdfs:comment>
  </mailo:LegalArticle>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#GDPR_Art22_4">
    <rdfs:label xml:lang="en">GDPR Art.22(4) — Prohibition on basing such decisions on special category data</rdfs:label>
    <rdfs:comment xml:lang="en">Decisions referred to in Art.22(2) SHALL NOT be based on special categories of personal data referred to in Art.9(1) — which include health data — unless point (a) (explicit consent) or point (g) (substantial public interest) of Art.9(2) applies AND suitable measures to safeguard rights, freedoms and legitimate interests are in place. CORRECTED in v5.1.0: the earlier text described this as 'enhanced protection', which understates a prohibition with two narrow gateways. Given that health data is squarely within Art.9(1), this is one of the most consequential provisions in MAILO's scope, and the earlier phrasing repeated the error class corrected in P_817_004: a prohibition recorded as a graduated safeguard.</rdfs:comment>
  </mailo:LegalArticle>
  <owl:Class rdf:about="https://w3id.org/mailo#HighRiskRoute">
    <rdfs:label xml:lang="en">HighRiskRoute</rdfs:label>
    <rdfs:comment xml:lang="en">The route by which an AI system becomes high-risk under the AI Act. Encoded in v5.1.0 because the distinction determines whether Art.86 and Art.26(11) apply at all, and MAILO had recorded it nowhere.</rdfs:comment>
  </owl:Class>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#DGA_Art29">
    <rdfs:label xml:lang="en">DGA Art.29 — European Data Innovation Board</rdfs:label>
    <rdfs:comment xml:lang="en">Expert group established by the Commission, comprising the competent authorities for data intermediation services and for data altruism registration from all Member States, the EDPB, the EDPS, ENISA and others. Its tasks are set out in Art.30. Includes guidance on interoperability between health data repositories used for AI training. Renumbered in v5.1.0: previously recorded as Art.31, which governs international access and transfer (Chapter VII).</rdfs:comment>
  </mailo:LegalArticle>
  <owl:Class rdf:about="https://w3id.org/mailo#DisclosureObligation">
    <rdfs:label>DisclosureObligation</rdfs:label>
    <rdfs:label xml:lang="en">Disclosure Obligation</rdfs:label>
    <rdfs:comment>Obligation to disclose information to data subjects</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://w3id.org/dpv#ProvideInformation"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#ComplianceObligation"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/mailo#ConformityAssessment">
    <rdfs:label>ConformityAssessment</rdfs:label>
    <rdfs:comment>A conformity assessment path under MDR or AI Act</rdfs:comment>
  </owl:Class>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#DataAct_Art15">
    <rdfs:label xml:lang="en">Data Act Art.15 — Exceptional need to use data (B2G)</rdfs:label>
    <rdfs:comment xml:lang="en">Defines when a public sector body has an exceptional need justifying a request for data under Chapter V. CORRECTED in v5.1.0: this individual was labelled 'Trade Secret Protection'. The Data Act's trade-secret safeguards are in Art.4(6)-(8) (data holder to user) and Art.5(9)-(11) (user to third party), not Art.15.</rdfs:comment>
  </mailo:LegalArticle>
  <owl:Class rdf:about="https://w3id.org/mailo#LegislativeAmendment">
    <rdfs:label>LegislativeAmendment</rdfs:label>
    <rdfs:comment>A legislative event that creates or modifies a regulation version</rdfs:comment>
  </owl:Class>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#MDR_Art15">
    <rdfs:label xml:lang="en">MDR Art.15 — Person Responsible for Regulatory Compliance</rdfs:label>
    <rdfs:comment xml:lang="en">MAILO OPERATIONALISATION: the requirement that the PRRC hold expertise in medical AI regulation is the designer's extension. Art.15 specifies qualification by diploma and experience in regulatory affairs or quality management for medical devices, without an AI-specific criterion. Recorded as such in v5.1.0.</rdfs:comment>
    <rdfs:comment xml:lang="en">Manufacturers must designate a person responsible for regulatory compliance (PRRC). For AI-SaMD companies this person must have expertise in medical AI regulation.</rdfs:comment>
  </mailo:LegalArticle>
  <owl:Class rdf:about="https://w3id.org/mailo#Right">
    <rdfs:label>Right</rdfs:label>
    <rdfs:label xml:lang="en">Right</rdfs:label>
    <rdfs:comment>A legal right</rdfs:comment>
  </owl:Class>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#DGA_Art10">
    <rdfs:label xml:lang="en">DGA Art.10 — Data intermediation services (scope)</rdfs:label>
    <rdfs:comment xml:lang="en">Defines which services fall within the data intermediation regime. CORRECTED in v5.1.0: the neutrality obligation previously described here belongs to Art.12; notification is Art.11.</rdfs:comment>
  </mailo:LegalArticle>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#MDR_Art83">
    <rdfs:label xml:lang="en">MDR Art.83 — Post-Market Surveillance</rdfs:label>
    <rdfs:comment xml:lang="en">MAILO OPERATIONALISATION: continuous monitoring of model drift and performance degradation in deployment populations is the designer's reading of what PMS entails for AI-SaMD. Art.83 requires a post-market surveillance system proportionate to risk class and device type; it does not name drift. Recorded as such in v5.1.0.</rdfs:comment>
    <rdfs:comment xml:lang="en">PMS system must collect real-world performance data. For AI-SaMD: continuous monitoring of model drift and performance degradation in deployment populations.</rdfs:comment>
  </mailo:LegalArticle>
  <owl:Class rdf:about="https://w3id.org/mailo#InclusionBasis">
    <rdfs:label xml:lang="en">InclusionBasis</rdfs:label>
    <rdfs:comment xml:lang="en">Why a case is present in MAILO at all.

        Added in v5.1.0 after an audit found two cases carrying medical-AI
        technology tags they did not warrant. The underlying defect was not
        the tags: it was that no instance recorded WHY it had been included,
        so twenty implicit inclusion judgements sat unstated across the graph
        and could not be reviewed.

        Note that MAILO's method is transposition. None of the three CJEU
        automated-decision cases is a medical-AI dispute: C-817/19 concerns
        passenger name records, C-634/21 and C-203/22 concern credit scoring.
        A criterion requiring direct medical-AI subject matter would exclude
        the trilogy the ontology is built on. The criterion therefore records
        the BASIS for relevance rather than demanding a single subject
        matter.</rdfs:comment>
  </owl:Class>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#PLD_Art4">
    <rdfs:label xml:lang="en">PLD Art.4 — Definitions ('product' includes software and AI systems)</rdfs:label>
    <rdfs:comment xml:lang="en">Defines 'product' as all movables, even if integrated into or interconnected with another movable or immovable, including electricity, digital manufacturing files, raw materials and SOFTWARE. The provision that brings standalone software and AI systems within the strict-liability regime, and the basis on which SaMD under the MDR is simultaneously a product under the PLD. Free and open-source software developed or supplied outside a commercial activity is excluded.

CORRECTED in v5.1.0: this individual previously carried the label 'Strict Liability for Defective Products' and the defectiveness test. Strict liability and the right to compensation are Art.5; the test that a product is defective where it does not provide the safety a person is entitled to expect is Art.7. The software-as-product content previously recorded under Art.7 belongs here. The two entries were in effect transposed.</rdfs:comment>
  </mailo:LegalArticle>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#PLD_Art10">
    <rdfs:label xml:lang="en">PLD Art.10 — Burden of proof (presumptions of defectiveness AND of causal link)</rdfs:label>
    <rdfs:comment xml:lang="en">Art.10 carries BOTH presumptions. Art.10(2): defectiveness is presumed where the defendant fails to disclose evidence, the product does not comply with mandatory safety requirements, or an obvious malfunction occurred. Art.10(4): defectiveness and/or the causal link are presumed where the claimant faces excessive difficulty owing to technical or scientific complexity and has demonstrated that the defect or the link is probable — the limb of most consequence for medical AI, expressly contemplated at recital 48. Art.10(5) preserves the defendant's right to rebut.</rdfs:comment>
  </mailo:LegalArticle>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#EHDS_Art73">
    <rdfs:label xml:lang="en">EHDS Art.73 — Secure processing environment</rdfs:label>
    <rdfs:comment xml:lang="en">Secondary use of electronic health data must take place within a secure processing environment under the control of a health data access body, from which raw data cannot be downloaded. This is the medical-domain reconciliation route for the trade-secret / transparency tension: disclosure to a controlled environment rather than to the requester. Implementing acts under Art.73(5) apply from 26 March 2029. Added in v5.1.0.</rdfs:comment>
  </mailo:LegalArticle>
  <mailo:DataSubjectRight rdf:about="https://w3id.org/mailo#Right_HumanIntervention">
    <rdfs:label xml:lang="en">Right to Human Intervention (Art.22(3)(a))</rdfs:label>
  </mailo:DataSubjectRight>
  <owl:Class rdf:about="https://w3id.org/mailo#TransparencyObligation">
    <rdfs:label>TransparencyObligation</rdfs:label>
    <rdfs:label xml:lang="en">Transparency Obligation</rdfs:label>
    <rdfs:comment>Obligation to be transparent about AI processing</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#ComplianceObligation"/>
    <owl:equivalentClass rdf:resource="http://w3id.org/dpv#TransparencyObligation"/>
  </owl:Class>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#DataAct_Art3">
    <rdfs:label xml:lang="en">Data Act Art.3 — Obligation to make product data accessible BY DESIGN</rdfs:label>
    <rdfs:comment xml:lang="en">Connected products shall be designed and manufactured, and connected services designed and provided, so that product data and related service data are, by default, directly accessible to the user in a simple, secure, free-of-charge, comprehensive, structured, commonly used and machine-readable format. Art.3(2)-(3) add pre-contractual information duties covering the nature, format and estimated volume of the data, whether it is generated in real time, and where it is stored. Applies to products placed on the market from 12 September 2026.

CORRECTED in v5.1.0: the earlier entry described Art.3 as an 'IoT Data Access Right ... enforceable against manufacturers'. That is Art.4. Art.3 is a design and by-default-accessibility obligation; the user's right to obtain data from the data holder is separate and has applied since 12 September 2025. For connected medical devices the distinction is practical, not merely formal: a device placed on the market before September 2026 is outside the design duty while its holder is already subject to the access duty.</rdfs:comment>
  </mailo:LegalArticle>
  <owl:Class rdf:about="https://w3id.org/mailo#PendingAmendment">
    <rdfs:label xml:lang="en">Pending Amendment</rdfs:label>
    <rdfs:comment xml:lang="en">A proposed but not yet adopted amendment to a legislative provision encoded in MAILO. MAILO encodes the numbering of the text currently in force; a PendingAmendment records, separately and explicitly, that a legislative proposal would change or delete that provision. The two are kept apart deliberately: encoding proposal numbering as though it were in force is the failure mode that produced the EHDS renumbering errors corrected in v5.1.0 Round 3.</rdfs:comment>
  </owl:Class>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#DataAct_Art21">
    <rdfs:label xml:lang="en">Data Act Art.21 — Sharing of data obtained on exceptional need with research organisations</rdfs:label>
    <rdfs:comment xml:lang="en">A public sector body, the Commission, the ECB or a Union body may share data received under Chapter V with individuals or organisations conducting scientific research or analytics compatible with the purpose of the request, or with national statistical institutes and Eurostat. Recipients assume the obligations in Art.17(3) and Art.19, and organisations under significant commercial influence likely to result in preferential access to results are excluded. Relevant to medical-AI research using data obtained through the exceptional-need route. Added in v5.1.0.</rdfs:comment>
  </mailo:LegalArticle>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#DataAct_Art14">
    <rdfs:label xml:lang="en">Data Act Art.14 — Obligation to make data available on the basis of exceptional need</rdfs:label>
    <rdfs:comment xml:lang="en">Where a public sector body, the Commission, the ECB or a Union body demonstrates an exceptional need under Art.15, the data holder shall make the data available. The obligation Art.15 qualifies and Art.17 procedurally implements. Added in v5.1.0: MAILO recorded the Chapter V machinery without the provision that creates the duty.</rdfs:comment>
    <mailo:hasPendingAmendment rdf:resource="https://w3id.org/mailo#DigitalOmnibus_DataAct_ChapterV"/>
  </mailo:LegalArticle>
  <owl:Class rdf:about="https://w3id.org/mailo#CrossFrameworkTension">
    <rdfs:label>CrossFrameworkTension</rdfs:label>
    <rdfs:comment>A conflict or gap between two regulatory frameworks</rdfs:comment>
  </owl:Class>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#TSD_Art9">
    <rdfs:label xml:lang="en">TSD Article 9 — Preservation of Confidentiality in Legal Proceedings</rdfs:label>
    <rdfs:comment xml:lang="en">Courts may impose confidentiality measures to protect trade secrets during litigation. Relevant to UPC discovery proceedings where a party seeks disclosure of AI model architecture or training data as part of infringement or validity analysis.</rdfs:comment>
  </mailo:LegalArticle>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#EHDS_Art57">
    <rdfs:label xml:lang="en">EHDS Art.57 — Tasks of health data access bodies</rdfs:label>
    <rdfs:comment xml:lang="en">Sets out the HDAB's functions, including deciding on data access applications, issuing and withdrawing data permits, and, under Art.57(c), balancing the rights and interests of health data holders against those of health data users. Art.57(c) is the counterpart to the Art.52 protection duty and is where the residual-risk judgment is institutionally located. Added in v5.1.0.</rdfs:comment>
  </mailo:LegalArticle>
  <owl:Class rdf:about="https://w3id.org/mailo#Explanation">
    <rdfs:label>Explanation</rdfs:label>
    <rdfs:label xml:lang="en">Explanation</rdfs:label>
    <rdfs:comment>Actionable non-technical explanation for data subjects (C-203/22 P_203_001)</rdfs:comment>
    <rdfs:comment xml:lang="en">An actionable, non-technical explanation of the logic and main input factors of an automated decision (C-203/22 P_203_001; GDPR Art.15(1)(h)).</rdfs:comment>
  </owl:Class>
  <mailo:RegulationVersion rdf:about="https://w3id.org/mailo#AIAct_v3a_Omnibus_AnnexIII_Standalone">
    <rdfs:label>Omnibus-revised Annex III standalone high-risk deadline (biometrics, employment, education, law enforcement, critical infrastructure, border management)</rdfs:label>
    <mailo:applicablePhase>high_risk_annex_iii_omnibus</mailo:applicablePhase>
    <mailo:isCurrentVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</mailo:isCurrentVersion>
    <mailo:triggeredBy rdf:resource="https://w3id.org/mailo#Amend_AIAct_v3a_Omnibus_AnnexIII_Standalone"/>
    <mailo:triggeredBy rdf:resource="https://w3id.org/mailo#OmnibusAI_ProvisionalAgreement_20260507"/>
    <mailo:versionOf rdf:resource="https://w3id.org/mailo#AIAct_2024_1689"/>
    <mailo:versionStartDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2027-12-02</mailo:versionStartDate>
  </mailo:RegulationVersion>
  <owl:Class rdf:about="https://w3id.org/mailo#ComplianceObligation">
    <rdfs:label>ComplianceObligation</rdfs:label>
    <rdfs:label xml:lang="en">Compliance Obligation</rdfs:label>
    <rdfs:comment>A concrete obligation arising from regulation</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/mailo#HumanOversightRecord">
    <rdfs:label>HumanOversightRecord</rdfs:label>
    <rdfs:label xml:lang="en">Human Oversight Record</rdfs:label>
    <rdfs:comment>Documented record of substantive human review (C-634/21 P_634_002)</rdfs:comment>
    <rdfs:comment xml:lang="en">A documented record of substantive human review of an automated decision (C-634/21 P_634_002: rubber-stamping is insufficient).</rdfs:comment>
  </owl:Class>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#EHDS_Art69">
    <rdfs:label xml:lang="en">EHDS Art.69 — Health data request (anonymised statistical answer)</rdfs:label>
    <rdfs:comment xml:lang="en">Where a health data user seeks only an answer in anonymised statistical form, a health data request may be made instead of a data permit; the HDAB supplies the result rather than access to the underlying data. The least intrusive route in the access hierarchy and a candidate safeguard where a protected element under Art.52 cannot be adequately mitigated within a secure processing environment. Added in v5.1.0.</rdfs:comment>
  </mailo:LegalArticle>
  <owl:Class rdf:about="https://w3id.org/mailo#RegulatoryAuthority">
    <rdfs:label>RegulatoryAuthority</rdfs:label>
    <rdfs:comment>An EU or national regulatory or supervisory body</rdfs:comment>
  </owl:Class>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#EHDS_Art51">
    <rdfs:label xml:lang="en">EHDS Art.51 — Minimum categories of electronic health data for secondary use</rdfs:label>
    <rdfs:comment xml:lang="en">Lists what health data holders must make available: EHR data, data on factors influencing health, pathogen data, healthcare-related administrative and claims data, human genetic, epigenomic and genomic data, other molecular omics data, automatically generated personal EHD from medical devices, data from wellness applications, health-professional and health-facility data, population-based health-data registries, health-data registries and clinical-trial data. Art.51(h) and (n) in particular govern device-generated data, where industry commentary argues the scope should reach only processed human-readable information rather than raw machine data used internally to derive diagnostic scores. Added in v5.1.0.</rdfs:comment>
  </mailo:LegalArticle>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#EPC_Art52">
    <rdfs:label xml:lang="en">EPC Art.52 — Patentable inventions</rdfs:label>
    <rdfs:comment xml:lang="en">Art.52(1): European patents are granted for any inventions in all fields of technology, provided they are new, involve an inventive step and are susceptible of industrial application. Art.52(2) excludes, among others, mathematical methods and programs for computers; Art.52(3) limits that exclusion to such subject matter 'AS SUCH'.

SCOPE NOTE added in v5.1.0: no MAILO case now interprets this article. All three EPO instances were re-anchored to Arts.56, 83 and 84 after the audit found the Art.52 attribution wrong in each. The provision is retained because the 'as such' limitation is the first hurdle any computer-implemented invention clears — G 1/19 confirms it is passed by any technical means — but it should be understood as background rather than as a provision MAILO's case law turns on.</rdfs:comment>
  </mailo:LegalArticle>
</rdf:RDF>
