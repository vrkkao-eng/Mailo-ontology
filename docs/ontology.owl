  <mailo:LiteratureSource rdf:about="https://w3id.org/mailo#lit_Kang_M_Li_B_et_al_2025_R_-Guard_Robust_Reasoning_E">
    <rdfs:label>Kang, M., Li, B. et al. (2025). R²-Guard: Robust Reasoning Enabled LLM Guardrail via Knowledge-Enhanced Logical Reasoning. ICLR 2025.</rdfs:label>
    <dcterms:date>2025</dcterms:date>
    <dcterms:description>Markov logic networks + probabilistic circuits over a safety reasoning graph. +30.2% over Llama Guard on ToxicChat; +59.5% under jailbreak attacks. Direct precedent for logic-graph-as-runtime-safety-filter pattern that MAILO advances, but for general LLM safety, not medical regulation.</dcterms:description>
    <dcterms:source rdf:resource="https://arxiv.org/abs/2407.05557"/>
    <mailo:relevanceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</mailo:relevanceScore>
  </mailo:LiteratureSource>
  <owl:DatatypeProperty rdf:about="https://w3id.org/mailo#amendmentProposalRef">
    <rdfs:label xml:lang="en">amendment proposal reference</rdfs:label>
    <rdfs:comment xml:lang="en">The Commission document reference of the proposal.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#PendingAmendment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <mailo:CrossFrameworkTension rdf:about="https://w3id.org/mailo#Tension_DGA_Neutrality_DataAcquisition">
    <rdfs:label xml:lang="en">DGA Art.10 neutrality obligation vs. AI Act Art.10 data governance</rdfs:label>
    <rdfs:comment xml:lang="en">DGA Art.10 prohibits data-sharing intermediaries from using shared data for purposes beyond the sharing service. Integrated AI development models in which intermediary and developer are related entities require structural business model restructuring that no guidance resolves.</rdfs:comment>
    <mailo:conflictType rdf:resource="https://w3id.org/mailo#DataGovernanceConflict"/>
    <mailo:hasResolutionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">unresolved</mailo:hasResolutionStatus>
  </mailo:CrossFrameworkTension>
