  <owl:Class rdf:about="https://w3id.org/mailo#DPIARecord">
    <rdfs:label>DPIARecord</rdfs:label>
    <rdfs:label xml:lang="en">DPIA Record</rdfs:label>
    <rdfs:comment>Data Protection Impact Assessment document (GDPR Art.35; C-817/19)</rdfs:comment>
    <rdfs:comment xml:lang="en">A Data Protection Impact Assessment document required for high-risk automated processing (GDPR Art.35; C-817/19 P_817_005).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/mailo#EPOProceding">
    <rdfs:label>EPOProceding</rdfs:label>
    <rdfs:label xml:lang="en">EPO Proceeding</rdfs:label>
    <rdfs:comment>EPO opposition, appeal, or examination</rdfs:comment>
    <rdfs:comment xml:lang="en">Opposition, appeal, or examination proceeding before the EPO.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#Case"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/mailo#ConformityAssessment">
    <rdfs:label>ConformityAssessment</rdfs:label>
    <rdfs:comment>A conformity assessment path under MDR or AI Act</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/mailo#AutomatedDecisionSystem">
    <rdfs:label>AutomatedDecisionSystem</rdfs:label>
    <rdfs:label xml:lang="en">Automated Decision System</rdfs:label>
    <rdfs:comment>System processing personal data without meaningful human review</rdfs:comment>
    <rdfs:comment xml:lang="en">A system that processes personal data to produce outputs affecting individuals without meaningful human review.</rdfs:comment>
    <rdfs:comment xml:lang="en">Corrected in v5.1.0: this class was declared rdfs:subClassOf mailo:MedicalAISystem, which entailed that every automated decision system is a medical AI system. The credit-scoring systems in C-634/21 and C-203/22 are counter-examples in MAILO's own graph. The relation runs the other way: a medical AI system producing decisions about individuals IS an automated decision system, which is why MedicalAISystem is now the subclass.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://w3id.org/dpv#DataProcessing"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#Technology"/>
    <owl:equivalentClass rdf:resource="http://w3id.org/dpv#AutomatedDecisionMaking"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/mailo#EuropeanPatent">
    <rdfs:label>EuropeanPatent</rdfs:label>
    <rdfs:label xml:lang="en">European Patent (EP)</rdfs:label>
    <rdfs:comment>A European patent granted by the EPO</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#Patent"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/mailo#Technology">
    <rdfs:label>Technology</rdfs:label>
    <rdfs:label xml:lang="en">Technology</rdfs:label>
    <rdfs:comment>A medical AI technology class</rdfs:comment>
  </owl:Class>
