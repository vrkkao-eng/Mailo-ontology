  </owl:ObjectProperty>
  <mailo:InternationalTreaty rdf:about="https://w3id.org/mailo#UPCA">
    <rdf:type rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
    <rdfs:label xml:lang="en">UPC Agreement (UPCA)</rdfs:label>
    <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-06-01</dcterms:date>
    <dcterms:identifier>OJ C 175, 20.6.2013</dcterms:identifier>
    <rdfs:comment xml:lang="en">Agreement on a Unified Patent Court (in force 2023-06-01). Establishes the UPC as a supranational court for infringement and revocation of European patents across contracting states. Key for medtech AI: opt-out strategy, PI threshold ('more likely than not' invalidity standard from 10x v. NanoString CoA), EPO-UPC divergence risk.</rdfs:comment>
  </mailo:InternationalTreaty>
  <mailo:LiteratureSource rdf:about="https://w3id.org/mailo#lit_Esteves_B_Rodr_guez-Doncel_V_et_al_2024_Analysis_of">
    <rdfs:label>Esteves, B., Rodríguez-Doncel, V. et al. (2024). Analysis of ontologies and policy languages to represent information flows in GDPR. Semantic Web Journal.</rdfs:label>
    <dcterms:date>2024</dcterms:date>
    <dcterms:description>Comparative table of ontology and policy languages. Positions DPV + ODRL + LegalRuleML as Pareto-front. ODRL+LegalRuleML+DPV+GDPRtEXT can model 39 of 57 informational items.</dcterms:description>
    <dcterms:source rdf:resource="https://journals.sagepub.com/doi/10.3233/SW-223009"/>
    <mailo:relevanceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</mailo:relevanceScore>
  </mailo:LiteratureSource>
  <owl:DatatypeProperty rdf:about="https://w3id.org/mailo#hasPredeterminedCriteria">
    <rdfs:label xml:lang="en">has predetermined criteria</rdfs:label>
    <rdfs:comment>True = pre-determined explainable criteria; false = self-learning black-box</rdfs:comment>
    <rdfs:comment xml:lang="en">True if the system's assessment criteria are pre-determined and not modified by self-learning without human review. Required to avoid black-box prohibition (C-817/19 P_817_002).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <mailo:CrossFrameworkTension rdf:about="https://w3id.org/mailo#Tension_EPO_GDPR_Disclosure">
    <rdfs:label xml:lang="en">EPC Art.83 Sufficiency Disclosure vs. GDPR Art.15(1)(h) + TSD Art.2 Secrecy</rdfs:label>
    <rdfs:comment xml:lang="en">&#13;
        EPC Art.83 requires public disclosure of training data structure to maintain patent validity.&#13;
        GDPR Art.15(1)(h) + C-203/22 require actionable explanations to data subjects.&#13;
        The EPO disclosure may inadvertently establish a baseline that strengthens GDPR access rights,&#13;
        eroding TSD Art.2 trade secret shields that might otherwise limit GDPR Art.15 responses.&#13;
        TSD Art.9 judicial confidentiality measures do not apply to EPO prosecution, leaving no&#13;
        mechanism to contain the disclosure baseline once it enters the public patent record.&#13;
    </rdfs:comment>
    <mailo:conflictsWith rdf:resource="https://w3id.org/mailo#DisclosureObligation"/>
    <mailo:involvesFramework rdf:resource="https://w3id.org/mailo#EPC"/>
    <mailo:involvesFramework rdf:resource="https://w3id.org/mailo#GDPR"/>
    <mailo:involvesFramework rdf:resource="https://w3id.org/mailo#TSD"/>
  </mailo:CrossFrameworkTension>
  <owl:ObjectProperty rdf:about="https://w3id.org/mailo#versionOf">
    <rdfs:comment>Version belongs to a parent regulation</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#RegulationVersion"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#EURegulation"/>
  </owl:ObjectProperty>
  <mailo:LiteratureSource rdf:about="https://w3id.org/mailo#lit_npj_Health_Systems_2026_Data-driven_medical_devices_and">
    <rdfs:label>npj Health Systems. (2026). Data-driven medical devices and the EU MDR: mapping gaps in standards for regulatory compliance.</rdfs:label>
    <dcterms:date>2026</dcterms:date>
    <dcterms:description>ISO/IEC 27001/27010 + ISO/IEC 5338, 25059, BS 30440 are insufficient for AI medical safety/transparency — exactly the gap MAILO addresses.</dcterms:description>
    <dcterms:source rdf:resource="https://www.nature.com/articles/s44401-026-00075-2"/>
    <mailo:relevanceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</mailo:relevanceScore>
  </mailo:LiteratureSource>
  <owl:ObjectProperty rdf:about="https://w3id.org/mailo#citesPrecedent">
    <rdfs:label xml:lang="en">cites precedent</rdfs:label>
    <rdfs:comment>Case relies on earlier case as precedent</rdfs:comment>
    <rdfs:comment xml:lang="en">A case relies on an earlier case as precedent.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#Case"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#Case"/>
  </owl:ObjectProperty>
  <mailo:EUDirective rdf:about="https://w3id.org/mailo#PLD">
    <rdf:type rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
    <rdfs:label xml:lang="en">PLD 2024/2853</rdfs:label>
    <eli:id_local>32024L2853</eli:id_local>
    <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-11-23</dcterms:date>
    <dcterms:identifier>2024/2853/EU</dcterms:identifier>
    <rdfs:comment xml:lang="en">Revised Product Liability Directive. AILD was withdrawn 2025-02-10; PLD 2024 is the operative EU strict-liability instrument for AI systems as 'products'.</rdfs:comment>
    <mailo:coversArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#PLD_Art10">
        <rdfs:label xml:lang="en">PLD Art.10 — Burden of proof (presumptions of defectiveness AND of causal link)</rdfs:label>
        <rdfs:comment xml:lang="en">Art.10 carries BOTH presumptions. Art.10(2): defectiveness is presumed where the defendant fails to disclose evidence, the product does not comply with mandatory safety requirements, or an obvious malfunction occurred. Art.10(4): defectiveness and/or the causal link are presumed where the claimant faces excessive difficulty owing to technical or scientific complexity and has demonstrated that the defect or the link is probable — the limb of most consequence for medical AI, expressly contemplated at recital 48. Art.10(5) preserves the defendant's right to rebut.</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:coversArticle>
    <mailo:coversArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#PLD_Art11">
        <rdfs:label xml:lang="en">PLD Art.11 — Exemption from liability</rdfs:label>
        <rdfs:comment xml:lang="en">Grounds on which an economic operator escapes liability, the burden resting on the operator: the product was not placed on the market by them, the defect probably did not exist when the product was placed on the market, or the defect is due to compliance with mandatory legal requirements. The state-of-the-art (development risk) defence sits at Art.11(1)(e), and Member States may derogate from it under Art.18(2). CORRECTED in v5.1.0: this individual previously carried the causation presumption, which is Art.10(4), not Art.11.</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:coversArticle>
    <mailo:coversArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#PLD_Art4">
        <rdfs:label xml:lang="en">PLD Art.4 — Definitions (software and AI systems as 'products')</rdfs:label>
        <rdfs:comment xml:lang="en">Art.4(1) defines 'product' to include software, expressly capturing AI systems and digital manufacturing files. SaMD under MDR may simultaneously be a 'product' under PLD. Corrected in v5.1.0 Round 5: this content was previously recorded as Art.7, which governs defectiveness.</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:coversArticle>
    <mailo:coversArticle rdf:resource="https://w3id.org/mailo#PLD_Art5"/>
    <mailo:coversArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#PLD_Art9">
        <rdfs:label xml:lang="en">PLD Art.9 — Disclosure Obligations (Evidence Facilitation)</rdfs:label>
        <rdfs:comment xml:lang="en">Courts may order defendants to disclose evidence about high-risk AI systems; creates procedural discovery mechanism absent in AILD.</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:coversArticle>
  </mailo:EUDirective>
