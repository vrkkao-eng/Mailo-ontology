  <mailo:EPOProceding rdf:about="https://w3id.org/mailo#EPO_G0001_19">
    <rdfs:label xml:lang="en">EPO G 0001/19 — Patentability of Computer-Implemented Simulations</rdfs:label>
    <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-10</dcterms:date>
    <dcterms:identifier>G 0001/19</dcterms:identifier>
    <rdfs:comment xml:lang="en">Inclusion basis (TransposedPrinciple): Computer-implemented simulation generally. MAILO applies the technical-character reasoning to clinical simulation; the Enlarged Board did not rule on medical AI.</rdfs:comment>
    <mailo:decidedBy>
      <mailo:Court rdf:about="https://w3id.org/mailo#EPO_EnlargedBoA">
        <rdfs:label xml:lang="en">EPO Enlarged Board of Appeal</rdfs:label>
        <rdfs:comment xml:lang="en">Ensures uniform application of the EPC and decides points of law referred to it. Declared in v5.1.0: it was already in use as the decidedBy value of G 1/19 but had never been typed.</rdfs:comment>
      </mailo:Court>
    </mailo:decidedBy>
    <mailo:hasInclusionBasis rdf:resource="https://w3id.org/mailo#TransposedPrinciple"/>
    <mailo:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Computer-implemented simulation of a technical process is not excluded from patentability (Art.52(2)). Technical character assessed at claim level. Foundational for AI-based clinical decision simulation systems.</mailo:hasOutcome>
    <mailo:interpretesArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#EPC_Art52">
        <rdfs:label xml:lang="en">EPC Article 52</rdfs:label>
        <rdfs:comment xml:lang="en">Patentable inventions; exclusion of mathematical methods and software as such.</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:interpretesArticle>
  </mailo:EPOProceding>
  <mailo:UPCCase rdf:about="https://w3id.org/mailo#UPC_Sanofi_Amgen">
    <rdfs:label xml:lang="en">Sanofi &amp; Regeneron v. Amgen — PCSK9 Medical Use</rdfs:label>
    <dcterms:identifier>UPC_CFI_505/2024</dcterms:identifier>
    <rdfs:comment xml:lang="en">Inclusion basis (DirectSubjectMatter): Antibody claims; biologic rather than AI, retained for claim-scope reasoning.</rdfs:comment>
    <mailo:decidedBy rdf:resource="https://w3id.org/mailo#UPC_LD_Dusseldorf"/>
    <mailo:hasInclusionBasis rdf:resource="https://w3id.org/mailo#DirectSubjectMatter"/>
    <mailo:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Düsseldorf LD: patent valid, no infringement (dual-element test established). CoA: EP'797 restored after Munich CD revocation. EPO-UPC divergence on inventive step.</mailo:hasOutcome>
    <mailo:hasStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Active — EPO BoA hearing scheduled 2026-04</mailo:hasStatus>
  </mailo:UPCCase>
  <mailo:EURegulation rdf:about="https://w3id.org/mailo#DGA">
    <rdf:type rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
    <rdfs:label xml:lang="en">DGA 2022/868</rdfs:label>
    <eli:id_local>32022R0868</eli:id_local>
    <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-05-30</dcterms:date>
    <dcterms:identifier>2022/868/EU</dcterms:identifier>
    <rdfs:comment xml:lang="en">Data Governance Act. Applies from 2023-09-24. Creates data intermediaries, data altruism organisations, and re-use frameworks for public sector health data.</rdfs:comment>
    <mailo:coversArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#DGA_Art10">
        <rdfs:label xml:lang="en">DGA Art.10 — Data Intermediation Services</rdfs:label>
        <rdfs:comment xml:lang="en">Notification requirements for data intermediaries facilitating health data exchange between data subjects and AI developers. Must be neutral — cannot use data for own purposes.</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:coversArticle>
    <mailo:coversArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#DGA_Art16">
        <rdfs:label xml:lang="en">DGA Art.16 — National arrangements for data altruism</rdfs:label>
        <rdfs:comment xml:lang="en">Member States may put in place organisational or technical arrangements to facilitate data altruism. Registration of recognised data altruism organisations, which may collect health data voluntarily shared for AI research, is governed by Arts.18-19; such entities are separate from commercial data intermediation services. Scope clarified in v5.1.0: the earlier label attributed the registration regime to Art.16.</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:coversArticle>
    <mailo:coversArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#DGA_Art29">
        <rdfs:label xml:lang="en">DGA Art.29 — European Data Innovation Board</rdfs:label>
        <rdfs:comment xml:lang="en">Expert group established by the Commission, comprising the competent authorities for data intermediation services and for data altruism registration from all Member States, the EDPB, the EDPS, ENISA and others. Its tasks are set out in Art.30. Includes guidance on interoperability between health data repositories used for AI training. Renumbered in v5.1.0: previously recorded as Art.31, which governs international access and transfer (Chapter VII).</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:coversArticle>
    <mailo:coversArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#DGA_Art3">
        <rdfs:label xml:lang="en">DGA Art.3 — Categories of protected public sector data eligible for re-use</rdfs:label>
        <rdfs:comment xml:lang="en">Opens Chapter II (Arts 3-9) by fixing the categories of protected data held by public sector bodies whose re-use the Regulation conditions, including data subject to statistical or commercial confidentiality and personal data. The substantive re-use conditions, including anonymisation and the secure processing environment, are in Art.5. Applies to AI training use cases at hospitals and research institutes. Corrected in v5.1.0 Round 5: previously recorded as Art.2, the Definitions article.</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:coversArticle>
  </mailo:EURegulation>
  <mailo:EUDirective rdf:about="https://w3id.org/mailo#PNRDirective">
    <rdf:type rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
    <rdfs:label xml:lang="en">PNR Directive 2016/681</rdfs:label>
    <dcterms:identifier>2016/681/EU</dcterms:identifier>
  </mailo:EUDirective>
  <owl:ObjectProperty rdf:about="https://w3id.org/mailo#decidedBy">
    <rdfs:label xml:lang="en">decided by</rdfs:label>
    <rdfs:comment>Case was decided by a court</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#Case"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#Court"/>
  </owl:ObjectProperty>
  <owl:Ontology rdf:about="https://w3id.org/mailo#">
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-30</dcterms:created>
    <dcterms:creator>Victor Kao</dcterms:creator>
    <dcterms:description>OWL ontology mapping EU regulatory frameworks (GDPR, AI Act, MDR, PLD, EHDS, DGA, Data Act) to medical AI automated decision-making, CJEU case law, UPC patent litigation, and compliance obligations.</dcterms:description>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-01</dcterms:modified>
    <dcterms:publisher>KU Leuven, Faculty of Engineering Science</dcterms:publisher>
    <dcterms:title>Medical AI Legal Ontology (MAILO)</dcterms:title>
    <rdfs:comment xml:lang="en">Version 5.0.2 (patch): corrected the ECLI recorded for C-203/22 (Dun &amp; Bradstreet Austria) from the erroneous ECLI:EU:C:2025:145 to the correct ECLI:EU:C:2025:117.</rdfs:comment>
    <rdfs:comment xml:lang="en">Version 5.1.0: corrective release consolidating four rounds of work, none previously deployed. (1) All nine CJEU paragraph citations were re-checked and all nine corrected; two substantive mischaracterisations were removed (the health-status exclusion is categorical under PNR Directive Art.6(4), not curable by a GDPR Art.9(2) basis; the strict-necessity test does not entail invalidity, the Court having upheld the Directive by Charter-conforming interpretation). (2) The patent, EPO and UPC instances were verified: T 1191/19 re-dated and its holding rewritten, T 0161/18 corrected to a refused application, the citesPrecedent graph repaired, litigation statuses refreshed. (3) Legislative citations were audited: all four EHDS articles carried proposal numbering and were renumbered, Art.73 was added, PLD Art.11 was corrected from the causation presumption to exemption from liability, DGA Art.31 was corrected to Art.29, and AI Act Art.50 was relabelled. (4) MAILO's boundaries were made explicit: every case now declares an InclusionBasis and every principle an EncodingBasis, separating what a court held from what the ontology designer inferred or operationalised. Correcting the hierarchy that let the boundary errors pass, AutomatedDecisionSystem is no longer a subclass of MedicalAISystem — the entailment ran backwards, making every automated decision system medical. Parts IV and V of the SHACL shapes now enforce citation integrity and boundary declaration on the graph itself, and each shape has been tested against the error it was written for.</rdfs:comment>
    <owl:priorVersion rdf:resource="https://w3id.org/mailo/5.0.2"/>
    <owl:versionIRI rdf:resource="https://w3id.org/mailo/5.1.0"/>
    <owl:versionInfo>5.1.0</owl:versionInfo>
  </owl:Ontology>
  <mailo:UPCCase rdf:about="https://w3id.org/mailo#UPC_Microsoft_Suinno">
    <rdfs:label xml:lang="en">Microsoft v. Suinno — AI Method Patent</rdfs:label>
    <dcterms:identifier>UPC_CFI_433/2024</dcterms:identifier>
    <rdfs:comment xml:lang="en">Inclusion basis (ProceduralPrecedent): EP 2 671 173 is a walking-and-browsing patent, neither medical nor AI. Retained for UPC practice only: Rule 30 RoP auxiliary requests and the representation requirement. Originally captured because the party name contains 'AI'.</rdfs:comment>
    <rdfs:comment xml:lang="en">SCOPE WARNING: EP 2 671 173 is a 'method and means for browsing by walking' - discovering web search results by physical proximity while walking. It is neither a medical nor an AI patent. The party name (Suinno Mobile &amp; AI Technologies Licensing Oy) contains 'AI', which is the likely reason this case was captured. It should not be counted as a medical-AI patent case.</rdfs:comment>
    <mailo:decidedBy>
      <mailo:UPCDivision rdf:about="https://w3id.org/mailo#UPC_CD_Paris">
        <rdfs:label xml:lang="en">UPC Central Division — Paris</rdfs:label>
      </mailo:UPCDivision>
    </mailo:decidedBy>
    <mailo:hasDefendant>
      <mailo:Company rdf:about="https://w3id.org/mailo#Microsoft">
        <rdfs:label xml:lang="en">Microsoft Corporation</rdfs:label>
      </mailo:Company>
    </mailo:hasDefendant>
    <mailo:hasInclusionBasis>
      <mailo:InclusionBasis rdf:about="https://w3id.org/mailo#ProceduralPrecedent">
        <rdfs:label xml:lang="en">Procedural precedent</rdfs:label>
        <rdfs:comment xml:lang="en">The case is relevant for procedure or forum practice rather than substance. Carries no implication about the technology at issue.</rdfs:comment>
      </mailo:InclusionBasis>
    </mailo:hasInclusionBasis>
    <mailo:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Paris Central Division, 7 January 2026: EP 2 671 173 revoked in its entirety on the counterclaim for revocation, with extensive guidance on the admissibility and presentation of auxiliary requests under Rule 30 RoP. Separately, the Court of Appeal held that Suinno was not validly represented, its managing director and main shareholder being precluded from acting as its UPC representative despite being qualified. NOTE: the ground previously recorded here as 'added matter' has not been confirmed against the decision text.</mailo:hasOutcome>
    <mailo:hasStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Revoked at first instance 2026-01-07; appealed by Suinno (verified 2026-09-01)</mailo:hasStatus>
    <mailo:involvesPatent>
      <mailo:EuropeanPatent rdf:about="https://w3id.org/mailo#EP_2671173">
        <rdfs:label xml:lang="en">EP 2 671 173</rdfs:label>
        <rdfs:comment xml:lang="en">Suinno AI-based pedestrian navigation method.</rdfs:comment>
      </mailo:EuropeanPatent>
    </mailo:involvesPatent>
  </mailo:UPCCase>
  <owl:DatatypeProperty rdf:about="https://w3id.org/mailo#doi">
    <rdfs:comment>Digital Object Identifier</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/mailo#NationalCourtCase">
    <rdfs:label>NationalCourtCase</rdfs:label>
    <rdfs:label xml:lang="en">National Court Case</rdfs:label>
    <rdfs:comment>Proceeding before a national court</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#Case"/>
  </owl:Class>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#AIAct_Art13">
    <rdfs:label xml:lang="en">AI Act Article 13</rdfs:label>
    <rdfs:comment xml:lang="en">Transparency and provision of information to deployers.</rdfs:comment>
  </mailo:LegalArticle>
  <owl:ObjectProperty rdf:about="https://w3id.org/mailo#interpretsArticle">
    <rdfs:comment>Case interprets a specific article</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#Case"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#LegalArticle"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/mailo#hasHumanOversightRecord">
    <rdfs:label xml:lang="en">has human oversight record</rdfs:label>
    <rdfs:comment>Links system to its oversight documentation</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an automated decision system to its human oversight documentation. At least one record is required (C-634/21 P_634_002).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#HumanOversightRecord"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/mailo#involvesFramework">
    <rdfs:label xml:lang="en">involves framework</rdfs:label>
    <rdfs:comment>A cross-framework tension involves a regulatory framework.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#CrossFrameworkTension"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/mailo#SoftwareAsMedicalDevice">
    <rdfs:label>SoftwareAsMedicalDevice</rdfs:label>
    <rdfs:label xml:lang="en">Software as Medical Device (SaMD)</rdfs:label>
    <rdfs:comment>Software qualifying as medical device under MDR 2017/745</rdfs:comment>
    <rdfs:comment xml:lang="en">Software qualifying as a medical device under MDR 2017/745.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://w3id.org/airo#HighRiskAISystem"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#MedicalAISystem"/>
    <mailo:hasRisk>
      <mailo:ComplianceRisk rdf:about="https://w3id.org/mailo#Risk_AIActQMS_MDR_Overlap">
        <rdfs:label xml:lang="en">AI Act Art.17 QMS / MDR Annex IX Double Burden</rdfs:label>
        <rdfs:comment xml:lang="en">AI-SaMD must comply with both AI Act QMS (Art.17) and MDR QMS (Annex IX). Without regulatory alignment, manufacturers face duplicative audit requirements.</rdfs:comment>
        <mailo:riskLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HIGH</mailo:riskLevel>
      </mailo:ComplianceRisk>
    </mailo:hasRisk>
    <mailo:hasRisk>
      <mailo:ComplianceRisk rdf:about="https://w3id.org/mailo#Risk_SEP_FRAND">
        <rdfs:label xml:lang="en">SEP/FRAND Obligations (HL7 FHIR, DICOM AI)</rdfs:label>
        <mailo:riskLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MEDIUM</mailo:riskLevel>
      </mailo:ComplianceRisk>
    </mailo:hasRisk>
  </owl:Class>
  <mailo:EURegulation rdf:about="https://w3id.org/mailo#DataAct">
    <rdf:type rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
    <rdfs:label xml:lang="en">Data Act 2023/2854</rdfs:label>
    <eli:id_local>32023R2854</eli:id_local>
    <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-12-13</dcterms:date>
    <dcterms:identifier>2023/2854/EU</dcterms:identifier>
    <rdfs:comment xml:lang="en">Data Act. Applies from 2025-09-12. Governs data sharing obligations for IoT-generated data (medical devices, wearables) and B2G/B2B data access for AI development.</rdfs:comment>
    <mailo:coversArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#DataAct_Art14">
        <rdfs:label xml:lang="en">Data Act Art.14 — Obligation to make data available on the basis of an exceptional need (B2G)</rdfs:label>
        <rdfs:comment xml:lang="en">Data holders must make data available to a public sector body, the Commission, the ECB or a Union body that demonstrates an exceptional need under Art.15. The public-emergency limb is Art.15(1)(a); the procedural requirements for the request itself are in Art.17. Applies to epidemic surveillance AI and clinical trial datasets. Corrected in v5.1.0 Round 5: previously recorded as Art.17. See the declared pending amendment on this article.</rdfs:comment>
        <mailo:hasPendingAmendment rdf:resource="https://w3id.org/mailo#DigitalOmnibus_DataAct_ChapterV"/>
      </mailo:LegalArticle>
    </mailo:coversArticle>
    <mailo:coversArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#DataAct_Art23">
        <rdfs:label xml:lang="en">Data Act Art.23 — Switching Cloud Services</rdfs:label>
        <rdfs:comment xml:lang="en">Medical AI providers using cloud infrastructure must enable switching between cloud providers without data lock-in. Relevant for hospital AI SaaS deployment models.</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:coversArticle>
    <mailo:coversArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#DataAct_Art3">
        <rdfs:label xml:lang="en">Data Act Art.3 — IoT Data Access Right</rdfs:label>
        <rdfs:comment xml:lang="en">Users of connected medical devices (wearables, implantables) have a right to access data generated by those devices, enforceable against manufacturers. Extends GDPR Art.20 portability.</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:coversArticle>
    <mailo:coversArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#DataAct_Art4">
        <rdfs:label xml:lang="en">Data Act Art.4 — User access to product data, subject to trade secret protection</rdfs:label>
        <rdfs:comment xml:lang="en">Art.4(6)-(8) limit the data-holder's access obligation where disclosure would reveal a protected trade secret, permitting withholding or refusal on a substantiated basis. The parallel limitation for third-party sharing is Art.5(9)-(11), and for B2G disclosure Art.19(2) and Art.21. Key tension with AI transparency obligations. Corrected in v5.1.0 Round 5: previously recorded as Art.15, which defines exceptional need for B2G access and says nothing about trade secrets.</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:coversArticle>
    <mailo:coversArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#DataAct_Art5">
        <rdfs:label xml:lang="en">Data Act Art.5 — Data Sharing with Third Parties</rdfs:label>
        <rdfs:comment xml:lang="en">Data holders must share IoT-generated health data with third parties at user request. Creates AI training data supply chain implications for medical device manufacturers.</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:coversArticle>
  </mailo:EURegulation>
  <owl:ObjectProperty rdf:about="https://w3id.org/mailo#hasDPIA">
    <rdfs:label xml:lang="en">has DPIA</rdfs:label>
    <rdfs:comment>Links system to its DPIA record</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a medical AI system to its DPIA record. Required for all high-risk automated processing (GDPR Art.35; C-817/19 P_817_005).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#MedicalAISystem"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#DPIARecord"/>
  </owl:ObjectProperty>
  <mailo:CrossFrameworkTension rdf:about="https://w3id.org/mailo#Tension_PLD_AIAct_LiabilityGap">
    <rdfs:label xml:lang="en">PLD Art.10 defect presumption vs. AI Act Art.9 risk management</rdfs:label>
    <rdfs:comment xml:lang="en">PLD Art.10 defect presumption applies where it is excessively difficult for the claimant to prove defect. AI Act Art.9-compliant risk management documentation may rebut the presumption but no legislative safe harbour confirms this.</rdfs:comment>
    <mailo:conflictType>
      <mailo:ConflictType rdf:about="https://w3id.org/mailo#LiabilityConflict">
        <rdfs:label xml:lang="en">Liability gap</rdfs:label>
        <rdfs:comment xml:lang="en">Compliance with one framework does not resolve, and may not even bear on, exposure under another liability regime (e.g. AI Act conformity against the revised Product Liability Directive).</rdfs:comment>
      </mailo:ConflictType>
    </mailo:conflictType>
    <mailo:hasResolutionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">partial</mailo:hasResolutionStatus>
  </mailo:CrossFrameworkTension>
  <owl:DatatypeProperty rdf:about="https://w3id.org/mailo#proposedEffect">
    <rdfs:label xml:lang="en">proposed effect</rdfs:label>
    <rdfs:comment xml:lang="en">What the proposal would do to the provision, in the drafter's own terms.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#PendingAmendment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <mailo:UPCCase rdf:about="https://w3id.org/mailo#UPC_GXD_Myriad">
    <rdfs:label xml:lang="en">GXD-Bio v. Myriad Genetics — Genomic Diagnostic AI</rdfs:label>
    <dcterms:identifier>UPC_CFI_437/2024</dcterms:identifier>
    <rdfs:comment xml:lang="en">Inclusion basis (DirectSubjectMatter): Genomic diagnostic signature patent (EndoPredict).</rdfs:comment>
    <mailo:decidedBy rdf:resource="https://w3id.org/mailo#UPC_LD_Munich"/>
    <mailo:hasDefendant>
      <mailo:Company rdf:about="https://w3id.org/mailo#MyriadGenetics">
        <rdfs:label xml:lang="en">Myriad Genetics Inc.</rdfs:label>
      </mailo:Company>
    </mailo:hasDefendant>
    <mailo:hasInclusionBasis rdf:resource="https://w3id.org/mailo#DirectSubjectMatter"/>
    <mailo:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Munich Local Division, December 2025: EP 3 346 403 revoked for added matter and the infringement claims against Myriad's EndoPredict test dismissed. First UPC biotech NPE action.</mailo:hasOutcome>
    <mailo:hasPlaintiff>
      <mailo:NPE rdf:about="https://w3id.org/mailo#GXDBio">
        <rdfs:label xml:lang="en">GXD-Bio Corporation (NPE)</rdfs:label>
      </mailo:NPE>
    </mailo:hasPlaintiff>
    <mailo:hasStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Under appeal — GXD-Bio appealed in February 2026 (verified 2026-09-01)</mailo:hasStatus>
    <mailo:involvesPatent>
      <mailo:EuropeanPatent rdf:about="https://w3id.org/mailo#EP_3346403">
        <rdfs:label xml:lang="en">EP 3 346 403</rdfs:label>
        <rdfs:comment xml:lang="en">Breast cancer recurrence prediction genomic expression test.</rdfs:comment>
      </mailo:EuropeanPatent>
    </mailo:involvesPatent>
    <mailo:involvesTechnology rdf:resource="https://w3id.org/mailo#GenomicDiagnosticAI"/>
  </mailo:UPCCase>
  <owl:DatatypeProperty rdf:about="https://w3id.org/mailo#hasStatus">
    <rdfs:label xml:lang="en">status</rdfs:label>
    <rdfs:comment>Procedural status of the case</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#Case"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/mailo#discusses">
    <rdfs:comment>Source discusses a legal principle</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#LiteratureSource"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#LegalPrinciple"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/mailo#hasPrecedenceLevel">
    <rdfs:label xml:lang="en">precedence level</rdfs:label>
    <rdfs:comment>binding_ratio | persuasive_obiter | constitutional_grand_chamber | authorial_transposition</rdfs:comment>
    <rdfs:comment xml:lang="en">binding_ratio | persuasive_obiter | constitutional_grand_chamber | authorial_transposition. The first three record how much interpretive weight a holding claims. The fourth marks a mapping the ontology designer has drawn across instruments or contexts, which is NOT a holding of the Court and must not be cited as one. This is an analytical metadata model adopted by MAILO, not a formal precedent hierarchy operated by the CJEU.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#LegalPrinciple"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/mailo#hasFormation">
    <rdfs:label xml:lang="en">court formation</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#CJEUCase"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <mailo:CrossFrameworkTension rdf:about="https://w3id.org/mailo#Tension_EPO_MDR_SemanticScope">
    <rdfs:label xml:lang="en">EPO G-II §3.3 broad claim scope vs. MDR Annex II §1.1 + AI Act Art.9/13 intended purpose</rdfs:label>
    <rdfs:comment xml:lang="en">EPO patent prosecution optimises for broad technical-effect claims (wider scope = stronger IP protection); MDR Annex II requires precise intended-purpose specification (narrower scope = easier clinical evaluation); AI Act Art.9/13 requires intermediate characterisation covering intended purpose plus reasonably foreseeable misuse. The same SaMD must be described at opposing granularity levels across three institutional knowledge spaces. No EPO, MDCG, or AI Office guidance addresses this triangular scope alignment problem.</rdfs:comment>
    <mailo:conflictType>
      <mailo:ConflictType rdf:about="https://w3id.org/mailo#SemanticGranularityConflict">
        <rdfs:label xml:lang="en">Semantic granularity conflict</rdfs:label>
        <rdfs:comment xml:lang="en">Frameworks describe the same artefact at incompatible levels of specificity, so a statement that satisfies one reads as over- or under-inclusive under another (e.g. broad EPO claim scope against narrow MDR intended purpose against intermediate AI Act foreseeable use).</rdfs:comment>
      </mailo:ConflictType>
    </mailo:conflictType>
    <mailo:hasResolutionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">unresolved</mailo:hasResolutionStatus>
  </mailo:CrossFrameworkTension>
  <mailo:Company rdf:about="https://w3id.org/mailo#Sanofi">
    <rdfs:label xml:lang="en">Sanofi S.A.</rdfs:label>
  </mailo:Company>
  <owl:ObjectProperty rdf:about="https://w3id.org/mailo#hasObligation">
    <rdfs:comment>Framework imposes an obligation</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#ComplianceObligation"/>
  </owl:ObjectProperty>
  <mailo:EPOProceding rdf:about="https://w3id.org/mailo#EPO_T1191_19">
    <rdfs:label xml:lang="en">EPO T 1191/19 — Neuronal plasticity/INSTITUT GUTTMANN: meta-learning, inventive step and training-data sufficiency</rdfs:label>
    <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-04-01</dcterms:date>
    <dcterms:identifier>T 1191/19</dcterms:identifier>
    <rdfs:comment xml:lang="en">Inclusion basis (DirectSubjectMatter): Meta-learning for personalised neurorehabilitation interventions.</rdfs:comment>
    <mailo:citesPrecedent>
      <mailo:EPOProceding rdf:about="https://w3id.org/mailo#EPO_T0161_18">
        <rdfs:label xml:lang="en">EPO T 0161/18 — AI Medical Device Disclosure</rdfs:label>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-05-12</dcterms:date>
        <dcterms:identifier>T 0161/18</dcterms:identifier>
        <rdfs:comment xml:lang="en">Inclusion basis (DirectSubjectMatter): Artificial neural network deriving cardiac output from an arterial pressure curve.</rdfs:comment>
        <mailo:decidedBy rdf:resource="https://w3id.org/mailo#EPO_BoA"/>
        <mailo:hasInclusionBasis rdf:resource="https://w3id.org/mailo#DirectSubjectMatter"/>
        <mailo:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Technical Board of Appeal 3.5.05, 12 May 2020 (Aequivalenter Aortendruck/ARC SEIBERSDORF), application 06804383.5: method of determining cardiac output from a peripheral arterial blood pressure curve using an artificial neural network. The APPLICATION WAS REFUSED (not a granted patent revoked) because the training of the network could not be reworked by the skilled person - neither suitable input data nor at least one suitable training data set was disclosed (Art.83); the claim was also held to lack inventive step for the same reason (Art.56). Leading EPO authority on training-data disclosure for AI inventions, reflected in the 2024 EPO Guidelines and followed in T 1191/19.</mailo:hasOutcome>
        <mailo:interpretesArticle rdf:resource="https://w3id.org/mailo#EPC_Art56"/>
        <mailo:interpretesArticle rdf:resource="https://w3id.org/mailo#EPC_Art83"/>
        <mailo:involvesTechnology rdf:resource="https://w3id.org/mailo#MedicalAISystem"/>
      </mailo:EPOProceding>
    </mailo:citesPrecedent>
    <mailo:decidedBy>
      <mailo:Court rdf:about="https://w3id.org/mailo#EPO_BoA">
        <rdfs:label xml:lang="en">EPO Board of Appeal</rdfs:label>
      </mailo:Court>
    </mailo:decidedBy>
    <mailo:hasInclusionBasis rdf:resource="https://w3id.org/mailo#DirectSubjectMatter"/>
    <mailo:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Technical Board of Appeal 3.5.05, application 08877672.9 (Fundacio Institut Guttmann): computer-implemented meta-learning method predicting personalised neurorehabilitation interventions. Appeal dismissed. Art.56: the mere application of a known machine learning technique to problems in a particular field is a general trend in technology (following T 161/18 point 3.6) and cannot be inventive as such. Art.83: insufficient disclosure - no example training or validation data, no minimum patient number for a meaningful prediction, and no disclosure of the artificial neural networks' topology, activation functions, end conditions or learning mechanism (following T 161/18 point 2); the Board described the disclosure as more like an invitation to a research programme. Separately, late-filed documents AX2-AX8 were not admitted under RPBA Art.12(4) - an evidential admissibility ruling, NOT a plausibility holding.</mailo:hasOutcome>
    <mailo:interpretesArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#EPC_Art56">
        <rdfs:label xml:lang="en">EPC Article 56</rdfs:label>
        <rdfs:comment xml:lang="en">Inventive step. Basis for the line of authority holding that merely applying a known machine-learning technique to a particular field follows a general technological trend and is not inventive as such (T 161/18 point 3.6; followed in T 1191/19).</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:interpretesArticle>
    <mailo:interpretesArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#EPC_Art83">
        <rdfs:label xml:lang="en">EPC Article 83</rdfs:label>
        <rdfs:comment xml:lang="en">Disclosure of the invention — sufficiency of disclosure. For AI inventions, requires disclosure of suitable training and validation data and of the neural network's topology, activation functions, end conditions and learning mechanism (T 161/18; T 1191/19).</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:interpretesArticle>
    <mailo:interpretesArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#EPC_Art84">
        <rdfs:label xml:lang="en">EPC Article 84</rdfs:label>
        <rdfs:comment xml:lang="en">Claims — clarity and support by the description.</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:interpretesArticle>
  </mailo:EPOProceding>
  <mailo:LiteratureSource rdf:about="https://w3id.org/mailo#lit_Frontiers_Digital_Health_2025_Ontologies_as_the_semantic">
    <rdfs:label>Frontiers Digital Health. (2025). Ontologies as the semantic bridge between artificial intelligence and healthcare.</rdfs:label>
    <dcterms:date>2025</dcterms:date>
    <dcterms:description>OWL2 + SWRL semantic reasoning enables auditable inference consistent with domain expertise. Ontologies encode explicit rules and traceable data relationships required by AI Act. Doctrinal scaffold for MAILO.</dcterms:description>
    <dcterms:source rdf:resource="https://www.frontiersin.org/journals/digital-health/articles/10.3389/fdgth.2025.1668385/full"/>
    <mailo:relevanceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</mailo:relevanceScore>
  </mailo:LiteratureSource>
  <mailo:LiteratureSource rdf:about="https://w3id.org/mailo#lit_EHJ_Digital_Health_Oxford_2025_Medicine_healthcare_an">
    <rdfs:label>EHJ Digital Health (Oxford). (2025). Medicine, healthcare and the AI act: gaps, challenges and future implications.</rdfs:label>
    <dcterms:date>2025</dcterms:date>
    <dcterms:description>Explicit multi-framework gap analysis. Core citation for MAILO Chapter 2.</dcterms:description>
    <dcterms:source rdf:resource="https://academic.oup.com/ehjdh/advance-article/doi/10.1093/ehjdh/ztaf041/8118685"/>
    <mailo:relevanceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</mailo:relevanceScore>
  </mailo:LiteratureSource>
  <owl:DatatypeProperty rdf:about="https://w3id.org/mailo#hasTemporalLimitation">
    <rdfs:label xml:lang="en">has temporal limitation</rdfs:label>
    <rdfs:comment>Tri-level proportionality (c): temporal limitation or review schedule</rdfs:comment>
    <rdfs:comment xml:lang="en">Tri-level proportionality test (c): temporal limitation or mandatory periodic review. C-817/19 P_817_003.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
