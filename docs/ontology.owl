    <rdfs:label xml:lang="en">precedence level</rdfs:label>
    <rdfs:comment>binding_ratio | persuasive_obiter | constitutional_grand_chamber</rdfs:comment>
    <rdfs:comment xml:lang="en">binding_ratio | persuasive_obiter | constitutional_grand_chamber</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#LegalPrinciple"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
