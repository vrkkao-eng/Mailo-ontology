  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#TSD_Art9">
    <rdfs:label xml:lang="en">TSD Article 9 — Preservation of Confidentiality in Legal Proceedings</rdfs:label>
    <rdfs:comment xml:lang="en">Courts may impose confidentiality measures to protect trade secrets during litigation. Relevant to UPC discovery proceedings where a party seeks disclosure of AI model architecture or training data as part of infringement or validity analysis.</rdfs:comment>
  </mailo:LegalArticle>
  <owl:Class rdf:about="https://w3id.org/mailo#MedicalAISystem">
    <rdfs:label>MedicalAISystem</rdfs:label>
    <rdfs:label xml:lang="en">Medical AI System</rdfs:label>
    <rdfs:comment>An AI-based system used in clinical contexts</rdfs:comment>
    <rdfs:comment xml:lang="en">An AI-based system used in clinical diagnosis, treatment recommendation, or patient risk stratification.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://w3id.org/airo#AISystem"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#Technology"/>
    <mailo:hasRisk>
      <mailo:ComplianceRisk rdf:about="https://w3id.org/mailo#Risk_BlackBox">
        <rdfs:label xml:lang="en">Black-Box ML System (C-817/19 Prohibition)</rdfs:label>
        <mailo:mitigatedBy rdf:resource="https://w3id.org/mailo#ExplainabilityObligation"/>
        <mailo:mitigatedBy rdf:resource="https://w3id.org/mailo#TransparencyObligation"/>
        <mailo:riskLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HIGH</mailo:riskLevel>
      </mailo:ComplianceRisk>
    </mailo:hasRisk>
    <mailo:hasRisk>
      <mailo:ComplianceRisk rdf:about="https://w3id.org/mailo#Risk_HealthDataDoubleLayer">
        <rdfs:label xml:lang="en">Health Data Double Protection Layer (Art.9 + Art.22(4))</rdfs:label>
        <mailo:mitigatedBy rdf:resource="https://w3id.org/mailo#DPIAObligation"/>
        <mailo:riskLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CRITICAL</mailo:riskLevel>
      </mailo:ComplianceRisk>
    </mailo:hasRisk>
    <mailo:hasRisk>
      <mailo:ComplianceRisk rdf:about="https://w3id.org/mailo#Risk_InsufficientDisclosure">
        <rdfs:label xml:lang="en">Insufficient Training Data Disclosure (EPO T0161/18)</rdfs:label>
        <mailo:mitigatedBy rdf:resource="https://w3id.org/mailo#DisclosureObligation"/>
        <mailo:riskLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HIGH</mailo:riskLevel>
      </mailo:ComplianceRisk>
    </mailo:hasRisk>
    <mailo:hasRisk>
      <mailo:ComplianceRisk rdf:about="https://w3id.org/mailo#Risk_PLDStrictLiability">
        <rdfs:label xml:lang="en">PLD 2024 Strict Liability for AI-SaMD</rdfs:label>
        <rdfs:comment xml:lang="en">Medical AI systems qualifying as 'defective products' under PLD Art.4 expose manufacturers to strict liability without fault. Presumptions in Art.10 and Art.11 shift burden to defendants.</rdfs:comment>
        <mailo:mitigatedBy rdf:resource="https://w3id.org/mailo#HumanOversightObligation"/>
        <mailo:mitigatedBy rdf:resource="https://w3id.org/mailo#TransparencyObligation"/>
        <mailo:riskLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HIGH</mailo:riskLevel>
      </mailo:ComplianceRisk>
    </mailo:hasRisk>
    <mailo:hasRisk>
      <mailo:ComplianceRisk rdf:about="https://w3id.org/mailo#Risk_SolelyTest">
        <rdfs:label xml:lang="en">GDPR Art.22 'Solely' Test Failure (Rubber-Stamping)</rdfs:label>
        <mailo:mitigatedBy rdf:resource="https://w3id.org/mailo#HumanOversightObligation"/>
        <mailo:riskLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CRITICAL</mailo:riskLevel>
      </mailo:ComplianceRisk>
    </mailo:hasRisk>
  </owl:Class>
  <mailo:EURegulation rdf:about="https://w3id.org/mailo#GDPR_2016_679">
    <rdfs:label>GDPR 2016/679</rdfs:label>
    <mailo:celex>32016R0679</mailo:celex>
