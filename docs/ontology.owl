  <mailo:ComplianceRisk rdf:about="https://w3id.org/mailo#Risk_TradeSecretTransparencyConflict">
    <rdfs:label xml:lang="en">Trade Secret Shield vs. AI Act/GDPR Transparency Mandate (TSD Art.2 Conflict)</rdfs:label>
    <rdfs:comment xml:lang="en">Medical AI operators relying on TSD Art.2 to protect model weights face: (a) mandatory AI Act Art.13 disclosure to deployers; (b) GDPR Art.15(1)(h) actionable explanation obligations to data subjects; (c) mandatory supervisory authority adjudication when TSD is claimed (C-203/22). Hybrid strategy required: patent final outputs, trade secret the AI platform, use ZKP/ZKML for auditor verification without weight disclosure.</rdfs:comment>
    <mailo:mitigatedBy rdf:resource="https://w3id.org/mailo#ExplainabilityObligation"/>
    <mailo:riskLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HIGH</mailo:riskLevel>
  </mailo:ComplianceRisk>
  <owl:Class rdf:about="https://w3id.org/mailo#SoftwareAsMedicalDevice">
    <rdfs:label>SoftwareAsMedicalDevice</rdfs:label>
    <rdfs:label xml:lang="en">Software as Medical Device (SaMD)</rdfs:label>
    <rdfs:comment>Software qualifying as medical device under MDR 2017/745</rdfs:comment>
    <rdfs:comment xml:lang="en">Software qualifying as a medical device under MDR 2017/745.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://w3id.org/airo#HighRiskAISystem"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#MedicalAISystem"/>
    <mailo:hasRisk>
      <mailo:ComplianceRisk rdf:about="https://w3id.org/mailo#Risk_AIActQMS_MDR_Overlap">
        <rdfs:label xml:lang="en">AI Act Art.17 QMS / MDR Annex IX Double Burden</rdfs:label>
        <rdfs:comment xml:lang="en">AI-SaMD must comply with both AI Act QMS (Art.17) and MDR QMS (Annex IX). Without regulatory alignment, manufacturers face duplicative audit requirements.</rdfs:comment>
        <mailo:riskLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HIGH</mailo:riskLevel>
      </mailo:ComplianceRisk>
    </mailo:hasRisk>
    <mailo:hasRisk>
      <mailo:ComplianceRisk rdf:about="https://w3id.org/mailo#Risk_SEP_FRAND">
        <rdfs:label xml:lang="en">SEP/FRAND Obligations (HL7 FHIR, DICOM AI)</rdfs:label>
        <mailo:riskLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MEDIUM</mailo:riskLevel>
      </mailo:ComplianceRisk>
    </mailo:hasRisk>
  </owl:Class>
  <mailo:UPCCase rdf:about="https://w3id.org/mailo#UPC_Microsoft_Suinno">
    <rdfs:label xml:lang="en">Microsoft v. Suinno — AI Method Patent</rdfs:label>
    <dcterms:identifier>UPC_CFI_433/2024</dcterms:identifier>
    <rdfs:comment xml:lang="en">Inclusion basis (ProceduralPrecedent): EP 2 671 173 is a walking-and-browsing patent, neither medical nor AI. Retained for UPC practice only: Rule 30 RoP auxiliary requests and the representation requirement. Originally captured because the party name contains 'AI'.</rdfs:comment>
    <rdfs:comment xml:lang="en">SCOPE WARNING: EP 2 671 173 is a 'method and means for browsing by walking' - discovering web search results by physical proximity while walking. It is neither a medical nor an AI patent. The party name (Suinno Mobile &amp; AI Technologies Licensing Oy) contains 'AI', which is the likely reason this case was captured. It should not be counted as a medical-AI patent case.</rdfs:comment>
    <mailo:decidedBy>
      <mailo:UPCDivision rdf:about="https://w3id.org/mailo#UPC_CD_Paris">
        <rdfs:label xml:lang="en">UPC Central Division — Paris</rdfs:label>
      </mailo:UPCDivision>
    </mailo:decidedBy>
    <mailo:hasDefendant>
      <mailo:Company rdf:about="https://w3id.org/mailo#Microsoft">
        <rdfs:label xml:lang="en">Microsoft Corporation</rdfs:label>
      </mailo:Company>
    </mailo:hasDefendant>
    <mailo:hasInclusionBasis>
      <mailo:InclusionBasis rdf:about="https://w3id.org/mailo#ProceduralPrecedent">
        <rdfs:label xml:lang="en">Procedural precedent</rdfs:label>
        <rdfs:comment xml:lang="en">The case is relevant for procedure or forum practice rather than substance. Carries no implication about the technology at issue.</rdfs:comment>
      </mailo:InclusionBasis>
    </mailo:hasInclusionBasis>
    <mailo:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Paris Central Division, 7 January 2026: EP 2 671 173 revoked in its entirety on the counterclaim for revocation, with extensive guidance on the admissibility and presentation of auxiliary requests under Rule 30 RoP. Separately, the Court of Appeal held that Suinno was not validly represented, its managing director and main shareholder being precluded from acting as its UPC representative despite being qualified. NOTE: the ground previously recorded here as 'added matter' has not been confirmed against the decision text.</mailo:hasOutcome>
    <mailo:hasStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Revoked at first instance 2026-01-07; appealed by Suinno (verified 2026-09-01)</mailo:hasStatus>
    <mailo:involvesPatent>
      <mailo:EuropeanPatent rdf:about="https://w3id.org/mailo#EP_2671173">
        <rdfs:label xml:lang="en">EP 2 671 173</rdfs:label>
        <rdfs:comment xml:lang="en">Suinno AI-based pedestrian navigation method.</rdfs:comment>
      </mailo:EuropeanPatent>
    </mailo:involvesPatent>
  </mailo:UPCCase>
  <owl:Ontology rdf:about="https://w3id.org/mailo">
    <dcterms:abstract xml:lang="en">MAILO (Medical AI Legal Ontology) is a machine-executable knowledge graph encoding EU regulatory obligations for medical artificial intelligence systems. It formalises eight EU legislative instruments -- the GDPR, MDR, AI Act, Product Liability Directive, EHDS, Data Governance Act, Data Act, and Trade Secrets Directive -- as OWL 2 classes and SHACL shape constraints, grounded in three CJEU judgments on automated decision-making (Ligue des droits humains, SCHUFA Holding, and Dun &amp; Bradstreet Austria). MAILO functions as a deterministic, auditable compliance-verification layer: SHACL NodeShapes validate instance data describing a medical AI system against the encoded legal constraints and produce structured, traceable conformance reports.</dcterms:abstract>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-27</dcterms:created>
    <dcterms:description xml:lang="en">&#13;
        Ontology capturing the legal landscape governing AI-driven automated&#13;
        decision-making in medical contexts. Covers CJEU precedents on GDPR&#13;
        Art.22, UPC/EPO patent litigation in MedTech, the EU AI Act high-risk&#13;
        regime, MDR 2017/745, PLD 2024/2853, EHDS 2025/327, DGA 2022/868,&#13;
        and Data Act 2023/2854 — with full precedent chains, SHACL runtime&#13;
        constraints, and compliance obligation mappings.&#13;
        Imports: W3C DPV v2.0 (data privacy vocabulary), AIRO (AI risk ontology),&#13;
        ELI (European Legislation Identifier), ECLI (European Case Law Identifier).&#13;
    </dcterms:description>
    <dcterms:language>en</dcterms:language>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-12</dcterms:modified>
    <dcterms:title xml:lang="en">Medical AI Legal Ontology (MAILO)</dcterms:title>
    <owl:imports rdf:resource="http://data.europa.eu/eli/ontology"/>
    <owl:imports rdf:resource="http://w3id.org/dpv"/>
    <owl:imports rdf:resource="https://w3id.org/airo"/>
  </owl:Ontology>
  <mailo:LiteratureSource rdf:about="https://w3id.org/mailo#lit_Medical_Law_Review_2024_A_health-conformant_reading_of_t">
    <rdfs:label>Medical Law Review. (2024). A health-conformant reading of the GDPR's right not to be subject to automated decision-making, 32(3), 373.</rdfs:label>
    <dcterms:date>2024</dcterms:date>
    <dcterms:description>Only article addressing the exact intersection of GDPR Art.22 + medical AI. Doctrinal foundation for MAILO's medical-AI ADM rules.</dcterms:description>
    <dcterms:source rdf:resource="https://academic.oup.com/medlaw/article/32/3/373/7732100"/>
    <mailo:relevanceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</mailo:relevanceScore>
  </mailo:LiteratureSource>
  <mailo:EPOProceding rdf:about="https://w3id.org/mailo#EPO_T1191_19">
    <rdfs:label xml:lang="en">EPO T 1191/19 — Neuronal plasticity/INSTITUT GUTTMANN: meta-learning, inventive step and training-data sufficiency</rdfs:label>
    <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-04-01</dcterms:date>
    <dcterms:identifier>T 1191/19</dcterms:identifier>
    <rdfs:comment xml:lang="en">Inclusion basis (DirectSubjectMatter): Meta-learning for personalised neurorehabilitation interventions.</rdfs:comment>
    <mailo:citesPrecedent>
      <mailo:EPOProceding rdf:about="https://w3id.org/mailo#EPO_T0161_18">
        <rdfs:label xml:lang="en">EPO T 0161/18 — AI Medical Device Disclosure</rdfs:label>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-05-12</dcterms:date>
        <dcterms:identifier>T 0161/18</dcterms:identifier>
        <rdfs:comment xml:lang="en">Inclusion basis (DirectSubjectMatter): Artificial neural network deriving cardiac output from an arterial pressure curve.</rdfs:comment>
        <mailo:decidedBy rdf:resource="https://w3id.org/mailo#EPO_BoA"/>
        <mailo:hasInclusionBasis rdf:resource="https://w3id.org/mailo#DirectSubjectMatter"/>
        <mailo:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Technical Board of Appeal 3.5.05, 12 May 2020 (Aequivalenter Aortendruck/ARC SEIBERSDORF), application 06804383.5: method of determining cardiac output from a peripheral arterial blood pressure curve using an artificial neural network. The APPLICATION WAS REFUSED (not a granted patent revoked) because the training of the network could not be reworked by the skilled person - neither suitable input data nor at least one suitable training data set was disclosed (Art.83); the claim was also held to lack inventive step for the same reason (Art.56). Leading EPO authority on training-data disclosure for AI inventions, reflected in the 2024 EPO Guidelines and followed in T 1191/19.</mailo:hasOutcome>
        <mailo:interpretesArticle rdf:resource="https://w3id.org/mailo#EPC_Art56"/>
        <mailo:interpretesArticle rdf:resource="https://w3id.org/mailo#EPC_Art83"/>
        <mailo:involvesTechnology rdf:resource="https://w3id.org/mailo#MedicalAISystem"/>
      </mailo:EPOProceding>
    </mailo:citesPrecedent>
    <mailo:decidedBy>
      <mailo:Court rdf:about="https://w3id.org/mailo#EPO_BoA">
        <rdfs:label xml:lang="en">EPO Board of Appeal</rdfs:label>
      </mailo:Court>
    </mailo:decidedBy>
    <mailo:hasInclusionBasis rdf:resource="https://w3id.org/mailo#DirectSubjectMatter"/>
    <mailo:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Technical Board of Appeal 3.5.05, application 08877672.9 (Fundacio Institut Guttmann): computer-implemented meta-learning method predicting personalised neurorehabilitation interventions. Appeal dismissed. Art.56: the mere application of a known machine learning technique to problems in a particular field is a general trend in technology (following T 161/18 point 3.6) and cannot be inventive as such. Art.83: insufficient disclosure - no example training or validation data, no minimum patient number for a meaningful prediction, and no disclosure of the artificial neural networks' topology, activation functions, end conditions or learning mechanism (following T 161/18 point 2); the Board described the disclosure as more like an invitation to a research programme. Separately, late-filed documents AX2-AX8 were not admitted under RPBA Art.12(4) - an evidential admissibility ruling, NOT a plausibility holding.</mailo:hasOutcome>
    <mailo:interpretesArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#EPC_Art56">
        <rdfs:label xml:lang="en">EPC Article 56</rdfs:label>
        <rdfs:comment xml:lang="en">Inventive step. Basis for the line of authority holding that merely applying a known machine-learning technique to a particular field follows a general technological trend and is not inventive as such (T 161/18 point 3.6; followed in T 1191/19).</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:interpretesArticle>
    <mailo:interpretesArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#EPC_Art83">
        <rdfs:label xml:lang="en">EPC Article 83</rdfs:label>
        <rdfs:comment xml:lang="en">Disclosure of the invention — sufficiency of disclosure. For AI inventions, requires disclosure of suitable training and validation data and of the neural network's topology, activation functions, end conditions and learning mechanism (T 161/18; T 1191/19).</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:interpretesArticle>
    <mailo:interpretesArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#EPC_Art84">
        <rdfs:label xml:lang="en">EPC Article 84</rdfs:label>
        <rdfs:comment xml:lang="en">Claims — clarity and support by the description.</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:interpretesArticle>
  </mailo:EPOProceding>
  <mailo:LiteratureSource rdf:about="https://w3id.org/mailo#lit_Golpayegani_D_Pandit_H_J_Lewis_D_2022_2025_AIRO">
    <rdfs:label>Golpayegani, D., Pandit, H. J., Lewis, D. (2022, 2025). AIRO: An Ontology for Representing AI Risks Based on the Proposed EU AI Act. SEMANTiCS + arXiv:2501.10391.</rdfs:label>
    <dcterms:date>2025</dcterms:date>
    <dcterms:description>OWL ontology + SHACL shapes implementing AI Act Annex III high-risk classifier + SPARQL ASK queries; integrated into W3C DPVCG. Most direct competitor to MAILO. AIRO already does for the AI Act what MAILO proposes for the medical-AI multi-framework intersection. Differentiator: MAILO adds medical-domain specificity, MDR+PLD integration, CJEU precedent chain, UPC patent overlay.</dcterms:description>
    <dcterms:source rdf:resource="https://delaramglp.github.io/airo/"/>
    <mailo:relevanceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</mailo:relevanceScore>
  </mailo:LiteratureSource>
  <owl:DatatypeProperty rdf:about="https://w3id.org/mailo#hasFormation">
    <rdfs:label xml:lang="en">court formation</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#CJEUCase"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <mailo:LiteratureSource rdf:about="https://w3id.org/mailo#lit_Conflict-tolerant_Deontic_Traditional_Scheme_for_the_Semanti">
    <rdfs:label>Conflict-tolerant Deontic Traditional Scheme for the Semantic Web. (2025). Journal of Logic and Computation 35(8), Oxford.</rdfs:label>
    <dcterms:date>2025</dcterms:date>
    <dcterms:description>Addresses cross-framework normative conflict resolution that MAILO will face (e.g. GDPR Art.22 vs AI Act Art.86). Provides RDF-based conflict-tolerant deontic logic.</dcterms:description>
    <dcterms:source rdf:resource="https://academic.oup.com/logcom/article/35/8/exaf054/8320660"/>
    <mailo:relevanceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</mailo:relevanceScore>
  </mailo:LiteratureSource>
  <owl:ObjectProperty rdf:about="https://w3id.org/mailo#appliesToRoute">
    <rdfs:label xml:lang="en">applies to route</rdfs:label>
    <rdfs:comment xml:lang="en">Restricts a provision to systems that became high-risk by a particular route. Art.86 is so restricted; most other high-risk obligations are not.</rdfs:comment>
  </owl:ObjectProperty>
  <mailo:CrossFrameworkTension rdf:about="https://w3id.org/mailo#Tension_PLD_AIAct_LiabilityGap">
    <rdfs:label xml:lang="en">PLD Art.10(4) defect and causation presumption vs. AI Act Art.9 risk management</rdfs:label>
    <rdfs:comment xml:lang="en">PLD Art.10(4) presumes defectiveness and/or the causal link where the claimant faces excessive difficulty owing to technical or scientific complexity and has demonstrated that the defect or link is probable; Art.10(5) preserves the defendant's right to rebut. AI Act Art.9-compliant risk-management documentation may serve to rebut, but no legislative safe harbour confirms this. CORRECTED in v5.1.0: the presumption was previously attributed to Art.11, which is exemption from liability.</rdfs:comment>
    <mailo:conflictType>
      <mailo:ConflictType rdf:about="https://w3id.org/mailo#LiabilityConflict">
        <rdfs:label xml:lang="en">Liability gap</rdfs:label>
        <rdfs:comment xml:lang="en">Compliance with one framework does not resolve, and may not even bear on, exposure under another liability regime (e.g. AI Act conformity against the revised Product Liability Directive).</rdfs:comment>
      </mailo:ConflictType>
    </mailo:conflictType>
    <mailo:hasResolutionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">partial</mailo:hasResolutionStatus>
    <mailo:involvesFramework rdf:resource="https://w3id.org/mailo#AIAct"/>
    <mailo:involvesFramework>
      <mailo:EUDirective rdf:about="https://w3id.org/mailo#PLD">
        <rdf:type rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
        <rdfs:label xml:lang="en">PLD 2024/2853</rdfs:label>
        <eli:id_local>32024L2853</eli:id_local>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-11-23</dcterms:date>
        <dcterms:identifier>2024/2853/EU</dcterms:identifier>
        <rdfs:comment xml:lang="en">Revised Product Liability Directive. AILD was withdrawn 2025-02-10; PLD 2024 is the operative EU strict-liability instrument for AI systems as 'products'.</rdfs:comment>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#PLD_Art10"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#PLD_Art11"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#PLD_Art4"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#PLD_Art5"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#PLD_Art6"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#PLD_Art7"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#PLD_Art9"/>
      </mailo:EUDirective>
    </mailo:involvesFramework>
  </mailo:CrossFrameworkTension>
  <owl:ObjectProperty rdf:about="https://w3id.org/mailo#involvesTechnology">
    <rdfs:label xml:lang="en">involves technology</rdfs:label>
    <rdfs:comment>Case involves a technology class</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#Case"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#Technology"/>
  </owl:ObjectProperty>
  <mailo:CrossFrameworkTension rdf:about="https://w3id.org/mailo#Tension_EPO_GDPR_Disclosure">
    <rdfs:label xml:lang="en">EPC Art.83 Sufficiency Disclosure vs. GDPR Art.15(1)(h) + TSD Art.2 Secrecy</rdfs:label>
    <rdfs:comment xml:lang="en">&#13;
        EPC Art.83 requires public disclosure of training data structure to maintain patent validity.&#13;
        GDPR Art.15(1)(h) + C-203/22 require actionable explanations to data subjects.&#13;
        The EPO disclosure may inadvertently establish a baseline that strengthens GDPR access rights,&#13;
        eroding TSD Art.2 trade secret shields that might otherwise limit GDPR Art.15 responses.&#13;
        TSD Art.9 judicial confidentiality measures do not apply to EPO prosecution, leaving no&#13;
        mechanism to contain the disclosure baseline once it enters the public patent record.&#13;
    </rdfs:comment>
    <rdfs:comment xml:lang="en">Re-anchored in v5.1.0 to TSD Art.1(2)(b), which preserves rules requiring disclosure of trade secrets to administrative or judicial authorities. The Art.5 exceptions previously relied on concern freedom of expression and whistleblowing, not data-subject or regulatory disclosure.</rdfs:comment>
    <mailo:conflictType>
      <mailo:ConflictType rdf:about="https://w3id.org/mailo#TradeSecretConflict">
        <rdfs:label xml:lang="en">Trade secret against transparency</rdfs:label>
        <rdfs:comment xml:lang="en">A disclosure duty under one framework collides with a legitimate secrecy interest protected by another (TSD Art.2 against AI Act Art.13 and GDPR Art.15(1)(h)).</rdfs:comment>
      </mailo:ConflictType>
    </mailo:conflictType>
    <mailo:conflictsWith rdf:resource="https://w3id.org/mailo#DisclosureObligation"/>
    <mailo:hasResolutionStatus>unresolved</mailo:hasResolutionStatus>
    <mailo:involvesArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#TSD_Art1_2">
        <rdfs:label xml:lang="en">TSD Art.1(2) — Matters the Directive does not affect</rdfs:label>
        <rdfs:comment xml:lang="en">The Directive shall not affect: (a) the exercise of the right to freedom of expression and information as set out in the Charter, including media freedom and pluralism; (b) THE APPLICATION OF UNION OR NATIONAL RULES REQUIRING TRADE SECRET HOLDERS TO DISCLOSE, FOR REASONS OF PUBLIC INTEREST, INFORMATION INCLUDING TRADE SECRETS, TO THE PUBLIC OR TO ADMINISTRATIVE OR JUDICIAL AUTHORITIES FOR THE PERFORMANCE OF THE DUTIES OF THOSE AUTHORITIES; (c) the application of rules requiring or allowing Union institutions and bodies or national public authorities to disclose information submitted by businesses; (d) the autonomy of social partners.

Art.1(2)(b) is the correct doctrinal anchor for the transparency-secrecy interface and had been absent from MAILO, its function having been wrongly attributed to Art.5. It maps directly onto the structure the CJEU adopted in C-203/22 — disclosure to a supervisory authority or court, which then balances — and onto EHDS Art.52, where protected elements are disclosed into an HDAB-controlled environment rather than to the requester. Note the limit it also implies: Art.1(2)(b) preserves disclosure duties owed to authorities and, where the rule so provides, to the public. It does not by itself create a disclosure duty owed to an individual. Added in v5.1.0.</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:involvesArticle>
    <mailo:involvesFramework rdf:resource="https://w3id.org/mailo#EPC"/>
    <mailo:involvesFramework>
      <mailo:EURegulation rdf:about="https://w3id.org/mailo#GDPR">
        <rdf:type rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
        <rdfs:label xml:lang="en">GDPR 2016/679</rdfs:label>
        <eli:id_local>32016R0679</eli:id_local>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2016-04-27</dcterms:date>
        <dcterms:identifier>2016/679/EU</dcterms:identifier>
        <rdfs:comment xml:lang="en">General Data Protection Regulation. Core data protection framework; Art.22 governs solely automated decision-making, Art.15/15(1)(h) the right of access and meaningful information, Art.9 special category health data, Art.35 DPIA obligation.</rdfs:comment>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#GDPR_Art12_5"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#GDPR_Art15"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#GDPR_Art15_1h"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#GDPR_Art15_3"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#GDPR_Art22"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#GDPR_Art22_1"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#GDPR_Art22_2"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#GDPR_Art22_3"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#GDPR_Art22_4"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#GDPR_Art23"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#GDPR_Art35"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#GDPR_Art9"/>
      </mailo:EURegulation>
    </mailo:involvesFramework>
    <mailo:involvesFramework>
      <mailo:EUDirective rdf:about="https://w3id.org/mailo#TSD">
        <rdf:type rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
        <rdfs:label xml:lang="en">Trade Secrets Directive 2016/943</rdfs:label>
        <eli:id_local>32016L0943</eli:id_local>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2016-06-08</dcterms:date>
        <dcterms:identifier>2016/943/EU</dcterms:identifier>
        <rdfs:comment xml:lang="en">EU Trade Secrets Directive. Harmonises civil-law protection of undisclosed know-how and business information. Key for medical AI: model weights, training data schemas, and proprietary algorithms qualify as trade secrets under the Art.2 three-part test. Art.5 carve-outs limit the secrecy shield when exercise of the right to information is at stake — directly engaged by GDPR Art.15(1)(h) and AI Act Art.13 transparency obligations.</rdfs:comment>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#TSD_Art1_2"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#TSD_Art2"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#TSD_Art3"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#TSD_Art5"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#TSD_Art9"/>
      </mailo:EUDirective>
    </mailo:involvesFramework>
  </mailo:CrossFrameworkTension>
  <owl:DatatypeProperty rdf:about="https://w3id.org/mailo#hasResolutionStatus">
    <rdfs:label xml:lang="en">has resolution status</rdfs:label>
    <rdfs:comment xml:lang="en">Records whether the tension between two frameworks has been resolved by legislation, case law or authoritative guidance. Values in use: 'unresolved' (no authority addresses the conflict), 'partial' (addressed in part, or addressed for an analogous but not identical situation), and 'procedural_only' (an authority routes the conflict to a forum without fixing a substantive outcome, as in C-203/22). This records the state of the law, not the ontology designer's confidence. Declared in v5.1.0 Round 5: the property was in use on tension instances but had never been typed or defined, so its value set was undocumented and unqueryable.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#CrossFrameworkTension"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/mailo#triggersRoute">
    <rdfs:label xml:lang="en">triggers high-risk route</rdfs:label>
    <rdfs:comment xml:lang="en">Links a classification rule to the AI Act high-risk route it produces. MDR Annex VIII Rule 11 places most diagnostic and decision-support software at Class IIa or above, requiring notified-body assessment, which satisfies AI Act Art.6(1) and puts the system on the Annex I route — with the consequence that the Art.86 right to explanation does not apply. Encoded in v5.1.0 so the chain is queryable rather than only described in prose.</rdfs:comment>
  </owl:ObjectProperty>
  <mailo:LiteratureSource rdf:about="https://w3id.org/mailo#lit_MDCG_2025-6_2025_European_Commission_Joint_Guidance_on_M">
    <rdfs:label>MDCG 2025-6. (2025). European Commission Joint Guidance on MDR/IVDR × AI Act.</rdfs:label>
    <dcterms:date>2025</dcterms:date>
    <dcterms:description>Official EU-level mapping document. MAILO instances must align with it.</dcterms:description>
    <dcterms:source rdf:resource="https://health.ec.europa.eu/document/download/b78a17d7-e3cd-4943-851d-e02a2f22bbb4_en"/>
    <mailo:relevanceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</mailo:relevanceScore>
  </mailo:LiteratureSource>
  <mailo:UPCCase rdf:about="https://w3id.org/mailo#UPC_Hologic_Siemens">
    <rdfs:label xml:lang="en">Hologic v. Siemens Healthineers — Medical Imaging AI</rdfs:label>
    <dcterms:identifier>UPC_CFI_758/2024</dcterms:identifier>
    <rdfs:comment xml:lang="en">Inclusion basis (DomainContext): Mammography X-ray tube hardware, with no AI element in the asserted claim. Retained only for the EPO/MDR semantic-scope tension, where the point is precisely that patent claim scope and MDR intended purpose describe the same device at different granularities.</rdfs:comment>
    <rdfs:comment xml:lang="en">SCOPE WARNING: this is medical imaging HARDWARE (X-ray tube focal spot control), not medical imaging AI. The asserted claim contains no AI or machine-learning element. Retained for the EPO/MDR/AI Act semantic-scope tension analysis, but it should not be counted as a medical-AI patent case.</rdfs:comment>
    <mailo:decidedBy>
      <mailo:UPCDivision rdf:about="https://w3id.org/mailo#UPC_LD_Dusseldorf">
        <rdfs:label xml:lang="en">UPC Local Division — Düsseldorf</rdfs:label>
      </mailo:UPCDivision>
    </mailo:decidedBy>
    <mailo:hasDefendant>
      <mailo:Company rdf:about="https://w3id.org/mailo#SiemensHealthineers">
        <rdfs:label xml:lang="en">Siemens Healthineers AG</rdfs:label>
      </mailo:Company>
    </mailo:hasDefendant>
    <mailo:hasInclusionBasis rdf:resource="https://w3id.org/mailo#DomainContext"/>
    <mailo:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dusseldorf Local Division, decision of 10 June 2026 (with counterclaim UPC_CFI_259/2025): permanent injunction granted to Hologic in three member states, with recall and destruction orders against several Siemens Healthineers entities. The patent concerns the 'Flying Focal Spot' X-ray tube feature of the MAMMOMAT B.brilliant mammography system. NOTE: the item previously recorded here as a decision of 2026-03-09 was a procedural order on the further exchange of written pleadings, not the judgment.</mailo:hasOutcome>
    <mailo:hasPlaintiff>
      <mailo:Company rdf:about="https://w3id.org/mailo#Hologic">
        <rdfs:label xml:lang="en">Hologic Inc.</rdfs:label>
      </mailo:Company>
    </mailo:hasPlaintiff>
    <mailo:hasStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Decided at first instance 2026-06-10 (verified 2026-09-01)</mailo:hasStatus>
    <mailo:involvesPatent>
      <mailo:EuropeanPatent rdf:about="https://w3id.org/mailo#EP_2352431">
        <rdfs:label xml:lang="en">EP 2 352 431 B1</rdfs:label>
        <rdfs:comment xml:lang="en">Hologic breast imaging AI-assisted reading technology.</rdfs:comment>
      </mailo:EuropeanPatent>
    </mailo:involvesPatent>
  </mailo:UPCCase>
  <owl:ObjectProperty rdf:about="https://w3id.org/mailo#enforcedBy">
    <rdfs:comment>Framework enforced by authority</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#RegulatoryAuthority"/>
  </owl:ObjectProperty>
  <mailo:CrossFrameworkTension rdf:about="https://w3id.org/mailo#Tension_DataAct_TradeSecret_AITransparency">
    <rdfs:label xml:lang="en">Data Act Arts.4(6)-(8) / 5(9)-(11) trade secret vs. AI Act Art.13 + GDPR Art.15(1)(h) transparency</rdfs:label>
    <rdfs:comment xml:lang="en">Article links added in v5.1.0: DataAct Art.4(6)-(8) and Art.5(9)-(11) for the trade-secret limb, AI Act Art.13 and GDPR Art.15(1)(h) for the transparency limb. Note the asymmetry now visible in the graph: Art.13's addressee is the deployer, not the affected person, and Art.86's right to explanation does not reach medical devices on the Annex I route, so on the transparency side only GDPR Art.15(1)(h) actually runs to the individual.</rdfs:comment>
    <rdfs:comment xml:lang="en">C-203/22 Dun &amp; Bradstreet §§59-62 limits the trade-secret defence: a controller cannot refuse all explanation on trade-secret grounds, and must describe the procedure and principles actually applied so the data subject understands which personal data were used and in what way. The precise boundary between permitted limitation and impermissible derogation is determined case by case, before a supervisory authority or court. NOTE: the Data Act limb of this tension was previously anchored to Art.15; the trade-secret safeguards are at Arts.4(6)-(8) and 5(9)-(11).</rdfs:comment>
    <rdfs:comment xml:lang="en">Re-anchored in v5.1.0 to TSD Art.1(2)(b), which preserves rules requiring disclosure of trade secrets to administrative or judicial authorities. The Art.5 exceptions previously relied on concern freedom of expression and whistleblowing, not data-subject or regulatory disclosure.</rdfs:comment>
    <mailo:conflictType rdf:resource="https://w3id.org/mailo#TradeSecretConflict"/>
    <mailo:hasResolutionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">partial</mailo:hasResolutionStatus>
    <mailo:involvesArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#AIAct_Art13">
        <rdfs:label xml:lang="en">AI Act Art.13 — Transparency and provision of information TO DEPLOYERS</rdfs:label>
        <rdfs:comment xml:lang="en">Art.13(1): high-risk AI systems shall be designed and developed so that their operation is sufficiently transparent to enable DEPLOYERS to interpret the output and use it appropriately. Art.13(2)-(3): instructions for use must accompany the system, specifying provider identity, characteristics, capabilities and limitations of performance including accuracy, robustness and cybersecurity metrics, known foreseeable risks, human oversight measures and expected lifetime.

SCOPE NOTE added in v5.1.0: the addressee is the DEPLOYER, not the affected person. Art.13 confers nothing on a patient or data subject. This is the pivot of the trade-secret debate — a provider may satisfy Art.13 in full while an affected individual receives nothing, which is why the explanation route for individuals runs through GDPR Art.15(1)(h) and Art.22, and, in the health domain, through EHDS Art.52's controlled-access mechanism. The earlier one-line comment did not record the addressee distinction on which that argument depends.</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:involvesArticle>
    <mailo:involvesArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#DataAct_Art4">
        <rdfs:label xml:lang="en">Data Act Art.4 — Rights and obligations of users and data holders regarding access and use</rdfs:label>
        <rdfs:comment xml:lang="en">Art.4(1): where data is not directly accessible from the connected product, data holders shall make readily available data, and the relevant metadata, available to the user without undue delay, in the same quality as it is available to the data holder, easily, securely, free of charge and in a machine-readable format. Art.4(4): data holders shall not unreasonably impede the user's choices or rights through the structure, design, function or operation of a digital user interface.

Art.4(6)-(8) carry the trade-secret safeguards: trade secrets are disclosed to the user only where the holder and user agree the measures necessary to preserve confidentiality; the holder may withhold or suspend sharing where it demonstrates that it is highly likely to suffer serious economic damage, with notification to the competent authority. This is the Data Act limb of MAILO's trade-secret-against-transparency tension, and it is a qualified withholding right rather than a veto. Scope broadened in v5.1.0: the entry previously covered only paragraphs (6)-(8).</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:involvesArticle>
    <mailo:involvesArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#DataAct_Art5">
        <rdfs:label xml:lang="en">Data Act Art.5 — Data Sharing with Third Parties</rdfs:label>
        <rdfs:comment xml:lang="en">Data holders must share IoT-generated health data with third parties at user request. Creates AI training data supply chain implications for medical device manufacturers.</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:involvesArticle>
    <mailo:involvesArticle rdf:resource="https://w3id.org/mailo#GDPR_Art15_1h"/>
    <mailo:involvesArticle rdf:resource="https://w3id.org/mailo#TSD_Art1_2"/>
    <mailo:involvesFramework rdf:resource="https://w3id.org/mailo#AIAct"/>
    <mailo:involvesFramework>
      <mailo:EURegulation rdf:about="https://w3id.org/mailo#DataAct">
        <rdf:type rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
        <rdfs:label xml:lang="en">Data Act 2023/2854</rdfs:label>
        <eli:id_local>32023R2854</eli:id_local>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-12-13</dcterms:date>
        <dcterms:identifier>2023/2854/EU</dcterms:identifier>
        <rdfs:comment xml:lang="en">Data Act. Applies from 2025-09-12. Governs data sharing obligations for IoT-generated data (medical devices, wearables) and B2G/B2B data access for AI development.</rdfs:comment>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#DataAct_Art14"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#DataAct_Art15"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#DataAct_Art17"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#DataAct_Art21"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#DataAct_Art23"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#DataAct_Art3"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#DataAct_Art4"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#DataAct_Art5"/>
      </mailo:EURegulation>
    </mailo:involvesFramework>
    <mailo:involvesFramework rdf:resource="https://w3id.org/mailo#GDPR"/>
  </mailo:CrossFrameworkTension>
