<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:mailo="https://w3id.org/mailo#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:eli="http://data.europa.eu/eli/ontology#"
>
  <owl:DatatypeProperty rdf:about="https://w3id.org/mailo#identifiesInputFactors">
    <rdfs:label xml:lang="en">identifies input factors</rdfs:label>
    <rdfs:comment>Explanation identifies which inputs affected the output</rdfs:comment>
    <rdfs:comment xml:lang="en">True if the explanation identifies which specific input data affected the automated output and the main reasoning path (C-203/22 P_203_001; GDPR Art.15(1)(h)).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#Explanation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <mailo:LiteratureSource rdf:about="https://w3id.org/mailo#lit_Robaldo_L_Bartolini_C_Palmirani_M_et_al_2020_Fo">
    <rdfs:label>Robaldo, L., Bartolini, C., Palmirani, M., et al. (2020). Formalizing GDPR Provisions in Reified I/O Logic: The DAPRECO Knowledge Base. Journal of Logic, Language and Information.</rdfs:label>
    <dcterms:date>2020</dcterms:date>
    <dcterms:description>LegalRuleML + reified Input/Output logic + SPINDle defeasible reasoner. The canonical precedent for formal GDPR reasoning. Limitations addressed by MAILO: GDPR-only; no medical AI integration; no CJEU case-law layer; no runtime guardrail integration.</dcterms:description>
    <dcterms:source rdf:resource="https://link.springer.com/article/10.1007/s10849-019-09309-z"/>
    <mailo:relevanceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</mailo:relevanceScore>
  </mailo:LiteratureSource>
  <mailo:CJEUCase rdf:about="https://w3id.org/mailo#C_311_18">
    <rdfs:label xml:lang="en">C-311/18 Schrems II</rdfs:label>
    <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-07-16</dcterms:date>
    <dcterms:identifier>C-311/18</dcterms:identifier>
    <rdfs:comment xml:lang="en">Inclusion basis (DomainContext): Schrems II. Background for cross-border health data transfer under EHDS.</rdfs:comment>
    <mailo:hasInclusionBasis>
      <mailo:InclusionBasis rdf:about="https://w3id.org/mailo#DomainContext">
        <rdfs:label xml:lang="en">Domain context</rdfs:label>
        <rdfs:comment xml:lang="en">Retained as background for a cross-framework tension rather than for any principle it establishes.</rdfs:comment>
      </mailo:InclusionBasis>
    </mailo:hasInclusionBasis>
    <mailo:hasStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Final</mailo:hasStatus>
  </mailo:CJEUCase>
  <mailo:CrossFrameworkTension rdf:about="https://w3id.org/mailo#Tension_PLD_AIAct_Liability">
    <rdfs:label xml:lang="en">PLD Strict Liability vs. AI Act Conformity Defence</rdfs:label>
    <rdfs:comment xml:lang="en">&#13;
        PLD Art.5 imposes strict liability; AI Act conformity assessment is not a&#13;
        defence to PLD claims. A CE-marked AI-SaMD that passes AI Act conformity&#13;
        assessment may still be 'defective' under PLD if it fails in real-world&#13;
        deployment. The two regimes do not create a safety harbour from each other.&#13;
    </rdfs:comment>
    <mailo:conflictsWith>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#PLD_Art5">
        <rdfs:label xml:lang="en">PLD Art.5 — Right to compensation (strict liability)</rdfs:label>
        <rdfs:comment xml:lang="en">Any natural person suffering damage caused by a defective product is entitled to compensation, without proof of fault. The economic operators against whom that right is exercised are listed in Art.8. Corrected in v5.1.0 Round 5: this content was previously recorded as Art.4, which is the Definitions article closing Chapter I.</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:conflictsWith>
  </mailo:CrossFrameworkTension>
  <owl:ObjectProperty rdf:about="https://w3id.org/mailo#hasConformityRecord">
    <rdfs:label xml:lang="en">has conformity record</rdfs:label>
    <rdfs:comment>Links system to its conformity record</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#MedicalAISystem"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#ConformityRecord"/>
  </owl:ObjectProperty>
  <mailo:LiteratureSource rdf:about="https://w3id.org/mailo#lit_Golpayegani_D_Pandit_H_J_Lewis_D_2022_2025_AIRO">
    <rdfs:label>Golpayegani, D., Pandit, H. J., Lewis, D. (2022, 2025). AIRO: An Ontology for Representing AI Risks Based on the Proposed EU AI Act. SEMANTiCS + arXiv:2501.10391.</rdfs:label>
    <dcterms:date>2025</dcterms:date>
    <dcterms:description>OWL ontology + SHACL shapes implementing AI Act Annex III high-risk classifier + SPARQL ASK queries; integrated into W3C DPVCG. Most direct competitor to MAILO. AIRO already does for the AI Act what MAILO proposes for the medical-AI multi-framework intersection. Differentiator: MAILO adds medical-domain specificity, MDR+PLD integration, CJEU precedent chain, UPC patent overlay.</dcterms:description>
    <dcterms:source rdf:resource="https://delaramglp.github.io/airo/"/>
    <mailo:relevanceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</mailo:relevanceScore>
  </mailo:LiteratureSource>
  <mailo:UPCCase rdf:about="https://w3id.org/mailo#UPC_Dexcom_Abbott">
    <rdfs:label xml:lang="en">Dexcom v. Abbott — Continuous Glucose Monitoring</rdfs:label>
    <dcterms:identifier>ACT_583778/2023</dcterms:identifier>
    <rdfs:comment xml:lang="en">Inclusion basis (DirectSubjectMatter): Continuous glucose monitoring with algorithmic estimation.</rdfs:comment>
    <mailo:decidedBy>
      <mailo:UPCDivision rdf:about="https://w3id.org/mailo#UPC_LD_Munich">
        <rdfs:label xml:lang="en">UPC Local Division — Munich</rdfs:label>
      </mailo:UPCDivision>
    </mailo:decidedBy>
    <mailo:decidedBy>
      <mailo:UPCDivision rdf:about="https://w3id.org/mailo#UPC_LD_Paris">
        <rdfs:label xml:lang="en">UPC Local Division — Paris</rdfs:label>
      </mailo:UPCDivision>
    </mailo:decidedBy>
    <mailo:hasDefendant>
      <mailo:Company rdf:about="https://w3id.org/mailo#Abbott">
        <rdfs:label xml:lang="en">Abbott Laboratories</rdfs:label>
      </mailo:Company>
    </mailo:hasDefendant>
    <mailo:hasInclusionBasis>
      <mailo:InclusionBasis rdf:about="https://w3id.org/mailo#DirectSubjectMatter">
        <rdfs:label xml:lang="en">Direct subject matter</rdfs:label>
        <rdfs:comment xml:lang="en">The case is itself about a medical AI or medical software system. Only such cases may carry a medical-AI value for mailo:involvesTechnology.</rdfs:comment>
      </mailo:InclusionBasis>
    </mailo:hasInclusionBasis>
    <mailo:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Paris LD revoked EP 3435866 and EP 3831282 (EPO had maintained validity — divergence). Case settled Dec 2024.</mailo:hasOutcome>
    <mailo:hasPlaintiff>
      <mailo:Company rdf:about="https://w3id.org/mailo#Dexcom">
        <rdfs:label xml:lang="en">Dexcom Inc.</rdfs:label>
      </mailo:Company>
    </mailo:hasPlaintiff>
    <mailo:hasStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Settled 2024-12-20</mailo:hasStatus>
    <mailo:involvesTechnology rdf:resource="https://w3id.org/mailo#RiskScoringSystem"/>
  </mailo:UPCCase>
  <mailo:CrossFrameworkTension rdf:about="https://w3id.org/mailo#Tension_MDR_AIAct_DualTrack">
    <rdfs:label xml:lang="en">MDR Annex IX conformity vs. AI Act Art.43 conformity assessment</rdfs:label>
    <rdfs:comment xml:lang="en">Two separate conformity assessment pathways for the same SaMD. MDCG AIB 2025-1 provides a procedural joint-assessment mechanism but does not harmonise the substantive requirement sets.</rdfs:comment>
    <mailo:conflictType>
      <mailo:ConflictType rdf:about="https://w3id.org/mailo#ConformityGapConflict">
        <rdfs:label xml:lang="en">Conformity gap</rdfs:label>
        <rdfs:comment xml:lang="en">Two frameworks impose parallel conformity-assessment routes that neither recognises, so satisfying one does not discharge the other (e.g. MDR notified-body assessment alongside AI Act high-risk conformity assessment).</rdfs:comment>
      </mailo:ConflictType>
    </mailo:conflictType>
    <mailo:hasResolutionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">procedural_only</mailo:hasResolutionStatus>
  </mailo:CrossFrameworkTension>
  <owl:DatatypeProperty rdf:about="https://w3id.org/mailo#isActionable">
    <rdfs:label xml:lang="en">is actionable</rdfs:label>
    <rdfs:comment>Explanation enables effective Art.22(3) remedies (C-203/22 P_203_001)</rdfs:comment>
    <rdfs:comment xml:lang="en">True if the explanation enables effective exercise of GDPR Art.22(3) remedies (C-203/22 P_203_001). Abstract mathematical formulas are insufficient.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#Explanation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <mailo:CJEUCase rdf:about="https://w3id.org/mailo#C_307_22">
    <rdfs:label xml:lang="en">C-307/22 FT v DW (Medical Records Access)</rdfs:label>
    <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-10-26</dcterms:date>
    <dcterms:identifier>C-307/22</dcterms:identifier>
    <dcterms:identifier>ECLI:EU:C:2023:811</dcterms:identifier>
    <rdfs:comment xml:lang="en">Inclusion basis (DirectSubjectMatter): Access to medical records under GDPR Art.15 in a medical context.</rdfs:comment>
    <skos:notation>ECLI:EU:C:2023:811</skos:notation>
    <mailo:decidedBy>
      <mailo:Court rdf:about="https://w3id.org/mailo#CJEU_FirstChamber">
        <rdfs:label xml:lang="en">CJEU First Chamber</rdfs:label>
      </mailo:Court>
    </mailo:decidedBy>
    <mailo:establishesPrinciple>
      <mailo:RatioDecidendi rdf:about="https://w3id.org/mailo#P_307_001">
        <rdfs:label xml:lang="en">P-307/22-001: Unconditional Patient Record Access</rdfs:label>
        <rdfs:comment xml:lang="en">Patients have an unconditional right to a complete copy of their medical records, free of charge, including all AI-generated diagnostic outputs, in a faithful and comprehensible format.</rdfs:comment>
        <mailo:appliesTo rdf:resource="https://w3id.org/mailo#MedicalAISystem"/>
        <mailo:hasEncodingBasis rdf:resource="https://w3id.org/mailo#CourtHolding"/>
        <mailo:hasPrecedenceLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">binding_ratio</mailo:hasPrecedenceLevel>
        <mailo:triggersObligation rdf:resource="https://w3id.org/mailo#DisclosureObligation"/>
        <mailo:triggersObligation rdf:resource="https://w3id.org/mailo#TransparencyObligation"/>
      </mailo:RatioDecidendi>
    </mailo:establishesPrinciple>
    <mailo:hasInclusionBasis rdf:resource="https://w3id.org/mailo#DirectSubjectMatter"/>
    <mailo:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unconditional right to free copy of complete medical records under GDPR Art.15, including AI-generated diagnostic data.</mailo:hasOutcome>
    <mailo:hasStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Final — binding precedent</mailo:hasStatus>
    <mailo:interpretesArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#GDPR_Art15">
        <rdfs:label xml:lang="en">GDPR Article 15</rdfs:label>
        <rdfs:comment xml:lang="en">Right of access by the data subject.</rdfs:comment>
        <mailo:grantsRight rdf:resource="https://w3id.org/mailo#Right_MedicalRecordAccess"/>
      </mailo:LegalArticle>
    </mailo:interpretesArticle>
    <mailo:interpretesArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#GDPR_Art15_1h">
        <rdfs:label xml:lang="en">GDPR Art.15(1)(h)</rdfs:label>
        <rdfs:comment xml:lang="en">Right to meaningful information about the logic, significance and envisaged consequences of automated processing.</rdfs:comment>
        <mailo:grantsRight rdf:resource="https://w3id.org/mailo#Right_Explanation"/>
      </mailo:LegalArticle>
    </mailo:interpretesArticle>
    <mailo:involvesTechnology rdf:resource="https://w3id.org/mailo#MedicalAISystem"/>
  </mailo:CJEUCase>
  <owl:ObjectProperty rdf:about="https://w3id.org/mailo#hasPrinciple">
    <rdfs:comment>Establishes a legal principle (alias)</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#CJEUCase"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#LegalPrinciple"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/mailo#overrules">
    <rdfs:comment>Overrules or modifies a prior principle</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#CJEUCase"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#LegalPrinciple"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/mailo#enforcedBy">
    <rdfs:comment>Framework enforced by authority</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#RegulatoryAuthority"/>
  </owl:ObjectProperty>
  <mailo:LiteratureSource rdf:about="https://w3id.org/mailo#lit_Communications_Medicine_Nature_2025_Neuro-symbolic_AI">
    <rdfs:label>Communications Medicine (Nature). (2025). Neuro-symbolic AI for auditable cognitive information extraction from medical reports.</rdfs:label>
    <dcterms:date>2025</dcterms:date>
    <dcterms:description>LLM extracts candidate facts → symbolic verifier checks against medical rules → traceable, deterministic labels. Empirical demonstration of the harness pattern MAILO advocates, applied to clinical text.</dcterms:description>
    <dcterms:source rdf:resource="https://www.nature.com/articles/s43856-025-01194-x"/>
    <mailo:relevanceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</mailo:relevanceScore>
  </mailo:LiteratureSource>
  <mailo:UPCCase rdf:about="https://w3id.org/mailo#UPC_Hologic_Siemens">
    <rdfs:label xml:lang="en">Hologic v. Siemens Healthineers — Medical Imaging AI</rdfs:label>
    <dcterms:identifier>UPC_CFI_758/2024</dcterms:identifier>
    <rdfs:comment xml:lang="en">Inclusion basis (DomainContext): Mammography X-ray tube hardware, with no AI element in the asserted claim. Retained only for the EPO/MDR semantic-scope tension, where the point is precisely that patent claim scope and MDR intended purpose describe the same device at different granularities.</rdfs:comment>
    <rdfs:comment xml:lang="en">SCOPE WARNING: this is medical imaging HARDWARE (X-ray tube focal spot control), not medical imaging AI. The asserted claim contains no AI or machine-learning element. Retained for the EPO/MDR/AI Act semantic-scope tension analysis, but it should not be counted as a medical-AI patent case.</rdfs:comment>
    <mailo:decidedBy>
      <mailo:UPCDivision rdf:about="https://w3id.org/mailo#UPC_LD_Dusseldorf">
        <rdfs:label xml:lang="en">UPC Local Division — Düsseldorf</rdfs:label>
      </mailo:UPCDivision>
    </mailo:decidedBy>
    <mailo:hasDefendant>
      <mailo:Company rdf:about="https://w3id.org/mailo#SiemensHealthineers">
        <rdfs:label xml:lang="en">Siemens Healthineers AG</rdfs:label>
      </mailo:Company>
    </mailo:hasDefendant>
    <mailo:hasInclusionBasis rdf:resource="https://w3id.org/mailo#DomainContext"/>
    <mailo:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dusseldorf Local Division, decision of 10 June 2026 (with counterclaim UPC_CFI_259/2025): permanent injunction granted to Hologic in three member states, with recall and destruction orders against several Siemens Healthineers entities. The patent concerns the 'Flying Focal Spot' X-ray tube feature of the MAMMOMAT B.brilliant mammography system. NOTE: the item previously recorded here as a decision of 2026-03-09 was a procedural order on the further exchange of written pleadings, not the judgment.</mailo:hasOutcome>
    <mailo:hasPlaintiff>
      <mailo:Company rdf:about="https://w3id.org/mailo#Hologic">
        <rdfs:label xml:lang="en">Hologic Inc.</rdfs:label>
      </mailo:Company>
    </mailo:hasPlaintiff>
    <mailo:hasStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Decided at first instance 2026-06-10 (verified 2026-09-01)</mailo:hasStatus>
    <mailo:involvesPatent>
      <mailo:EuropeanPatent rdf:about="https://w3id.org/mailo#EP_2352431">
        <rdfs:label xml:lang="en">EP 2 352 431 B1</rdfs:label>
        <rdfs:comment xml:lang="en">Hologic breast imaging AI-assisted reading technology.</rdfs:comment>
      </mailo:EuropeanPatent>
    </mailo:involvesPatent>
  </mailo:UPCCase>
  <mailo:CrossFrameworkTension rdf:about="https://w3id.org/mailo#Tension_TSD_AIAct_Transparency">
    <rdfs:label xml:lang="en">TSD Art.2 Trade Secret vs. AI Act Art.13 + GDPR Art.15(1)(h) — Core Transparency Tension</rdfs:label>
    <rdfs:comment xml:lang="en">TSD Art.2 protects model weights, training data schemas, and architecture as trade secrets. AI Act Art.13 requires deployers to receive sufficient information about high-risk AI system capabilities and limitations. C-203/22 §§60-70 sets the mandatory floor: controller cannot invoke TSD Art.2 to deny all causal explanation of an automated decision — disputed information must be produced to the competent supervisory authority or court for balance. AI Act Art.78 ensures national authority confidentiality but does not disapply Art.13 disclosure to deployers. TSD Art.5 is the only legislative bridge but its scope in the medical AI context remains unresolved pending a CJEU reference on Art.22 and clinical AI.</rdfs:comment>
    <mailo:conflictType>
      <mailo:ConflictType rdf:about="https://w3id.org/mailo#TradeSecretConflict">
        <rdfs:label xml:lang="en">Trade secret against transparency</rdfs:label>
        <rdfs:comment xml:lang="en">A disclosure duty under one framework collides with a legitimate secrecy interest protected by another (TSD Art.2 against AI Act Art.13 and GDPR Art.15(1)(h)).</rdfs:comment>
      </mailo:ConflictType>
    </mailo:conflictType>
    <mailo:conflictsWith rdf:resource="https://w3id.org/mailo#ExplainabilityObligation"/>
    <mailo:conflictsWith rdf:resource="https://w3id.org/mailo#TransparencyObligation"/>
    <mailo:hasResolutionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">partial</mailo:hasResolutionStatus>
    <mailo:involvesFramework>
      <mailo:EURegulation rdf:about="https://w3id.org/mailo#AIAct">
        <rdf:type rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
        <rdfs:label xml:lang="en">EU AI Act 2024/1689</rdfs:label>
        <eli:id_local>32024R1689</eli:id_local>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-08-01</dcterms:date>
        <dcterms:identifier>2024/1689/EU</dcterms:identifier>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#AIAct_Art10"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#AIAct_Art17"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#AIAct_Art26"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#AIAct_Art50"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#AIAct_Art9"/>
      </mailo:EURegulation>
    </mailo:involvesFramework>
    <mailo:involvesFramework>
      <mailo:EURegulation rdf:about="https://w3id.org/mailo#GDPR">
        <rdf:type rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
        <rdfs:label xml:lang="en">GDPR 2016/679</rdfs:label>
        <eli:id_local>32016R0679</eli:id_local>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2016-04-27</dcterms:date>
        <dcterms:identifier>2016/679/EU</dcterms:identifier>
        <rdfs:comment xml:lang="en">General Data Protection Regulation. Core data protection framework; Art.22 governs solely automated decision-making, Art.15/15(1)(h) the right of access and meaningful information, Art.9 special category health data, Art.35 DPIA obligation.</rdfs:comment>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#GDPR_Art15"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#GDPR_Art15_1h"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#GDPR_Art22"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#GDPR_Art22_1"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#GDPR_Art22_2"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#GDPR_Art22_3"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#GDPR_Art22_4"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#GDPR_Art35"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#GDPR_Art9"/>
      </mailo:EURegulation>
    </mailo:involvesFramework>
    <mailo:involvesFramework>
      <mailo:EUDirective rdf:about="https://w3id.org/mailo#TSD">
        <rdf:type rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
        <rdfs:label xml:lang="en">Trade Secrets Directive 2016/943</rdfs:label>
        <eli:id_local>32016L0943</eli:id_local>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2016-06-08</dcterms:date>
        <dcterms:identifier>2016/943/EU</dcterms:identifier>
        <rdfs:comment xml:lang="en">EU Trade Secrets Directive. Harmonises civil-law protection of undisclosed know-how and business information. Key for medical AI: model weights, training data schemas, and proprietary algorithms qualify as trade secrets under the Art.2 three-part test. Art.5 carve-outs limit the secrecy shield when exercise of the right to information is at stake — directly engaged by GDPR Art.15(1)(h) and AI Act Art.13 transparency obligations.</rdfs:comment>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#TSD_Art2"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#TSD_Art5"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#TSD_Art9"/>
      </mailo:EUDirective>
    </mailo:involvesFramework>
  </mailo:CrossFrameworkTension>
  <owl:ObjectProperty rdf:about="https://w3id.org/mailo#establishesPrinciple">
    <rdfs:label xml:lang="en">establishes principle</rdfs:label>
    <rdfs:comment>Case establishes a legal principle</rdfs:comment>
    <rdfs:comment xml:lang="en">A case establishes a legal principle.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#Case"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#LegalPrinciple"/>
  </owl:ObjectProperty>
  <mailo:LiteratureSource rdf:about="https://w3id.org/mailo#lit_Conflict-tolerant_Deontic_Traditional_Scheme_for_the_Semanti">
    <rdfs:label>Conflict-tolerant Deontic Traditional Scheme for the Semantic Web. (2025). Journal of Logic and Computation 35(8), Oxford.</rdfs:label>
    <dcterms:date>2025</dcterms:date>
    <dcterms:description>Addresses cross-framework normative conflict resolution that MAILO will face (e.g. GDPR Art.22 vs AI Act Art.86). Provides RDF-based conflict-tolerant deontic logic.</dcterms:description>
    <dcterms:source rdf:resource="https://academic.oup.com/logcom/article/35/8/exaf054/8320660"/>
    <mailo:relevanceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</mailo:relevanceScore>
  </mailo:LiteratureSource>
  <owl:DatatypeProperty rdf:about="https://w3id.org/mailo#versionStartDate">
    <rdfs:comment>Date from which this regulation version/expression applies</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/mailo#complementedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:label xml:lang="en">complemented by</rdfs:label>
    <rdfs:comment>Article is complemented by another</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#LegalArticle"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/mailo#isNonTechnical">
    <rdfs:label xml:lang="en">is non-technical</rdfs:label>
    <rdfs:comment>Explanation expressed in non-technical language</rdfs:comment>
    <rdfs:comment xml:lang="en">True if the explanation is expressed in language understandable to the data subject without specialist knowledge (C-203/22 P_203_001).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#Explanation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <mailo:CJEUCase rdf:about="https://w3id.org/mailo#C_203_22">
    <rdfs:label xml:lang="en">C-203/22 Dun &amp; Bradstreet Austria</rdfs:label>
    <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-02-27</dcterms:date>
    <dcterms:identifier>C-203/22</dcterms:identifier>
    <dcterms:identifier>ECLI:EU:C:2025:117</dcterms:identifier>
    <rdfs:comment xml:lang="en">Inclusion basis (TransposedPrinciple): Telecoms credit scoring. The Art.15(1)(h) explanation standard is transposed to medical AI explanations.</rdfs:comment>
    <skos:notation>ECLI:EU:C:2025:117</skos:notation>
    <mailo:citesPrecedent>
      <mailo:CJEUCase rdf:about="https://w3id.org/mailo#C_634_21">
        <rdfs:label xml:lang="en">C-634/21 SCHUFA Holding (Scoring)</rdfs:label>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-12-07</dcterms:date>
        <dcterms:identifier>C-634/21</dcterms:identifier>
        <dcterms:identifier>ECLI:EU:C:2023:957</dcterms:identifier>
        <rdfs:comment xml:lang="en">Inclusion basis (TransposedPrinciple): Consumer credit scoring. The Art.22(1) analysis is transposed to clinical risk-scoring systems.</rdfs:comment>
        <skos:notation>ECLI:EU:C:2023:957</skos:notation>
        <mailo:citesPrecedent rdf:resource="https://w3id.org/mailo#C_817_19"/>
        <mailo:decidedBy rdf:resource="https://w3id.org/mailo#CJEU_FirstChamber"/>
        <mailo:establishesPrinciple rdf:resource="https://w3id.org/mailo#P_634_001"/>
        <mailo:establishesPrinciple rdf:resource="https://w3id.org/mailo#P_634_002"/>
        <mailo:establishesPrinciple rdf:resource="https://w3id.org/mailo#P_634_003"/>
        <mailo:establishesPrinciple rdf:resource="https://w3id.org/mailo#P_634_004"/>
        <mailo:hasInclusionBasis rdf:resource="https://w3id.org/mailo#TransposedPrinciple"/>
        <mailo:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GDPR Art.22(1) constitutes a prohibition; automated scoring by credit agency = 'decision' triggering Art.22; 'solely' test is functional not formal.</mailo:hasOutcome>
        <mailo:hasStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Final — binding precedent</mailo:hasStatus>
        <mailo:interpretesArticle rdf:resource="https://w3id.org/mailo#GDPR_Art15_1h"/>
        <mailo:interpretesArticle rdf:resource="https://w3id.org/mailo#GDPR_Art22"/>
        <mailo:interpretesArticle rdf:resource="https://w3id.org/mailo#GDPR_Art22_1"/>
        <mailo:interpretesArticle rdf:resource="https://w3id.org/mailo#GDPR_Art22_2"/>
        <mailo:involvesTechnology rdf:resource="https://w3id.org/mailo#RiskScoringSystem"/>
      </mailo:CJEUCase>
    </mailo:citesPrecedent>
    <mailo:decidedBy rdf:resource="https://w3id.org/mailo#CJEU_FirstChamber"/>
    <mailo:establishesPrinciple>
      <mailo:RatioDecidendi rdf:about="https://w3id.org/mailo#P_203_001">
        <rdfs:label xml:lang="en">P-203/22-001: Meaningful Explainability Standard</rdfs:label>
        <rdfs:comment xml:lang="en">Art.15(1)(h) requires actionable explanations in non-technical language, identifying which inputs affected the output and the main reasoning path. Abstract mathematical formulas are insufficient.</rdfs:comment>
        <rdfs:comment xml:lang="en">Encoding basis (DesignerOperationalisation): Para 61 requires the data subject to understand which personal data were used and in what way. identifiesInputFactors is MAILO's predicate for that standard.</rdfs:comment>
        <mailo:appliesTo rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
        <mailo:appliesTo rdf:resource="https://w3id.org/mailo#MedicalAISystem"/>
        <mailo:hasEncodingBasis rdf:resource="https://w3id.org/mailo#DesignerOperationalisation"/>
        <mailo:hasPrecedenceLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">binding_ratio</mailo:hasPrecedenceLevel>
        <mailo:triggersObligation rdf:resource="https://w3id.org/mailo#ExplainabilityObligation"/>
      </mailo:RatioDecidendi>
    </mailo:establishesPrinciple>
    <mailo:hasInclusionBasis>
      <mailo:InclusionBasis rdf:about="https://w3id.org/mailo#TransposedPrinciple">
        <rdfs:label xml:lang="en">Transposed principle</rdfs:label>
        <rdfs:comment xml:lang="en">The case establishes a principle in another domain that MAILO applies to medical AI by structural analogy. The transposition is the ontology designer's step, not the court's, and the affected shapes say so.</rdfs:comment>
      </mailo:InclusionBasis>
    </mailo:hasInclusionBasis>
    <mailo:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Actionable explanations required (not algorithm formulas); explanation must enable effective exercise of Art.22(3) remedies.</mailo:hasOutcome>
    <mailo:hasStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Final — binding precedent</mailo:hasStatus>
    <mailo:interpretesArticle rdf:resource="https://w3id.org/mailo#GDPR_Art15_1h"/>
    <mailo:interpretesArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#GDPR_Art22">
        <rdfs:label xml:lang="en">GDPR Article 22</rdfs:label>
        <rdfs:comment xml:lang="en">Prohibition on solely automated individual decision-making.</rdfs:comment>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#GDPR"/>
      </mailo:LegalArticle>
    </mailo:interpretesArticle>
  </mailo:CJEUCase>
  <mailo:CrossFrameworkTension rdf:about="https://w3id.org/mailo#Tension_EHDS_GDPR_OptOut">
    <rdfs:label xml:lang="en">EHDS Art.35 opt-out vs. AI Act Art.10(3) representativeness</rdfs:label>
    <rdfs:comment xml:lang="en">EHDS Art.35 grants patients an unconditional right to opt out of secondary health data use. Where opt-out rates are elevated in a clinically significant subpopulation, the resulting training dataset violates AI Act Art.10(3) representativeness. No legislative safe harbour bridges these positions.</rdfs:comment>
    <mailo:conflictType>
      <mailo:ConflictType rdf:about="https://w3id.org/mailo#DataGovernanceConflict">
        <rdfs:label xml:lang="en">Data governance conflict</rdfs:label>
        <rdfs:comment xml:lang="en">Frameworks impose incompatible conditions on the acquisition, sharing or reuse of data (e.g. an EHDS opt-out reducing dataset representativeness against AI Act Art.10 data-quality duties).</rdfs:comment>
      </mailo:ConflictType>
    </mailo:conflictType>
    <mailo:hasResolutionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">unresolved</mailo:hasResolutionStatus>
  </mailo:CrossFrameworkTension>
  <mailo:LegalArticle rdf:about="https://w3id.org/mailo#AIAct_Art86">
    <rdfs:label xml:lang="en">AI Act Article 86</rdfs:label>
    <rdfs:comment xml:lang="en">Right to explanation of individual decision-making.</rdfs:comment>
    <mailo:complementedBy rdf:resource="https://w3id.org/mailo#GDPR_Art15_1h"/>
  </mailo:LegalArticle>
  <owl:DatatypeProperty rdf:about="https://w3id.org/mailo#celex">
    <rdfs:comment>CELEX number for EU legislation</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <mailo:EuropeanPatent rdf:about="https://w3id.org/mailo#EP_3435866">
    <rdfs:label xml:lang="en">EP 3 435 866</rdfs:label>
    <rdfs:comment xml:lang="en">Dexcom continuous glucose monitoring system.</rdfs:comment>
  </mailo:EuropeanPatent>
  <owl:ObjectProperty rdf:about="https://w3id.org/mailo#conflictsWith">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:label xml:lang="en">conflicts with</rdfs:label>
    <rdfs:comment>Article conflicts with another</rdfs:comment>
    <rdfs:comment xml:lang="en">Two legal obligations or principles that are in tension.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#LegalArticle"/>
  </owl:ObjectProperty>
  <mailo:EURegulation rdf:about="https://w3id.org/mailo#EHDS">
    <rdf:type rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
    <rdfs:label xml:lang="en">EHDS Regulation 2025/327</rdfs:label>
    <eli:id_local>32025R0327</eli:id_local>
    <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-02-11</dcterms:date>
    <dcterms:identifier>2025/327/EU</dcterms:identifier>
    <rdfs:comment xml:lang="en">European Health Data Space. Governs primary use (MyHealth@EU, Art.23) and secondary use (HealthData@EU, Art.75) of health data for research, innovation and AI training. Adopted 11 February 2025, published in the OJ on 5 March 2025, in force 26 March 2025; most secondary-use obligations apply from 26 March 2029, with genetic and clinical-trial data from 26 March 2031. All article references were renumbered in v5.1.0 from COM(2022) 197 proposal numbering to the published text.</rdfs:comment>
    <mailo:coversArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#EHDS_Art68">
        <rdfs:label xml:lang="en">EHDS Art.68 — Data permit (secondary use authorisation)</rdfs:label>
        <rdfs:comment xml:lang="en">Health data access bodies issue data permits authorising secondary use of electronic health data for research, innovation and policy. Access is granted within a secure processing environment (Art.73) from which raw data cannot be downloaded; a health data request under Art.69 yields only an anonymised statistical answer. Renumbered in v5.1.0: previously recorded as Art.33, which is COM(2022) 197 proposal numbering.</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:coversArticle>
    <mailo:coversArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#EHDS_Art71">
        <rdfs:label xml:lang="en">EHDS Art.71 — Right to opt out of secondary use</rdfs:label>
        <rdfs:comment xml:lang="en">Natural persons may opt out of the processing of their personal electronic health data for secondary use. GDPR supervisory authorities are competent for monitoring and enforcing this right. Creates tension with AI Act Art.10 data governance obligations, since opt-out reduces dataset representativeness. Renumbered in v5.1.0: previously recorded as Art.35, which is COM(2022) 197 proposal numbering.</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:coversArticle>
    <mailo:coversArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#EHDS_Art73">
        <rdfs:label xml:lang="en">EHDS Art.73 — Secure processing environment</rdfs:label>
        <rdfs:comment xml:lang="en">Secondary use of electronic health data must take place within a secure processing environment under the control of a health data access body, from which raw data cannot be downloaded. This is the medical-domain reconciliation route for the trade-secret / transparency tension: disclosure to a controlled environment rather than to the requester. Implementing acts under Art.73(5) apply from 26 March 2029. Added in v5.1.0.</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:coversArticle>
    <mailo:coversArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#EHDS_Art75">
        <rdfs:label xml:lang="en">EHDS Art.75 — HealthData@EU (cross-border infrastructure for secondary use)</rdfs:label>
        <rdfs:comment xml:lang="en">HealthData@EU connects national contact points for secondary use, enabling EU-wide access to datasets through a single channel without raw data transfer. Not to be confused with MyHealth@EU (Art.23), the corresponding infrastructure for primary use. Third-country participation becomes possible under Art.75(5) from 26 March 2035. Renumbered in v5.1.0: previously recorded as Art.50, which is COM(2022) 197 proposal numbering.</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:coversArticle>
    <mailo:coversArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#EHDS_Art92">
        <rdfs:label xml:lang="en">EHDS Art.92 — European Health Data Space Board (EHDS Board)</rdfs:label>
        <rdfs:comment xml:lang="en">Independent advisory body facilitating cooperation between Member States and the Commission, with two representatives per Member State (one for primary and one for secondary use). Its remit is consultative. Renumbered in v5.1.0: previously recorded as Art.68 — a particularly hazardous error, since Art.68 exists but governs the data permit, so the citation resolved to a real provision about something else.</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:coversArticle>
  </mailo:EURegulation>
  <mailo:EURegulation rdf:about="https://w3id.org/mailo#MDR">
    <rdf:type rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
    <rdfs:label xml:lang="en">MDR 2017/745</rdfs:label>
    <eli:id_local>32017R0745</eli:id_local>
    <dcterms:identifier>2017/745/EU</dcterms:identifier>
    <mailo:coversArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#MDR_Art15">
        <rdfs:label xml:lang="en">MDR Art.15 — Person Responsible for Regulatory Compliance</rdfs:label>
        <rdfs:comment xml:lang="en">Manufacturers must designate a person responsible for regulatory compliance (PRRC). For AI-SaMD companies this person must have expertise in medical AI regulation.</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:coversArticle>
    <mailo:coversArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#MDR_Art61">
        <rdfs:label xml:lang="en">MDR Art.61 — Clinical Evaluation</rdfs:label>
        <rdfs:comment xml:lang="en">Medical device manufacturers must conduct clinical evaluation demonstrating safety and performance. For AI-SaMD, AI-specific performance validation (bias, drift, edge cases) is required.</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:coversArticle>
    <mailo:coversArticle>
      <mailo:LegalArticle rdf:about="https://w3id.org/mailo#MDR_Art83">
        <rdfs:label xml:lang="en">MDR Art.83 — Post-Market Surveillance</rdfs:label>
        <rdfs:comment xml:lang="en">PMS system must collect real-world performance data. For AI-SaMD: continuous monitoring of model drift and performance degradation in deployment populations.</rdfs:comment>
      </mailo:LegalArticle>
    </mailo:coversArticle>
  </mailo:EURegulation>
  <owl:DatatypeProperty rdf:about="https://w3id.org/mailo#oversightIsSubstantive">
    <rdfs:label xml:lang="en">oversight is substantive</rdfs:label>
    <rdfs:comment>True = genuine review; false = rubber-stamping (C-634/21 P_634_002)</rdfs:comment>
    <rdfs:comment xml:lang="en">True if the human reviewer exercised independent judgment; false if the review was a mere formality (rubber-stamping). C-634/21 P_634_002 requires true.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#HumanOversightRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <mailo:LiteratureSource rdf:about="https://w3id.org/mailo#lit_Medical_Law_Review_2024_A_health-conformant_reading_of_t">
    <rdfs:label>Medical Law Review. (2024). A health-conformant reading of the GDPR's right not to be subject to automated decision-making, 32(3), 373.</rdfs:label>
    <dcterms:date>2024</dcterms:date>
    <dcterms:description>Only article addressing the exact intersection of GDPR Art.22 + medical AI. Doctrinal foundation for MAILO's medical-AI ADM rules.</dcterms:description>
    <dcterms:source rdf:resource="https://academic.oup.com/medlaw/article/32/3/373/7732100"/>
    <mailo:relevanceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</mailo:relevanceScore>
  </mailo:LiteratureSource>
  <owl:DatatypeProperty rdf:about="https://w3id.org/mailo#riskLevel">
    <rdfs:label xml:lang="en">risk level</rdfs:label>
    <rdfs:comment>CRITICAL | HIGH | MEDIUM | LOW</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#ComplianceRisk"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/mailo#hasPurposeLimitation">
    <rdfs:label xml:lang="en">has purpose limitation</rdfs:label>
    <rdfs:comment>Tri-level proportionality (b): purpose limitation</rdfs:comment>
    <rdfs:comment xml:lang="en">Tri-level proportionality test (b): documented purpose limitation. C-817/19 P_817_003.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/mailo#usesHealthStatusAsCriterion">
    <rdfs:label xml:lang="en">uses health status as criterion</rdfs:label>
    <rdfs:comment>Must be false — health status excluded from automated criteria (C-817/19 P_817_004)</rdfs:comment>
    <rdfs:comment xml:lang="en">True if the system uses an individual's health status as an automated classification criterion. Must be false (C-817/19 P_817_004 Grand Chamber prohibition).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/mailo#art22ExceptionApplied">
    <rdfs:label xml:lang="en">Art.22 exception applied</rdfs:label>
    <rdfs:comment>contract_necessity | explicit_consent | member_state_law</rdfs:comment>
    <rdfs:comment xml:lang="en">The GDPR Art.22(2) exception relied on: 'contract_necessity' | 'explicit_consent' | 'member_state_law'. Must be stated or Art.22(1) prohibition applies (C-634/21 P_634_004).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/mailo#proposedRenumberingTo">
    <rdfs:label xml:lang="en">proposed renumbering to</rdfs:label>
    <rdfs:comment xml:lang="en">The article designation the provision would carry if the proposal is adopted as drafted. A string, not an IRI: the target provision does not exist in law and must not be resolvable as though it did.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#PendingAmendment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <mailo:UPCCase rdf:about="https://w3id.org/mailo#UPC_10x_NanoString">
    <rdfs:label xml:lang="en">10x Genomics v. NanoString — Spatial Biology AI</rdfs:label>
    <rdfs:comment xml:lang="en">Inclusion basis (DirectSubjectMatter): Spatial genomic analysis instrumentation and methods.</rdfs:comment>
    <mailo:decidedBy>
      <mailo:Court rdf:about="https://w3id.org/mailo#UPC_CoA">
        <rdfs:label xml:lang="en">UPC Court of Appeal</rdfs:label>
        <rdfs:subClassOf rdf:resource="https://w3id.org/mailo#UPC"/>
      </mailo:Court>
    </mailo:decidedBy>
    <mailo:decidedBy rdf:resource="https://w3id.org/mailo#UPC_LD_Munich"/>
    <mailo:hasInclusionBasis rdf:resource="https://w3id.org/mailo#DirectSubjectMatter"/>
    <mailo:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Munich LD granted PI; CoA first substantive ruling reversed PI on invalidity grounds ('more likely than not' standard). Case settled 2025.</mailo:hasOutcome>
    <mailo:hasStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Settled 2025</mailo:hasStatus>
    <mailo:involvesTechnology rdf:resource="https://w3id.org/mailo#GenomicDiagnosticAI"/>
  </mailo:UPCCase>
  <owl:ObjectProperty rdf:about="https://w3id.org/mailo#coversArticle">
    <rdfs:label xml:lang="en">covers article</rdfs:label>
    <rdfs:comment>Framework contains an article</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#LegalArticle"/>
  </owl:ObjectProperty>
  <mailo:Court rdf:about="https://w3id.org/mailo#CJEU">
    <rdfs:label xml:lang="en">Court of Justice of the EU (CJEU)</rdfs:label>
  </mailo:Court>
  <owl:DatatypeProperty rdf:about="https://w3id.org/mailo#isHighRiskAIAct">
    <rdfs:label xml:lang="en">is high-risk under AI Act</rdfs:label>
    <rdfs:comment>True if system falls under AI Act Annex III high-risk categories</rdfs:comment>
    <rdfs:comment xml:lang="en">True if the system falls within AI Act Annex III high-risk categories (medical device AI, biometric, critical infrastructure).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#MedicalAISystem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:Ontology rdf:about="https://w3id.org/mailo">
    <dcterms:abstract xml:lang="en">MAILO (Medical AI Legal Ontology) is a machine-executable knowledge graph encoding EU regulatory obligations for medical artificial intelligence systems. It formalises eight EU legislative instruments -- the GDPR, MDR, AI Act, Product Liability Directive, EHDS, Data Governance Act, Data Act, and Trade Secrets Directive -- as OWL 2 classes and SHACL shape constraints, grounded in three CJEU judgments on automated decision-making (Ligue des droits humains, SCHUFA Holding, and Dun &amp; Bradstreet Austria). MAILO functions as a deterministic, auditable compliance-verification layer: SHACL NodeShapes validate instance data describing a medical AI system against the encoded legal constraints and produce structured, traceable conformance reports.</dcterms:abstract>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-27</dcterms:created>
    <dcterms:description xml:lang="en">&#13;
        Ontology capturing the legal landscape governing AI-driven automated&#13;
        decision-making in medical contexts. Covers CJEU precedents on GDPR&#13;
        Art.22, UPC/EPO patent litigation in MedTech, the EU AI Act high-risk&#13;
        regime, MDR 2017/745, PLD 2024/2853, EHDS 2025/327, DGA 2022/868,&#13;
        and Data Act 2023/2854 — with full precedent chains, SHACL runtime&#13;
        constraints, and compliance obligation mappings.&#13;
        Imports: W3C DPV v2.0 (data privacy vocabulary), AIRO (AI risk ontology),&#13;
        ELI (European Legislation Identifier), ECLI (European Case Law Identifier).&#13;
    </dcterms:description>
    <dcterms:language>en</dcterms:language>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-12</dcterms:modified>
    <dcterms:title xml:lang="en">Medical AI Legal Ontology (MAILO)</dcterms:title>
    <rdfs:comment xml:lang="en">Round 5 (v5.1.0, pre-release): a systematic audit of all 48 LegalArticle individuals, rather than only previously flagged ones, found five mis-numbered citations. PLD Art.4 (Definitions) had been recorded as the strict-liability provision, which is Art.5, and PLD Art.7 (Defectiveness) had been recorded as the software-as-product definition, which is Art.4(1). DGA Art.2 (Definitions) had been recorded as the Chapter II re-use framework, which opens at Art.3. Data Act Art.15 (exceptional need) had been recorded as trade-secret protection, which is Art.4(6)-(8), and Art.17 (request procedure) as the B2G obligation, which is Art.14. Two cross-framework tension descriptions still carried article numbers superseded in Round 3. None of the five was detectable by any SHACL shape: each was a well-formed triple naming an article that exists. A PendingAmendment vocabulary was added so that proposed legislative change can be recorded without contaminating the in-force numbering, and is used to declare the Digital Omnibus proposal on Data Act Chapter V.</rdfs:comment>
    <owl:imports rdf:resource="http://data.europa.eu/eli/ontology"/>
    <owl:imports rdf:resource="http://w3id.org/dpv"/>
    <owl:imports rdf:resource="https://w3id.org/airo"/>
  </owl:Ontology>
  <owl:DatatypeProperty rdf:about="https://w3id.org/mailo#caseDate">
    <rdfs:comment>Date of judgment or decision</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <mailo:CrossFrameworkTension rdf:about="https://w3id.org/mailo#Tension_BlackBox_PatentProtection">
    <rdfs:label xml:lang="en">Black-Box Patent Protection vs. EU AI Act Transparency Obligation</rdfs:label>
    <rdfs:comment xml:lang="en">&#13;
        Deep-learning medical AI is inherently opaque (black-box). Patent protection incentivises&#13;
        secrecy over model weights. EU AI Act Art.13 and C-817/19 black-box prohibition&#13;
        require transparency for high-risk AI systems, creating structural tension with&#13;
        commercial IP protection strategies. TSD Art.2 reinforces the secrecy interest;&#13;
        TSD Art.5 carve-outs are the only legislative bridge, but their scope is unresolved.&#13;
    </rdfs:comment>
    <mailo:conflictsWith rdf:resource="https://w3id.org/mailo#TransparencyObligation"/>
    <mailo:involvesFramework rdf:resource="https://w3id.org/mailo#AIAct"/>
    <mailo:involvesFramework>
      <mailo:InternationalTreaty rdf:about="https://w3id.org/mailo#EPC">
        <rdf:type rdf:resource="https://w3id.org/mailo#RegulatoryFramework"/>
        <rdfs:label xml:lang="en">European Patent Convention</rdfs:label>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1977-10-07</dcterms:date>
        <rdfs:comment xml:lang="en">European Patent Convention (in force 1977-10-07). Governs patentability of AI/medical-AI inventions (Art.52 exclusions), sufficiency of disclosure for ML models (Art.83), and EPO opposition/appeal proceedings. Administered by EPO; distinct from EU law but intersects via UPC.</rdfs:comment>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#EPC_Art52"/>
        <mailo:coversArticle rdf:resource="https://w3id.org/mailo#EPC_Art83"/>
      </mailo:InternationalTreaty>
    </mailo:involvesFramework>
    <mailo:involvesFramework rdf:resource="https://w3id.org/mailo#TSD"/>
  </mailo:CrossFrameworkTension>
  <owl:ObjectProperty rdf:about="https://w3id.org/mailo#triggersObligation">
    <rdfs:label xml:lang="en">triggers obligation</rdfs:label>
    <rdfs:comment>Principle triggers a compliance obligation</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#LegalPrinciple"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#ComplianceObligation"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/mailo#mitigatedBy">
