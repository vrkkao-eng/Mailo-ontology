  <rdf:Description rdf:about="https://w3id.org/mailo#lit_Andrade_F_Rebelo_D_M_2024_Schufa_s_Case_C-634_21_on">
    <rdf:type rdf:resource="https://w3id.org/mailo#LiteratureSource"/>
    <rdfs:label>Andrade, F., Rebelo, D. M. (2024). Schufa's Case C-634/21 on ADM: the 'Lenders' Quest' for GDPR-friendly Scoring has not been settled yet! SSRN 4882806.</rdfs:label>
    <dcterms:date>2024</dcterms:date>
    <dcterms:description>Challenges the breadth of SCHUFA holding. Informs MAILO's functional-solely rule encoding.</dcterms:description>
    <dcterms:source rdf:resource="https://papers.ssrn.com/sol3/papers.cfm?abstract_id=4882806"/>
    <mailo:relevanceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</mailo:relevanceScore>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#TSD_Art9">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">TSD Article 9 — Preservation of Confidentiality in Legal Proceedings</rdfs:label>
    <rdfs:comment xml:lang="en">Courts may impose confidentiality measures to protect trade secrets during litigation. Relevant to UPC discovery proceedings where a party seeks disclosure of AI model architecture or training data as part of infringement or validity analysis.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#EP_2671173">
    <rdf:type rdf:resource="https://w3id.org/mailo#EuropeanPatent"/>
    <rdfs:label xml:lang="en">EP 2 671 173</rdfs:label>
    <rdfs:comment xml:lang="en">Suinno AI-based pedestrian navigation method.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#GDPR_Art35">
    <rdf:type rdf:resource="https://w3id.org/mailo#LegalArticle"/>
    <rdfs:label xml:lang="en">GDPR Article 35</rdfs:label>
    <rdfs:comment xml:lang="en">Data Protection Impact Assessment (DPIA).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#LegislativeAmendment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>LegislativeAmendment</rdfs:label>
    <rdfs:comment>A legislative event that creates or modifies a regulation version</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/mailo#interpretesArticle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
