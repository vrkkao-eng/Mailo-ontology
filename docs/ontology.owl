    <rdfs:comment>Links system to its oversight documentation</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an automated decision system to its human oversight documentation. At least one record is required (C-634/21 P_634_002).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/mailo#AutomatedDecisionSystem"/>
    <rdfs:range rdf:resource="https://w3id.org/mailo#HumanOversightRecord"/>
