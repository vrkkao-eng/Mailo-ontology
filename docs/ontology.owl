  <mailo:LiteratureSource rdf:about="https://w3id.org/mailo#lit_Hybrid_Neuro-Symbolic_Models_for_Ethical_AI_in_Risk-Sensitiv">
    <rdfs:label>Hybrid Neuro-Symbolic Models for Ethical AI in Risk-Sensitive Domains. (2025). arXiv:2511.17644.</rdfs:label>
    <dcterms:date>2025</dcterms:date>
    <dcterms:description>Risk-sensitive domains demand transparency + regulatory compliance. Neural pattern recognition + symbolic reasoning yields verifiable explanations. Healthcare among the case studies.</dcterms:description>
