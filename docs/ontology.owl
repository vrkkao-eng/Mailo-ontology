    <dcterms:identifier>C-511/18</dcterms:identifier>
    <mailo:citesPrecedent rdf:resource="https://w3id.org/mailo#C_201_14"/>
    <mailo:hasStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Final</mailo:hasStatus>
  </rdf:Description>
