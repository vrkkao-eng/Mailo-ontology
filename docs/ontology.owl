  <rdf:Description rdf:about="https://w3id.org/mailo#P_307_001">
    <rdf:type rdf:resource="https://w3id.org/mailo#RatioDecidendi"/>
    <rdfs:label xml:lang="en">P-307/22-001: Unconditional Patient Record Access</rdfs:label>
    <rdfs:comment xml:lang="en">Patients have an unconditional right to a complete copy of their medical records, free of charge, including all AI-generated diagnostic outputs, in a faithful and comprehensible format.</rdfs:comment>
    <mailo:appliesTo rdf:resource="https://w3id.org/mailo#MedicalAISystem"/>
    <mailo:hasPrecedenceLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">binding_ratio</mailo:hasPrecedenceLevel>
    <mailo:triggersObligation rdf:resource="https://w3id.org/mailo#DisclosureObligation"/>
    <mailo:triggersObligation rdf:resource="https://w3id.org/mailo#TransparencyObligation"/>
  </rdf:Description>
