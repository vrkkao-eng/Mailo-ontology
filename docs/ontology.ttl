mailo:OmnibusAI_ProvisionalAgreement_20260507 a mailo:LegislativeAmendment ;
    rdfs:label "Digital Omnibus on AI — Provisional Agreement (Council + EP, 2026-05-07)" ;
    mailo:amendmentDescription "Provisional political agreement on Digital Omnibus on AI (Omnibus VII package). Extends Annex III standalone high-risk deadline to 2027-12-02 and Annex I (SaMD/MDR) deadline to 2028-08-02 via conditional standards-availability mechanism. Introduces unified MDR+AI Act notified body assessment pathway. Not yet formally adopted as of 2026-05-10; formal adoption expected before 2026-08-02. Source: Consilium press release 2026-05-07." ;
    mailo:versionStartDate "2026-05-07"^^xsd:date .

mailo:PLD_Art4 a mailo:LegalArticle ;
