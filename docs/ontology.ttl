    rdfs:label "10x Genomics v. NanoString — Spatial Biology AI"@en ;
    mailo:decidedBy mailo:UPC_CoA,
        mailo:UPC_LD_Munich ;
    mailo:hasOutcome "Munich LD granted PI; CoA first substantive ruling reversed PI on invalidity grounds ('more likely than not' standard). Case settled 2025."^^xsd:string ;
    mailo:hasStatus "Settled 2025"^^xsd:string ;
    mailo:involvesTechnology mailo:GenomicDiagnosticAI .

