mailo:GDPR_Art22_1 a mailo:LegalArticle ;
    rdfs:label "GDPR Art.22(1)"@en ;
    rdfs:comment "Core prohibition: individuals shall not be subject to solely automated decisions producing significant effects."@en .

mailo:GDPR_Art22_2 a mailo:LegalArticle ;
    rdfs:label "GDPR Art.22(2)"@en ;
    rdfs:comment "Exceptions: contract necessity, explicit consent, EU/Member State law."@en .

mailo:GDPR_Art22_3 a mailo:LegalArticle ;
    rdfs:label "GDPR Art.22(3)"@en ;
