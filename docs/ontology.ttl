mailo:TSD a mailo:EUDirective,
        mailo:RegulatoryFramework ;
    rdfs:label "Trade Secrets Directive 2016/943"@en ;
    eli:id_local "32016L0943" ;
    dcterms:date "2016-06-08"^^xsd:date ;
    dcterms:identifier "2016/943/EU" ;
    rdfs:comment "EU Trade Secrets Directive. Harmonises civil-law protection of undisclosed know-how and business information. Key for medical AI: model weights, training data schemas, and proprietary algorithms qualify as trade secrets under the Art.2 three-part test. Art.5 carve-outs limit the secrecy shield when exercise of the right to information is at stake — directly engaged by GDPR Art.15(1)(h) and AI Act Art.13 transparency obligations."@en ;
    mailo:coversArticle mailo:TSD_Art2,
        mailo:TSD_Art5,
        mailo:TSD_Art9 .

mailo:UPC_LD_Munich a mailo:UPCDivision ;
    rdfs:label "UPC Local Division — Munich"@en .

mailo:EPC_Art52 a mailo:LegalArticle ;
