mailo:C_203_22 a mailo:CJEUCase ;
    rdfs:label "C-203/22 Dun & Bradstreet Austria"@en ;
    dcterms:date "2025-02-27"^^xsd:date ;
    dcterms:identifier "C-203/22",
        "ECLI:EU:C:2025:117" ;
    rdfs:comment "Inclusion basis (TransposedPrinciple): Telecoms credit scoring. The Art.15(1)(h) explanation standard is transposed to medical AI explanations."@en ;
    skos:notation "ECLI:EU:C:2025:117" ;
    mailo:citesPrecedent mailo:C_634_21 ;
    mailo:decidedBy mailo:CJEU_FirstChamber ;
    mailo:establishesPrinciple mailo:P_203_001 ;
    mailo:hasInclusionBasis mailo:TransposedPrinciple ;
    mailo:hasOutcome "Actionable explanations required (not algorithm formulas); explanation must enable effective exercise of Art.22(3) remedies."^^xsd:string ;
    mailo:hasStatus "Final — binding precedent"^^xsd:string ;
    mailo:interpretesArticle mailo:GDPR_Art15_1h,
        mailo:GDPR_Art22 .

mailo:C_307_22 a mailo:CJEUCase ;
