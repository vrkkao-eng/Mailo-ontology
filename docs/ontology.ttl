<https://w3id.org/mailo> a owl:Ontology ;
    dcterms:abstract """MAILO (Medical AI Legal Ontology) is a machine-executable knowledge graph encoding EU regulatory obligations for medical artificial intelligence systems. It formalises eight EU legislative instruments -- the GDPR, MDR, AI Act, Product Liability Directive, EHDS, Data Governance Act, Data Act, and Trade Secrets Directive -- as OWL 2 classes and SHACL shape constraints, grounded in three CJEU judgments on automated decision-making (Ligue des droits humains, SCHUFA Holding, and Dun & Bradstreet Austria). MAILO functions as a deterministic, auditable compliance-verification layer: SHACL NodeShapes validate instance data describing a medical AI system against the encoded legal constraints and produce structured, traceable conformance reports."""@en ;
    dcterms:created "2026-03-27"^^xsd:date ;
    dcterms:description """\r
        Ontology capturing the legal landscape governing AI-driven automated\r
        decision-making in medical contexts. Covers CJEU precedents on GDPR\r
        Art.22, UPC/EPO patent litigation in MedTech, the EU AI Act high-risk\r
        regime, MDR 2017/745, PLD 2024/2853, EHDS 2025/327, DGA 2022/868,\r
        and Data Act 2023/2854 — with full precedent chains, SHACL runtime\r
        constraints, and compliance obligation mappings.\r
        Imports: W3C DPV v2.0 (data privacy vocabulary), AIRO (AI risk ontology),\r
        ELI (European Legislation Identifier), ECLI (European Case Law Identifier).\r
    """@en ;
    dcterms:language "en" ;
    dcterms:modified "2026-08-12"^^xsd:date ;
    dcterms:title "Medical AI Legal Ontology (MAILO)"@en ;
    owl:imports <http://data.europa.eu/eli/ontology>,
        <http://w3id.org/dpv>,
        <https://w3id.org/airo> .

mailo: a owl:Ontology ;
    dcterms:created "2026-04-30"^^xsd:date ;
    dcterms:creator "Victor Kao" ;
    dcterms:description "OWL ontology mapping EU regulatory frameworks (GDPR, AI Act, MDR, PLD, EHDS, DGA, Data Act) to medical AI automated decision-making, CJEU case law, UPC patent litigation, and compliance obligations." ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-08-12"^^xsd:date ;
    dcterms:publisher "KU Leuven, Faculty of Engineering Science" ;
    dcterms:title "Medical AI Legal Ontology (MAILO)" ;
    rdfs:comment "Version 5.0.2 (patch): corrected the ECLI recorded for C-203/22 (Dun & Bradstreet Austria) from the erroneous ECLI:EU:C:2025:145 to the correct ECLI:EU:C:2025:117."@en ;
    owl:priorVersion <https://w3id.org/mailo/5.0.1> ;
    owl:versionIRI <https://w3id.org/mailo/5.0.2> ;
    owl:versionInfo "5.0.2" .

