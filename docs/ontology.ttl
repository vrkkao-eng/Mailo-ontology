    mailo:amendmentDescription "Entry into force — OJ L 2024/1689 published 12 July 2024" ;
    mailo:versionStartDate "2024-08-01"^^xsd:date .

mailo:Amend_AIAct_v2_GPAIModelObligations a mailo:LegislativeAmendment ;
    rdfs:label "Activation event: gpai_model_obligations" ;
    mailo:amendmentDescription "12-month anniversary — GPAI model chapter becomes applicable" ;
    mailo:versionStartDate "2025-08-02"^^xsd:date .

mailo:Amend_AIAct_v3_OriginalHighRisk a mailo:LegislativeAmendment ;
    rdfs:label "Activation event: high_risk_original_deadline" ;
    mailo:amendmentDescription "24-month anniversary — original high-risk deadline per Art.113(2); SUPERSEDED: Omnibus provisional agreement (2026-05-07) extends this deadline." ;
    mailo:versionStartDate "2026-08-02"^^xsd:date .

mailo:Amend_AIAct_v3a_Omnibus_AnnexIII_Standalone a mailo:LegislativeAmendment ;
    rdfs:label "Activation event: high_risk_annex_iii_omnibus" ;
    mailo:amendmentDescription "Omnibus VII provisional agreement — Annex III standalone systems: 2027-12-02. Conditional on harmonised standards availability (Article 6(2) revised)." ;
    mailo:versionStartDate "2027-12-02"^^xsd:date .

mailo:Amend_AIAct_v3b_Omnibus_AnnexI_SaMD a mailo:LegislativeAmendment ;
    rdfs:label "Activation event: high_risk_annex_i_samd_omnibus" ;
    mailo:amendmentDescription "Omnibus VII provisional agreement — Annex I systems (AI embedded in regulated products including medical devices): 2028-08-02. Single joint MDR+AI Act notified body assessment pathway available. Art.9/10/13/14/43 high-risk obligations apply by this date." ;
    mailo:versionStartDate "2028-08-02"^^xsd:date .

mailo:Amend_AIAct_v4_FRIA_PublicBodies a mailo:LegislativeAmendment ;
    rdfs:label "Activation event: fria_public_bodies" ;
    mailo:amendmentDescription "36-month anniversary — Fundamental Rights Impact Assessment mandatory for public-body deployers of high-risk AI systems" ;
    mailo:versionStartDate "2027-08-02"^^xsd:date .

mailo:CJEU_GrandChamber a mailo:Court ;
    rdfs:label "CJEU Grand Chamber"@en ;
    rdfs:comment "Highest formation of CJEU; judgments carry maximum precedential weight."@en .

mailo:C_201_14 a mailo:CJEUCase ;
    rdfs:label "C-201/14 Bara"@en ;
    dcterms:date "2015-10-01"^^xsd:date ;
    dcterms:identifier "C-201/14" ;
    rdfs:comment "Inclusion basis (TransposedPrinciple): Health data transferred between public bodies without information; earliest link in the retained chain."@en ;
    mailo:establishesPrinciple mailo:P_Bara_001 ;
    mailo:hasInclusionBasis mailo:TransposedPrinciple ;
    mailo:hasStatus "Final"^^xsd:string .

mailo:C_511_18 a mailo:CJEUCase ;
    rdfs:label "C-511/18 La Quadrature du Net"@en ;
    dcterms:date "2020-10-06"^^xsd:date ;
    dcterms:identifier "C-511/18" ;
    rdfs:comment "Inclusion basis (TransposedPrinciple): Bulk data retention. Retained for the proportionality line feeding C-817/19."@en ;
    mailo:citesPrecedent mailo:C_201_14 ;
    mailo:hasInclusionBasis mailo:TransposedPrinciple ;
    mailo:hasStatus "Final"^^xsd:string .

mailo:C_634_21 a mailo:CJEUCase ;
    rdfs:label "C-634/21 SCHUFA Holding (Scoring)"@en ;
    dcterms:date "2023-12-07"^^xsd:date ;
    dcterms:identifier "C-634/21",
        "ECLI:EU:C:2023:957" ;
    rdfs:comment "Inclusion basis (TransposedPrinciple): Consumer credit scoring. The Art.22(1) analysis is transposed to clinical risk-scoring systems."@en ;
    skos:notation "ECLI:EU:C:2023:957" ;
    mailo:citesPrecedent mailo:C_817_19 ;
    mailo:decidedBy mailo:CJEU_FirstChamber ;
    mailo:establishesPrinciple mailo:P_634_001,
        mailo:P_634_002,
        mailo:P_634_003,
        mailo:P_634_004 ;
    mailo:hasInclusionBasis mailo:TransposedPrinciple ;
    mailo:hasOutcome "GDPR Art.22(1) constitutes a prohibition; automated scoring by credit agency = 'decision' triggering Art.22; 'solely' test is functional not formal."^^xsd:string ;
    mailo:hasStatus "Final — binding precedent"^^xsd:string ;
    mailo:interpretesArticle mailo:GDPR_Art15_1h,
        mailo:GDPR_Art22,
        mailo:GDPR_Art22_1,
        mailo:GDPR_Art22_2 ;
    mailo:involvesTechnology mailo:RiskScoringSystem .

mailo:C_817_19 a mailo:CJEUCase ;
    rdfs:label "C-817/19 Ligue des droits humains v. Conseil des ministres"@en ;
    dcterms:date "2022-06-21"^^xsd:date ;
    dcterms:identifier "C-817/19",
        "ECLI:EU:C:2022:491" ;
    rdfs:comment "A citesPrecedent link to C-634/21 (SCHUFA) was removed in v5.2.0 as temporally impossible: this judgment is of 21 June 2022 and SCHUFA was decided on 7 December 2023. The influence runs the other way."@en,
        "Inclusion basis (TransposedPrinciple): PNR / counter-terrorism. MAILO transposes the Grand Chamber's automated-decision safeguards to medical AI by structural analogy."@en ;
    skos:notation "ECLI:EU:C:2022:491" ;
    mailo:citesPrecedent mailo:C_511_18 ;
    mailo:decidedBy mailo:CJEU_GrandChamber ;
    mailo:establishesPrinciple mailo:P_817_001,
        mailo:P_817_002,
        mailo:P_817_003,
        mailo:P_817_004,
        mailo:P_817_005 ;
    mailo:hasInclusionBasis mailo:TransposedPrinciple ;
    mailo:hasOutcome "PNR Directive valid only with strict necessity; black-box ML systems prohibited; mandatory non-automated individual review; health status excluded from automated criteria."^^xsd:string ;
    mailo:hasStatus "Final — Grand Chamber binding precedent"^^xsd:string ;
    mailo:interpretesArticle mailo:Charter_Art7,
        mailo:Charter_Art8 ;
    mailo:involvesTechnology mailo:AutomatedDecisionSystem,
        mailo:BlackBoxMLSystem .

mailo:Charter_Art7 a mailo:LegalArticle ;
    rdfs:label "EU Charter Art.7"@en ;
    rdfs:comment "Respect for private and family life."@en .

mailo:Charter_Art8 a mailo:LegalArticle ;
    rdfs:label "EU Charter Art.8"@en ;
    rdfs:comment "Protection of personal data."@en .

mailo:ConformityAssessment a owl:Class ;
    rdfs:label "ConformityAssessment" ;
    rdfs:comment "A conformity assessment path under MDR or AI Act" .

mailo:ConformityGapConflict a mailo:ConflictType ;
    rdfs:label "Conformity gap"@en ;
    rdfs:comment "Two frameworks impose parallel conformity-assessment routes that neither recognises, so satisfying one does not discharge the other (e.g. MDR notified-body assessment alongside AI Act high-risk conformity assessment)."@en .

mailo:ConformityRecord a owl:Class ;
    rdfs:label "ConformityRecord",
        "Conformity Record"@en ;
    rdfs:comment "Conformity assessment / technical documentation record",
        "A conformity assessment or technical documentation record under AI Act Annex IV / MDR Annex II."@en .

mailo:DGA_Art10 a mailo:LegalArticle ;
    rdfs:label "DGA Art.10 — Data Intermediation Services"@en ;
    rdfs:comment "Notification requirements for data intermediaries facilitating health data exchange between data subjects and AI developers. Must be neutral — cannot use data for own purposes."@en .

mailo:DGA_Art16 a mailo:LegalArticle ;
    rdfs:label "DGA Art.16 — National arrangements for data altruism"@en ;
    rdfs:comment "Member States may put in place organisational or technical arrangements to facilitate data altruism. Registration of recognised data altruism organisations, which may collect health data voluntarily shared for AI research, is governed by Arts.18-19; such entities are separate from commercial data intermediation services. Scope clarified in v5.1.0: the earlier label attributed the registration regime to Art.16."@en .

mailo:DGA_Art29 a mailo:LegalArticle ;
    rdfs:label "DGA Art.29 — European Data Innovation Board"@en ;
    rdfs:comment "Expert group established by the Commission, comprising the competent authorities for data intermediation services and for data altruism registration from all Member States, the EDPB, the EDPS, ENISA and others. Its tasks are set out in Art.30. Includes guidance on interoperability between health data repositories used for AI training. Renumbered in v5.1.0: previously recorded as Art.31, which governs international access and transfer (Chapter VII)."@en .

mailo:DGA_Art3 a mailo:LegalArticle ;
    rdfs:label "DGA Art.3 — Categories of protected public sector data eligible for re-use"@en ;
    rdfs:comment "Opens Chapter II (Arts 3-9) by fixing the categories of protected data held by public sector bodies whose re-use the Regulation conditions, including data subject to statistical or commercial confidentiality and personal data. The substantive re-use conditions, including anonymisation and the secure processing environment, are in Art.5. Applies to AI training use cases at hospitals and research institutes. Corrected in v5.1.0 Round 5: previously recorded as Art.2, the Definitions article."@en .

mailo:DPIARecord a owl:Class ;
    rdfs:label "DPIARecord",
        "DPIA Record"@en ;
    rdfs:comment "Data Protection Impact Assessment document (GDPR Art.35; C-817/19)",
        "A Data Protection Impact Assessment document required for high-risk automated processing (GDPR Art.35; C-817/19 P_817_005)."@en .

mailo:DataAct_Art14 a mailo:LegalArticle ;
    rdfs:label "Data Act Art.14 — Obligation to make data available on the basis of an exceptional need (B2G)"@en ;
    rdfs:comment "Data holders must make data available to a public sector body, the Commission, the ECB or a Union body that demonstrates an exceptional need under Art.15. The public-emergency limb is Art.15(1)(a); the procedural requirements for the request itself are in Art.17. Applies to epidemic surveillance AI and clinical trial datasets. Corrected in v5.1.0 Round 5: previously recorded as Art.17. See the declared pending amendment on this article."@en ;
    mailo:hasPendingAmendment mailo:DigitalOmnibus_DataAct_ChapterV .

mailo:DataAct_Art23 a mailo:LegalArticle ;
    rdfs:label "Data Act Art.23 — Switching Cloud Services"@en ;
    rdfs:comment "Medical AI providers using cloud infrastructure must enable switching between cloud providers without data lock-in. Relevant for hospital AI SaaS deployment models."@en .

mailo:DataAct_Art3 a mailo:LegalArticle ;
    rdfs:label "Data Act Art.3 — IoT Data Access Right"@en ;
    rdfs:comment "Users of connected medical devices (wearables, implantables) have a right to access data generated by those devices, enforceable against manufacturers. Extends GDPR Art.20 portability."@en .

mailo:DataAct_Art4 a mailo:LegalArticle ;
    rdfs:label "Data Act Art.4 — User access to product data, subject to trade secret protection"@en ;
    rdfs:comment "Art.4(6)-(8) limit the data-holder's access obligation where disclosure would reveal a protected trade secret, permitting withholding or refusal on a substantiated basis. The parallel limitation for third-party sharing is Art.5(9)-(11), and for B2G disclosure Art.19(2) and Art.21. Key tension with AI transparency obligations. Corrected in v5.1.0 Round 5: previously recorded as Art.15, which defines exceptional need for B2G access and says nothing about trade secrets."@en .

mailo:DataAct_Art5 a mailo:LegalArticle ;
    rdfs:label "Data Act Art.5 — Data Sharing with Third Parties"@en ;
    rdfs:comment "Data holders must share IoT-generated health data with third parties at user request. Creates AI training data supply chain implications for medical device manufacturers."@en .

mailo:DesignerTransposition a mailo:EncodingBasis ;
    rdfs:label "Designer transposition"@en ;
    rdfs:comment "The proposition is inferred across instruments or contexts by the ontology designer and is not held by any court. Must never be cited as case law. Example: the bridge from C-817/19 independent prior review to a GDPR Art.35 DPIA duty."@en .

mailo:Dexcom a mailo:Company ;
    rdfs:label "Dexcom Inc."@en .

mailo:DigitalOmnibus_DataAct_ChapterV a mailo:PendingAmendment ;
    rdfs:label "Digital Omnibus — proposed consolidation of Data Act Chapter V into a new Art.15a"@en ;
    mailo:amendmentProcedureRef "2025/0360(COD)"^^xsd:string ;
    mailo:amendmentProposalRef "COM(2025) 837 final"^^xsd:string ;
    mailo:legislativeStatus "council_position"^^xsd:string ;
    mailo:proposedEffect "Deletes Data Act Arts 14 and 15 and consolidates the business-to-government regime into a new Art.15a, narrowing the trigger from 'exceptional need' to public emergencies only. Not adopted as at the verification date: the AI limb of the Digital Omnibus was severed and adopted separately as Regulation (EU) 2026/1744, while the data limb remains in negotiation. MAILO therefore continues to encode the numbering of Regulation (EU) 2023/2854 as published."^^xsd:string ;
    mailo:proposedRenumberingTo "Data Act Art.15a"^^xsd:string ;
    mailo:statusVerifiedAsAt "2026-09-05"^^xsd:date .

mailo:EHDS_Art68 a mailo:LegalArticle ;
    rdfs:label "EHDS Art.68 — Data permit (secondary use authorisation)"@en ;
    rdfs:comment "Health data access bodies issue data permits authorising secondary use of electronic health data for research, innovation and policy. Access is granted within a secure processing environment (Art.73) from which raw data cannot be downloaded; a health data request under Art.69 yields only an anonymised statistical answer. Renumbered in v5.1.0: previously recorded as Art.33, which is COM(2022) 197 proposal numbering."@en .

mailo:EHDS_Art71 a mailo:LegalArticle ;
    rdfs:label "EHDS Art.71 — Right to opt out of secondary use"@en ;
    rdfs:comment "Natural persons may opt out of the processing of their personal electronic health data for secondary use. GDPR supervisory authorities are competent for monitoring and enforcing this right. Creates tension with AI Act Art.10 data governance obligations, since opt-out reduces dataset representativeness. Renumbered in v5.1.0: previously recorded as Art.35, which is COM(2022) 197 proposal numbering."@en .

mailo:EHDS_Art73 a mailo:LegalArticle ;
    rdfs:label "EHDS Art.73 — Secure processing environment"@en ;
    rdfs:comment "Secondary use of electronic health data must take place within a secure processing environment under the control of a health data access body, from which raw data cannot be downloaded. This is the medical-domain reconciliation route for the trade-secret / transparency tension: disclosure to a controlled environment rather than to the requester. Implementing acts under Art.73(5) apply from 26 March 2029. Added in v5.1.0."@en .

mailo:EHDS_Art75 a mailo:LegalArticle ;
    rdfs:label "EHDS Art.75 — HealthData@EU (cross-border infrastructure for secondary use)"@en ;
    rdfs:comment "HealthData@EU connects national contact points for secondary use, enabling EU-wide access to datasets through a single channel without raw data transfer. Not to be confused with MyHealth@EU (Art.23), the corresponding infrastructure for primary use. Third-country participation becomes possible under Art.75(5) from 26 March 2035. Renumbered in v5.1.0: previously recorded as Art.50, which is COM(2022) 197 proposal numbering."@en .

mailo:EHDS_Art92 a mailo:LegalArticle ;
    rdfs:label "EHDS Art.92 — European Health Data Space Board (EHDS Board)"@en ;
    rdfs:comment "Independent advisory body facilitating cooperation between Member States and the Commission, with two representatives per Member State (one for primary and one for secondary use). Its remit is consultative. Renumbered in v5.1.0: previously recorded as Art.68 — a particularly hazardous error, since Art.68 exists but governs the data permit, so the citation resolved to a real provision about something else."@en .

mailo:EPC_Art84 a mailo:LegalArticle ;
    rdfs:label "EPC Article 84"@en ;
    rdfs:comment "Claims — clarity and support by the description."@en .

mailo:EPO_EnlargedBoA a mailo:Court ;
    rdfs:label "EPO Enlarged Board of Appeal"@en ;
    rdfs:comment "Ensures uniform application of the EPC and decides points of law referred to it. Declared in v5.1.0: it was already in use as the decidedBy value of G 1/19 but had never been typed."@en .

mailo:EPO_T0161_18 a mailo:EPOProceding ;
    rdfs:label "EPO T 0161/18 — AI Medical Device Disclosure"@en ;
    dcterms:date "2020-05-12"^^xsd:date ;
    dcterms:identifier "T 0161/18" ;
    rdfs:comment "Inclusion basis (DirectSubjectMatter): Artificial neural network deriving cardiac output from an arterial pressure curve."@en ;
    mailo:decidedBy mailo:EPO_BoA ;
    mailo:hasInclusionBasis mailo:DirectSubjectMatter ;
    mailo:hasOutcome "Technical Board of Appeal 3.5.05, 12 May 2020 (Aequivalenter Aortendruck/ARC SEIBERSDORF), application 06804383.5: method of determining cardiac output from a peripheral arterial blood pressure curve using an artificial neural network. The APPLICATION WAS REFUSED (not a granted patent revoked) because the training of the network could not be reworked by the skilled person - neither suitable input data nor at least one suitable training data set was disclosed (Art.83); the claim was also held to lack inventive step for the same reason (Art.56). Leading EPO authority on training-data disclosure for AI inventions, reflected in the 2024 EPO Guidelines and followed in T 1191/19."^^xsd:string ;
    mailo:interpretesArticle mailo:EPC_Art56,
        mailo:EPC_Art83 ;
    mailo:involvesTechnology mailo:MedicalAISystem .

mailo:EP_2352431 a mailo:EuropeanPatent ;
    rdfs:label "EP 2 352 431 B1"@en ;
    rdfs:comment "Hologic breast imaging AI-assisted reading technology."@en .

mailo:EP_2671173 a mailo:EuropeanPatent ;
    rdfs:label "EP 2 671 173"@en ;
    rdfs:comment "Suinno AI-based pedestrian navigation method."@en .

mailo:EP_3346403 a mailo:EuropeanPatent ;
    rdfs:label "EP 3 346 403"@en ;
    rdfs:comment "Breast cancer recurrence prediction genomic expression test."@en .

mailo:GDPR_Art22_4 a mailo:LegalArticle ;
    rdfs:label "GDPR Art.22(4)"@en ;
    rdfs:comment "Enhanced protection for special category data (including health data) in automated decisions."@en .

mailo:GDPR_Art35 a mailo:LegalArticle ;
    rdfs:label "GDPR Article 35"@en ;
    rdfs:comment "Data Protection Impact Assessment (DPIA)."@en .

mailo:GDPR_Art9 a mailo:LegalArticle ;
    rdfs:label "GDPR Article 9"@en ;
    rdfs:comment "Processing of special categories of personal data, including health data."@en ;
    rdfs:seeAlso dpv:SpecialCategoryData .

mailo:GDPR_v1_FullyApplicable a mailo:RegulationVersion ;
    rdfs:label "GDPR fully applicable — all provisions in force" ;
    mailo:applicablePhase "fully_applicable" ;
    mailo:isCurrentVersion true ;
    mailo:versionOf mailo:GDPR_2016_679 ;
    mailo:versionStartDate "2018-05-25"^^xsd:date .

mailo:GDPR_v2_OmnibusProposed_Art22 a mailo:RegulationVersion ;
    rdfs:label "GDPR Art.22 Omnibus-proposed version — permission list framing (PROSPECTIVE, NOT ADOPTED)" ;
    mailo:applicablePhase "art22_omnibus_proposed_NOT_ADOPTED" ;
    mailo:isCurrentVersion false ;
    mailo:triggeredBy mailo:OmnibusGDPR_Art22_Proposal_20251119 ;
    mailo:versionOf mailo:GDPR_2016_679 .

mailo:GXDBio a mailo:NPE ;
    rdfs:label "GXD-Bio Corporation (NPE)"@en .

mailo:Hologic a mailo:Company ;
    rdfs:label "Hologic Inc."@en .

mailo:LiabilityConflict a mailo:ConflictType ;
    rdfs:label "Liability gap"@en ;
    rdfs:comment "Compliance with one framework does not resolve, and may not even bear on, exposure under another liability regime (e.g. AI Act conformity against the revised Product Liability Directive)."@en .

mailo:MDR_Art15 a mailo:LegalArticle ;
    rdfs:label "MDR Art.15 — Person Responsible for Regulatory Compliance"@en ;
    rdfs:comment "Manufacturers must designate a person responsible for regulatory compliance (PRRC). For AI-SaMD companies this person must have expertise in medical AI regulation."@en .

mailo:MDR_Art61 a mailo:LegalArticle ;
    rdfs:label "MDR Art.61 — Clinical Evaluation"@en ;
    rdfs:comment "Medical device manufacturers must conduct clinical evaluation demonstrating safety and performance. For AI-SaMD, AI-specific performance validation (bias, drift, edge cases) is required."@en .

mailo:MDR_Art83 a mailo:LegalArticle ;
    rdfs:label "MDR Art.83 — Post-Market Surveillance"@en ;
    rdfs:comment "PMS system must collect real-world performance data. For AI-SaMD: continuous monitoring of model drift and performance degradation in deployment populations."@en .

mailo:MedicalImagingAI a owl:Class ;
    rdfs:label "MedicalImagingAI",
        "Medical Imaging AI"@en ;
    rdfs:comment "AI system for medical image analysis" ;
    rdfs:subClassOf mailo:MedicalAISystem ;
    mailo:hasRisk mailo:Risk_DataActIoT,
        mailo:Risk_EPOUPC_Divergence .

mailo:Microsoft a mailo:Company ;
    rdfs:label "Microsoft Corporation"@en .

mailo:MyriadGenetics a mailo:Company ;
    rdfs:label "Myriad Genetics Inc."@en .

mailo:NPE a owl:Class ;
    rdfs:label "NPE",
        "Non-Practising Entity"@en ;
    rdfs:comment "Non-Practising Entity — patent assertion vehicle" ;
    rdfs:subClassOf mailo:Company .

mailo:ObiterDictum a owl:Class ;
    rdfs:label "ObiterDictum",
        "Obiter Dictum"@en ;
    rdfs:comment "Persuasive (non-binding) judicial observation",
        "Persuasive (non-binding) judicial observation."@en ;
    rdfs:subClassOf mailo:LegalPrinciple .

mailo:OmnibusGDPR_Art22_Proposal_20251119 a mailo:LegislativeAmendment ;
    rdfs:label "Digital Omnibus Regulation — GDPR Art.22 Reframing Proposal (NOT YET ADOPTED)" ;
    mailo:amendmentDescription "Commission proposal (2025-11-19) to replace GDPR Art.22(1)-(2) prohibition structure with an exhaustive positive permission list for solely automated decision-making. EDPB-EDPS Joint Opinion 2/2026 (2026-02-11) strongly opposes the reframing, citing CJEU confirmation of Art.22 as a prohibition in principle (C-634/21, C-817/19). Status: UNADOPTED — in trilogue negotiation as of 2026-05-10. MAILO SHACL shapes remain grounded in current prohibition structure. If adopted, NodeShapes C634_Art22ProhibitionShape and related shapes require reformulation to encode positive permission conditions rather than absence of exception." ;
    mailo:versionStartDate "2025-11-19"^^xsd:date .

mailo:PLD_Art10 a mailo:LegalArticle ;
    rdfs:label "PLD Art.10 — Burden of proof (presumptions of defectiveness AND of causal link)"@en ;
    rdfs:comment "Art.10 carries BOTH presumptions. Art.10(2): defectiveness is presumed where the defendant fails to disclose evidence, the product does not comply with mandatory safety requirements, or an obvious malfunction occurred. Art.10(4): defectiveness and/or the causal link are presumed where the claimant faces excessive difficulty owing to technical or scientific complexity and has demonstrated that the defect or the link is probable — the limb of most consequence for medical AI, expressly contemplated at recital 48. Art.10(5) preserves the defendant's right to rebut."@en .

mailo:PLD_Art11 a mailo:LegalArticle ;
    rdfs:label "PLD Art.11 — Exemption from liability"@en ;
    rdfs:comment "Grounds on which an economic operator escapes liability, the burden resting on the operator: the product was not placed on the market by them, the defect probably did not exist when the product was placed on the market, or the defect is due to compliance with mandatory legal requirements. The state-of-the-art (development risk) defence sits at Art.11(1)(e), and Member States may derogate from it under Art.18(2). CORRECTED in v5.1.0: this individual previously carried the causation presumption, which is Art.10(4), not Art.11."@en .

mailo:PLD_Art4 a mailo:LegalArticle ;
    rdfs:label "PLD Art.4 — Definitions (software and AI systems as 'products')"@en ;
    rdfs:comment "Art.4(1) defines 'product' to include software, expressly capturing AI systems and digital manufacturing files. SaMD under MDR may simultaneously be a 'product' under PLD. Corrected in v5.1.0 Round 5: this content was previously recorded as Art.7, which governs defectiveness."@en .

mailo:PLD_Art9 a mailo:LegalArticle ;
    rdfs:label "PLD Art.9 — Disclosure Obligations (Evidence Facilitation)"@en ;
    rdfs:comment "Courts may order defendants to disclose evidence about high-risk AI systems; creates procedural discovery mechanism absent in AILD."@en .

mailo:P_203_001 a mailo:RatioDecidendi ;
    rdfs:label "P-203/22-001: Meaningful Explainability Standard"@en ;
    rdfs:comment "Art.15(1)(h) requires actionable explanations in non-technical language, identifying which inputs affected the output and the main reasoning path. Abstract mathematical formulas are insufficient."@en,
        "Encoding basis (DesignerOperationalisation): Para 61 requires the data subject to understand which personal data were used and in what way. identifiesInputFactors is MAILO's predicate for that standard."@en ;
    mailo:appliesTo mailo:AutomatedDecisionSystem,
        mailo:MedicalAISystem ;
    mailo:hasEncodingBasis mailo:DesignerOperationalisation ;
    mailo:hasPrecedenceLevel "binding_ratio"^^xsd:string ;
    mailo:triggersObligation mailo:ExplainabilityObligation .

mailo:P_307_001 a mailo:RatioDecidendi ;
    rdfs:label "P-307/22-001: Unconditional Patient Record Access"@en ;
    rdfs:comment "Patients have an unconditional right to a complete copy of their medical records, free of charge, including all AI-generated diagnostic outputs, in a faithful and comprehensible format."@en ;
    mailo:appliesTo mailo:MedicalAISystem ;
    mailo:hasEncodingBasis mailo:CourtHolding ;
    mailo:hasPrecedenceLevel "binding_ratio"^^xsd:string ;
    mailo:triggersObligation mailo:DisclosureObligation,
        mailo:TransparencyObligation .

mailo:P_634_001 a mailo:RatioDecidendi ;
    rdfs:label "P-634/21-001: Broad 'Decision' Concept"@en ;
    rdfs:comment "A 'decision' under Art.22 encompasses any act producing legal or similarly significant effects. Automated scoring creating probabilities relied upon by third parties constitutes a 'decision'."@en ;
    mailo:appliesTo mailo:AutomatedDecisionSystem,
        mailo:ClinicalDecisionSupport,
        mailo:RiskScoringSystem ;
    mailo:hasEncodingBasis mailo:CourtHolding ;
    mailo:hasPrecedenceLevel "binding_ratio"^^xsd:string .

mailo:P_634_002 a mailo:RatioDecidendi ;
    rdfs:label "P-634/21-002: Functional 'Solely' Test"@en ;
    rdfs:comment "C-634/21 paras 49-50: where an automated output plays a determining role in the resulting decision, establishing that output is itself a decision under Art.22(1). The Court did not set out a rubber-stamping or substantive-review standard; MAILO operationalises the determining-role test through a human-asserted substantive-oversight proxy, which is the ontology designer's construction."@en,
        "Encoding basis (DesignerOperationalisation): Paras 49-50 state a determining-role test. The substantive-oversight predicate is MAILO's proxy for it; the Court set no rubber-stamping standard."@en ;
    mailo:appliesTo mailo:AutomatedDecisionSystem,
        mailo:ClinicalDecisionSupport,
        mailo:MedicalImagingAI ;
    mailo:hasEncodingBasis mailo:DesignerOperationalisation ;
    mailo:hasPrecedenceLevel "binding_ratio"^^xsd:string ;
    mailo:triggersObligation mailo:HumanOversightObligation .

mailo:P_634_003 a mailo:RatioDecidendi ;
    rdfs:label "P-634/21-003: Multi-Actor ADM Chain Gap-Filling"@en ;
    rdfs:comment "The prohibition in Art.22 cannot be circumvented by splitting the automated decision across multiple actors (scoring agency + final decision maker). Both may bear responsibility."@en ;
    mailo:appliesTo mailo:AutomatedDecisionSystem ;
    mailo:hasEncodingBasis mailo:CourtHolding ;
    mailo:hasPrecedenceLevel "binding_ratio"^^xsd:string .

mailo:P_634_004 a mailo:RatioDecidendi ;
    rdfs:label "P-634/21-004: Art.22 = Prohibition Rule"@en ;
    rdfs:comment "Art.22(1) is a prohibition rule, not merely a right to object. Exceptions in Art.22(2) are exhaustive; safeguards in Art.22(3) are mandatory when an exception applies."@en,
        "Encoding basis (DesignerOperationalisation): The characterisation of Art.22(1) as a prohibition rather than a right to be invoked is not anchored to its own paragraphs and remains contested in the literature. Recorded as the designer's reading pending verification."@en ;
    mailo:hasEncodingBasis mailo:DesignerOperationalisation ;
    mailo:hasPrecedenceLevel "persuasive_obiter"^^xsd:string .

mailo:P_817_001 a mailo:RatioDecidendi ;
    rdfs:label "P-817/19-001: Mandatory Non-Automated Individual Review"@en ;
    rdfs:comment "Any positive match from automated PNR analysis must be subject to individual non-automated review before any measure is taken. Establishes constitutional minimum for meaningful human intervention."@en ;
    mailo:appliesTo mailo:AutomatedDecisionSystem,
        mailo:MedicalAISystem ;
    mailo:hasEncodingBasis mailo:CourtHolding ;
    mailo:hasPrecedenceLevel "constitutional_grand_chamber"^^xsd:string ;
    mailo:triggersObligation mailo:HumanOversightObligation .

mailo:P_817_002 a mailo:RatioDecidendi ;
    rdfs:label "P-817/19-002: Black-Box ML Prohibition"@en ;
    rdfs:comment "Non-transparent, self-learning ML risk assessment systems may not be used for decisions with significant impact. Pre-determined criteria and regular review are required."@en ;
    mailo:appliesTo mailo:BlackBoxMLSystem,
        mailo:MedicalAISystem ;
    mailo:hasEncodingBasis mailo:CourtHolding ;
    mailo:hasPrecedenceLevel "constitutional_grand_chamber"^^xsd:string ;
    mailo:triggersObligation mailo:ExplainabilityObligation,
        mailo:TransparencyObligation .

mailo:P_817_003 a mailo:RatioDecidendi ;
    rdfs:label "P-817/19-003: Strict Necessity Tri-Level Proportionality Test"@en ;
    rdfs:comment "Large-scale automated processing must satisfy: (a) targeted scope (C-817/19 paras 167-168, 184, 191), (b) purpose limitation (para 191), (c) temporal limitation (paras 255-256, 262). The Court upheld the PNR Directive subject to Charter-conforming restrictive interpretation; non-conformity at a limb is flagged for review and does not entail invalidity."@en ;
    mailo:appliesTo mailo:AutomatedDecisionSystem ;
    mailo:hasEncodingBasis mailo:CourtHolding ;
    mailo:hasPrecedenceLevel "constitutional_grand_chamber"^^xsd:string .

mailo:P_817_004 a mailo:RatioDecidendi ;
    rdfs:label "P-817/19-004: Non-Discrimination — Health Status Excluded"@en ;
    rdfs:comment "Pre-determined assessment criteria may in no circumstances be based on health (PNR Directive Art.6(4); C-817/19 paras 105, 196-197) — a categorical prohibition, not a special-category rule curable by a GDPR Art.9(2) basis. MAILO transposes this to medical AI as a bar on using health condition as a discriminatory classification or risk-scoring criterion, which is narrower than any processing of health data."@en ;
    mailo:appliesTo mailo:GenomicDiagnosticAI,
        mailo:MedicalAISystem ;
    mailo:hasEncodingBasis mailo:CourtHolding ;
    mailo:hasPrecedenceLevel "constitutional_grand_chamber"^^xsd:string .

mailo:P_817_005 a mailo:ObiterDictum ;
    rdfs:label "P-817/19-005: Independent Prior Review (and MAILO's DPIA bridge)"@en ;
    rdfs:comment "C-817/19 paras 222-227 (PNR Directive Art.12(3)(b)): disclosure after the initial period requires prior review by a court or independent administrative authority, which must be objective, impartial, free from external influence, and distinct from the requesting authority or the PIU. The Court said nothing about GDPR Art.35 or DPIAs; the link from independent prior review to a DPIA obligation for medical AI is an authorial cross-instrument interpretation by the ontology designer, not a holding. The DPIA requirement stands on GDPR Art.35 alone."@en,
        "Encoding basis (DesignerTransposition): C-817/19 paras 222-227 concern prior review of PNR disclosure requests. The bridge to a GDPR Art.35 DPIA duty is the designer's; the DPIA constraint stands on Art.35 alone."@en ;
    mailo:hasEncodingBasis mailo:DesignerTransposition ;
    mailo:hasPrecedenceLevel "authorial_transposition"^^xsd:string ;
    mailo:triggersObligation mailo:DPIAObligation .

mailo:P_Bara_001 a mailo:RatioDecidendi ;
    rdfs:label "Transparency Rights Foundation"@en ;
    rdfs:comment "Data subjects must be informed of data transfers; establishes foundational transparency obligation."@en ;
    mailo:hasEncodingBasis mailo:CourtHolding ;
    mailo:hasPrecedenceLevel "binding_ratio"^^xsd:string .

mailo:PatentClassification a owl:Class ;
    rdfs:label "PatentClassification" ;
    rdfs:comment "An IPC/CPC patent classification code" .

mailo:PatientRight a owl:Class ;
    rdfs:label "PatientRight",
        "Patient Right"@en ;
    rdfs:comment "A patient-specific data or health right" ;
    rdfs:subClassOf mailo:DataSubjectRight .

mailo:ProceduralPrecedent a mailo:InclusionBasis ;
    rdfs:label "Procedural precedent"@en ;
    rdfs:comment "The case is relevant for procedure or forum practice rather than substance. Carries no implication about the technology at issue."@en .

mailo:RegulatoryAuthority a owl:Class ;
    rdfs:label "RegulatoryAuthority" ;
    rdfs:comment "An EU or national regulatory or supervisory body" .

mailo:Right_Contest a mailo:DataSubjectRight ;
    rdfs:label "Right to Contest Decision (Art.22(3)(c))"@en .

mailo:Right_Explanation a mailo:DataSubjectRight ;
    rdfs:label "Right to Meaningful Explanation (Art.15(1)(h), C-203/22)"@en .

mailo:Right_ExpressViews a mailo:DataSubjectRight ;
    rdfs:label "Right to Express Views (Art.22(3)(b))"@en .

mailo:Right_HumanIntervention a mailo:DataSubjectRight ;
    rdfs:label "Right to Human Intervention (Art.22(3)(a))"@en .

mailo:Right_MedicalRecordAccess a mailo:PatientRight ;
    rdfs:label "Right to Access Medical Records (C-307/22)"@en .

mailo:Risk_AIActQMS_MDR_Overlap a mailo:ComplianceRisk ;
    rdfs:label "AI Act Art.17 QMS / MDR Annex IX Double Burden"@en ;
    rdfs:comment "AI-SaMD must comply with both AI Act QMS (Art.17) and MDR QMS (Annex IX). Without regulatory alignment, manufacturers face duplicative audit requirements."@en ;
    mailo:riskLevel "HIGH"^^xsd:string .

mailo:Risk_BlackBox a mailo:ComplianceRisk ;
    rdfs:label "Black-Box ML System (C-817/19 Prohibition)"@en ;
    mailo:mitigatedBy mailo:ExplainabilityObligation,
        mailo:TransparencyObligation ;
    mailo:riskLevel "HIGH"^^xsd:string .

mailo:Risk_DataActIoT a mailo:ComplianceRisk ;
    rdfs:label "Data Act Art.3/5 IoT Data Sharing Obligation"@en ;
    rdfs:comment "Medical device manufacturers must share IoT-generated health data with users/third parties. Conflicts with trade secret protection (Art.15) and competitive AI training data strategies."@en ;
    mailo:riskLevel "MEDIUM"^^xsd:string .

mailo:Risk_EHDSOptOut a mailo:ComplianceRisk ;
    rdfs:label "EHDS Art.35 Opt-Out Erodes Training Dataset"@en ;
    rdfs:comment "Widespread exercise of opt-out rights under EHDS Art.35 may substantially reduce available health data for AI training, creating representativeness risk under AI Act Art.10."@en ;
    mailo:riskLevel "MEDIUM"^^xsd:string .

mailo:Risk_EPOUPC_Divergence a mailo:ComplianceRisk ;
    rdfs:label "EPO-UPC Divergent Validity Rulings (Opt-Out Strategy)"@en ;
    mailo:riskLevel "HIGH"^^xsd:string .

mailo:Risk_HealthDataDoubleLayer a mailo:ComplianceRisk ;
    rdfs:label "Health Data Double Protection Layer (Art.9 + Art.22(4))"@en ;
    mailo:mitigatedBy mailo:DPIAObligation ;
    mailo:riskLevel "CRITICAL"^^xsd:string .

mailo:Risk_InsufficientDisclosure a mailo:ComplianceRisk ;
    rdfs:label "Insufficient Training Data Disclosure (EPO T0161/18)"@en ;
    mailo:mitigatedBy mailo:DisclosureObligation ;
    mailo:riskLevel "HIGH"^^xsd:string .

mailo:Risk_NPE_Revocation a mailo:ComplianceRisk ;
    rdfs:label "NPE-Initiated Revocation Attack"@en ;
    mailo:riskLevel "MEDIUM"^^xsd:string .

mailo:Risk_PLDStrictLiability a mailo:ComplianceRisk ;
    rdfs:label "PLD 2024 Strict Liability for AI-SaMD"@en ;
    rdfs:comment "Medical AI systems qualifying as 'defective products' under PLD Art.4 expose manufacturers to strict liability without fault. Presumptions in Art.10 and Art.11 shift burden to defendants."@en ;
    mailo:mitigatedBy mailo:HumanOversightObligation,
        mailo:TransparencyObligation ;
    mailo:riskLevel "HIGH"^^xsd:string .

mailo:Risk_SEP_FRAND a mailo:ComplianceRisk ;
    rdfs:label "SEP/FRAND Obligations (HL7 FHIR, DICOM AI)"@en ;
    mailo:riskLevel "MEDIUM"^^xsd:string .

mailo:Risk_SolelyTest a mailo:ComplianceRisk ;
    rdfs:label "GDPR Art.22 'Solely' Test Failure (Rubber-Stamping)"@en ;
    mailo:mitigatedBy mailo:HumanOversightObligation ;
    mailo:riskLevel "CRITICAL"^^xsd:string .

mailo:SemanticGranularityConflict a mailo:ConflictType ;
    rdfs:label "Semantic granularity conflict"@en ;
    rdfs:comment "Frameworks describe the same artefact at incompatible levels of specificity, so a statement that satisfies one reads as over- or under-inclusive under another (e.g. broad EPO claim scope against narrow MDR intended purpose against intermediate AI Act foreseeable use)."@en .

mailo:SiemensHealthineers a mailo:Company ;
    rdfs:label "Siemens Healthineers AG"@en .

mailo:TSD_Art2 a mailo:LegalArticle ;
    rdfs:label "TSD Article 2 — Definition of Trade Secret"@en ;
    rdfs:comment "Three-part cumulative test: information must be (1) secret (not generally known or readily accessible), (2) have commercial value because it is secret, and (3) be subject to reasonable steps to keep it secret. All three must hold for ML model weights or training data to qualify."@en .

mailo:TSD_Art5 a mailo:LegalArticle ;
    rdfs:label "TSD Article 5 — Exceptions"@en ;
    rdfs:comment "Trade secret protection does not apply where disclosure is required for the exercise of the right to information. Directly engaged when a data subject invokes GDPR Art.15(1)(h) or AI Act Art.86 for an explanation of an automated medical decision — controller cannot use TSD Art.2 to block all causal explanation (C-203/22 §§60-70)."@en .

mailo:TSD_Art9 a mailo:LegalArticle ;
    rdfs:label "TSD Article 9 — Preservation of Confidentiality in Legal Proceedings"@en ;
    rdfs:comment "Courts may impose confidentiality measures to protect trade secrets during litigation. Relevant to UPC discovery proceedings where a party seeks disclosure of AI model architecture or training data as part of infringement or validity analysis."@en .

mailo:UPC a mailo:Court ;
    rdfs:label "Unified Patent Court (UPC)"@en .

mailo:UPC_CD_Paris a mailo:UPCDivision ;
    rdfs:label "UPC Central Division — Paris"@en .

mailo:UPC_CoA a mailo:Court ;
    rdfs:label "UPC Court of Appeal"@en ;
    rdfs:subClassOf mailo:UPC .

mailo:UPC_LD_Paris a mailo:UPCDivision ;
    rdfs:label "UPC Local Division — Paris"@en .

mailo:AIAct a mailo:EURegulation,
        mailo:RegulatoryFramework ;
    rdfs:label "EU AI Act 2024/1689"@en ;
    eli:id_local "32024R1689" ;
    dcterms:date "2024-08-01"^^xsd:date ;
    dcterms:identifier "2024/1689/EU" ;
    mailo:coversArticle mailo:AIAct_Art10,
        mailo:AIAct_Art17,
        mailo:AIAct_Art26,
        mailo:AIAct_Art50,
        mailo:AIAct_Art9 .

mailo:AIAct_Art14 a mailo:LegalArticle ;
    rdfs:label "AI Act Article 14"@en ;
    rdfs:comment "Human oversight for high-risk AI systems."@en ;
    mailo:complementedBy mailo:GDPR_Art22_3 .

mailo:BlackBoxMLSystem a owl:Class ;
    rdfs:label "BlackBoxMLSystem",
        "Black-Box ML System"@en ;
    rdfs:comment "Non-transparent self-learning ML system (C-817/19 prohibition)",
        "A non-transparent, self-learning system whose decision logic cannot be explained. Prohibited under C-817/19 for decisions with significant impact."@en,
        "Corrected in v5.1.0: previously declared a subclass of MedicalAISystem. Opacity is a property of a system's decision logic, not of its clinical application; the PNR system in C-817/19 was not medical."@en ;
    rdfs:seeAlso airo:OpaqueSystem ;
    rdfs:subClassOf mailo:AutomatedDecisionSystem .

mailo:ClinicalDecisionSupport a owl:Class ;
    rdfs:label "ClinicalDecisionSupport",
        "Clinical Decision Support System"@en ;
    rdfs:comment "Clinical decision support system (CDSS)" ;
    rdfs:subClassOf mailo:MedicalAISystem .

mailo:DPIAObligation a owl:Class ;
    rdfs:label "DPIAObligation",
        "DPIA Obligation"@en ;
    rdfs:comment "Obligation to carry out a DPIA under GDPR Art.35" ;
    rdfs:subClassOf mailo:ComplianceObligation ;
    owl:equivalentClass dpv:DPIA .

mailo:DataGovernanceConflict a mailo:ConflictType ;
    rdfs:label "Data governance conflict"@en ;
    rdfs:comment "Frameworks impose incompatible conditions on the acquisition, sharing or reuse of data (e.g. an EHDS opt-out reducing dataset representativeness against AI Act Art.10 data-quality duties)."@en .

mailo:DomainContext a mailo:InclusionBasis ;
    rdfs:label "Domain context"@en ;
    rdfs:comment "Retained as background for a cross-framework tension rather than for any principle it establishes."@en .

mailo:EPC a mailo:InternationalTreaty,
        mailo:RegulatoryFramework ;
    rdfs:label "European Patent Convention"@en ;
    dcterms:date "1977-10-07"^^xsd:date ;
    rdfs:comment "European Patent Convention (in force 1977-10-07). Governs patentability of AI/medical-AI inventions (Art.52 exclusions), sufficiency of disclosure for ML models (Art.83), and EPO opposition/appeal proceedings. Administered by EPO; distinct from EU law but intersects via UPC."@en ;
    mailo:coversArticle mailo:EPC_Art52,
        mailo:EPC_Art83 .

mailo:EPC_Art52 a mailo:LegalArticle ;
    rdfs:label "EPC Article 52"@en ;
    rdfs:comment "Patentable inventions; exclusion of mathematical methods and software as such."@en .

mailo:EPC_Art56 a mailo:LegalArticle ;
    rdfs:label "EPC Article 56"@en ;
    rdfs:comment "Inventive step. Basis for the line of authority holding that merely applying a known machine-learning technique to a particular field follows a general technological trend and is not inventive as such (T 161/18 point 3.6; followed in T 1191/19)."@en .

mailo:EPO_BoA a mailo:Court ;
    rdfs:label "EPO Board of Appeal"@en .

mailo:GDPR_2016_679 a mailo:EURegulation ;
    rdfs:label "GDPR 2016/679" ;
    mailo:celex "32016R0679" ;
    mailo:hasVersion mailo:GDPR_v1_FullyApplicable,
        mailo:GDPR_v2_OmnibusProposed_Art22 .

mailo:GDPR_Art15 a mailo:LegalArticle ;
    rdfs:label "GDPR Article 15"@en ;
    rdfs:comment "Right of access by the data subject."@en ;
    mailo:grantsRight mailo:Right_MedicalRecordAccess .

mailo:GDPR_Art22_1 a mailo:LegalArticle ;
    rdfs:label "GDPR Art.22(1)"@en ;
    rdfs:comment "Core prohibition: individuals shall not be subject to solely automated decisions producing significant effects."@en .

mailo:GDPR_Art22_2 a mailo:LegalArticle ;
    rdfs:label "GDPR Art.22(2)"@en ;
    rdfs:comment "Exceptions: contract necessity, explicit consent, EU/Member State law."@en .

mailo:GDPR_Art22_3 a mailo:LegalArticle ;
    rdfs:label "GDPR Art.22(3)"@en ;
    rdfs:comment "Safeguards when exceptions apply: human intervention, right to express views, contest decision."@en ;
    mailo:grantsRight mailo:Right_Contest,
        mailo:Right_ExpressViews,
        mailo:Right_HumanIntervention .

mailo:HumanOversightRecord a owl:Class ;
    rdfs:label "HumanOversightRecord",
        "Human Oversight Record"@en ;
    rdfs:comment "Documented record of substantive human review (C-634/21 P_634_002)",
        "A documented record of substantive human review of an automated decision (C-634/21 P_634_002: rubber-stamping is insufficient)."@en .

mailo:OmnibusAI_ProvisionalAgreement_20260507 a mailo:LegislativeAmendment ;
    rdfs:label "Digital Omnibus on AI — Provisional Agreement (Council + EP, 2026-05-07)" ;
    mailo:amendmentDescription "Provisional political agreement on Digital Omnibus on AI (Omnibus VII package). Extends Annex III standalone high-risk deadline to 2027-12-02 and Annex I (SaMD/MDR) deadline to 2028-08-02 via conditional standards-availability mechanism. Introduces unified MDR+AI Act notified body assessment pathway. Not yet formally adopted as of 2026-05-10; formal adoption expected before 2026-08-02. Source: Consilium press release 2026-05-07." ;
    mailo:versionStartDate "2026-05-07"^^xsd:date .

mailo:PLD_Art5 a mailo:LegalArticle ;
    rdfs:label "PLD Art.5 — Right to compensation (strict liability)"@en ;
    rdfs:comment "Any natural person suffering damage caused by a defective product is entitled to compensation, without proof of fault. The economic operators against whom that right is exercised are listed in Art.8. Corrected in v5.1.0 Round 5: this content was previously recorded as Art.4, which is the Definitions article closing Chapter I."@en .

mailo:Patent a owl:Class ;
    rdfs:label "Patent",
        "Patent"@en ;
    rdfs:comment "A patent grant" .

mailo:Right a owl:Class ;
    rdfs:label "Right",
        "Right"@en ;
    rdfs:comment "A legal right" .

mailo:TradeSecretConflict a mailo:ConflictType ;
    rdfs:label "Trade secret against transparency"@en ;
    rdfs:comment "A disclosure duty under one framework collides with a legitimate secrecy interest protected by another (TSD Art.2 against AI Act Art.13 and GDPR Art.15(1)(h))."@en .

mailo:UPC_LD_Dusseldorf a mailo:UPCDivision ;
    rdfs:label "UPC Local Division — Düsseldorf"@en .

mailo:CJEU_FirstChamber a mailo:Court ;
    rdfs:label "CJEU First Chamber"@en .

mailo:DesignerOperationalisation a mailo:EncodingBasis ;
    rdfs:label "Designer operationalisation"@en ;
    rdfs:comment "The court's test is open-textured and the constraint encodes a proxy for it. The paragraphs are correct; the operative predicate is MAILO's. Example: C-634/21 states a determining-role test; the substantive-oversight predicate is a proxy for it."@en .

mailo:DisclosureObligation a owl:Class ;
    rdfs:label "DisclosureObligation",
        "Disclosure Obligation"@en ;
    rdfs:comment "Obligation to disclose information to data subjects" ;
    rdfs:seeAlso dpv:ProvideInformation ;
    rdfs:subClassOf mailo:ComplianceObligation .

mailo:EPC_Art83 a mailo:LegalArticle ;
    rdfs:label "EPC Article 83"@en ;
    rdfs:comment "Disclosure of the invention — sufficiency of disclosure. For AI inventions, requires disclosure of suitable training and validation data and of the neural network's topology, activation functions, end conditions and learning mechanism (T 161/18; T 1191/19)."@en .

mailo:EPOProceding a owl:Class ;
    rdfs:label "EPOProceding",
        "EPO Proceeding"@en ;
    rdfs:comment "EPO opposition, appeal, or examination",
        "Opposition, appeal, or examination proceeding before the EPO."@en ;
    rdfs:subClassOf mailo:Case .

mailo:EUDirective a owl:Class ;
    rdfs:label "EUDirective",
        "EU Directive"@en ;
    rdfs:comment "EU Directive (requires transposition)" ;
    rdfs:subClassOf mailo:LegalInstrument .

mailo:GDPR a mailo:EURegulation,
        mailo:RegulatoryFramework ;
    rdfs:label "GDPR 2016/679"@en ;
    eli:id_local "32016R0679" ;
    dcterms:date "2016-04-27"^^xsd:date ;
    dcterms:identifier "2016/679/EU" ;
    rdfs:comment "General Data Protection Regulation. Core data protection framework; Art.22 governs solely automated decision-making, Art.15/15(1)(h) the right of access and meaningful information, Art.9 special category health data, Art.35 DPIA obligation."@en ;
    mailo:coversArticle mailo:GDPR_Art15,
        mailo:GDPR_Art15_1h,
        mailo:GDPR_Art22,
        mailo:GDPR_Art22_1,
        mailo:GDPR_Art22_2,
        mailo:GDPR_Art22_3,
        mailo:GDPR_Art22_4,
        mailo:GDPR_Art35,
        mailo:GDPR_Art9 .

mailo:GDPR_Art22 a mailo:LegalArticle ;
    rdfs:label "GDPR Article 22"@en ;
    rdfs:comment "Prohibition on solely automated individual decision-making."@en ;
    mailo:coversArticle mailo:GDPR .

mailo:GenomicDiagnosticAI a owl:Class ;
    rdfs:label "GenomicDiagnosticAI",
        "Genomic Diagnostic AI"@en ;
    rdfs:comment "AI system for genomic/genetic diagnostics" ;
    rdfs:subClassOf mailo:MedicalAISystem ;
    mailo:hasRisk mailo:Risk_EHDSOptOut,
        mailo:Risk_NPE_Revocation .

mailo:InternationalTreaty a owl:Class ;
    rdfs:label "InternationalTreaty",
        "International Treaty"@en ;
    rdfs:comment "International treaty or convention" ;
    rdfs:subClassOf mailo:LegalInstrument .

mailo:LegalInstrument a owl:Class ;
    rdfs:label "LegalInstrument",
        "Legal Instrument"@en ;
    rdfs:comment "Any binding or persuasive legal document",
        "Any binding or persuasive legal document (regulation, directive, treaty, standard)."@en ;
    rdfs:subClassOf eli:LegalResource .

mailo:RiskScoringSystem a owl:Class ;
    rdfs:label "RiskScoringSystem",
        "Risk Scoring System"@en ;
    rdfs:comment "Automated risk stratification or scoring system" ;
    rdfs:subClassOf mailo:AutomatedDecisionSystem .

mailo:TSD a mailo:EUDirective,
        mailo:RegulatoryFramework ;
    rdfs:label "Trade Secrets Directive 2016/943"@en ;
    eli:id_local "32016L0943" ;
    dcterms:date "2016-06-08"^^xsd:date ;
    dcterms:identifier "2016/943/EU" ;
    rdfs:comment "EU Trade Secrets Directive. Harmonises civil-law protection of undisclosed know-how and business information. Key for medical AI: model weights, training data schemas, and proprietary algorithms qualify as trade secrets under the Art.2 three-part test. Art.5 carve-outs limit the secrecy shield when exercise of the right to information is at stake — directly engaged by GDPR Art.15(1)(h) and AI Act Art.13 transparency obligations."@en ;
    mailo:coversArticle mailo:TSD_Art2,
        mailo:TSD_Art5,
        mailo:TSD_Art9 .

mailo:UPC_LD_Munich a mailo:UPCDivision ;
    rdfs:label "UPC Local Division — Munich"@en .

mailo:EncodingBasis a owl:Class ;
    rdfs:label "EncodingBasis"@en ;
    rdfs:comment """Whether an encoded principle states what a court held, or a
        construct of the ontology designer built on top of it.

        hasPrecedenceLevel records how much weight a holding claims. It cannot
        answer the prior question of whether the encoded proposition is a
        holding at all. Keeping the two apart means a reader can query for
        everything the graph asserts on the designer's own authority."""@en .

mailo:EuropeanPatent a owl:Class ;
    rdfs:label "EuropeanPatent",
        "European Patent (EP)"@en ;
    rdfs:comment "A European patent granted by the EPO" ;
    rdfs:subClassOf mailo:Patent .

mailo:Explanation a owl:Class ;
    rdfs:label "Explanation",
        "Explanation"@en ;
    rdfs:comment "Actionable non-technical explanation for data subjects (C-203/22 P_203_001)",
        "An actionable, non-technical explanation of the logic and main input factors of an automated decision (C-203/22 P_203_001; GDPR Art.15(1)(h))."@en .

mailo:HumanOversightObligation a owl:Class ;
    rdfs:label "HumanOversightObligation",
        "Human Oversight Obligation"@en ;
    rdfs:comment "Obligation to ensure substantive human review" ;
    rdfs:seeAlso airo:HumanOversight ;
    rdfs:subClassOf mailo:ComplianceObligation ;
    owl:equivalentClass dpv:HumanInvolvement .

mailo:UPCDivision a owl:Class ;
    rdfs:label "UPC Division"@en ;
    rdfs:subClassOf mailo:Court .

mailo:DataSubjectRight a owl:Class ;
    rdfs:label "DataSubjectRight",
        "Data Subject Right"@en ;
    rdfs:comment "A right of an individual under GDPR" ;
    rdfs:seeAlso dpv:DataSubjectRight ;
    rdfs:subClassOf mailo:Right .

mailo:ExplainabilityObligation a owl:Class ;
    rdfs:label "ExplainabilityObligation",
        "Explainability Obligation"@en ;
    rdfs:comment "Obligation to provide actionable explanations" ;
    rdfs:seeAlso dpv:ExplainabilityObligation ;
    rdfs:subClassOf mailo:ComplianceObligation .

mailo:GDPR_Art15_1h a mailo:LegalArticle ;
    rdfs:label "GDPR Art.15(1)(h)"@en ;
    rdfs:comment "Right to meaningful information about the logic, significance and envisaged consequences of automated processing."@en ;
    mailo:grantsRight mailo:Right_Explanation .

mailo:InclusionBasis a owl:Class ;
    rdfs:label "InclusionBasis"@en ;
    rdfs:comment """Why a case is present in MAILO at all.

        Added in v5.1.0 after an audit found two cases carrying medical-AI
        technology tags they did not warrant. The underlying defect was not
        the tags: it was that no instance recorded WHY it had been included,
        so twenty implicit inclusion judgements sat unstated across the graph
        and could not be reviewed.

        Note that MAILO's method is transposition. None of the three CJEU
        automated-decision cases is a medical-AI dispute: C-817/19 concerns
        passenger name records, C-634/21 and C-203/22 concern credit scoring.
        A criterion requiring direct medical-AI subject matter would exclude
        the trilogy the ontology is built on. The criterion therefore records
        the BASIS for relevance rather than demanding a single subject
        matter."""@en .

mailo:AIAct_2024_1689 a mailo:EURegulation ;
    rdfs:label "AI Act 2024/1689" ;
    mailo:celex "32024R1689" ;
    mailo:hasVersion mailo:AIAct_v1_ProhibitedPractices,
        mailo:AIAct_v2_GPAIModelObligations,
        mailo:AIAct_v3_OriginalHighRisk,
        mailo:AIAct_v3a_Omnibus_AnnexIII_Standalone,
        mailo:AIAct_v3b_Omnibus_AnnexI_SaMD,
        mailo:AIAct_v4_FRIA_PublicBodies .

mailo:ConflictType a owl:Class ;
    rdfs:label "ConflictType"@en ;
    rdfs:comment "Classification of the kind of friction a CrossFrameworkTension represents. Declared in v5.1.0: the five instances below were in use as values of mailo:conflictType but had never been typed."@en .

mailo:TransparencyObligation a owl:Class ;
    rdfs:label "TransparencyObligation",
        "Transparency Obligation"@en ;
    rdfs:comment "Obligation to be transparent about AI processing" ;
    rdfs:subClassOf mailo:ComplianceObligation ;
    owl:equivalentClass dpv:TransparencyObligation .

mailo:TransposedPrinciple a mailo:InclusionBasis ;
    rdfs:label "Transposed principle"@en ;
    rdfs:comment "The case establishes a principle in another domain that MAILO applies to medical AI by structural analogy. The transposition is the ontology designer's step, not the court's, and the affected shapes say so."@en .

mailo:DirectSubjectMatter a mailo:InclusionBasis ;
    rdfs:label "Direct subject matter"@en ;
    rdfs:comment "The case is itself about a medical AI or medical software system. Only such cases may carry a medical-AI value for mailo:involvesTechnology."@en .

mailo:LegalEntity a owl:Class ;
    rdfs:label "LegalEntity",
        "Legal Entity"@en ;
    rdfs:comment "Any natural or legal person with legal standing" .

mailo:Technology a owl:Class ;
    rdfs:label "Technology",
        "Technology"@en ;
    rdfs:comment "A medical AI technology class" .

mailo:ComplianceObligation a owl:Class ;
    rdfs:label "ComplianceObligation",
        "Compliance Obligation"@en ;
    rdfs:comment "A concrete obligation arising from regulation" .

mailo:CourtHolding a mailo:EncodingBasis ;
    rdfs:label "Court holding"@en ;
    rdfs:comment "The encoded proposition is what the court decided, at the paragraphs cited."@en .

mailo:PendingAmendment a owl:Class ;
    rdfs:label "Pending Amendment"@en ;
    rdfs:comment "A proposed but not yet adopted amendment to a legislative provision encoded in MAILO. MAILO encodes the numbering of the text currently in force; a PendingAmendment records, separately and explicitly, that a legislative proposal would change or delete that provision. The two are kept apart deliberately: encoding proposal numbering as though it were in force is the failure mode that produced the EHDS renumbering errors corrected in v5.1.0 Round 3."@en .

mailo:UPCCase a owl:Class ;
    rdfs:label "UPCCase",
        "UPC Case"@en ;
    rdfs:comment "Case before the Unified Patent Court",
        "Infringement, revocation, or PI proceeding before the Unified Patent Court."@en ;
    rdfs:subClassOf mailo:Case .

mailo:Company a owl:Class ;
    rdfs:label "Company",
        "Company"@en ;
    rdfs:comment "A corporate entity" ;
    rdfs:subClassOf mailo:LegalEntity .

mailo:Court a owl:Class ;
    rdfs:label "Court",
        "Court"@en ;
    rdfs:comment "A judicial body" ;
    rdfs:subClassOf mailo:LegalEntity .

mailo:LegislativeAmendment a owl:Class ;
    rdfs:label "LegislativeAmendment" ;
    rdfs:comment "A legislative event that creates or modifies a regulation version" .

mailo:EURegulation a owl:Class ;
    rdfs:label "EURegulation",
        "EU Regulation"@en ;
    rdfs:comment "EU Regulation (directly applicable)" ;
    rdfs:seeAlso eli:LegalResource ;
    rdfs:subClassOf mailo:LegalInstrument .

mailo:LegalPrinciple a owl:Class ;
    rdfs:label "LegalPrinciple",
        "Legal Principle"@en ;
    rdfs:comment "A binding or persuasive rule extracted from case law",
        "A binding or persuasive rule extracted from case law or legislation."@en .

mailo:RatioDecidendi a owl:Class ;
    rdfs:label "RatioDecidendi",
        "Ratio Decidendi"@en ;
    rdfs:comment "Binding legal reasoning upon which decision rests",
        "The binding legal reasoning upon which the decision rests."@en ;
    rdfs:subClassOf mailo:LegalPrinciple .

mailo:RegulationVersion a owl:Class ;
    rdfs:label "RegulationVersion" ;
    rdfs:comment "A versioned expression of an EU regulation at a specific applicability phase" ;
    rdfs:subClassOf mailo:EURegulation .

mailo:CJEUCase a owl:Class ;
    rdfs:label "CJEUCase",
        "CJEU Case"@en ;
    rdfs:comment "Judgment of the Court of Justice of the EU",
        "Preliminary ruling or direct action before the Court of Justice of the EU."@en ;
    rdfs:subClassOf mailo:Case .

mailo:CrossFrameworkTension a owl:Class ;
    rdfs:label "CrossFrameworkTension" ;
    rdfs:comment "A conflict or gap between two regulatory frameworks" .

mailo:MedicalAISystem a owl:Class ;
    rdfs:label "MedicalAISystem",
        "Medical AI System"@en ;
    rdfs:comment "An AI-based system used in clinical contexts",
        "An AI-based system used in clinical diagnosis, treatment recommendation, or patient risk stratification."@en ;
    rdfs:seeAlso airo:AISystem ;
    rdfs:subClassOf mailo:AutomatedDecisionSystem,
        mailo:Technology ;
    mailo:hasRisk mailo:Risk_BlackBox,
        mailo:Risk_HealthDataDoubleLayer,
        mailo:Risk_InsufficientDisclosure,
        mailo:Risk_PLDStrictLiability,
        mailo:Risk_SolelyTest .

mailo:ComplianceRisk a owl:Class ;
    rdfs:label "ComplianceRisk",
        "Compliance Risk"@en ;
    rdfs:comment "A compliance risk for medical AI developers" ;
    rdfs:seeAlso airo:Risk .

mailo:Case a owl:Class ;
    rdfs:label "Case",
        "Case"@en ;
    rdfs:comment "Any judicial or quasi-judicial proceeding",
        "Any judicial or quasi-judicial proceeding."@en .

mailo:RegulatoryFramework a owl:Class ;
    rdfs:label "RegulatoryFramework",
        "Regulatory Framework"@en ;
    rdfs:comment "A coherent body of rules governing a domain",
        "A coherent body of rules governing a specific domain."@en .

mailo:LiteratureSource a owl:Class ;
    rdfs:label "LiteratureSource" ;
    rdfs:comment "An academic paper, commentary, or official guidance" .

mailo:AutomatedDecisionSystem a owl:Class ;
    rdfs:label "AutomatedDecisionSystem",
        "Automated Decision System"@en ;
    rdfs:comment "System processing personal data without meaningful human review",
        "A system that processes personal data to produce outputs affecting individuals without meaningful human review."@en,
        "Corrected in v5.1.0: this class was declared rdfs:subClassOf mailo:MedicalAISystem, which entailed that every automated decision system is a medical AI system. The credit-scoring systems in C-634/21 and C-203/22 are counter-examples in MAILO's own graph. The relation runs the other way: a medical AI system producing decisions about individuals IS an automated decision system, which is why MedicalAISystem is now the subclass."@en ;
    rdfs:seeAlso dpv:DataProcessing ;
    rdfs:subClassOf mailo:Technology ;
    owl:equivalentClass dpv:AutomatedDecisionMaking .

mailo:LegalArticle a owl:Class ;
    rdfs:label "LegalArticle",
        "Legal Article"@en ;
    rdfs:comment "A specific provision within a legal instrument",
        "A specific provision within a legal instrument."@en ;
    rdfs:subClassOf eli:LegalExpression .

