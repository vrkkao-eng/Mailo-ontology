mailo:AIAct_v3b_Omnibus_AnnexI_SaMD a mailo:RegulationVersion ;
    rdfs:label "Omnibus-revised Annex I deadline — SaMD under MDR 2017/745 and IVDR 2017/746 (primary compliance target for MAILO)" ;
    mailo:applicablePhase "high_risk_annex_i_samd_omnibus" ;
    mailo:isCurrentVersion true ;
