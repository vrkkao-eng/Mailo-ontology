        mailo:OmnibusAI_ProvisionalAgreement_20260507 ;
    mailo:versionOf mailo:AIAct_2024_1689 ;
    mailo:versionStartDate "2028-08-02"^^xsd:date .

mailo:AIAct_v4_FRIA_PublicBodies a mailo:RegulationVersion ;
    rdfs:label "FRIA obligation for public-body deployers applies (Art.27)" ;
    mailo:applicablePhase "fria_public_bodies" ;
    mailo:isCurrentVersion false ;
    mailo:triggeredBy mailo:Amend_AIAct_v4_FRIA_PublicBodies ;
    mailo:versionOf mailo:AIAct_2024_1689 ;
    mailo:versionStartDate "2027-08-02"^^xsd:date .

mailo:Abbott a mailo:Company ;
    rdfs:label "Abbott Laboratories"@en .

mailo:Amend_AIAct_v1_ProhibitedPractices a mailo:LegislativeAmendment ;
    rdfs:label "Activation event: prohibited_practices_and_general" ;
    mailo:amendmentDescription "Entry into force — OJ L 2024/1689 published 12 July 2024" ;
    mailo:versionStartDate "2024-08-01"^^xsd:date .

mailo:Amend_AIAct_v2_GPAIModelObligations a mailo:LegislativeAmendment ;
    rdfs:label "Activation event: gpai_model_obligations" ;
    mailo:amendmentDescription "12-month anniversary — GPAI model chapter becomes applicable" ;
    mailo:versionStartDate "2025-08-02"^^xsd:date .

mailo:Amend_AIAct_v3_OriginalHighRisk a mailo:LegislativeAmendment ;
    rdfs:label "Activation event: high_risk_original_deadline" ;
    mailo:amendmentDescription "24-month anniversary — original high-risk deadline per Art.113(2); SUPERSEDED: Omnibus provisional agreement (2026-05-07) extends this deadline." ;
    mailo:versionStartDate "2026-08-02"^^xsd:date .

mailo:Amend_AIAct_v3a_Omnibus_AnnexIII_Standalone a mailo:LegislativeAmendment ;
    rdfs:label "Activation event: high_risk_annex_iii_omnibus" ;
    mailo:amendmentDescription "Omnibus VII provisional agreement — Annex III standalone systems: 2027-12-02. Conditional on harmonised standards availability (Article 6(2) revised)." ;
    mailo:versionStartDate "2027-12-02"^^xsd:date .

mailo:Amend_AIAct_v3b_Omnibus_AnnexI_SaMD a mailo:LegislativeAmendment ;
    rdfs:label "Activation event: high_risk_annex_i_samd_omnibus" ;
    mailo:amendmentDescription "Omnibus VII provisional agreement — Annex I systems (AI embedded in regulated products including medical devices): 2028-08-02. Single joint MDR+AI Act notified body assessment pathway available. Art.9/10/13/14/43 high-risk obligations apply by this date." ;
    mailo:versionStartDate "2028-08-02"^^xsd:date .

