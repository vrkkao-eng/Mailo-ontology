    rdfs:domain mailo:LegalArticle ;
    rdfs:range mailo:LegalArticle .

mailo:conflictsWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "conflicts with"@en ;
    rdfs:comment "Article conflicts with another",
        "Two legal obligations or principles that are in tension."@en ;
    rdfs:domain mailo:LegalArticle ;
    rdfs:range mailo:LegalArticle .

mailo:coversArticle a owl:ObjectProperty ;
    rdfs:label "covers article"@en ;
    rdfs:comment "Framework contains an article" ;
    rdfs:domain mailo:RegulatoryFramework ;
    rdfs:range mailo:LegalArticle .

