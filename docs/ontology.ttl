    rdfs:label "Activation event: fria_public_bodies" ;
    mailo:amendmentDescription "36-month anniversary — Fundamental Rights Impact Assessment mandatory for public-body deployers of high-risk AI systems" ;
    mailo:versionStartDate "2027-08-02"^^xsd:date .

mailo:CJEU_GrandChamber a mailo:Court ;
    rdfs:label "CJEU Grand Chamber"@en ;
    rdfs:comment "Highest formation of CJEU; judgments carry maximum precedential weight."@en .

mailo:C_201_14 a mailo:CJEUCase ;
    rdfs:label "C-201/14 Bara"@en ;
    dcterms:date "2015-10-01"^^xsd:date ;
    dcterms:identifier "C-201/14" ;
    mailo:citesPrecedent [ ] ;
    mailo:establishesPrinciple mailo:P_Bara_001 ;
    mailo:hasStatus "Final"^^xsd:string .

mailo:C_511_18 a mailo:CJEUCase ;
    rdfs:label "C-511/18 La Quadrature du Net"@en ;
    dcterms:date "2020-10-06"^^xsd:date ;
    dcterms:identifier "C-511/18" ;
    mailo:citesPrecedent mailo:C_201_14 ;
    mailo:hasStatus "Final"^^xsd:string .

mailo:C_817_19 a mailo:CJEUCase ;
    rdfs:label "C-817/19 Ligue des droits humains v. Conseil des ministres"@en ;
    dcterms:date "2022-06-21"^^xsd:date ;
    dcterms:identifier "C-817/19",
        "ECLI:EU:C:2022:491" ;
    skos:notation "ECLI:EU:C:2022:491" ;
    mailo:citesPrecedent mailo:C_511_18,
        mailo:C_634_21 ;
    mailo:decidedBy mailo:CJEU_GrandChamber ;
    mailo:establishesPrinciple mailo:P_817_001,
        mailo:P_817_002,
        mailo:P_817_003,
        mailo:P_817_004,
        mailo:P_817_005 ;
    mailo:hasOutcome "PNR Directive valid only with strict necessity; black-box ML systems prohibited; mandatory non-automated individual review; health status excluded from automated criteria."^^xsd:string ;
    mailo:hasStatus "Final — Grand Chamber binding precedent"^^xsd:string ;
    mailo:interpretesArticle mailo:Charter_Art7,
        mailo:Charter_Art8 ;
    mailo:involvesTechnology mailo:AutomatedDecisionSystem,
        mailo:BlackBoxMLSystem .

mailo:Charter_Art7 a mailo:LegalArticle ;
    rdfs:label "EU Charter Art.7"@en ;
    rdfs:comment "Respect for private and family life."@en .

mailo:Charter_Art8 a mailo:LegalArticle ;
    rdfs:label "EU Charter Art.8"@en ;
    rdfs:comment "Protection of personal data."@en .

mailo:ConformityAssessment a owl:Class ;
    rdfs:label "ConformityAssessment" ;
    rdfs:comment "A conformity assessment path under MDR or AI Act" .

mailo:ConformityRecord a owl:Class ;
    rdfs:label "ConformityRecord",
        "Conformity Record"@en ;
    rdfs:comment "Conformity assessment / technical documentation record",
        "A conformity assessment or technical documentation record under AI Act Annex IV / MDR Annex II."@en .

mailo:DGA_Art10 a mailo:LegalArticle ;
    rdfs:label "DGA Art.10 — Data Intermediation Services"@en ;
    rdfs:comment "Notification requirements for data intermediaries facilitating health data exchange between data subjects and AI developers. Must be neutral — cannot use data for own purposes."@en .

mailo:DGA_Art16 a mailo:LegalArticle ;
    rdfs:label "DGA Art.16 — Data Altruism Organisations"@en ;
    rdfs:comment "Registered data altruism organisations may collect health data voluntarily shared for AI research, subject to GDPR. Separate from commercial data intermediaries."@en .

mailo:DGA_Art2 a mailo:LegalArticle ;
    rdfs:label "DGA Art.2 — Re-use of Public Sector Health Data"@en ;
    rdfs:comment "Chapter II framework for re-use of protected public sector data (including health data subject to confidentiality). Applies to AI training use cases at hospitals and research institutes."@en .

mailo:DGA_Art31 a mailo:LegalArticle ;
    rdfs:label "DGA Art.31 — European Data Innovation Board"@en ;
    rdfs:comment "Advisory body for DGA implementation, including guidance on interoperability between health data repositories used for AI training."@en .

mailo:DPIARecord a owl:Class ;
    rdfs:label "DPIARecord",
        "DPIA Record"@en ;
    rdfs:comment "Data Protection Impact Assessment document (GDPR Art.35; C-817/19)",
        "A Data Protection Impact Assessment document required for high-risk automated processing (GDPR Art.35; C-817/19 P_817_005)."@en .

mailo:DataAct_Art15 a mailo:LegalArticle ;
    rdfs:label "Data Act Art.15 — Trade Secret Protection"@en ;
    rdfs:comment "Data sharing obligation is limited by trade secret protection — manufacturers may refuse where disclosure would reveal protected business information. Key tension with AI transparency obligations."@en .

mailo:DataAct_Art17 a mailo:LegalArticle ;
    rdfs:label "Data Act Art.17 — B2G Data Sharing (Public Emergency)"@en ;
    rdfs:comment "In public health emergencies, governments may require medical AI companies to share health data. Applies to epidemic surveillance AI and clinical trial datasets."@en .

mailo:DataAct_Art23 a mailo:LegalArticle ;
    rdfs:label "Data Act Art.23 — Switching Cloud Services"@en ;
    rdfs:comment "Medical AI providers using cloud infrastructure must enable switching between cloud providers without data lock-in. Relevant for hospital AI SaaS deployment models."@en .

mailo:DataAct_Art3 a mailo:LegalArticle ;
    rdfs:label "Data Act Art.3 — IoT Data Access Right"@en ;
    rdfs:comment "Users of connected medical devices (wearables, implantables) have a right to access data generated by those devices, enforceable against manufacturers. Extends GDPR Art.20 portability."@en .

mailo:DataAct_Art5 a mailo:LegalArticle ;
    rdfs:label "Data Act Art.5 — Data Sharing with Third Parties"@en ;
    rdfs:comment "Data holders must share IoT-generated health data with third parties at user request. Creates AI training data supply chain implications for medical device manufacturers."@en .

mailo:Dexcom a mailo:Company ;
    rdfs:label "Dexcom Inc."@en .

mailo:EHDS_Art33 a mailo:LegalArticle ;
    rdfs:label "EHDS Art.33 — Secondary Use Authorisation"@en ;
    rdfs:comment "Health data access bodies must authorise secondary use of health data for AI training, research, and policy. Access by data permit only; no direct de-identified access."@en .

mailo:EHDS_Art35 a mailo:LegalArticle ;
    rdfs:label "EHDS Art.35 — Opt-Out Right"@en ;
    rdfs:comment "Data subjects may opt out of secondary use of their health data in databases not requiring individual consent. Creates tension with AI Act Art.10 data governance obligations."@en .

mailo:EHDS_Art50 a mailo:LegalArticle ;
    rdfs:label "EHDS Art.50 — HealthData@EU Infrastructure"@en ;
    rdfs:comment "HealthData@EU federated cross-border health data access infrastructure. Enables EU-wide AI training datasets without raw data transfer."@en .

mailo:EHDS_Art68 a mailo:LegalArticle ;
    rdfs:label "EHDS Art.68 — European Health Data Space Board"@en ;
    rdfs:comment "Governance body coordinating national health data access bodies and harmonising data access rules for AI research across Member States."@en .

mailo:EP_2352431 a mailo:EuropeanPatent ;
    rdfs:label "EP 2 352 431 B1"@en ;
    rdfs:comment "Hologic breast imaging AI-assisted reading technology."@en .

mailo:EP_2671173 a mailo:EuropeanPatent ;
    rdfs:label "EP 2 671 173"@en ;
    rdfs:comment "Suinno AI-based pedestrian navigation method."@en .

mailo:EP_3346403 a mailo:EuropeanPatent ;
    rdfs:label "EP 3 346 403"@en ;
    rdfs:comment "Breast cancer recurrence prediction genomic expression test."@en .

mailo:GDPR_Art22_4 a mailo:LegalArticle ;
    rdfs:label "GDPR Art.22(4)"@en ;
    rdfs:comment "Enhanced protection for special category data (including health data) in automated decisions."@en .

mailo:GDPR_Art35 a mailo:LegalArticle ;
    rdfs:label "GDPR Article 35"@en ;
    rdfs:comment "Data Protection Impact Assessment (DPIA)."@en .

mailo:GDPR_Art9 a mailo:LegalArticle ;
    rdfs:label "GDPR Article 9"@en ;
    rdfs:comment "Processing of special categories of personal data, including health data."@en ;
    rdfs:seeAlso dpv:SpecialCategoryData .

mailo:GDPR_v1_FullyApplicable a mailo:RegulationVersion ;
    rdfs:label "GDPR fully applicable — all provisions in force" ;
    mailo:applicablePhase "fully_applicable" ;
    mailo:isCurrentVersion true ;
    mailo:versionOf mailo:GDPR_2016_679 ;
    mailo:versionStartDate "2018-05-25"^^xsd:date .

mailo:GDPR_v2_OmnibusProposed_Art22 a mailo:RegulationVersion ;
    rdfs:label "GDPR Art.22 Omnibus-proposed version — permission list framing (PROSPECTIVE, NOT ADOPTED)" ;
    mailo:applicablePhase "art22_omnibus_proposed_NOT_ADOPTED" ;
    mailo:isCurrentVersion false ;
    mailo:triggeredBy mailo:OmnibusGDPR_Art22_Proposal_20251119 ;
    mailo:versionOf mailo:GDPR_2016_679 .

mailo:GXDBio a mailo:NPE ;
    rdfs:label "GXD-Bio Corporation (NPE)"@en .

mailo:Hologic a mailo:Company ;
    rdfs:label "Hologic Inc."@en .

mailo:MDR_Art15 a mailo:LegalArticle ;
    rdfs:label "MDR Art.15 — Person Responsible for Regulatory Compliance"@en ;
    rdfs:comment "Manufacturers must designate a person responsible for regulatory compliance (PRRC). For AI-SaMD companies this person must have expertise in medical AI regulation."@en .

mailo:MDR_Art61 a mailo:LegalArticle ;
    rdfs:label "MDR Art.61 — Clinical Evaluation"@en ;
    rdfs:comment "Medical device manufacturers must conduct clinical evaluation demonstrating safety and performance. For AI-SaMD, AI-specific performance validation (bias, drift, edge cases) is required."@en .

mailo:MDR_Art83 a mailo:LegalArticle ;
    rdfs:label "MDR Art.83 — Post-Market Surveillance"@en ;
    rdfs:comment "PMS system must collect real-world performance data. For AI-SaMD: continuous monitoring of model drift and performance degradation in deployment populations."@en .

mailo:Microsoft a mailo:Company ;
    rdfs:label "Microsoft Corporation"@en .

mailo:MyriadGenetics a mailo:Company ;
    rdfs:label "Myriad Genetics Inc."@en .

mailo:NPE a owl:Class ;
    rdfs:label "NPE",
        "Non-Practising Entity"@en ;
    rdfs:comment "Non-Practising Entity — patent assertion vehicle" ;
    rdfs:subClassOf mailo:Company .

mailo:ObiterDictum a owl:Class ;
    rdfs:label "ObiterDictum",
        "Obiter Dictum"@en ;
    rdfs:comment "Persuasive (non-binding) judicial observation",
        "Persuasive (non-binding) judicial observation."@en ;
    rdfs:subClassOf mailo:LegalPrinciple .

mailo:OmnibusGDPR_Art22_Proposal_20251119 a mailo:LegislativeAmendment ;
    rdfs:label "Digital Omnibus Regulation — GDPR Art.22 Reframing Proposal (NOT YET ADOPTED)" ;
    mailo:amendmentDescription "Commission proposal (2025-11-19) to replace GDPR Art.22(1)-(2) prohibition structure with an exhaustive positive permission list for solely automated decision-making. EDPB-EDPS Joint Opinion 2/2026 (2026-02-11) strongly opposes the reframing, citing CJEU confirmation of Art.22 as a prohibition in principle (C-634/21, C-817/19). Status: UNADOPTED — in trilogue negotiation as of 2026-05-10. MAILO SHACL shapes remain grounded in current prohibition structure. If adopted, NodeShapes C634_Art22ProhibitionShape and related shapes require reformulation to encode positive permission conditions rather than absence of exception." ;
    mailo:versionStartDate "2025-11-19"^^xsd:date .

mailo:PLD_Art10 a mailo:LegalArticle ;
    rdfs:label "PLD Art.10 — Presumption of Defectiveness"@en ;
    rdfs:comment "Rebuttable presumption of defect where: defendant fails to disclose; product does not comply with mandatory safety requirements; obvious malfunction occurs. Reduces claimant's evidential burden."@en .

mailo:PLD_Art11 a mailo:LegalArticle ;
    rdfs:label "PLD Art.11 — Causation Presumption"@en ;
    rdfs:comment "Rebuttable causation presumption where defect is established and damage is of a kind normally caused by the defect. Key for medical AI harm cases."@en .

mailo:PLD_Art7 a mailo:LegalArticle ;
    rdfs:label "PLD Art.7 — AI and Software as Products"@en ;
    rdfs:comment "Expressly includes software (including AI systems) in the definition of 'product'. SaMD under MDR may simultaneously be a 'product' under PLD."@en .

mailo:PLD_Art9 a mailo:LegalArticle ;
    rdfs:label "PLD Art.9 — Disclosure Obligations (Evidence Facilitation)"@en ;
    rdfs:comment "Courts may order defendants to disclose evidence about high-risk AI systems; creates procedural discovery mechanism absent in AILD."@en .

mailo:P_203_001 a mailo:RatioDecidendi ;
    rdfs:label "P-203/22-001: Meaningful Explainability Standard"@en ;
    rdfs:comment "Art.15(1)(h) requires actionable explanations in non-technical language, identifying which inputs affected the output and the main reasoning path. Abstract mathematical formulas are insufficient."@en ;
    mailo:appliesTo mailo:AutomatedDecisionSystem,
        mailo:MedicalAISystem ;
    mailo:hasPrecedenceLevel "binding_ratio"^^xsd:string ;
    mailo:triggersObligation mailo:ExplainabilityObligation .

mailo:P_307_001 a mailo:RatioDecidendi ;
    rdfs:label "P-307/22-001: Unconditional Patient Record Access"@en ;
    rdfs:comment "Patients have an unconditional right to a complete copy of their medical records, free of charge, including all AI-generated diagnostic outputs, in a faithful and comprehensible format."@en ;
    mailo:appliesTo mailo:MedicalAISystem ;
    mailo:hasPrecedenceLevel "binding_ratio"^^xsd:string ;
    mailo:triggersObligation mailo:DisclosureObligation,
        mailo:TransparencyObligation .

mailo:P_634_001 a mailo:RatioDecidendi ;
    rdfs:label "P-634/21-001: Broad 'Decision' Concept"@en ;
    rdfs:comment "A 'decision' under Art.22 encompasses any act producing legal or similarly significant effects. Automated scoring creating probabilities relied upon by third parties constitutes a 'decision'."@en ;
    mailo:appliesTo mailo:AutomatedDecisionSystem,
        mailo:ClinicalDecisionSupport,
        mailo:RiskScoringSystem ;
    mailo:hasPrecedenceLevel "binding_ratio"^^xsd:string .

mailo:P_634_002 a mailo:RatioDecidendi ;
    rdfs:label "P-634/21-002: Functional 'Solely' Test"@en ;
    rdfs:comment "'Solely' is assessed functionally: formal human intervention that does not constitute substantive review (rubber-stamping) does not negate the 'solely' requirement. The decisive weight given to the automated output is the test."@en ;
    mailo:appliesTo mailo:AutomatedDecisionSystem,
        mailo:ClinicalDecisionSupport,
        mailo:MedicalImagingAI ;
    mailo:hasPrecedenceLevel "binding_ratio"^^xsd:string ;
    mailo:triggersObligation mailo:HumanOversightObligation .

mailo:P_634_003 a mailo:RatioDecidendi ;
    rdfs:label "P-634/21-003: Multi-Actor ADM Chain Gap-Filling"@en ;
    rdfs:comment "The prohibition in Art.22 cannot be circumvented by splitting the automated decision across multiple actors (scoring agency + final decision maker). Both may bear responsibility."@en ;
    mailo:appliesTo mailo:AutomatedDecisionSystem ;
    mailo:hasPrecedenceLevel "binding_ratio"^^xsd:string .

mailo:P_634_004 a mailo:RatioDecidendi ;
    rdfs:label "P-634/21-004: Art.22 = Prohibition Rule"@en ;
    rdfs:comment "Art.22(1) is a prohibition rule, not merely a right to object. Exceptions in Art.22(2) are exhaustive; safeguards in Art.22(3) are mandatory when an exception applies."@en ;
    mailo:hasPrecedenceLevel "persuasive_obiter"^^xsd:string .

mailo:P_817_001 a mailo:RatioDecidendi ;
    rdfs:label "P-817/19-001: Mandatory Non-Automated Individual Review"@en ;
    rdfs:comment "Any positive match from automated PNR analysis must be subject to individual non-automated review before any measure is taken. Establishes constitutional minimum for meaningful human intervention."@en ;
    mailo:appliesTo mailo:AutomatedDecisionSystem,
        mailo:MedicalAISystem ;
    mailo:hasPrecedenceLevel "constitutional_grand_chamber"^^xsd:string ;
    mailo:triggersObligation mailo:HumanOversightObligation .

mailo:P_817_002 a mailo:RatioDecidendi ;
    rdfs:label "P-817/19-002: Black-Box ML Prohibition"@en ;
    rdfs:comment "Non-transparent, self-learning ML risk assessment systems may not be used for decisions with significant impact. Pre-determined criteria and regular review are required."@en ;
    mailo:appliesTo mailo:BlackBoxMLSystem,
        mailo:MedicalAISystem ;
    mailo:hasPrecedenceLevel "constitutional_grand_chamber"^^xsd:string ;
    mailo:triggersObligation mailo:ExplainabilityObligation,
        mailo:TransparencyObligation .

mailo:P_817_003 a mailo:RatioDecidendi ;
    rdfs:label "P-817/19-003: Strict Necessity Tri-Level Proportionality Test"@en ;
    rdfs:comment "Large-scale automated processing must satisfy: (a) targeted scope, (b) purpose limitation, (c) temporal limitation. Failure at any level invalidates the entire processing system."@en ;
    mailo:appliesTo mailo:AutomatedDecisionSystem ;
    mailo:hasPrecedenceLevel "constitutional_grand_chamber"^^xsd:string .

mailo:P_817_004 a mailo:RatioDecidendi ;
    rdfs:label "P-817/19-004: Non-Discrimination — Health Status Excluded"@en ;
    rdfs:comment "Automated assessment criteria must not be based on health status. AI systems trained on medical history data may not use health condition as a discriminatory classification basis."@en ;
    mailo:appliesTo mailo:GenomicDiagnosticAI,
        mailo:MedicalAISystem ;
    mailo:hasPrecedenceLevel "constitutional_grand_chamber"^^xsd:string .

mailo:P_817_005 a mailo:ObiterDictum ;
    rdfs:label "P-817/19-005: Independent Oversight Obligation"@en ;
    rdfs:comment "Automated processing systems must be subject to effective independent oversight including DPO access and regular algorithmic legality review."@en ;
    mailo:hasPrecedenceLevel "persuasive_obiter"^^xsd:string ;
    mailo:triggersObligation mailo:DPIAObligation .

mailo:P_Bara_001 a mailo:RatioDecidendi ;
    rdfs:label "Transparency Rights Foundation"@en ;
    rdfs:comment "Data subjects must be informed of data transfers; establishes foundational transparency obligation."@en ;
    mailo:hasPrecedenceLevel "binding_ratio"^^xsd:string .

mailo:PatentClassification a owl:Class ;
    rdfs:label "PatentClassification" ;
    rdfs:comment "An IPC/CPC patent classification code" .

mailo:PatientRight a owl:Class ;
    rdfs:label "PatientRight",
        "Patient Right"@en ;
    rdfs:comment "A patient-specific data or health right" ;
    rdfs:subClassOf mailo:DataSubjectRight .

mailo:RegulatoryAuthority a owl:Class ;
    rdfs:label "RegulatoryAuthority" ;
    rdfs:comment "An EU or national regulatory or supervisory body" .

mailo:Right_Contest a mailo:DataSubjectRight ;
    rdfs:label "Right to Contest Decision (Art.22(3)(c))"@en .

mailo:Right_Explanation a mailo:DataSubjectRight ;
    rdfs:label "Right to Meaningful Explanation (Art.15(1)(h), C-203/22)"@en .

mailo:Right_ExpressViews a mailo:DataSubjectRight ;
    rdfs:label "Right to Express Views (Art.22(3)(b))"@en .

mailo:Right_HumanIntervention a mailo:DataSubjectRight ;
    rdfs:label "Right to Human Intervention (Art.22(3)(a))"@en .

mailo:Right_MedicalRecordAccess a mailo:PatientRight ;
    rdfs:label "Right to Access Medical Records (C-307/22)"@en .

mailo:Risk_AIActQMS_MDR_Overlap a mailo:ComplianceRisk ;
    rdfs:label "AI Act Art.17 QMS / MDR Annex IX Double Burden"@en ;
    rdfs:comment "AI-SaMD must comply with both AI Act QMS (Art.17) and MDR QMS (Annex IX). Without regulatory alignment, manufacturers face duplicative audit requirements."@en ;
    mailo:riskLevel "HIGH"^^xsd:string .

mailo:Risk_BlackBox a mailo:ComplianceRisk ;
    rdfs:label "Black-Box ML System (C-817/19 Prohibition)"@en ;
    mailo:mitigatedBy mailo:ExplainabilityObligation,
        mailo:TransparencyObligation ;
    mailo:riskLevel "HIGH"^^xsd:string .

mailo:Risk_DataActIoT a mailo:ComplianceRisk ;
    rdfs:label "Data Act Art.3/5 IoT Data Sharing Obligation"@en ;
    rdfs:comment "Medical device manufacturers must share IoT-generated health data with users/third parties. Conflicts with trade secret protection (Art.15) and competitive AI training data strategies."@en ;
    mailo:riskLevel "MEDIUM"^^xsd:string .

mailo:Risk_EHDSOptOut a mailo:ComplianceRisk ;
    rdfs:label "EHDS Art.35 Opt-Out Erodes Training Dataset"@en ;
    rdfs:comment "Widespread exercise of opt-out rights under EHDS Art.35 may substantially reduce available health data for AI training, creating representativeness risk under AI Act Art.10."@en ;
    mailo:riskLevel "MEDIUM"^^xsd:string .

mailo:Risk_EPOUPC_Divergence a mailo:ComplianceRisk ;
    rdfs:label "EPO-UPC Divergent Validity Rulings (Opt-Out Strategy)"@en ;
    mailo:riskLevel "HIGH"^^xsd:string .

mailo:Risk_HealthDataDoubleLayer a mailo:ComplianceRisk ;
    rdfs:label "Health Data Double Protection Layer (Art.9 + Art.22(4))"@en ;
    mailo:mitigatedBy mailo:DPIAObligation ;
    mailo:riskLevel "CRITICAL"^^xsd:string .

mailo:Risk_InsufficientDisclosure a mailo:ComplianceRisk ;
    rdfs:label "Insufficient Training Data Disclosure (EPO T0161/18)"@en ;
    mailo:mitigatedBy mailo:DisclosureObligation ;
    mailo:riskLevel "HIGH"^^xsd:string .

mailo:Risk_NPE_Revocation a mailo:ComplianceRisk ;
    rdfs:label "NPE-Initiated Revocation Attack"@en ;
    mailo:riskLevel "MEDIUM"^^xsd:string .

mailo:Risk_PLDStrictLiability a mailo:ComplianceRisk ;
    rdfs:label "PLD 2024 Strict Liability for AI-SaMD"@en ;
    rdfs:comment "Medical AI systems qualifying as 'defective products' under PLD Art.4 expose manufacturers to strict liability without fault. Presumptions in Art.10 and Art.11 shift burden to defendants."@en ;
    mailo:mitigatedBy mailo:HumanOversightObligation,
        mailo:TransparencyObligation ;
    mailo:riskLevel "HIGH"^^xsd:string .

mailo:Risk_SEP_FRAND a mailo:ComplianceRisk ;
    rdfs:label "SEP/FRAND Obligations (HL7 FHIR, DICOM AI)"@en ;
    mailo:riskLevel "MEDIUM"^^xsd:string .

mailo:Risk_SolelyTest a mailo:ComplianceRisk ;
    rdfs:label "GDPR Art.22 'Solely' Test Failure (Rubber-Stamping)"@en ;
    mailo:mitigatedBy mailo:HumanOversightObligation ;
    mailo:riskLevel "CRITICAL"^^xsd:string .

mailo:SiemensHealthineers a mailo:Company ;
    rdfs:label "Siemens Healthineers AG"@en .

mailo:TSD_Art2 a mailo:LegalArticle ;
    rdfs:label "TSD Article 2 — Definition of Trade Secret"@en ;
    rdfs:comment "Three-part cumulative test: information must be (1) secret (not generally known or readily accessible), (2) have commercial value because it is secret, and (3) be subject to reasonable steps to keep it secret. All three must hold for ML model weights or training data to qualify."@en .

mailo:TSD_Art5 a mailo:LegalArticle ;
    rdfs:label "TSD Article 5 — Exceptions"@en ;
    rdfs:comment "Trade secret protection does not apply where disclosure is required for the exercise of the right to information. Directly engaged when a data subject invokes GDPR Art.15(1)(h) or AI Act Art.86 for an explanation of an automated medical decision — controller cannot use TSD Art.2 to block all causal explanation (C-203/22 §§60-70)."@en .

mailo:TSD_Art9 a mailo:LegalArticle ;
    rdfs:label "TSD Article 9 — Preservation of Confidentiality in Legal Proceedings"@en ;
    rdfs:comment "Courts may impose confidentiality measures to protect trade secrets during litigation. Relevant to UPC discovery proceedings where a party seeks disclosure of AI model architecture or training data as part of infringement or validity analysis."@en .

mailo:UPC a mailo:Court ;
    rdfs:label "Unified Patent Court (UPC)"@en .

mailo:UPC_CD_Paris a mailo:UPCDivision ;
    rdfs:label "UPC Central Division — Paris"@en .

mailo:UPC_CoA a mailo:Court ;
    rdfs:label "UPC Court of Appeal"@en ;
    rdfs:subClassOf mailo:UPC .

mailo:UPC_LD_Paris a mailo:UPCDivision ;
    rdfs:label "UPC Local Division — Paris"@en .

mailo:AIAct a mailo:EURegulation,
        mailo:RegulatoryFramework ;
    rdfs:label "EU AI Act 2024/1689"@en ;
    eli:id_local "32024R1689" ;
    dcterms:date "2024-08-01"^^xsd:date ;
    dcterms:identifier "2024/1689/EU" ;
    mailo:coversArticle mailo:AIAct_Art10,
        mailo:AIAct_Art17,
        mailo:AIAct_Art26,
        mailo:AIAct_Art50,
        mailo:AIAct_Art9 .

mailo:AIAct_Art14 a mailo:LegalArticle ;
    rdfs:label "AI Act Article 14"@en ;
    rdfs:comment "Human oversight for high-risk AI systems."@en ;
    mailo:complementedBy mailo:GDPR_Art22_3 .

mailo:BlackBoxMLSystem a owl:Class ;
    rdfs:label "BlackBoxMLSystem",
        "Black-Box ML System"@en ;
    rdfs:comment "Non-transparent self-learning ML system (C-817/19 prohibition)",
        "A non-transparent, self-learning system whose decision logic cannot be explained. Prohibited under C-817/19 for decisions with significant impact."@en ;
    rdfs:seeAlso airo:OpaqueSystem ;
    rdfs:subClassOf mailo:MedicalAISystem .

mailo:C_634_21 a mailo:CJEUCase ;
    rdfs:label "C-634/21 SCHUFA Holding (Scoring)"@en ;
    dcterms:date "2023-12-07"^^xsd:date ;
    dcterms:identifier "C-634/21",
        "ECLI:EU:C:2023:957" ;
    skos:notation "ECLI:EU:C:2023:957" ;
    mailo:citesPrecedent mailo:C_817_19 ;
    mailo:decidedBy mailo:CJEU_FirstChamber ;
    mailo:establishesPrinciple mailo:P_634_001,
        mailo:P_634_002,
        mailo:P_634_003,
        mailo:P_634_004 ;
    mailo:hasOutcome "GDPR Art.22(1) constitutes a prohibition; automated scoring by credit agency = 'decision' triggering Art.22; 'solely' test is functional not formal."^^xsd:string ;
    mailo:hasStatus "Final — binding precedent"^^xsd:string ;
    mailo:interpretesArticle mailo:GDPR_Art15_1h,
        mailo:GDPR_Art22,
        mailo:GDPR_Art22_1,
        mailo:GDPR_Art22_2 ;
    mailo:involvesTechnology mailo:RiskScoringSystem .

mailo:ClinicalDecisionSupport a owl:Class ;
    rdfs:label "ClinicalDecisionSupport",
        "Clinical Decision Support System"@en ;
    rdfs:comment "Clinical decision support system (CDSS)" ;
    rdfs:subClassOf mailo:MedicalAISystem .

mailo:DPIAObligation a owl:Class ;
    rdfs:label "DPIAObligation",
        "DPIA Obligation"@en ;
    rdfs:comment "Obligation to carry out a DPIA under GDPR Art.35" ;
    rdfs:subClassOf mailo:ComplianceObligation ;
    owl:equivalentClass dpv:DPIA .

mailo:EPC a mailo:InternationalTreaty,
        mailo:RegulatoryFramework ;
    rdfs:label "European Patent Convention"@en ;
    dcterms:date "1977-10-07"^^xsd:date ;
    rdfs:comment "European Patent Convention (in force 1977-10-07). Governs patentability of AI/medical-AI inventions (Art.52 exclusions), sufficiency of disclosure for ML models (Art.83), and EPO opposition/appeal proceedings. Administered by EPO; distinct from EU law but intersects via UPC."@en ;
    mailo:coversArticle mailo:EPC_Art52,
        mailo:EPC_Art83 .

mailo:EPO_BoA a mailo:Court ;
    rdfs:label "EPO Board of Appeal"@en .

mailo:EPO_T0161_18 a mailo:EPOProceding ;
    rdfs:label "EPO T 0161/18 — AI Medical Device Disclosure"@en ;
    dcterms:date "2020-05-12"^^xsd:date ;
    dcterms:identifier "T 0161/18" ;
    mailo:decidedBy mailo:EPO_BoA ;
    mailo:hasOutcome "AI medical device patent invalid for insufficient disclosure: training data set characteristics must be disclosed. Gold standard for AI patent sufficiency in EPO and UPC."^^xsd:string ;
    mailo:interpretesArticle mailo:EPC_Art52,
        mailo:EPC_Art83 ;
    mailo:involvesTechnology mailo:MedicalAISystem .

