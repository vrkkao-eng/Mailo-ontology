  {
    "@id": "https://w3id.org/mailo#OmnibusAI_ProvisionalAgreement_20260507",
    "@type": [
      "https://w3id.org/mailo#LegislativeAmendment"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Digital Omnibus on AI — Provisional Agreement (Council + EP, 2026-05-07)"
      }
    ],
    "https://w3id.org/mailo#amendmentDescription": [
      {
        "@value": "Provisional political agreement on Digital Omnibus on AI (Omnibus VII package). Extends Annex III standalone high-risk deadline to 2027-12-02 and Annex I (SaMD/MDR) deadline to 2028-08-02 via conditional standards-availability mechanism. Introduces unified MDR+AI Act notified body assessment pathway. Not yet formally adopted as of 2026-05-10; formal adoption expected before 2026-08-02. Source: Consilium press release 2026-05-07."
      }
    ],
    "https://w3id.org/mailo#versionStartDate": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-05-07"
      }
