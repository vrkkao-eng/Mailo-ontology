  {
    "@id": "https://w3id.org/mailo#OmnibusGDPR_Art22_Proposal_20251119",
    "@type": [
      "https://w3id.org/mailo#LegislativeAmendment"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Digital Omnibus Regulation — GDPR Art.22 Reframing Proposal (NOT YET ADOPTED)"
      }
    ],
    "https://w3id.org/mailo#amendmentDescription": [
      {
        "@value": "Commission proposal (2025-11-19) to replace GDPR Art.22(1)-(2) prohibition structure with an exhaustive positive permission list for solely automated decision-making. EDPB-EDPS Joint Opinion 2/2026 (2026-02-11) strongly opposes the reframing, citing CJEU confirmation of Art.22 as a prohibition in principle (C-634/21, C-817/19). Status: UNADOPTED — in trilogue negotiation as of 2026-05-10. MAILO SHACL shapes remain grounded in current prohibition structure. If adopted, NodeShapes C634_Art22ProhibitionShape and related shapes require reformulation to encode positive permission conditions rather than absence of exception."
      }
    ],
    "https://w3id.org/mailo#versionStartDate": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2025-11-19"
      }
    ]
  },
