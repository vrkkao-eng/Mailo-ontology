    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Core prohibition: individuals shall not be subject to solely automated decisions producing significant effects."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "GDPR Art.22(1)"
      }
    ]
