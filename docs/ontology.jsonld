  {
    "@id": "https://w3id.org/mailo#Tension_EPO_MDR_SemanticScope",
    "@type": [
      "https://w3id.org/mailo#CrossFrameworkTension"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "EPO patent prosecution optimises for broad technical-effect claims (wider scope = stronger IP protection); MDR Annex II requires precise intended-purpose specification (narrower scope = easier clinical evaluation); AI Act Art.9/13 requires intermediate characterisation covering intended purpose plus reasonably foreseeable misuse. The same SaMD must be described at opposing granularity levels across three institutional knowledge spaces. No EPO, MDCG, or AI Office guidance addresses this triangular scope alignment problem."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "EPO G-II §3.3 broad claim scope vs. MDR Annex II §1.1 + AI Act Art.9/13 intended purpose"
      }
    ],
    "https://w3id.org/mailo#conflictType": [
      {
        "@id": "https://w3id.org/mailo#SemanticGranularityConflict"
      }
    ],
    "https://w3id.org/mailo#hasResolutionStatus": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "unresolved"
      }
    ]
  },
  {
