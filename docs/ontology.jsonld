    "http://purl.org/dc/terms/description": [
      {
        "@value": "Colang DSL + dialogue-state engine; rules user-defined and interpretable. 2025 update: NIM micro-services with ~0.5s added latency for ~50% protection lift. Establishes programmable-rail paradigm; uses ad-hoc DSL not formal ontology."
      }
    ],
