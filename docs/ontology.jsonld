  {
    "@id": "https://w3id.org/mailo#Tension_EHDS_GDPR_OptOut",
    "@type": [
      "https://w3id.org/mailo#CrossFrameworkTension"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "EHDS Art.35 grants patients an unconditional right to opt out of secondary health data use. Where opt-out rates are elevated in a clinically significant subpopulation, the resulting training dataset violates AI Act Art.10(3) representativeness. No legislative safe harbour bridges these positions."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "EHDS Art.35 opt-out vs. AI Act Art.10(3) representativeness"
