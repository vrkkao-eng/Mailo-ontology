  {
    "@id": "https://w3id.org/mailo#Tension_TSD_AIAct_Transparency",
    "@type": [
      "https://w3id.org/mailo#CrossFrameworkTension"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "TSD Art.2 protects model weights, training data schemas, and architecture as trade secrets. AI Act Art.13 requires deployers to receive sufficient information about high-risk AI system capabilities and limitations. C-203/22 §§60-70 sets the mandatory floor: controller cannot invoke TSD Art.2 to deny all causal explanation of an automated decision — disputed information must be produced to the competent supervisory authority or court for balance. AI Act Art.78 ensures national authority confidentiality but does not disapply Art.13 disclosure to deployers. TSD Art.5 is the only legislative bridge but its scope in the medical AI context remains unresolved pending a CJEU reference on Art.22 and clinical AI."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "TSD Art.2 Trade Secret vs. AI Act Art.13 + GDPR Art.15(1)(h) — Core Transparency Tension"
      }
    ],
    "https://w3id.org/mailo#conflictType": [
      {
        "@id": "https://w3id.org/mailo#TradeSecretConflict"
      }
    ],
    "https://w3id.org/mailo#conflictsWith": [
      {
        "@id": "https://w3id.org/mailo#ExplainabilityObligation"
      },
      {
        "@id": "https://w3id.org/mailo#TransparencyObligation"
      }
    ],
    "https://w3id.org/mailo#hasResolutionStatus": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "partial"
      }
    ],
    "https://w3id.org/mailo#involvesFramework": [
      {
        "@id": "https://w3id.org/mailo#AIAct"
      },
      {
        "@id": "https://w3id.org/mailo#GDPR"
      },
      {
        "@id": "https://w3id.org/mailo#TSD"
      }
    ]
  },
