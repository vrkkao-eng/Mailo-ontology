  {
    "@id": "https://w3id.org/mailo#Risk_TradeSecretTransparencyConflict",
    "@type": [
      "https://w3id.org/mailo#ComplianceRisk"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Medical AI operators relying on TSD Art.2 to protect model weights face: (a) mandatory AI Act Art.13 disclosure to deployers; (b) GDPR Art.15(1)(h) actionable explanation obligations to data subjects; (c) mandatory supervisory authority adjudication when TSD is claimed (C-203/22). Hybrid strategy required: patent final outputs, trade secret the AI platform, use ZKP/ZKML for auditor verification without weight disclosure."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Trade Secret Shield vs. AI Act/GDPR Transparency Mandate (TSD Art.2 Conflict)"
      }
    ],
    "https://w3id.org/mailo#mitigatedBy": [
      {
        "@id": "https://w3id.org/mailo#ExplainabilityObligation"
      }
    ],
    "https://w3id.org/mailo#riskLevel": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "HIGH"
      }
    ]
  },
