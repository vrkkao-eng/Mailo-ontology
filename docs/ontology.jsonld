  {
    "@id": "https://w3id.org/mailo#Tension_BlackBox_PatentProtection",
    "@type": [
      "https://w3id.org/mailo#CrossFrameworkTension"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\r\n        Deep-learning medical AI is inherently opaque (black-box). Patent protection incentivises\r\n        secrecy over model weights. EU AI Act Art.13 and C-817/19 black-box prohibition\r\n        require transparency for high-risk AI systems, creating structural tension with\r\n        commercial IP protection strategies. TSD Art.2 reinforces the secrecy interest;\r\n        TSD Art.5 carve-outs are the only legislative bridge, but their scope is unresolved.\r\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Black-Box Patent Protection vs. EU AI Act Transparency Obligation"
      }
    ],
    "https://w3id.org/mailo#conflictsWith": [
      {
        "@id": "https://w3id.org/mailo#TransparencyObligation"
      }
    ],
    "https://w3id.org/mailo#involvesFramework": [
      {
        "@id": "https://w3id.org/mailo#AIAct"
      },
      {
        "@id": "https://w3id.org/mailo#EPC"
      },
      {
        "@id": "https://w3id.org/mailo#TSD"
      }
    ]
  },
