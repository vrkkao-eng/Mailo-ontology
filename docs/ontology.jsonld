  {
    "@id": "https://w3id.org/mailo#lit_Golpayegani_D_Pandit_H_J_Lewis_D_2022_2025_AIRO",
    "@type": [
      "https://w3id.org/mailo#LiteratureSource"
    ],
    "http://purl.org/dc/terms/date": [
      {
        "@value": "2025"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "OWL ontology + SHACL shapes implementing AI Act Annex III high-risk classifier + SPARQL ASK queries; integrated into W3C DPVCG. Most direct competitor to MAILO. AIRO already does for the AI Act what MAILO proposes for the medical-AI multi-framework intersection. Differentiator: MAILO adds medical-domain specificity, MDR+PLD integration, CJEU precedent chain, UPC patent overlay."
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://delaramglp.github.io/airo/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Golpayegani, D., Pandit, H. J., Lewis, D. (2022, 2025). AIRO: An Ontology for Representing AI Risks Based on the Proposed EU AI Act. SEMANTiCS + arXiv:2501.10391."
      }
    ],
