  {
    "@id": "https://w3id.org/mailo#TSD_Art5",
    "@type": [
      "https://w3id.org/mailo#LegalArticle"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Trade secret protection does not apply where disclosure is required for the exercise of the right to information. Directly engaged when a data subject invokes GDPR Art.15(1)(h) or AI Act Art.86 for an explanation of an automated medical decision — controller cannot use TSD Art.2 to block all causal explanation (C-203/22 §§60-70)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "TSD Article 5 — Exceptions"
      }
    ]
  },
  {
    "@id": "https://w3id.org/mailo#lit_Medical_Law_Review_2024_A_health-conformant_reading_of_t",
    "@type": [
      "https://w3id.org/mailo#LiteratureSource"
    ],
    "http://purl.org/dc/terms/date": [
      {
        "@value": "2024"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "Only article addressing the exact intersection of GDPR Art.22 + medical AI. Doctrinal foundation for MAILO's medical-AI ADM rules."
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://academic.oup.com/medlaw/article/32/3/373/7732100"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Medical Law Review. (2024). A health-conformant reading of the GDPR's right not to be subject to automated decision-making, 32(3), 373."
      }
    ],
    "https://w3id.org/mailo#relevanceScore": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 5
      }
    ]
  },
  {
    "@id": "https://w3id.org/mailo#lit_Kang_M_Li_B_et_al_2025_R_-Guard_Robust_Reasoning_E",
    "@type": [
      "https://w3id.org/mailo#LiteratureSource"
    ],
    "http://purl.org/dc/terms/date": [
      {
        "@value": "2025"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "Markov logic networks + probabilistic circuits over a safety reasoning graph. +30.2% over Llama Guard on ToxicChat; +59.5% under jailbreak attacks. Direct precedent for logic-graph-as-runtime-safety-filter pattern that MAILO advances, but for general LLM safety, not medical regulation."
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://arxiv.org/abs/2407.05557"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Kang, M., Li, B. et al. (2025). R²-Guard: Robust Reasoning Enabled LLM Guardrail via Knowledge-Enhanced Logical Reasoning. ICLR 2025."
      }
    ],
    "https://w3id.org/mailo#relevanceScore": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 5
      }
    ]
  },
