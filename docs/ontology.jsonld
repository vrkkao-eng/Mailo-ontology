  {
    "@id": "https://w3id.org/mailo#Tension_EPO_GDPR_Disclosure",
    "@type": [
      "https://w3id.org/mailo#CrossFrameworkTension"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\r\n        EPC Art.83 requires public disclosure of training data structure to maintain patent validity.\r\n        GDPR Art.15(1)(h) + C-203/22 require actionable explanations to data subjects.\r\n        The EPO disclosure may inadvertently establish a baseline that strengthens GDPR access rights,\r\n        eroding TSD Art.2 trade secret shields that might otherwise limit GDPR Art.15 responses.\r\n        TSD Art.9 judicial confidentiality measures do not apply to EPO prosecution, leaving no\r\n        mechanism to contain the disclosure baseline once it enters the public patent record.\r\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "EPC Art.83 Sufficiency Disclosure vs. GDPR Art.15(1)(h) + TSD Art.2 Secrecy"
      }
    ],
    "https://w3id.org/mailo#conflictsWith": [
      {
        "@id": "https://w3id.org/mailo#DisclosureObligation"
      }
    ],
    "https://w3id.org/mailo#involvesFramework": [
      {
        "@id": "https://w3id.org/mailo#EPC"
      },
      {
        "@id": "https://w3id.org/mailo#GDPR"
      },
      {
        "@id": "https://w3id.org/mailo#TSD"
      }
    ]
  },
  {
    "@id": "https://w3id.org/mailo#lit_Communications_Medicine_Nature_2025_Neuro-symbolic_AI",
    "@type": [
      "https://w3id.org/mailo#LiteratureSource"
    ],
    "http://purl.org/dc/terms/date": [
      {
        "@value": "2025"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "LLM extracts candidate facts → symbolic verifier checks against medical rules → traceable, deterministic labels. Empirical demonstration of the harness pattern MAILO advocates, applied to clinical text."
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://www.nature.com/articles/s43856-025-01194-x"
