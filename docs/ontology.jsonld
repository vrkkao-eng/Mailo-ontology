    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "DGA Art.10 prohibits data-sharing intermediaries from using shared data for purposes beyond the sharing service. Integrated AI development models in which intermediary and developer are related entities require structural business model restructuring that no guidance resolves."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "DGA Art.10 neutrality obligation vs. AI Act Art.10 data governance"
      }
    ],
