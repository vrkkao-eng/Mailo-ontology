  {
    "@id": "https://w3id.org/mailo#Tension_DataAct_TradeSecret_AITransparency",
    "@type": [
      "https://w3id.org/mailo#CrossFrameworkTension"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "C-203/22 Dun & Bradstreet §§60-70 limits trade-secret defence: a controller cannot refuse all causal explanation on trade-secret grounds. The precise boundary between permitted limitation and impermissible derogation is determined case-by-case."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Data Act Art.15 trade secret vs. AI Act Art.13 + GDPR Art.15(1)(h) transparency"
      }
    ],
