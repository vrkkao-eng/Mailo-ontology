  {
    "@id": "https://w3id.org/mailo#lit_Robaldo_L_Bartolini_C_Palmirani_M_et_al_2020_Fo",
    "@type": [
      "https://w3id.org/mailo#LiteratureSource"
    ],
    "http://purl.org/dc/terms/date": [
      {
        "@value": "2020"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "LegalRuleML + reified Input/Output logic + SPINDle defeasible reasoner. The canonical precedent for formal GDPR reasoning. Limitations addressed by MAILO: GDPR-only; no medical AI integration; no CJEU case-law layer; no runtime guardrail integration."
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
