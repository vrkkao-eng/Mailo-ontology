    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/mailo#RegulatoryAuthority"
      }
    ]
  },
  {
    "@id": "https://w3id.org/mailo#EPC",
    "@type": [
      "https://w3id.org/mailo#InternationalTreaty",
      "https://w3id.org/mailo#RegulatoryFramework"
    ],
    "http://purl.org/dc/terms/date": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "1977-10-07"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "European Patent Convention (in force 1977-10-07). Governs patentability of AI/medical-AI inventions (Art.52 exclusions), sufficiency of disclosure for ML models (Art.83), and EPO opposition/appeal proceedings. Administered by EPO; distinct from EU law but intersects via UPC."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "European Patent Convention"
      }
    ],
    "https://w3id.org/mailo#coversArticle": [
      {
        "@id": "https://w3id.org/mailo#EPC_Art52"
      },
      {
        "@id": "https://w3id.org/mailo#EPC_Art83"
      }
    ]
  },
  {
    "@id": "https://w3id.org/mailo#GDPR_Art9",
    "@type": [
      "https://w3id.org/mailo#LegalArticle"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Processing of special categories of personal data, including health data."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "GDPR Article 9"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://w3id.org/dpv#SpecialCategoryData"
      }
    ]
  },
  {
    "@id": "https://w3id.org/mailo",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-27"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "\r\n        Ontology capturing the legal landscape governing AI-driven automated\r\n        decision-making in medical contexts. Covers CJEU precedents on GDPR\r\n        Art.22, UPC/EPO patent litigation in MedTech, the EU AI Act high-risk\r\n        regime, MDR 2017/745, PLD 2024/2853, EHDS 2025/327, DGA 2022/868,\r\n        and Data Act 2023/2854 — with full precedent chains, SHACL runtime\r\n        constraints, and compliance obligation mappings.\r\n        Imports: W3C DPV v2.0 (data privacy vocabulary), AIRO (AI risk ontology),\r\n        ELI (European Legislation Identifier), ECLI (European Case Law Identifier).\r\n    "
      }
    ],
    "http://purl.org/dc/terms/language": [
      {
        "@value": "en"
      }
    ],
    "http://purl.org/dc/terms/modified": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-05-19"
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "en",
        "@value": "Medical AI Legal Ontology (MAILO)"
      }
    ],
    "http://www.w3.org/2002/07/owl#imports": [
      {
        "@id": "http://data.europa.eu/eli/ontology"
      },
