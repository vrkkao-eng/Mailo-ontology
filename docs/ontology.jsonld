  {
    "@id": "https://w3id.org/mailo#Tension_PLD_AIAct_Liability",
    "@type": [
      "https://w3id.org/mailo#CrossFrameworkTension"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\r\n        PLD Art.4 imposes strict liability; AI Act conformity assessment is not a\r\n        defence to PLD claims. A CE-marked AI-SaMD that passes AI Act conformity\r\n        assessment may still be 'defective' under PLD if it fails in real-world\r\n        deployment. The two regimes do not create a safety harbour from each other.\r\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "PLD Strict Liability vs. AI Act Conformity Defence"
      }
    ],
    "https://w3id.org/mailo#conflictsWith": [
      {
        "@id": "https://w3id.org/mailo#PLD_Art4"
      }
    ]
  },
